---
// Componente Unificado: Formulario / Funnel de Captación y Auditoría Técnica EMAX
// Centralizado en un único archivo para toda la web y preparado para conexión con el Backend.

import { site } from "../data/site";
import Logo from "./Logo.astro";
---

<!-- =========================================================================
     MODAL UNIFICADO: FORMULARIO DE ESTUDIO TÉCNICO Y CONTACTO
     ========================================================================= -->
<div
  class="modal-backdrop"
  id="modal-funnel"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-funnel-titulo"
  hidden
>
  <div class="modal-dialog">
    <!-- Cabecera: logo original, teléfono y cierre -->
    <header class="modal-cabecera">
      <div class="modal-marca-wrap">
        <Logo />
        <span class="modal-marca-sep" aria-hidden="true">|</span>
        <a href={site.phoneHref} class="modal-tel" title={`Llamar al ${site.phone}`}>{site.phone}</a>
      </div>

      <button
        type="button"
        class="modal-btn-cerrar"
        id="btn-cerrar-funnel"
        aria-label="Cerrar ventana y volver a la web"
      >
        <span>Volver a la web</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <!-- Barra de progreso paso a paso: cada etapa con su color -->
    <nav class="fn-stepper" aria-label="Progreso del estudio">
      <div class="fn-step activa" data-etapa-indicador="1" style="--c: #004aad; --c-suave: #e0edfe;">
        <span class="fn-step-circulo">
          <span class="fn-step-num">1</span>
          <svg class="fn-step-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span class="fn-step-textos">
          <span class="fn-step-label">Tu empresa</span>
          <span class="fn-step-desc">Nº de suministros</span>
        </span>
      </div>

      <div class="fn-step-linea" data-step-linea="1" style="--c: #004aad;" aria-hidden="true"></div>

      <div class="fn-step" data-etapa-indicador="2" style="--c: #19a9f0; --c-suave: #e1f4fd;">
        <span class="fn-step-circulo">
          <span class="fn-step-num">2</span>
          <svg class="fn-step-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span class="fn-step-textos">
          <span class="fn-step-label">Cómo empezamos</span>
          <span class="fn-step-desc">Llamada o factura</span>
        </span>
      </div>

      <div class="fn-step-linea" data-step-linea="2" style="--c: #19a9f0;" aria-hidden="true"></div>

      <div class="fn-step" data-etapa-indicador="3" style="--c: #f26a1b; --c-suave: #fdeadd;">
        <span class="fn-step-circulo">
          <span class="fn-step-num">3</span>
          <svg class="fn-step-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span class="fn-step-textos">
          <span class="fn-step-label">Tus datos</span>
          <span class="fn-step-desc">Contacto y franja</span>
        </span>
      </div>

      <div class="fn-step-linea" data-step-linea="3" style="--c: #f26a1b;" aria-hidden="true"></div>

      <div class="fn-step" data-etapa-indicador="4" style="--c: #12b76a; --c-suave: #e3f7ee;">
        <span class="fn-step-circulo">
          <span class="fn-step-num">4</span>
          <svg class="fn-step-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span class="fn-step-textos">
          <span class="fn-step-label">Listo</span>
          <span class="fn-step-desc">Solicitud enviada</span>
        </span>
      </div>
    </nav>

    <div class="modal-cuerpo-grid">
      <!-- COLUMNA IZQUIERDA: Formulario -->
      <div class="fn-col-izq">
        <!-- PASO 1: Suministros de la empresa -->
        <div class="fn-paso-vista" id="fn-paso-1" style="--c: #004aad;">
          <p class="fn-eyebrow">Paso 1 de 4 · Tu empresa</p>

          <div class="fn-resultado">
            <p class="fn-resultado-cifra" id="fn-resultado-texto">
              Estudio técnico gratuito para tu empresa.
            </p>
            <p class="fn-resultado-comun">Sin cambiarte de compañía ni asumir permanencias.</p>
            <p class="fn-resultado-msg" id="fn-resultado-msg">
              Revisamos tu curva de consumo, la potencia contratada vs demandada y eliminamos penalizaciones innecesarias.
            </p>
          </div>

          <h2 id="modal-funnel-titulo" class="fn-titulo">¿Cuántos suministros o sedes tiene tu empresa?</h2>

          <div class="fn-dos-botones">
            <button type="button" class="fn-opcion-btn" data-elegir-suministro="uno">
              Uno
            </button>
            <button type="button" class="fn-opcion-btn" data-elegir-suministro="varios">
              Varios
            </button>
          </div>

          <p class="fn-ayuda">Cada local, nave o sede con su propio contador cuenta como un suministro.</p>

          <div class="fn-porque">
            <p class="fn-porque-t">Por qué te lo preguntamos</p>
            <p class="fn-porque-c">Con varios suministros te atiende un gestor especialista que optimiza cada punto y el conjunto.</p>
          </div>
        </div>

        <!-- PASO 2: Cómo empezamos -->
        <div class="fn-paso-vista" id="fn-paso-2" style="--c: #19a9f0;" hidden>
          <p class="fn-eyebrow">Paso 2 de 4 · Cómo empezamos</p>
          <h2 class="fn-titulo">¿Cómo prefieres empezar?</h2>
          <p class="fn-sub">Elige lo que te resulte más cómodo para poner en marcha el estudio.</p>

          <div class="fn-canales-lista">
            <button type="button" class="fn-canal-tarjeta" data-elegir-canal="llamada">
              <div class="fn-canal-info">
                <strong class="fn-canal-tit">Una llamada</strong>
                <span class="fn-canal-desc">Un consultor te llama en la franja que elijas, con tu informe técnico delante.</span>
              </div>
              <span class="fn-canal-flecha" aria-hidden="true">→</span>
            </button>

            <button type="button" class="fn-canal-tarjeta" data-elegir-canal="factura">
              <div class="fn-canal-info">
                <strong class="fn-canal-tit">Subir mi factura</strong>
                <span class="fn-canal-desc">Foto o PDF de tu factura más reciente para hacer la auditoría inmediata.</span>
              </div>
              <span class="fn-canal-flecha" aria-hidden="true">→</span>
            </button>
          </div>

          <div class="fn-porque">
            <p class="fn-porque-t">Sin compromiso comercial</p>
            <p class="fn-porque-c">Te explicamos los números antes de pedirte nada. Si no te compensa, te lo decimos con honestidad.</p>
          </div>

          <button type="button" class="fn-atras-btn" data-ir-paso="1">
            ← Atrás
          </button>
        </div>

        <!-- PASO 3: Datos de contacto -->
        <div class="fn-paso-vista" id="fn-paso-3" style="--c: #f26a1b;" hidden>
          <p class="fn-eyebrow">Paso 3 de 4 · Tus datos</p>
          <h2 class="fn-titulo">¿Dónde te llamamos?</h2>
          <p class="fn-sub">Dinos a quién preguntar y en qué franja horaria te va mejor hablar.</p>

          <form class="fn-formulario" id="fn-form-datos">
            <!-- Campos ocultos para metadatos de lead y backend -->
            <input type="hidden" id="fn-input-suministros" name="suministros" value="uno" />
            <input type="hidden" id="fn-input-canal" name="canal" value="llamada" />
            <input type="hidden" id="fn-input-tramo" name="tramo_origen" value="general" />

            <div class="fn-campo">
              <label for="fn-input-nombre">Tu nombre o empresa</label>
              <input type="text" id="fn-input-nombre" name="nombre" required placeholder="Ej. Obrador La Espiga" autocomplete="organization" />
            </div>

            <div class="fn-campo">
              <label for="fn-input-telefono">Teléfono de contacto</label>
              <input type="tel" id="fn-input-telefono" name="telefono" required placeholder="Ej. 600 000 000" autocomplete="tel" />
            </div>

            <fieldset class="fn-grupo-franja">
              <legend>¿Cuándo te va mejor que te llamemos?</legend>
              <label class="fn-radio-label">
                <input type="radio" name="franja" value="manana" checked />
                <span>Por la mañana, de 9:00 a 13:00</span>
              </label>
              <label class="fn-radio-label">
                <input type="radio" name="franja" value="tarde" />
                <span>Por la tarde, de 15:00 a 19:00</span>
              </label>
            </fieldset>

            <p class="fn-antes-boton">
              Al pulsar, un consultor técnico te llamará con tu informe elaborado sin ningún coste ni permanencia.
            </p>

            <button type="submit" class="boton-fn-enviar" id="btn-submit-formulario">
              <span>Solicitar la llamada con mi informe</span>
            </button>
          </form>

          <button type="button" class="fn-atras-btn" data-ir-paso="2">
            ← Atrás
          </button>
        </div>

        <!-- PASO 4: Confirmación -->
        <div class="fn-paso-vista" id="fn-paso-4" style="--c: #12b76a;" hidden>
          <p class="fn-eyebrow">Paso 4 de 4 · Listo</p>

          <div class="fn-exito-tarjeta">
            <span class="fn-exito-check" aria-hidden="true">✓</span>
            <h2 class="fn-titulo">Hecho. Hemos recibido tu solicitud.</h2>
            <p class="fn-sub">
              Un consultor especialista de EMAX revisará los datos de tu empresa y te contactará en la franja elegida.
            </p>
          </div>

          <div class="fn-resumen-confirmacion">
            <p><strong>Lo que va a pasar ahora:</strong></p>
            <ul>
              <li>Revisamos tu consumo por periodos y maxímetros.</li>
              <li>Te llamamos para explicártelo por teléfono con tu informe delante.</li>
              <li>Te lo mandamos por escrito decidas lo que decidas.</li>
            </ul>
          </div>

          <button type="button" class="boton-fn-enviar" id="btn-finalizar-funnel">
            Volver a la web
          </button>
        </div>
      </div>

      <!-- COLUMNA DERECHA: Qué va a pasar -->
      <aside class="fn-panel" aria-label="Información del proceso de EMAX">
        <h3 class="fn-panel-t">Qué va a pasar</h3>

        <ol class="fn-panel-pasos">
          <li data-panel-paso="1" class="paso-actual" style="--c: #004aad; --c-suave: #e0edfe;">
            <span class="cifra">1</span>
            <div>
              <strong>Nos dices cómo consume tu empresa y cómo prefieres empezar.</strong>
            </div>
          </li>
          <li data-panel-paso="2" style="--c: #19a9f0; --c-suave: #e1f4fd;">
            <span class="cifra">2</span>
            <div>
              <strong>Maxi lee tu factura o los datos de tu suministro, y un especialista revisa los números.</strong>
            </div>
          </li>
          <li data-panel-paso="3" style="--c: #f26a1b; --c-suave: #fdeadd;">
            <span class="cifra">3</span>
            <div>
              <strong>Un consultor te llama, cuando tú digas, con tu informe técnico delante.</strong>
            </div>
          </li>
          <li data-panel-paso="4" style="--c: #12b76a; --c-suave: #e3f7ee;">
            <span class="cifra">4</span>
            <div>
              <strong>Te lo mandamos por escrito. Y decides tú.</strong>
            </div>
          </li>
        </ol>

        <div class="fn-panel-cierre">
          <p class="fn-panel-cierre-linea">Recibes tu informe decidas lo que decidas.</p>
          <p class="fn-panel-sin-coste">El análisis no tiene coste.</p>
          <p class="fn-panel-cierre-sub">
            Si tu contrato actual ya encaja con cómo consume tu empresa, te lo decimos por escrito en lugar de proponerte un cambio forzado.
          </p>
        </div>
      </aside>
    </div>
  </div>
</div>

<script>
  // =========================================================================
  // CONTROL GLOBAL DEL FORMULARIO Y CONEXIÓN CON BACKEND
  // =========================================================================
  function inicializarFormularioUnificado() {
    const modalFunnel = document.getElementById("modal-funnel");
    if (!modalFunnel || modalFunnel.dataset.iniciado === "true") return;
    modalFunnel.dataset.iniciado = "true";

    const btnCerrarFunnel = document.getElementById("btn-cerrar-funnel");
    const btnFinalizarFunnel = document.getElementById("btn-finalizar-funnel");

    const pasoVistas: Record<number, HTMLElement | null> = {
      1: document.getElementById("fn-paso-1"),
      2: document.getElementById("fn-paso-2"),
      3: document.getElementById("fn-paso-3"),
      4: document.getElementById("fn-paso-4"),
    };

    const etapaIndicadores = document.querySelectorAll("[data-etapa-indicador]");

    // Campos ocultos
    const inputSuministros = document.getElementById("fn-input-suministros") as HTMLInputElement | null;
    const inputCanal = document.getElementById("fn-input-canal") as HTMLInputElement | null;
    const inputTramo = document.getElementById("fn-input-tramo") as HTMLInputElement | null;

    // Elementos dinámicos del encabezado del paso 1
    const resultadoTexto = document.getElementById("fn-resultado-texto");
    const resultadoMsg = document.getElementById("fn-resultado-msg");

    function irAlPaso(numPaso: number) {
      Object.keys(pasoVistas).forEach((key) => {
        const k = Number(key);
        const vista = pasoVistas[k];
        if (vista) {
          if (k === numPaso) {
            vista.removeAttribute("hidden");
          } else {
            vista.setAttribute("hidden", "true");
          }
        }
      });

      etapaIndicadores.forEach((ind) => {
        const idx = Number(ind.getAttribute("data-etapa-indicador"));
        ind.classList.remove("activa", "completada");
        ind.removeAttribute("aria-current");
        if (idx === numPaso) {
          ind.classList.add("activa");
          ind.setAttribute("aria-current", "step");
        } else if (idx < numPaso) {
          ind.classList.add("completada");
        }
      });

      // Líneas conectoras del stepper
      document.querySelectorAll("[data-step-linea]").forEach((linea) => {
        const lineIdx = Number(linea.getAttribute("data-step-linea"));
        linea.classList.toggle("completada", lineIdx < numPaso);
      });

      // Pasos informativos de la columna derecha
      document.querySelectorAll("[data-panel-paso]").forEach((li) => {
        const pIdx = Number(li.getAttribute("data-panel-paso"));
        li.classList.remove("paso-actual", "paso-hecho");
        if (pIdx === numPaso) li.classList.add("paso-actual");
        else if (pIdx < numPaso) li.classList.add("paso-hecho");
      });
    }

    function abrirModalFunnel(btn?: HTMLElement | null) {
      // Personalizar el mensaje según el botón que abrió el modal
      if (btn) {
        const label = btn.getAttribute("data-tramo-label") || "Estudio técnico gratuito para tu empresa.";
        const msg = btn.getAttribute("data-tramo-msg") || "Revisamos tu curva de consumo, la potencia contratada vs demandada y eliminamos penalizaciones innecesarias.";
        const tramoId = btn.getAttribute("data-tramo-id") || "general";

        if (resultadoTexto) resultadoTexto.textContent = label;
        if (resultadoMsg) resultadoMsg.textContent = msg;
        if (inputTramo) inputTramo.value = tramoId;
      }

      irAlPaso(1);
      modalFunnel!.removeAttribute("hidden");
      document.body.style.overflow = "hidden";
    }

    function cerrarModalFunnel() {
      modalFunnel!.setAttribute("hidden", "true");
      document.body.style.overflow = "";
    }

    // Delegación global: cualquier botón con data-abrir-funnel abre este único formulario
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      const btn = target?.closest<HTMLElement>("[data-abrir-funnel]");
      if (btn) {
        e.preventDefault();
        abrirModalFunnel(btn);
      }
    });

    btnCerrarFunnel?.addEventListener("click", cerrarModalFunnel);
    btnFinalizarFunnel?.addEventListener("click", cerrarModalFunnel);

    // Cerrar con Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modalFunnel.hasAttribute("hidden")) {
        cerrarModalFunnel();
      }
    });

    // Cerrar al hacer clic fuera
    modalFunnel.addEventListener("click", (e) => {
      if (e.target === modalFunnel) {
        cerrarModalFunnel();
      }
    });

    // Paso 1: Selección de suministros
    document.querySelectorAll<HTMLButtonElement>("[data-elegir-suministro]").forEach((b) => {
      b.addEventListener("click", () => {
        const val = b.getAttribute("data-elegir-suministro") || "uno";
        if (inputSuministros) inputSuministros.value = val;
        irAlPaso(2);
      });
    });

    // Paso 2: Selección de canal de contacto
    document.querySelectorAll<HTMLButtonElement>("[data-elegir-canal]").forEach((b) => {
      b.addEventListener("click", () => {
        const canal = b.getAttribute("data-elegir-canal") || "llamada";
        if (inputCanal) inputCanal.value = canal;
        irAlPaso(3);
      });
    });

    // Botones de vuelta atrás
    document.querySelectorAll<HTMLButtonElement>("[data-ir-paso]").forEach((b) => {
      b.addEventListener("click", () => {
        const target = Number(b.getAttribute("data-ir-paso")) || 1;
        irAlPaso(target);
      });
    });

    // =========================================================================
    // CONEXIÓN CON EL BACKEND (API / CRM / EMAIL)
    // =========================================================================
    async function enviarLeadAlBackend(datos: Record<string, string>) {
      /*
      // EJEMPLO DE CONEXIÓN CON ENDPOINT BACKEND:
      try {
        const respuesta = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datos)
        });
        return respuesta.ok;
      } catch (error) {
        console.error("Error al enviar lead al backend:", error);
        return false;
      }
      */
      console.log("Lead capturado correctamente para el backend:", datos);
      return true;
    }

    // Paso 3: Envío del formulario
    const formDatos = document.getElementById("fn-form-datos") as HTMLFormElement | null;
    formDatos?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(formDatos);
      const datosLead: Record<string, string> = {
        nombre: String(formData.get("nombre") || ""),
        telefono: String(formData.get("telefono") || ""),
        franja: String(formData.get("franja") || "manana"),
        suministros: inputSuministros?.value || "uno",
        canal: inputCanal?.value || "llamada",
        tramo_origen: inputTramo?.value || "general",
        fecha: new Date().toISOString(),
      };

      await enviarLeadAlBackend(datosLead);
      irAlPaso(4);
    });
  }

  inicializarFormularioUnificado();
  document.addEventListener("astro:page-load", inicializarFormularioUnificado);
</script>

<style>
  /* ==========================================================================
     MODAL FUNNEL / FORMULARIO UNIFICADO EMAX
     Diseño corporativo sobrio: sin animaciones ni transiciones.
     ========================================================================== */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(8, 20, 42, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(12px, 3vw, 32px);
    overflow-y: auto;
  }

  .modal-backdrop[hidden] {
    display: none !important;
  }

  .modal-dialog {
    position: relative;
    width: 100%;
    max-width: 1040px;
    background: #ffffff;
    border: 1px solid #dce6f2;
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(0, 20, 50, 0.35);
    overflow: hidden;
  }

  /* ---------- Cabecera ---------- */
  .modal-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 28px;
    background: #ffffff;
    border-bottom: 1px solid #e8eef6;
  }

  .modal-marca-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .modal-marca-wrap :global(.logo) {
    display: flex;
    align-items: center;
  }

  .modal-marca-wrap :global(.logo img) {
    height: 32px;
    width: auto;
    display: block;
  }

  .modal-marca-sep {
    color: #cbd5e1;
    font-size: 0.9rem;
    font-weight: 300;
  }

  .modal-tel {
    font-size: 0.88rem;
    color: #0f2346;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .modal-tel:hover {
    color: #004aad;
  }

  .modal-btn-cerrar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid #dce6f2;
    color: #3a4b68;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 7px 13px;
    border-radius: 9999px;
    cursor: pointer;
  }

  .modal-btn-cerrar:hover {
    background: #f1f5f9;
    color: #0f2346;
  }

  /* ==========================================================================
     STEPPER PASO A PASO
     Pendiente: gris · Activo: color de la etapa · Completado: check + color suave
     ========================================================================== */
  .fn-stepper {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 28px;
    background: #f8fafc;
    border-bottom: 1px solid #e8eef6;
  }

  .fn-step {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    color: #8a97ab;
  }

  .fn-step-circulo {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #cbd5e1;
    color: #8a97ab;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .fn-step-check {
    display: none;
  }

  .fn-step-textos {
    display: flex;
    flex-direction: column;
