---
// Componente: Dock Flotante de Conversión (Fijo en la parte inferior)
// Diseñado para mantener siempre visible la llamada a la acción clave
// (Te llamamos gratis + Analizar factura). Aparece suavemente al hacer scroll.
import { site } from "../data/site";
---

<aside class="dock-flotante" aria-label="Acciones rápidas de contacto" data-dock>
  <div class="dock-capsula">
    <a href={site.phoneHref} class="dock-btn dock-btn-secundario" data-dock-call>
      <svg class="dock-icono" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      <span>Te llamamos gratis</span>
    </a>

    <a href="/#estudio" class="dock-btn dock-btn-primario" data-dock-cta>
      <span>Analizar mi factura</span>
      <svg class="dock-icono" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</aside>

<script>
  const dock = document.querySelector("[data-dock]");
  const handleScroll = () => {
    if (dock) {
      if (window.scrollY > 280) {
        dock.classList.add("visible");
      } else {
        dock.classList.remove("visible");
      }
    }
  };
  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();
</script>

<style>
  .dock-flotante {
    position: fixed;
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translate(-50%, 20px);
    opacity: 0;
    pointer-events: none;
    z-index: var(--z-dock, 45);
    width: auto;
    max-width: calc(100vw - 32px);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dock-flotante.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .dock-capsula {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(14px);
    border: 1.5px solid #d0deef;
    border-radius: var(--radio-pill, 999px);
    box-shadow: 0 14px 40px rgba(15, 35, 70, 0.18);
  }

  .dock-capsula:hover {
    box-shadow: 0 18px 48px rgba(0, 74, 173, 0.24);
  }

  .dock-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 46px;
    padding: 0 20px;
    border-radius: var(--radio-pill, 999px);
    font-size: 0.925rem;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .dock-btn-secundario {
    background: transparent;
    color: var(--tinta, #0f2346);
  }

  .dock-btn-secundario:hover {
    background: var(--azul-suave, #edf4fe);
    color: var(--azul-900, #004aad);
  }

  .dock-btn-primario {
    background: var(--azul-900, #004aad);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 74, 173, 0.3);
  }

  .dock-btn-primario:hover {
    background: var(--azul-900-hover, #003c8c);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(0, 74, 173, 0.4);
  }

  .dock-icono {
    flex-shrink: 0;
  }

  @media (max-width: 580px) {
    .dock-flotante {
      width: calc(100vw - 24px);
    }

    .dock-capsula {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      padding: 5px;
    }

    .dock-btn {
      padding: 0 10px;
      font-size: 0.82rem;
      height: 42px;
    }

    .dock-btn span {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
