---
// Componente: HeroGas.astro
// Sección Hero oficial de la página Gas Natural para Empresas, Comunidades y Hogares
import heroGasImg from "../../../imagenes/tarifas/gas/Hero (3).png";
---

<section class="hero-gas-seccion" aria-labelledby="h1-gas-natural">
  <!-- Fondo fotográfico con encuadre de personas como en el boceto y degradado azul corporativo -->
  <div class="hero-gas-fondo" aria-hidden="true">
    <div class="hero-gas-foto-wrap">
      <img
        src={heroGasImg.src}
        alt=""
        class="hero-bg-img"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="hero-bg-overlay"></div>
  </div>

  <div class="hero-gas-contenedor">
    <!-- Rejilla Principal en 2 Columnas -->
    <div class="hero-gas-grid">
      <!-- Columna Izquierda: Miga de pan, mensaje y propuesta de valor -->
      <div class="hero-gas-col-izq">


        <p class="gas-kicker">
          GAS NATURAL · EMPRESAS, COMUNIDADES Y HOGARES <span class="kicker-cursor" aria-hidden="true">|</span>
        </p>

        <h1 class="gas-hero-titulo" id="h1-gas-natural">
          TU <span class="titulo-cursiva-gas">factura de gas</span><br />
          TAMBIÉN SE LEE ANTES<br />
          DE CAMBIARLA.
        </h1>

        <p class="gas-hero-desc">
          Tu peaje, tu consumo del año, tu precio y si te corresponde la tarifa regulada. Si tienes luz y gas, los revisamos en el mismo estudio.
        </p>

        <!-- Píldora interactiva cian -->
        <div class="gas-pildora-wrap">
          <a href="/tarifas/comunidades-de-propietarios" class="btn-gas-pildora">
            <span>¿Comunidad de vecinos o vivienda? Empieza aquí</span>
            <span class="btn-pildora-circulo" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 3.5 10.5 8 6 12.5"></path>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Tarjeta "¿Para quién es el gas?" -->
      <div class="hero-gas-col-der">
        <div class="gas-hero-card">
          <span class="card-etiqueta-tag">EMPIEZA AQUÍ · SIN COSTE</span>
          <h2 class="gas-card-titulo">¿Para quién es el gas?</h2>

          <div class="gas-opciones-lista">
            <!-- Opción 1: PARA MI EMPRESA -->
            <button
              type="button"
              class="btn-gas-opcion"
              data-abrir-funnel
              data-segmento="empresa"
              aria-label="Contratar gas para mi empresa"
            >
              <div class="opcion-circulo-icono" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#004aad" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>
              <div class="opcion-textos">
                <span class="opcion-tit">PARA MI EMPRESA</span>
                <span class="opcion-sub">Local, nave, hotel, restaurante u oficina.</span>
              </div>
            </button>

            <!-- Opción 2: PARA UNA COMUNIDAD -->
            <button
              type="button"
              class="btn-gas-opcion"
              data-abrir-funnel
              data-segmento="comunidad"
              aria-label="Contratar gas para una comunidad de propietarios"
            >
              <div class="opcion-circulo-icono" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#004aad" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21h18"></path>
                  <path d="M19 21v-8a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v8"></path>
                  <path d="M9 21v-4a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v4"></path>
                  <path d="M10 9l4-4 4 4"></path>
                </svg>
              </div>
              <div class="opcion-textos">
                <span class="opcion-tit">PARA UNA COMUNIDAD</span>
                <span class="opcion-sub">Calefacción central, agua caliente o la caldera común.</span>
              </div>
            </button>

            <!-- Opción 3: PARA MI CASA -->
            <button
              type="button"
              class="btn-gas-opcion"
              data-abrir-funnel
              data-segmento="hogar"
              aria-label="Contratar gas para mi casa o vivienda"
            >
              <div class="opcion-circulo-icono" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#004aad" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
              </div>
              <div class="opcion-textos">
                <span class="opcion-tit">PARA MI CASA</span>
                <span class="opcion-sub">Cocina, agua caliente o calefacción.</span>
              </div>
            </button>
          </div>

          <p class="gas-card-pie-nota">
            Después te preguntamos cuánto pagas, con importes de tu caso.
          </p>
        </div>
      </div>
    </div>

    <!-- Cintillo inferior continuo de lectura integrado con línea divisoria como en el boceto -->
    <div class="gas-hero-cintillo">
      <span class="cintillo-label">LEEMOS:</span>
      <span class="cintillo-items">PEAJE · CONSUMO DEL AÑO · TEMPORADA · PRECIO · TARIFA REGULADA</span>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     HERO GAS NATURAL - DISEÑO OFICIAL BOCETO
     ========================================================================== */
  .hero-gas-seccion {
    position: relative;
    z-index: 20;
    margin-top: -78px;
    min-height: clamp(640px, 82vh, 760px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(78px + 28px);
    background: #011d55;
    overflow: hidden;
    color: #ffffff;
  }

  /* Fondo fotográfico posicionado en el bloque centro-derecha para encuadrar a las dos personas exactamente como en el boceto */
  .hero-gas-fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background-color: #011d55;
  }

  .hero-gas-foto-wrap {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 64%;
    overflow: hidden;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #011d55 0%,
      #011d55 37%,
      rgba(1, 29, 85, 0.94) 41%,
      rgba(3, 34, 96, 0.72) 48%,
      rgba(4, 38, 106, 0.56) 58%,
      rgba(5, 40, 108, 0.38) 67%,
      rgba(5, 40, 108, 0.12) 75%,
      transparent 83%
    );
    pointer-events: none;
  }

  @media (max-width: 1024px) {
    .hero-gas-foto-wrap {
      width: 100%;
    }

    .hero-bg-img {
      object-position: 55% 20%;
    }

    .hero-bg-overlay {
      background: linear-gradient(
        180deg,
        rgba(1, 29, 85, 0.92) 0%,
        rgba(2, 32, 92, 0.84) 55%,
        rgba(3, 35, 98, 0.78) 100%
      );
    }
  }

  .hero-gas-contenedor {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    margin-top: auto;
    padding-inline: clamp(24px, 4.5vw, 64px);
    padding-top: 24px;
    padding-bottom: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(28px, 4vh, 44px);
  }

  /* Rejilla de 2 columnas */
  .hero-gas-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 68px);
    align-items: start;
  }

  @media (max-width: 1024px) {
    .hero-gas-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  /* ==========================================================================
     COLUMNA IZQUIERDA
     ========================================================================== */
  .hero-gas-col-izq {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    max-width: 520px;
    padding-top: 8px;
  }

  .gas-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Sora", sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.52);
    margin-bottom: clamp(28px, 4vh, 46px);
  }

  .gas-breadcrumb a {
    color: rgba(255, 255, 255, 0.52);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .gas-breadcrumb a:hover {
    color: #ffffff;
  }

  .bc-dot {
    color: rgba(255, 255, 255, 0.4);
  }

  .bc-actual {
    color: #ffffff;
    font-weight: 700;
    margin-left: 4px;
  }

  .gas-kicker {
    font-family: "Sora", sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .kicker-cursor {
    color: #00c2ff;
    font-weight: 700;
    font-size: 1.15em;
  }

  .gas-hero-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.15rem, 1.75rem + 1.9vw, 3.1rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.16;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .titulo-cursiva-gas {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: #00c2ff;
    letter-spacing: 0;
    display: inline;
  }

  .gas-hero-desc {
    font-size: clamp(0.98rem, 0.92rem + 0.25vw, 1.08rem);
    line-height: 1.58;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 24px;
    max-width: 470px;
  }

  /* Píldora cian */
  .gas-pildora-wrap {
    margin-top: 2px;
  }

  .btn-gas-pildora {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #00c2ff;
    color: #05225c;
    font-family: "Sora", sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    padding: 7px 9px 7px 20px;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(0, 194, 255, 0.3);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-gas-pildora:hover {
    background: #2ed1ff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 194, 255, 0.45);
  }

  .btn-pildora-circulo {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #004aad;
    color: #00c2ff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .btn-gas-pildora:hover .btn-pildora-circulo {
    transform: translateX(2px);
    background: #003785;
  }

  /* ==========================================================================
     COLUMNA DERECHA - TARJETA TRANSLÚCIDA BOCETO
     ========================================================================== */
  .hero-gas-col-der {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    width: 100%;
    padding-top: clamp(32px, 5.5vh, 58px);
  }

  @media (max-width: 1024px) {
    .hero-gas-col-der {
      justify-content: flex-start;
      padding-top: 0;
    }
  }

  .gas-hero-card {
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.34) 0%,
      rgba(235, 243, 255, 0.24) 100%
    );
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 20px;
    padding: clamp(22px, 2.6vw, 30px);
    width: 100%;
    max-width: 450px;
    box-shadow: 0 18px 42px rgba(0, 15, 45, 0.18);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-etiqueta-tag {
    font-family: "Sora", sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    color: #004aad;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gas-card-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.4rem, 1.25rem + 0.4vw, 1.7rem);
    font-weight: 800;
    color: #111827;
    margin: -4px 0 4px;
    line-height: 1.22;
  }

  .gas-opciones-lista {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  /* Botones de opción azul corporativo dentro de la tarjeta de cristal */
  .btn-gas-opcion {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #004aad;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 12px 16px;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(0, 50, 130, 0.22);
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
  }

  .btn-gas-opcion:hover {
    background: #0059cf;
    border-color: rgba(0, 194, 255, 0.6);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 50, 130, 0.35);
  }

  .opcion-circulo-icono {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #d8dee6;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .btn-gas-opcion:hover .opcion-circulo-icono {
    transform: scale(1.04);
    background: #ffffff;
  }

  .opcion-textos {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .opcion-tit {
    font-family: "Sora", sans-serif;
    font-size: 0.82rem;
    font-weight: 800;
    color: #00c2ff;
    letter-spacing: 0.05em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .opcion-sub {
    font-size: 0.85rem;
    color: #ffffff;
    line-height: 1.35;
  }

  .gas-card-pie-nota {
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.45;
    color: #1e293b;
    margin: 4px 0 0;
  }

  /* ==========================================================================
     CINTILLO INFERIOR INTEGRADO
     ========================================================================== */
  .gas-hero-cintillo {
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    padding-top: 16px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: "Sora", sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  .cintillo-label {
    font-weight: 800;
    color: #ffffff;
  }

  .cintillo-items {
    font-weight: 500;
    color: rgba(255, 255, 255, 0.82);
  }

  @media (max-width: 640px) {
    .btn-gas-pildora {
      font-size: 0.78rem;
      padding: 7px 8px 7px 14px;
    }
    .gas-hero-card {
      padding: 20px 16px;
    }
    .btn-gas-opcion {
      padding: 11px 13px;
      gap: 12px;
    }
  }
</style>
