---
// Componente: QueFijaLaNormaGas.astro
// Sección: "ÁREAS DE ANÁLISIS | QUÉ fija la norma Y QUÉ SE PUEDE DECIDIR"
// Tarjetas interactivas a la izquierda con el diseño oficial de Guías (icono, badge 01-04, tag, titular, subtítulo y flecha circular)
// Panel azul dinámico a la derecha con dos tarjetas blancas interiores: "Qué dice la norma" y "Qué hacemos con eso".

const tabsNorma = [
  {
    id: "peajes-cargos",
    num: "01",
    categoria: "Regulación de peajes",
    label: "Peajes y cargos",
    subtitulo: "Qué fija la norma y cómo se calcula",
    icono: "layers",
    norma: "Los fija la regulación según tu consumo anual. Son los mismos con cualquier comercializadora.",
    hacemos: "Comprobamos que tu peaje corresponde a lo que consumes."
  },
  {
    id: "tarifa-regulada",
    num: "02",
    categoria: "Tarifa regulada (TUR)",
    label: "Tarifa regulada (TUR)",
    subtitulo: "Límites de consumo hasta 50.000 kWh",
    icono: "shield-check",
    norma: "Existe para consumos de hasta 50.000 kWh al año, pensada para hogares y consumos pequeños.",
    hacemos: "Si estás en ella, te decimos si te compensa seguir."
  },
  {
    id: "comunidades-calefaccion",
    num: "03",
    categoria: "Calefacción central",
    label: "Comunidades con calefacción central",
    subtitulo: "Uso residencial y calderas comunes",
    icono: "building",
    norma: "Las comunidades de uso residencial con calefacción central pueden acogerse a la tarifa regulada aunque consuman más de 50.000 kWh al año. Necesitan contadores individuales o repartidores de costes, salvo que no sea técnicamente viable, y la inspección RITE en regla.",
    hacemos: "Comprobamos si la comunidad cumple y qué le cuesta frente al mercado libre."
  },
  {
    id: "precio-energia",
    num: "04",
    categoria: "Condiciones de contrato",
    label: "Precio de la energía y condiciones",
    subtitulo: "Margen de mercado y negociación",
    icono: "sliders",
    norma: "Los fija tu contrato con la comercializadora.",
    hacemos: "Es lo que se puede mejorar: precio, modalidad y duración."
  }
];
---

<section class="norma-gas-seccion" id="norma-gas" aria-labelledby="h2-norma-gas">
  <div class="norma-gas-contenedor">
    <!-- Encabezado de la Sección -->
    <header class="norma-gas-header">
      <p class="norma-gas-kicker">
        ÁREAS DE ANÁLISIS <span class="kicker-cursor" aria-hidden="true">|</span>
      </p>

      <h2 class="norma-gas-titulo" id="h2-norma-gas">
        QUÉ <span class="titulo-cursiva-azul">fija la norma</span> Y QUÉ SE PUEDE DECIDIR
      </h2>

      <p class="norma-gas-subtitulo">
        La normativa establece unas bases, pero hay margen para adaptar tu contrato a tus necesidades y perfil de consumo.
      </p>
    </header>

    <!-- Componente Interactivo Split: Tarjetas estilo Guías a la izquierda + Panel a la derecha -->
    <div class="norma-split-layout" data-norma-interactivo>
      <!-- Columna Izquierda: Tarjetas estilo Guías -->
      <div class="norma-tabs-col" role="tablist" aria-label="Áreas de análisis de gas">
        {
          tabsNorma.map((t, index) => (
            <button
              type="button"
              class:list={["tab-norma-card", { activo: index === 0 }]}
              role="tab"
              id={`tab-btn-${t.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`panel-${t.id}`}
              data-tab-target={t.id}
            >
              <!-- Icono temático en caja redondeada suave -->
              <div class="tab-card-izq" aria-hidden="true">
                <div class="tab-card-icono-box">
                  {t.icono === "layers" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                      <polyline points="2 17 12 22 22 17"></polyline>
                      <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                  )}
                  {t.icono === "shield-check" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                  )}
                  {t.icono === "building" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 21h18"></path>
                      <path d="M19 21v-8a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v8"></path>
                      <path d="M9 21v-4a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v4"></path>
                      <path d="M10 9l4-4 4 4"></path>
                    </svg>
                  )}
                  {t.icono === "sliders" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="4" y1="21" x2="4" y2="14"></line>
                      <line x1="4" y1="10" x2="4" y2="3"></line>
                      <line x1="12" y1="21" x2="12" y2="12"></line>
                      <line x1="12" y1="8" x2="12" y2="3"></line>
                      <line x1="20" y1="21" x2="20" y2="16"></line>
                      <line x1="20" y1="12" x2="20" y2="3"></line>
                      <line x1="1" y1="14" x2="7" y2="14"></line>
                      <line x1="9" y1="8" x2="15" y2="8"></line>
                      <line x1="17" y1="16" x2="23" y2="16"></line>
                    </svg>
                  )}
                </div>
              </div>

              <!-- Contenido central: badges, título y subtítulo -->
              <div class="tab-card-content">
                <div class="tab-card-top">
                  <span class="tab-num-badge">{t.num}</span>
                  <span class="tab-tag">{t.categoria}</span>
                </div>
                <h3 class="tab-pregunta">{t.label}</h3>
                <div class="tab-card-bottom">
                  <span class="tab-guia-txt">
                    <span class="tab-guia-prefijo">Guía recomendada:</span> {t.subtitulo}
                  </span>
                </div>
              </div>

              <!-- Flecha circular a la derecha -->
              <div class="tab-card-der" aria-hidden="true">
                <span class="tab-btn-flecha">
                  <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="8" x2="13" y2="8"></line>
                    <polyline points="8 3 13 8 8 13"></polyline>
                  </svg>
                </span>
              </div>
            </button>
          ))
        }
      </div>

      <!-- Columna Derecha: Paneles Azules Dinámicos -->
      <div class="norma-paneles-col">
        {
          tabsNorma.map((t, index) => (
            <div
              class:list={["norma-panel-azul", { visible: index === 0 }]}
              id={`panel-${t.id}`}
              role="tabpanel"
              aria-labelledby={`tab-btn-${t.id}`}
              data-panel-id={t.id}
            >
              <!-- Indicador de número superior con línea -->
              <div class="panel-indicador-sup">
                <span class="indicador-num-circulo">{t.num}</span>
                <span class="indicador-linea" aria-hidden="true"></span>
              </div>

              <!-- Dos tarjetas blancas interiores -->
              <div class="panel-dos-tarjetas">
                <!-- Tarjeta 1: Qué dice la norma -->
                <article class="tarjeta-blanca-interior">
                  <div class="tarjeta-icono-header">
                    <div class="tarjeta-icono-circulo" aria-hidden="true">
                      <!-- Icono documento / norma -->
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004aad" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                      </svg>
                    </div>
                  </div>
                  <h4 class="tarjeta-interior-tit">Qué dice la norma</h4>
                  <p class="tarjeta-interior-desc">{t.norma}</p>
                </article>

                <!-- Tarjeta 2: Qué hacemos con eso -->
                <article class="tarjeta-blanca-interior">
                  <div class="tarjeta-icono-header">
                    <div class="tarjeta-icono-circulo" aria-hidden="true">
                      <!-- Icono engranaje / ajustes -->
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#004aad" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                      </svg>
                    </div>
                  </div>
                  <h4 class="tarjeta-interior-tit">Qué hacemos con eso</h4>
                  <p class="tarjeta-interior-desc">{t.hacemos}</p>
                </article>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: QUÉ FIJA LA NORMA Y QUÉ SE PUEDE DECIDIR
     ========================================================================== */
  .norma-gas-seccion {
    padding: clamp(64px, 7vw, 100px) 0;
    background: #ffffff;
    width: 100%;
    position: relative;
    border-top: 1px solid #eef2f6;
  }

  .norma-gas-contenedor {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 52px);
  }

  /* Encabezado */
  .norma-gas-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(36px, 4vw, 50px);
  }

  .norma-gas-kicker {
    font-family: "Sora", sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .kicker-cursor {
    color: #0052cc;
    font-weight: 400;
    font-size: 1.15em;
    margin-left: 2px;
  }

  .norma-gas-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2rem, 1.8rem + 1.2vw, 2.85rem);
    font-weight: 800;
    color: #0c192c;
    line-height: 1.18;
    margin: 0 0 16px;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .titulo-cursiva-azul {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: #4f8df9;
    letter-spacing: 0;
    display: inline;
  }

  .norma-gas-subtitulo {
    font-size: 1.05rem;
    line-height: 1.62;
    color: #334155;
    margin: 0;
    max-width: 760px;
  }

  /* Layout Dividido 2 Columnas */
  .norma-split-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.45fr);
    gap: clamp(24px, 3.5vw, 44px);
    align-items: start;
  }

  @media (max-width: 1024px) {
    .norma-split-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* Columna Izquierda: Tarjetas estilo Guías */
  .norma-tabs-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  /* Tarjeta interactiva estilo Guías */
  .tab-norma-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 20px;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(15, 35, 70, 0.04);
    transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
    overflow: hidden;
    width: 100%;
  }

  .tab-norma-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: transparent;
    transition: background-color 0.25s ease;
  }

  .tab-norma-card:hover,
  .tab-norma-card.activo {
    background: #ffffff;
    border-color: #004aad;
    box-shadow: 0 8px 24px rgba(0, 74, 173, 0.10);
  }

  .tab-norma-card.activo::before,
  .tab-norma-card:hover::before {
    background: #004aad;
  }

  /* Icono temático */
  .tab-card-icono-box {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #f0f7ff;
    border: 1px solid #dbeafe;
    color: #004aad;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }

  .tab-norma-card:hover .tab-card-icono-box,
  .tab-norma-card.activo .tab-card-icono-box {
    background: #004aad;
    border-color: #004aad;
    color: #ffffff;
  }

  .tab-card-content {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .tab-card-top {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tab-num-badge {
    font-family: "Sora", sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    color: #64748b;
    background: #f1f5f9;
    padding: 2px 7px;
    border-radius: 6px;
    letter-spacing: 0.04em;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .tab-norma-card.activo .tab-num-badge,
  .tab-norma-card:hover .tab-num-badge {
    background: #e0edfe;
    color: #004aad;
  }

  .tab-tag {
    font-family: "Sora", sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    color: #0284c7;
    background: #e0f2fe;
    padding: 2px 9px;
    border-radius: 9999px;
  }

  .tab-pregunta {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.05rem;
    line-height: 1.35;
    font-weight: 700;
    color: #0f2346;
    margin: 0;
    transition: color 0.2s ease;
  }

  .tab-norma-card:hover .tab-pregunta,
  .tab-norma-card.activo .tab-pregunta {
    color: #004aad;
  }

  .tab-card-bottom {
    margin-top: 1px;
  }

  .tab-guia-txt {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.4;
  }

  .tab-guia-prefijo {
    color: #94a3b8;
    font-weight: 500;
  }

  /* Flecha a la derecha */
  .tab-btn-flecha {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f1f5f9;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .tab-norma-card:hover .tab-btn-flecha,
  .tab-norma-card.activo .tab-btn-flecha {
    background: #004aad;
    color: #ffffff;
  }

  /* Columna Derecha: Paneles Azules Dinámicos */
  .norma-paneles-col {
    position: relative;
    width: 100%;
  }

  .norma-panel-azul {
    display: none;
    background: #004aad;
    border-radius: 28px;
    padding: clamp(26px, 3.2vw, 38px);
    box-shadow: 0 16px 40px rgba(0, 74, 173, 0.18);
    width: 100%;
  }

  .norma-panel-azul.visible {
    display: flex;
    flex-direction: column;
    gap: 22px;
    animation: fadeInPanelSuave 0.22s ease-out;
  }

  @keyframes fadeInPanelSuave {
    from {
      opacity: 0.25;
    }
    to {
      opacity: 1;
    }
  }

  /* Indicador numérico superior */
  .panel-indicador-sup {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .indicador-num-circulo {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    color: #004aad;
    font-family: "Sora", sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .indicador-linea {
    width: 34px;
    height: 2.5px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 2px;
  }

  /* Dos tarjetas blancas interiores */
  .panel-dos-tarjetas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 680px) {
    .panel-dos-tarjetas {
      grid-template-columns: 1fr;
    }
  }

  .tarjeta-blanca-interior {
    background: #ffffff;
    border-radius: 22px;
    padding: 26px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
  }

  .tarjeta-icono-header {
    margin-bottom: 2px;
  }

  .tarjeta-icono-circulo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #e0f2fe;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tarjeta-interior-tit {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.15rem;
    font-weight: 800;
    color: #004aad;
    margin: 0;
    line-height: 1.28;
  }

  .tarjeta-interior-desc {
    font-size: 0.88rem;
    line-height: 1.58;
    color: #475569;
    margin: 0;
  }
</style>

<script>
  function setupNormaTabs() {
    const containers = document.querySelectorAll('[data-norma-interactivo]');
    containers.forEach((container) => {
      const cards = container.querySelectorAll<HTMLButtonElement>('.tab-norma-card');
      const panels = container.querySelectorAll<HTMLElement>('.norma-panel-azul');

      function activarCard(card: HTMLButtonElement) {
        if (card.classList.contains('activo')) return;
        const targetId = card.getAttribute('data-tab-target');
        if (!targetId) return;

        // Actualizar estado activo de las tarjetas
        cards.forEach((c) => {
          const isActive = c === card;
          c.classList.toggle('activo', isActive);
          c.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        // Actualizar visibilidad de los paneles
        panels.forEach((p) => {
          const matches = p.getAttribute('data-panel-id') === targetId;
          p.classList.toggle('visible', matches);
        });
      }

      let hoverTimer: ReturnType<typeof setTimeout> | null = null;

      cards.forEach((card) => {
        // Al pasar el cursor por encima (hover suave y fluido)
        card.addEventListener('mouseenter', () => {
          if (card.classList.contains('activo')) return;
          if (hoverTimer) clearTimeout(hoverTimer);
          hoverTimer = setTimeout(() => {
            activarCard(card);
          }, 60);
        });

        // Al hacer click
        card.addEventListener('click', () => {
          if (hoverTimer) clearTimeout(hoverTimer);
          activarCard(card);
        });

        // Al navegar con teclado (focus)
        card.addEventListener('focus', () => {
          if (hoverTimer) clearTimeout(hoverTimer);
          activarCard(card);
        });
      });

      const listContainer = container.querySelector('.norma-tabs-col');
      listContainer?.addEventListener('mouseleave', () => {
        if (hoverTimer) clearTimeout(hoverTimer);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNormaTabs);
  } else {
    setupNormaTabs();
  }
  document.addEventListener('astro:page-load', setupNormaTabs);
</script>
