---
// Componente CasoTarifa para la página /tarifas
// Muestra el caso de auditoría real del obrador de panadería: "ASÍ QUEDÓ SU TARIFA"
// Diseño de alta fidelidad según la maqueta oficial: tarjeta gris sobre fondo azul marino profundo
const filasCaso = [
  {
    num: "1",
    pieza: "Estructura",
    valor: "Genio · seis periodos",
    porque: "El 56 % de su consumo del año cae en P6."
  },
  {
    num: "2",
    pieza: "Modalidad",
    valor: "Precio fijo · 12 meses",
    porque: "Márgenes estrechos y consumo estable de un mes a otro."
  },
  {
    num: "3",
    pieza: "Potencia",
    valor: "25 · 30 · 30 · 30 · 30 · 42 kW",
    porque: "Maxímetros de doce meses, con margen. P3 y P5 suben a 30 kW porque cada periodo necesita igual o más potencia que el anterior."
  },
  {
    num: "4",
    pieza: "Condiciones",
    valor: "Entrada el 1-12-2026",
    porque: "Al terminar su contrato actual, para no pagar penalización."
  }
];
---

<section class="caso-obrador-seccion" id="caso-obrador" aria-labelledby="h2-quedo">
  <div class="caso-contenedor">
    <article class="caso-card">
      <!-- Banda superior informativa (blanca) -->
      <header class="caso-banda">
        <span class="caso-etiqueta">Caso de ejemplo</span>
        <span class="caso-supuestos-txt">
          Los peajes, los cargos y los impuestos son los oficiales de 2026.
          <a href="/guias/factura-luz-empresa#supuestos" class="link-supuestos">Ver los supuestos</a>
        </span>
      </header>

      <!-- Cuerpo del caso (gris suave) -->
      <div class="caso-cuerpo">
        <h2 class="caso-titulo" id="h2-quedo">ASÍ QUEDÓ SU TARIFA</h2>
        <p class="caso-entradilla">
          Un obrador de panadería con tienda: 2.078 € en febrero. Esto es lo que salió de leer sus doce meses de datos.
        </p>

        <!-- 4 Filas de la tarifa auditada con badges numéricos cian -->
        <div class="quedo-filas-lista">
          {
            filasCaso.map((f) => (
              <div class="quedo-fila">
                <span class="quedo-num-badge" aria-hidden="true">{f.num}</span>
                <div class="quedo-info">
                  <h3 class="quedo-pieza-tit">{f.pieza}</h3>
                  <p class="quedo-valor">{f.valor}</p>
                  <p class="quedo-porque">{f.porque}</p>
                </div>
              </div>
            ))
          }
        </div>

        <p class="quedo-nota">
          Es un ejemplo. Tu tarifa sale de tu consumo, con las mismas cuatro piezas.
        </p>

        <!-- Botón Píldora inferior -->
        <div class="caso-btn-wrap">
          <a href="/guias/factura-luz-empresa" class="btn-metodo-pill">
            <span>Ver cómo leímos su factura, línea a línea</span>
            <span class="pill-circulo-flecha" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 3.5 10.5 8 6 12.5"></path>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <!-- Pie del caso (blanco) -->
      <footer class="caso-pie">
        <span class="caso-pregunta">¿Hacemos lo mismo con tu factura?</span>
        <a href="/guias/factura-luz-empresa" class="link-guia-factura">Cómo leer la factura de luz de tu empresa</a>
      </footer>
    </article>
  </div>
</section>

<style>
  .caso-obrador-seccion {
    padding: clamp(64px, 7vw, 104px) 0;
    background: #081d3e;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .caso-contenedor {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(20px, 3.5vw, 48px);
  }

  .caso-card {
    background: #e2e8f0;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* Banda superior informativa */
  .caso-banda {
    background: #ffffff;
    padding: 18px clamp(24px, 4vw, 64px);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 20px;
    border-bottom: 1px solid #cbd5e1;
  }

  .caso-etiqueta {
    display: inline-flex;
    align-items: center;
    background: #0052cc;
    color: #ffffff;
    padding: 6px 16px;
    border-radius: 999px;
    font-family: "Sora", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .caso-supuestos-txt {
    font-size: 0.90rem;
    color: #475569;
    font-weight: 500;
  }

  .link-supuestos {
    color: #0c192c;
    font-weight: 800;
    text-decoration: none;
    margin-left: 6px;
    transition: color 0.2s ease;
  }

  .link-supuestos:hover {
    color: #0052cc;
    text-decoration: underline;
  }

  /* Cuerpo del caso */
  .caso-cuerpo {
    padding: clamp(40px, 4.5vw, 62px) clamp(24px, 4vw, 64px);
  }

  @media (max-width: 640px) {
    .caso-cuerpo {
      padding: 28px 20px 24px;
    }
  }

  .caso-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.75rem, 2.3vw, 2.3rem);
    font-weight: 800;
    color: #0c192c;
    margin: 0 0 12px;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .caso-entradilla {
    font-family: "Sora", sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.6;
    color: #0052cc;
    margin: 0 0 28px;
  }

  /* Filas de la tarifa */
  .quedo-filas-lista {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #cbd5e1;
    margin-bottom: 26px;
  }

  .quedo-fila {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid #cbd5e1;
  }

  .quedo-num-badge {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #00c2ff;
    color: #0c192c;
    font-family: "Sora", sans-serif;
    font-size: 1.12rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0, 194, 255, 0.4);
    margin-top: 2px;
  }

  .quedo-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  .quedo-pieza-tit {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.12rem;
    font-weight: 800;
    color: #0052cc;
    margin: 0;
  }

  .quedo-valor {
    font-size: 1.02rem;
    font-weight: 600;
    color: #1e293b;
    margin: 0;
  }

  .quedo-porque {
    font-size: 0.94rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }

  .quedo-nota {
    font-family: "Sora", sans-serif;
    font-size: 0.96rem;
    font-weight: 700;
    color: #0052cc;
    margin: 0 0 24px;
  }

  /* Botón Píldora inferior */
  .caso-btn-wrap {
    margin-top: 4px;
  }

  .btn-metodo-pill {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: #0052cc;
    color: #ffffff;
    font-family: "Sora", sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    padding: 10px 14px 10px 22px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(0, 82, 204, 0.35);
    transition: all 0.2s ease;
  }

  .btn-metodo-pill:hover {
    background: #003fa0;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 82, 204, 0.45);
  }

  .pill-circulo-flecha {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #00c2ff;
    color: #0052cc;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Pie del caso */
  .caso-pie {
    background: #ffffff;
    padding: 20px clamp(24px, 4.5vw, 60px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px 20px;
    border-top: 1px solid #cbd5e1;
  }

  @media (max-width: 640px) {
    .caso-pie {
      padding: 16px 20px;
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .caso-pregunta {
    font-family: "Sora", sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    color: #0c192c;
    margin: 0;
  }

  .link-guia-factura {
    font-family: "Sora", sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    color: #0052cc;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link-guia-factura:hover {
    color: #003fa0;
    text-decoration: underline;
  }
</style>
