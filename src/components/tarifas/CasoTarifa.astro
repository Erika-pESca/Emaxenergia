---
// Componente CasoTarifa para la página /tarifas
// Muestra el caso de auditoría real del obrador de panadería: "Así quedó su tarifa"
const filasCaso = [
  {
    pieza: "Estructura",
    valor: "Genio · seis periodos",
    porque: "El 56 % de su consumo del año cae en P6 (periodo nocturno más barato)."
  },
  {
    pieza: "Modalidad",
    valor: "Precio fijo · 12 meses",
    porque: "Márgenes estrechos y consumo estable y predecible de un mes a otro."
  },
  {
    pieza: "Potencia",
    valor: "25 · 30 · 30 · 30 · 30 · 42 kW",
    porque: "Maxímetros de doce meses con margen técnico. P3 y P5 suben a 30 kW porque cada periodo necesita igual o más potencia que el anterior por normativa."
  },
  {
    pieza: "Condiciones",
    valor: "Entrada el 1-12-2026",
    porque: "Al terminar su contrato actual, para no pagar penalización por permanencia."
  }
];
---

<section class="caso-obrador-seccion" id="caso-obrador" aria-labelledby="h2-quedo">
  <div class="caso-contenedor">
    <article class="caso-card">
      <!-- Banda superior informativa -->
      <header class="caso-banda">
        <span class="caso-etiqueta">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16">
            <path d="M1.8 4.2a1 1 0 0 1 1-1h3.4l1.4 1.6h5.6a1 1 0 0 1 1 1v6.9a1 1 0 0 1-1 1H2.8a1 1 0 0 1-1-1Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
          </svg>
          Caso de ejemplo
        </span>
        <span class="caso-supuestos-txt">
          Los peajes, los cargos y los impuestos son los oficiales de 2026.
        </span>
      </header>

      <!-- Cuerpo del caso -->
      <div class="caso-cuerpo">
        <h2 class="caso-titulo" id="h2-quedo">ASÍ QUEDÓ SU TARIFA</h2>
        <p class="caso-entradilla">
          Un obrador de panadería con tienda: 2.078 € en febrero. Esto es lo que salió de leer sus doce meses de datos de consumo.
        </p>

        <div class="quedo-filas-lista">
          {
            filasCaso.map((f) => (
              <div class="quedo-fila">
                <dt class="quedo-pieza">{f.pieza}</dt>
                <dd class="quedo-detalle">
                  <strong class="quedo-valor">{f.valor}</strong>
                  <span class="quedo-porque">{f.porque}</span>
                </dd>
              </div>
            ))
          }
        </div>

        <p class="quedo-nota">
          Es un ejemplo. Tu tarifa sale de tu consumo real, construida con las mismas cuatro piezas.
        </p>

        <div class="caso-enlace-diag">
          <a href="/diagnostico#factura-obrador" class="link-diag-obrador">
            <span>Ver cómo leímos su factura, línea a línea</span>
            <span class="link-flecha" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Pie del caso con CTA directo -->
      <footer class="caso-pie">
        <p class="caso-pregunta">¿Hacemos lo mismo con tu factura?</p>
        <div class="caso-acciones">
          <a href="#estudio" class="btn-analizar-caso" data-abrir-funnel>
            <span>Analizar mi factura</span>
            <span class="btn-flecha" aria-hidden="true">→</span>
          </a>
        </div>
      </footer>
    </article>
  </div>
</section>

<style>
  .caso-obrador-seccion {
    padding: clamp(48px, 6vw, 84px) 0;
    background: #ffffff;
    border-bottom: 1px solid #eef2f6;
  }

  .caso-contenedor {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 44px);
  }

  .caso-card {
    background: #f8fafc;
    border: 1.5px solid #dbeafe;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(0, 74, 173, 0.08);
  }

  .caso-banda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    padding: 16px 28px;
    background: #eff6ff;
    border-bottom: 1px solid #bfdbfe;
  }

  .caso-etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #004aad;
    color: #ffffff;
    padding: 5px 12px;
    border-radius: 999px;
    font-family: "Sora", sans-serif;
    font-size: 0.80rem;
    font-weight: 700;
  }

  .caso-supuestos-txt {
    font-size: 0.86rem;
    color: #475569;
    font-weight: 500;
  }

  .caso-cuerpo {
    padding: 36px 32px;
  }

  @media (max-width: 768px) {
    .caso-cuerpo {
      padding: 24px 20px;
    }
  }

  .caso-titulo {
    font-family: "Sora", sans-serif;
    font-size: clamp(1.6rem, 1.35rem + 1vw, 2.2rem);
    font-weight: 800;
    color: #0c1c38;
    margin: 0 0 12px;
    letter-spacing: -0.015em;
  }

  .caso-entradilla {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #475569;
    margin: 0 0 28px;
  }

  .quedo-filas-lista {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #e2e8f0;
    margin-bottom: 20px;
  }

  .quedo-fila {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid #eef2f6;
    align-items: baseline;
  }

  @media (max-width: 680px) {
    .quedo-fila {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  .quedo-pieza {
    font-family: "Sora", sans-serif;
    font-size: 0.88rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748b;
  }

  .quedo-detalle {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .quedo-valor {
    font-family: "Sora", sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    color: #004aad;
  }

  .quedo-porque {
    font-size: 0.90rem;
    line-height: 1.5;
    color: #475569;
  }

  .quedo-nota {
    font-size: 0.86rem;
    color: #64748b;
    font-style: italic;
    margin: 0 0 20px;
  }

  .caso-enlace-diag {
    margin-top: 10px;
  }

  .link-diag-obrador {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: #004aad;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .link-diag-obrador:hover {
    color: #003680;
    text-decoration: underline;
  }

  .link-flecha {
    transition: transform 0.2s ease;
  }

  .link-diag-obrador:hover .link-flecha {
    transform: translateX(4px);
  }

  .caso-pie {
    padding: 24px 32px;
    background: #eff6ff;
    border-top: 1px solid #bfdbfe;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  @media (max-width: 768px) {
    .caso-pie {
      padding: 20px;
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .caso-pregunta {
    font-family: "Sora", sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    color: #0c1c38;
    margin: 0;
  }

  .btn-analizar-caso {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #004aad;
    color: #ffffff;
    font-family: "Sora", sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0, 74, 173, 0.25);
    transition: all 0.2s ease;
  }

  .btn-analizar-caso:hover {
    background: #003680;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 74, 173, 0.35);
  }

  .btn-flecha {
    transition: transform 0.2s ease;
  }

  .btn-analizar-caso:hover .btn-flecha {
    transform: translateX(4px);
  }
</style>
