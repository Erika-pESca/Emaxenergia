<script>
  // Control interactivo de acordeón para las 4 piezas
  const contenedor = document.querySelector("[data-acordeon-piezas]");
  if (contenedor) {
    const items = contenedor.querySelectorAll("[data-pieza-item]");

    items.forEach((item) => {
      const trigger = item.querySelector("[data-pieza-trigger]");
      const panel = item.querySelector(".acordeon-contenido");

      trigger?.addEventListener("click", () => {
        const estaAbierta = item.classList.contains("abierta");

        // Cerrar las demás para mantener una vista limpia idéntica al boceto
        items.forEach((otro) => {
          otro.classList.remove("abierta");
          otro.querySelector("[data-pieza-trigger]")?.setAttribute("aria-expanded", "false");
          const otroPanel = otro.querySelector(".acordeon-contenido");
          if (otroPanel) (otroPanel as HTMLElement).hidden = true;
        });

        // Alternar la pulsada
        if (!estaAbierta && panel) {
          item.classList.add("abierta");
          trigger.setAttribute("aria-expanded", "true");
          (panel as HTMLElement).hidden = false;
        }
      });
    });
  }
</script>

