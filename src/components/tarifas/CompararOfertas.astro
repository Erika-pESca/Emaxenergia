---
// Componente: CompararOfertas para la página /tarifas
// Cinco comprobaciones indispensables para comparar cualquier oferta eléctrica de empresa
// Diseño oficial fiel a la maqueta: Fondo azul oscuro (#081d3e), badges cian (1-5),
// acordeones interactivos que se cierran entre sí, y CTA con botón píldora cian.

const comprobaciones = [
  {
    num: "1",
    titulo: "Con tu consumo, no con un kWh",
    texto: "Pide que te calculen un año de factura con tu consumo real por periodos de los últimos doce meses. Un precio por kWh suelto no dice cuánto vas a pagar."
  },
  {
    num: "2",
    titulo: "La potencia, además de la energía",
    texto: "Mira a qué precio va la potencia: si es el regulado o lleva algo encima."
  },
  {
    num: "3",
    titulo: "Qué puede cambiar",
    texto: "Pregunta qué puede cambiar durante el contrato y cómo te lo tienen que avisar."
  },
  {
    num: "4",
    titulo: "La permanencia",
    texto: "Si la hay, pregunta qué obtienes a cambio."
  },
  {
    num: "5",
    titulo: "Qué protege un techo",
    texto: "Un precio máximo protege el precio de la energía. No corrige una potencia que sobra, ni un reparto por periodos que no es el tuyo."
  }
];
---

<section class="comparar-seccion" id="comparar" aria-labelledby="h2-comparar">
  <div class="comparar-contenedor">
    <!-- Columna Izquierda: Título y Subtítulo -->
    <div class="comparar-col-izq">
      <h2 class="comparar-titulo" id="h2-comparar">
        CÓMO COMPARAR CUALQUIER OFERTA. <span class="titulo-destacado-cursiva">La nuestra también.</span>
      </h2>
      <p class="comparar-subtitulo">
        Cinco comprobaciones que te sirven aunque no contrates con nosotros.
      </p>
    </div>

    <!-- Columna Derecha: Acordeones 1 al 5 + Mensaje + Botón CTA -->
    <div class="comparar-col-der">
      <div class="comprobaciones-lista" data-comprobaciones-acordeon>
        {
          comprobaciones.map((c) => (
            <details class="comprobacion-item" name="comprobaciones-acordeon">
              <summary class="comprobacion-trigger">
                <span class="comprobacion-num-badge" aria-hidden="true">{c.num}</span>
                <span class="comprobacion-tit">{c.titulo}</span>
                <span class="comprobacion-icono-toggle" aria-hidden="true">
                  <svg class="icono-flecha" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="comprobacion-cuerpo">
                <p class="comprobacion-texto">{c.texto}</p>
              </div>
            </details>
          ))
        }
      </div>

      <!-- Bloque final de llamada a la acción -->
      <div class="comparar-cierre">
        <p class="cierre-texto">
          El paso siguiente es aplicar estas cinco comprobaciones a tu factura. Podemos hacerlo contigo.
        </p>

        <a href="#estudio" class="btn-analizar-factura" data-abrir-funnel>
          <span>Analizar mi factura</span>
          <span class="btn-circulo-flecha" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .comparar-seccion {
    padding: clamp(64px, 7vw, 100px) 0;
    background: #081d3e;
    color: #ffffff;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .comparar-contenedor {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: clamp(36px, 6vw, 84px);
    align-items: start;
  }

  @media (max-width: 960px) {
    .comparar-contenedor {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* Columna Izquierda */
  .comparar-col-izq {
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 100px;
  }

  @media (max-width: 960px) {
    .comparar-col-izq {
      position: static;
    }
  }

  .comparar-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2rem, 1.8rem + 1.4vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.18;
    margin: 0 0 22px;
    letter-spacing: -0.015em;
  }

  .titulo-destacado-cursiva {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    color: #00c2ff;
    display: inline;
  }

  .comparar-subtitulo {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
    max-width: 440px;
  }

  /* Columna Derecha */
  .comparar-col-der {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .comprobaciones-lista {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    width: 100%;
  }

  .comprobacion-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    transition: background 0.2s ease;
  }

  .comprobacion-item[open] {
    background: rgba(255, 255, 255, 0.03);
  }

  .comprobacion-trigger {
    padding: 18px 8px;
    display: flex;
    align-items: center;
    gap: 18px;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: all 0.2s ease;
  }

  .comprobacion-trigger::-webkit-details-marker {
    display: none;
  }

  .comprobacion-trigger:hover .comprobacion-tit {
    color: #ffffff;
  }

  .comprobacion-trigger:hover .comprobacion-icono-toggle {
    border-color: #00c2ff;
    color: #00c2ff;
  }

  /* Badge numérico circular cian (1 al 5) */
  .comprobacion-num-badge {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #00c2ff;
    color: #081d3e;
    font-family: "Sora", sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 10px rgba(0, 194, 255, 0.3);
  }

  /* Título de la comprobación en cian */
  .comprobacion-tit {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: #00c2ff;
    flex-grow: 1;
    line-height: 1.35;
    transition: color 0.2s ease;
  }

  /* Icono toggle circular con flecha */
  .comprobacion-icono-toggle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .icono-flecha {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .comprobacion-item[open] .comprobacion-icono-toggle {
    border-color: #00c2ff;
    background: #00c2ff;
    color: #081d3e;
  }

  .comprobacion-item[open] .icono-flecha {
    transform: rotate(180deg);
  }

  /* Cuerpo expandido con animación fluida */
  .comprobacion-cuerpo {
    padding: 2px 12px 20px 52px;
    animation: fadeInSlide 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .comprobacion-texto {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
  }

  /* Bloque de cierre inferior */
  .comparar-cierre {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .cierre-texto {
    font-size: 0.98rem;
    line-height: 1.55;
    color: #cbd5e1;
    margin: 0;
    max-width: 540px;
  }

  /* Botón píldora cian con círculo de flecha azul oscuro */
  .btn-analizar-factura {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: #00c2ff;
    color: #081d3e;
    font-family: "Sora", sans-serif;
    font-size: 0.96rem;
    font-weight: 800;
    padding: 8px 10px 8px 24px;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(0, 194, 255, 0.3);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-analizar-factura:hover {
    background: #26cbff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 194, 255, 0.45);
  }

  .btn-circulo-flecha {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #0083a8;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .btn-analizar-factura:hover .btn-circulo-flecha {
    transform: translateX(3px);
    background: #006b8a;
  }

  @media (max-width: 640px) {
    .comprobacion-cuerpo {
      padding-left: 20px;
    }
    .comprobacion-trigger {
      gap: 12px;
    }
  }
</style>

<script>
  function setupComprobacionesAcordeon() {
    const containers = document.querySelectorAll('[data-comprobaciones-acordeon]');
    containers.forEach((container) => {
      const items = container.querySelectorAll<HTMLDetailsElement>('details.comprobacion-item');
      items.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (item.open) {
            items.forEach((otherItem) => {
              if (otherItem !== item && otherItem.open) {
                otherItem.open = false;
              }
            });
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupComprobacionesAcordeon);
  } else {
    setupComprobacionesAcordeon();
  }
  document.addEventListener('astro:page-load', setupComprobacionesAcordeon);
</script>
