---
// Componente: DosComunidadesComparativa.astro
// Sección de Comunidades: "DOS COMUNIDADES, DOS facturas que no se parecen"
// Comparativa visual de alta fidelidad entre "Comunidad A" vs "Comunidad B" con fotografía real y tarjeta de conclusión

import imgComunidadA from "../../../imagenes/comunidad_a_complejo.jpg";
import imgComunidadB from "../../../imagenes/comunidad_b_bloque.jpg";

interface FilaComunidad {
  titulo: string;
  icono: "tiene" | "potencia" | "ano" | "primero";
  textoA: string;
  textoB: string;
}

const caracteristicas: FilaComunidad[] = [
  {
    titulo: "Qué tiene",
    icono: "tiene",
    textoA: "Ascensor, garaje con puerta y ventilación, y piscina con depuradora en verano.",
    textoB: "Sin ascensor. Alumbrado de escalera y portero automático.",
  },
  {
    titulo: "Su potencia",
    icono: "potencia",
    textoA: "La marcan el ascensor y el garaje cuando coinciden. Puede llegar a pasar de 15 kW, y entonces cambian el peaje y las reglas.",
    textoB: "Muy baja. Lo que pesa en su factura es la parte fija, no el consumo.",
  },
  {
    titulo: "Su año",
    icono: "ano",
    textoA: "Más consumo en verano, por la piscina.",
    textoB: "Casi igual todo el año.",
  },
  {
    titulo: "Qué se mira primero",
    icono: "primero",
    textoA: "Que la potencia cubra el ascensor y el garaje a la vez, sin sobrar el resto del tiempo.",
    textoB: "Que la potencia contratada no sea mayor de lo que necesitan una escalera y un portero.",
  },
];
---

<section
  class="dos-comunidades-seccion"
  id="dos-comunidades-comparativa"
  aria-labelledby="dos-comunidades-tit"
>
  <div class="dos-comunidades-contenedor">
    <!-- Encabezado de la Sección -->
    <div class="dos-comunidades-header">
      <div class="etiqueta-kicker">
        <span>DOS COMUNIDADES QUE NO SE PARECEN</span>
        <span class="separador-barra" aria-hidden="true">|</span>
      </div>

      <h2 class="dos-comunidades-titulo" id="dos-comunidades-tit">
        DOS COMUNIDADES, DOS
        <span class="subtitulo-destacado">facturas que no se parecen</span>
      </h2>

      <p class="dos-comunidades-bajada">
        Mismo tipo de cliente, necesidades muy distintas.
      </p>

      <span class="nota-ilustrativa">Ejemplo ilustrativo.</span>
    </div>

    <!-- Rejilla Comparativa de las 2 Comunidades -->
    <div class="comparativa-comunidades-grid">
      <!-- 1. COMUNIDAD A -->
      <article class="tarjeta-comunidad" aria-label="Análisis de Comunidad A">
        <div class="tarjeta-media">
          <img
            src={imgComunidadA.src}
            alt="Complejo residencial con ascensor exterior, garaje comunitario y piscina"
            class="tarjeta-foto"
            loading="lazy"
            decoding="async"
          />
          <div class="badge-comunidad badge-comunidad-a">Comunidad A</div>
        </div>

        <div class="tarjeta-cuerpo">
          <ul class="filas-stack" role="list">
            {
              caracteristicas.map((c) => (
                <li class="fila-detalle">
                  <div class="circulo-icono-azul" aria-hidden="true">
                    {c.icono === "tiene" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <path d="M3 9h18" />
                        <path d="M9 21V9" />
                      </svg>
                    )}
                    {c.icono === "potencia" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                      </svg>
                    )}
                    {c.icono === "ano" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2" />
                        <path d="M12 20v2" />
                        <path d="m4.93 4.93 1.41 1.41" />
                        <path d="m17.66 17.66 1.41 1.41" />
                        <path d="M2 12h2" />
                        <path d="M20 12h2" />
                        <path d="m6.34 17.66-1.41 1.41" />
                        <path d="m19.07 4.93-1.41 1.41" />
                      </svg>
                    )}
                    {c.icono === "primero" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 14 14" />
                      </svg>
                    )}
                  </div>
                  <div class="fila-textos">
                    <h3 class="fila-titulo">{c.titulo}</h3>
                    <p class="fila-desc">{c.textoA}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <!-- 2. COMUNIDAD B -->
      <article class="tarjeta-comunidad" aria-label="Análisis de Comunidad B">
        <div class="tarjeta-media">
          <img
            src={imgComunidadB.src}
            alt="Edificio residencial tradicional de tres plantas sin ascensor en calle tranquila"
            class="tarjeta-foto"
            loading="lazy"
            decoding="async"
          />
          <div class="badge-comunidad badge-comunidad-b">Comunidad B</div>
        </div>

        <div class="tarjeta-cuerpo">
          <ul class="filas-stack" role="list">
            {
              caracteristicas.map((c) => (
                <li class="fila-detalle">
                  <div class="circulo-icono-azul" aria-hidden="true">
                    {c.icono === "tiene" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <path d="M3 9h18" />
                        <path d="M9 21V9" />
                      </svg>
                    )}
                    {c.icono === "potencia" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                      </svg>
                    )}
                    {c.icono === "ano" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2" />
                        <path d="M12 20v2" />
                        <path d="m4.93 4.93 1.41 1.41" />
                        <path d="m17.66 17.66 1.41 1.41" />
                        <path d="M2 12h2" />
                        <path d="M20 12h2" />
                        <path d="m6.34 17.66-1.41 1.41" />
                        <path d="m19.07 4.93-1.41 1.41" />
                      </svg>
                    )}
                    {c.icono === "primero" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 14 14" />
                      </svg>
                    )}
                  </div>
                  <div class="fila-textos">
                    <h3 class="fila-titulo">{c.titulo}</h3>
                    <p class="fila-desc">{c.textoB}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: DOS COMUNIDADES, DOS FACTURAS QUE NO SE PARECEN (FONDO AZUL)
     ========================================================================== */
  .dos-comunidades-seccion {
    position: relative;
    width: 100%;
    background: #081d3e;
    color: #ffffff;
    padding: clamp(65px, 7vw, 105px) 0 clamp(75px, 8vw, 115px);
    overflow: hidden;
    box-sizing: border-box;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .dos-comunidades-contenedor {
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  /* Encabezado */
  .dos-comunidades-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(38px, 4.5vw, 54px);
    max-width: 920px;
  }

  .etiqueta-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .separador-barra {
    color: #00c2ff;
    font-weight: 800;
  }

  .dos-comunidades-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.9rem + 1.2vw, 2.95rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 10px 0;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .subtitulo-destacado {
    display: block;
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #00c2ff;
    margin-top: 4px;
  }

  .dos-comunidades-bajada {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem);
    line-height: 1.55;
    color: #cbd5e1;
    margin: 0 0 6px 0;
  }

  .nota-ilustrativa {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  /* ==========================================================================
     REJILLA COMPARATIVA DE 2 TARJETAS
     ========================================================================== */
  .comparativa-comunidades-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3.2vw, 44px);
    margin-bottom: 0;
  }

  /* Tarjeta Individual en Fondo Oscuro */
  .tarjeta-comunidad {
    background: rgba(11, 30, 64, 0.78);
    border: 1.5px solid rgba(56, 182, 255, 0.26);
    border-radius: 28px;
    overflow: hidden;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.32);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .tarjeta-comunidad:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 194, 255, 0.55);
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.44), 0 0 24px rgba(0, 194, 255, 0.12);
  }

  /* Media Superior con Foto y Badge de Píldora */
  .tarjeta-media {
    position: relative;
    width: 100%;
    height: clamp(200px, 22vw, 260px);
    overflow: hidden;
    background: #081d3e;
  }

  .tarjeta-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
  }

  .tarjeta-comunidad:hover .tarjeta-foto {
    transform: scale(1.03);
  }

  /* Badge de Píldora */
  .badge-comunidad {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    padding: 7px 24px;
    border-radius: 9999px;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    z-index: 2;
    letter-spacing: 0.02em;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .badge-comunidad-a {
    background: #004aad;
  }

  .badge-comunidad-b {
    background: #0070f3;
  }

  /* Cuerpo de la Tarjeta */
  .tarjeta-cuerpo {
    padding: clamp(24px, 3vw, 36px) clamp(20px, 2.8vw, 32px);
    display: flex;
    flex-direction: column;
    flex: 1;
    background: transparent;
  }

  .filas-stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.2vw, 24px);
  }

  .fila-detalle {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding-bottom: clamp(14px, 1.8vw, 20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .fila-detalle:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Círculo con Icono Azul Sólido */
  .circulo-icono-azul {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #0052cc;
    border: 1px solid rgba(255, 255, 255, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(0, 82, 204, 0.45);
    margin-top: 2px;
  }

  .fila-textos {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fila-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: #00c2ff;
    margin: 0;
    line-height: 1.3;
  }

  .fila-desc {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: 0.88rem;
    line-height: 1.55;
    color: #e2e8f0;
    margin: 0;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 900px) {
    .comparativa-comunidades-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 600px) {
    .tarjeta-cuerpo {
      padding: 22px 18px;
    }

    .fila-detalle {
      gap: 12px;
    }

    .circulo-icono-azul {
      width: 32px;
      height: 32px;
    }

    .circulo-icono-azul svg {
      width: 14px;
      height: 14px;
    }
  }
</style>
