---
// Componente: ComoLoHacemosComunidades.astro
// Sección: "CÓMO lo hacemos" para Comunidades de Propietarios (/tarifas/comunidades-de-propietarios)
// Estilo oficial de tarjetas EMAX con insignias circulares superpuestas (azul + cian con número en relieve),
// fondo azul corporativo (#081d3e) y tipografía Poppins + Literata.

interface Props {
  id?: string;
}

const { id = "como-lo-hacemos" } = Astro.props;

interface TarjetaProceso {
  numero: string;
  icono: "llamada" | "varias" | "fiscal";
  titulo: string;
  texto: string;
  notaLegal?: string;
}

const pasos: TarjetaProceso[] = [
  {
    numero: "01",
    icono: "llamada",
    titulo: "Quién nos llama",
    texto: "El presidente o el administrador.",
  },
  {
    numero: "02",
    icono: "varias",
    titulo: "Si llevas varias",
    texto: "Cada comunidad es un titular distinto y autoriza lo suyo. Tú tienes un solo interlocutor en EMAX para todas.",
  },
  {
    numero: "03",
    icono: "fiscal",
    titulo: "Al comparar ofertas",
    texto: "Mirad el importe con impuestos. Una comunidad, por lo general, no se deduce el IVA: es lo que pagan los vecinos.",
    notaLegal: "[LEGAL: validar con asesoría fiscal]",
  },
];
---

<section
  class="como-hacemos-seccion"
  id={id}
  aria-labelledby="como-hacemos-tit"
>
  <div class="como-hacemos-contenedor">
    <!-- Encabezado de la Sección con combinación de tipografías Poppins + Literata -->
    <div class="como-hacemos-header">
      <h2 class="como-hacemos-titulo" id="como-hacemos-tit">
        CÓMO <span class="como-hacemos-cursiva">lo hacemos</span>
      </h2>

      <p class="como-hacemos-bajada">
        El estudio de una comunidad es más sencillo que el de una empresa. Lo hacemos en una llamada, con la factura delante.
      </p>
    </div>

    <!-- Rejilla oficial de 3 Tarjetas con insignia flotante circular solapada -->
    <div class="como-hacemos-grid">
      {
        pasos.map((p) => (
          <article class="proceso-card" aria-label={p.titulo}>
            <!-- Insignia circular decorativa superior con icono alusivo y número en relieve -->
            <div class="proceso-badge-wrap" aria-hidden="true">
              <div class="badge-circulo-azul">
                {p.icono === "llamada" && (
                  <svg
                    class="badge-svg-icono"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                )}

                {p.icono === "varias" && (
                  <svg
                    class="badge-svg-icono"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                  </svg>
                )}

                {p.icono === "fiscal" && (
                  <svg
                    class="badge-svg-icono"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                  </svg>
                )}
              </div>

              <!-- Círculo cian inferior con el número en relieve -->
              <div class="badge-circulo-cyan">
                <span class="badge-num">{p.numero}</span>
              </div>
            </div>

            <!-- Contenido de la tarjeta -->
            <h3 class="proceso-card-tit">{p.titulo}</h3>
            <p class="proceso-card-desc">{p.texto}</p>

            {p.notaLegal && (
              <div class="proceso-nota-legal-wrap">
                <span class="proceso-nota-legal" role="note">
                  {p.notaLegal}
                </span>
              </div>
            )}
          </article>
        ))
      }
    </div>

    <!-- Enlaces Píldora de Acción Inferiores -->
    <div class="como-hacemos-acciones">
      <!-- 1. Enlace a varios suministros -->
      <a
        href="/sectores/varios-suministros"
        class="boton-pildora-accion"
      >
        <span>Cómo trabajamos con varios suministros</span>
        <span class="icono-flecha-azul" aria-hidden="true">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#003882"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>

      <!-- 2. Enlace de recomendación a comunidades -->
      <a
        href="/diagnostico"
        class="boton-pildora-accion"
      >
        <span>¿Quieres recomendarnos a tus comunidades?</span>
        <span class="icono-flecha-azul" aria-hidden="true">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#003882"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: CÓMO LO HACEMOS (FONDO AZUL CORPORATIVO #081d3e)
     Estilo oficial idéntico a "UN SERVICIO, leído en la factura" (Restaurantes)
     ========================================================================== */
  .como-hacemos-seccion {
    position: relative;
    width: 100%;
    background: #081d3e;
    color: #ffffff;
    padding: clamp(65px, 7vw, 105px) 0 clamp(75px, 8vw, 115px);
    overflow: hidden;
    box-sizing: border-box;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .como-hacemos-contenedor {
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
  }

  /* Encabezado */
  .como-hacemos-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(48px, 6vw, 68px);
    max-width: 820px;
  }

  /* Título en dos tiempos con cursiva de marca */
  .como-hacemos-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.9rem + 1.2vw, 2.95rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 14px 0;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .como-hacemos-cursiva {
    display: inline;
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #00c2ff;
  }

  .como-hacemos-bajada {
    font-size: clamp(0.98rem, 0.94rem + 0.25vw, 1.1rem);
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
  }

  /* ==========================================================================
     REJILLA DE 3 TARJETAS OFICIALES EMAX
     ========================================================================== */
  .como-hacemos-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 36px);
    align-items: stretch;
    margin-top: 28px;
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  /* Tarjeta individual con efecto vidrio azul y bordes cian sutiles */
  .proceso-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(11, 30, 64, 0.76);
    border: 1.5px solid rgba(56, 182, 255, 0.26);
    border-radius: 24px;
    padding: 56px 30px 36px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.32);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    box-sizing: border-box;
  }

  .proceso-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 194, 255, 0.55);
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.44), 0 0 24px rgba(0, 194, 255, 0.12);
  }

  /* Insignia circular decorativa superior con 2 círculos superpuestos */
  .proceso-badge-wrap {
    position: absolute;
    top: -38px;
    left: 50%;
    transform: translateX(-50%);
    width: 82px;
    height: 76px;
    pointer-events: none;
  }

  .badge-circulo-azul {
    position: absolute;
    top: 0;
    left: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #0052cc;
    box-shadow: 0 8px 20px rgba(0, 82, 204, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .proceso-card:hover .badge-circulo-azul {
    transform: scale(1.04);
    background: #0060ed;
  }

  .badge-svg-icono {
    margin-top: -3px;
    margin-left: -3px;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }

  .badge-circulo-cyan {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #00c2ff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(0, 194, 255, 0.45);
    border: 2px solid #081d3e;
    transition: transform 0.25s ease;
  }

  .proceso-card:hover .badge-circulo-cyan {
    transform: scale(1.08);
  }

  .badge-num {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.88rem;
    font-weight: 800;
    color: #081d3e;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* Título de la tarjeta centrado */
  .proceso-card-tit {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.38rem;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
    margin: 0 0 16px 0;
    line-height: 1.25;
  }

  /* Párrafo explicativo alineado a la izquierda */
  .proceso-card-desc {
    font-size: 0.94rem;
    line-height: 1.64;
    color: #cbd5e1;
    text-align: left;
    margin: 0;
    width: 100%;
  }

  /* Etiqueta legal editorial sobre fondo oscuro */
  .proceso-nota-legal-wrap {
    margin-top: 14px;
    width: 100%;
    text-align: left;
  }

  .proceso-nota-legal {
    display: inline-block;
    font-family: var(--font-cuerpo, "Poppins", sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.15);
    border: 1px dashed #f87171;
    border-radius: 6px;
    padding: 4px 9px;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }

  /* ==========================================================================
     BOTONES PÍLDORA INFERIORES
     ========================================================================== */
  .como-hacemos-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .boton-pildora-accion {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    color: #004aad;
    background: #ffffff;
    border: 1.5px solid #ffffff;
    border-radius: 999px;
    padding: 10px 24px;
    text-decoration: none;
    box-sizing: border-box;
    transition: background-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }

  .boton-pildora-accion:hover {
    background: #f0f7ff;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 194, 255, 0.35);
  }

  .boton-pildora-accion:focus-visible {
    outline: 2px solid #00c2ff;
    outline-offset: 2px;
  }

  .icono-flecha-azul {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 150ms ease;
  }

  .boton-pildora-accion:hover .icono-flecha-azul {
    transform: translateX(4px);
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 960px) {
    .como-hacemos-grid {
      grid-template-columns: 1fr;
      gap: 52px;
      max-width: 580px;
      margin-inline: auto;
      margin-top: 36px;
    }

    .proceso-card {
      padding: 52px 26px 32px;
    }

    .como-hacemos-acciones {
      justify-content: center;
    }
  }

  @media (max-width: 680px) {
    .como-hacemos-seccion {
      padding: 55px 0 65px;
    }

    .como-hacemos-titulo {
      font-size: 1.9rem;
    }

    .como-hacemos-grid {
      gap: 48px;
    }

    .como-hacemos-acciones {
      flex-direction: column;
      width: 100%;
    }

    .boton-pildora-accion {
      width: 100%;
      justify-content: center;
    }
  }

  /* ==========================================================================
     ACCESIBILIDAD: PREFERS-REDUCED-MOTION
     ========================================================================== */
  @media (prefers-reduced-motion: reduce) {
    .proceso-card,
    .badge-circulo-azul,
    .badge-circulo-cyan,
    .boton-pildora-accion,
    .icono-flecha-azul {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
