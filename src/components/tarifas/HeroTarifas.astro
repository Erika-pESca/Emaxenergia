---
// Componente HeroTarifas para la página "Luz para empresas" (/tarifas)
// Replicación exacta del diseño oficial de marca con Hero (2).png
// Fondo azul oscuro oficial de Gas Natural (#03142e -> #062350 -> #082c62), tipografía Poppins + Literata, píldora cian y tarjeta de cristal interactiva idéntica a Método
import heroTarifasImg from "../../imagenes/tarifas/Hero (2).png";

interface TramoGasto {
  id: string;
  etiqueta: string;
  rango: string;
  msg: string;
}

const tramosGasto: TramoGasto[] = [
  {
    id: "menos-300",
    etiqueta: "MENOS DE 300€",
    rango: "menos de 300 € al mes",
    msg: "Construimos una propuesta técnica con el término de potencia ajustado al milímetro para que no pagues de más.",
  },
  {
    id: "300-1000",
    etiqueta: "300 - 1.000€",
    rango: "entre 3.600 y 12.000 € al año en luz",
    msg: "Analizamos tu curva horaria y optimizamos tus potencias para maximizar tu ahorro mensual.",
  },
  {
    id: "1000-3000",
    etiqueta: "1.000 - 3.000€",
    rango: "entre 12.000 y 36.000 € al año",
    msg: "Auditoría exhaustiva de cuartohorarias, penalizaciones de reactiva y oportunidad en mercado indexado vs fijo.",
  },
  {
    id: "mas-3000",
    etiqueta: "Más de 3.000€",
    rango: "más de 36.000 € al año en energía",
    msg: "Un consultor senior de EMAX revisa tus peajes, maxímetros y coberturas OMIE de forma personalizada.",
  },
];
---

<section class="hero-tarifas-seccion" aria-labelledby="h1-tarifas-luz">
  <!-- Fondo fotográfico con degradado azul oscuro corporativo de Gas Natural -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src={heroTarifasImg.src}
      alt=""
      class="hero-bg-img"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="hero-bg-overlay"></div>
  </div>

  <div class="hero-tarifas-contenedor">
    <!-- Columna Izquierda: Mensaje principal y propuesta de valor -->
    <div class="hero-tarifas-col-izq">
      <p class="hero-tarifas-kicker">
        EMAX ENERGÍA · QUÉ RECIBES <span class="kicker-sep" aria-hidden="true">|</span>
      </p>

      <h1 class="hero-tarifas-titulo" id="h1-tarifas-luz">
        EL ANÁLISIS DE LA<br />
        <span class="titulo-cursiva">factura de luz</span> DE TU<br />
        EMPRESA, POR DENTRO
      </h1>

      <div class="hero-tarifas-subbloque">
        <p class="hero-sub-bold">Está en tu factura.</p>
        <p class="hero-tarifas-desc">
          La leemos y construimos la tarifa que encaja con cómo consume tu empresa. Empieza por lo que pagas hoy.
        </p>
      </div>

      <!-- Píldora de redirección para comunidades o viviendas -->
      <div class="hero-pildora-wrap">
        <a href="/tarifas/comunidades-de-propietarios" class="btn-comunidad-pildora">
          <span>¿Comunidad de vecinos o vivienda? Empieza aquí</span>
          <span class="btn-pildora-circulo" aria-hidden="true">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        </a>
      </div>
    </div>

    <!-- Columna Derecha: Tarjeta de cristal interactiva con los 4 tramos de gasto -->
    <div class="hero-tarifas-col-der">
      <div class="hero-tarifas-card-cristal">
        <h2 class="tarifas-card-titulo">¿Cuánto paga tu empresa de luz al mes?</h2>
        <p class="tarifas-card-subtitulo">
          En total, sumando todos tus suministros. Con una cifra aproximada nos basta.
        </p>

        <!-- Rejilla 2x2 de botones de gasto con círculo cian y chevron -->
        <div class="tarifas-tramos-grid">
          {
            tramosGasto.map((t) => (
              <button
                type="button"
                class="btn-tramo-tarifa"
                data-abrir-funnel
                data-tramo-id={t.id}
                data-tramo-label={`Estudio para empresa: ${t.etiqueta}`}
                data-tramo-rango={t.rango}
                data-tramo-msg={t.msg}
              >
                <span class="btn-txt">{t.etiqueta}</span>
                <span class="btn-circulo" aria-hidden="true">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </span>
              </button>
            ))
          }
        </div>

        <p class="tarifas-card-nota">
          Tú eliges cómo empezamos: con tu factura, con tu CUPS o con dos datos de tu negocio. El análisis no tiene coste.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     HERO TARIFAS - FONDO Hero (2).png CON AZUL OSCURO OFICIAL DE GAS NATURAL
     ========================================================================== */
  .hero-tarifas-seccion {
    position: relative;
    z-index: 20;
    margin-top: -78px;
    min-height: calc(84vh + 78px);
    display: flex;
    align-items: center;
    padding: calc(78px + 48px) 0 72px;
    background-color: #03142e;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  /* Degradado oficial de Gas Natural (#03142e hacia azul profundo y transparente) */
  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #03142e 0%,
      #03142e 26%,
      #041a3c 36%,
      rgba(7, 35, 78, 0.94) 46%,
      rgba(8, 44, 98, 0.6) 58%,
      rgba(10, 56, 126, 0.18) 72%,
      transparent 88%
    );
    pointer-events: none;
  }

  @media (max-width: 1024px) {
    .hero-bg-overlay {
      background: linear-gradient(
        180deg,
        rgba(3, 20, 46, 0.98) 0%,
        rgba(4, 26, 60, 0.92) 55%,
        rgba(7, 35, 78, 0.82) 100%
      );
    }
  }

  .hero-tarifas-contenedor {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 52px);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 60px);
    align-items: center;
  }

  @media (max-width: 1024px) {
    .hero-tarifas-contenedor {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* ==========================================================================
     COLUMNA IZQUIERDA
     ========================================================================== */
  .hero-tarifas-col-izq {
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hero-tarifas-kicker {
    font-family: "Poppins", "Sora", sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .kicker-sep {
    color: #00d4ff;
    font-weight: 400;
    font-size: 1.15em;
  }

  .hero-tarifas-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.7rem + 1.8vw, 3.2rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .titulo-cursiva {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: #00d4ff;
    letter-spacing: -0.01em;
    display: inline;
  }

  .hero-tarifas-subbloque {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero-sub-bold {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.1rem, 1.05rem + 0.3vw, 1.3rem);
    font-weight: 700;
    color: #00d4ff;
    margin: 0;
    line-height: 1.3;
  }

  .hero-tarifas-desc {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.12rem);
    line-height: 1.6;
    color: rgba(240, 248, 255, 0.95);
    font-weight: 400;
    margin: 0;
    max-width: 520px;
  }

  /* Píldora cian */
  .hero-pildora-wrap {
    margin-top: 8px;
  }

  .btn-comunidad-pildora {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #00c2ff;
    color: #002554;
    padding: 10px 18px 10px 22px;
    border-radius: 999px;
    font-family: "Sora", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(0, 194, 255, 0.35);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-comunidad-pildora:hover {
    background: #38b6ff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 194, 255, 0.5);
    color: #001736;
  }

  .btn-pildora-circulo {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #004aad;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .btn-comunidad-pildora:hover .btn-pildora-circulo {
    transform: translateX(2px);
    background: #002244;
  }

  /* ==========================================================================
     COLUMNA DERECHA: TARJETA DE CRISTAL INTERACTIVA
     ========================================================================== */
  .hero-tarifas-col-der {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 1024px) {
    .hero-tarifas-col-der {
      justify-content: flex-start;
    }
  }

  .hero-tarifas-card-cristal {
    width: 100%;
    max-width: 530px;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.62) 0%,
      rgba(235, 244, 255, 0.5) 100%
    );
    border: 1.5px solid rgba(255, 255, 255, 0.75);
    border-radius: 28px;
    padding: clamp(28px, 3.4vw, 38px);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 24px 60px rgba(0, 16, 48, 0.28), inset 0 1px 1px rgba(255, 255, 255, 0.9);
  }

  .tarifas-card-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.24rem, 1.1rem + 0.4vw, 1.48rem);
    font-weight: 700;
    color: #004aad;
    line-height: 1.25;
    margin: 0 0 8px;
    letter-spacing: -0.015em;
  }

  .tarifas-card-subtitulo {
    font-size: 0.94rem;
    color: #0f172a;
    margin: 0 0 22px;
    line-height: 1.5;
    font-weight: 500;
  }

  /* Rejilla 2x2 */
  .tarifas-tramos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 13px;
  }

  @media (max-width: 540px) {
    .tarifas-tramos-grid {
      grid-template-columns: 1fr;
    }
  }

  .btn-tramo-tarifa {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 15px 17px;
    background: #004aad;
    border: 1.5px solid rgba(0, 74, 173, 0.25);
    border-radius: 12px;
    color: #ffffff;
    font-family: "Sora", sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    text-align: left;
    box-shadow: 0 6px 16px rgba(0, 25, 75, 0.25);
    transition: transform 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
  }

  .btn-tramo-tarifa:hover {
    background: #005ce6;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(0, 74, 173, 0.4);
  }

  .btn-txt {
    font-family: "Sora", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .btn-circulo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #00d4ff;
    color: #004aad;
    flex-shrink: 0;
    transition: transform 0.18s ease, background-color 0.18s ease, color 0.18s ease;
  }

  .btn-tramo-tarifa:hover .btn-circulo {
    transform: translateX(3px);
    background: #ffffff;
    color: #004aad;
  }

  .tarifas-card-nota {
    font-family: "Inter", sans-serif;
    font-size: 0.86rem;
    line-height: 1.5;
    color: #0f172a;
    font-weight: 500;
    margin: 22px 0 0;
  }
</style>
