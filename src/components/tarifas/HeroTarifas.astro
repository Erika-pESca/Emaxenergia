---
// Componente HeroTarifas para la página "Luz para empresas" (/tarifas)
// Replicación exacta del diseño oficial de marca con fondo_tarifas.jpg
// Tipografía Poppins + cursiva Literata, píldora cian y tarjeta de cristal interactiva
import fondoTarifas from "../../imagenes/fondo_tarifas.jpg";

interface TramoGasto {
  id: string;
  etiqueta: string;
  rango: string;
  msg: string;
}

const tramosGasto: TramoGasto[] = [
  {
    id: "<300",
    etiqueta: "MENOS DE 300€",
    rango: "menos de 300 € al mes",
    msg: "Construimos una propuesta técnica con el término de potencia ajustado al milímetro para que no pagues de más.",
  },
  {
    id: "300-1000",
    etiqueta: "300 - 1.000€",
    rango: "entre 3.600 y 12.000 € al año en luz",
    msg: "Analizamos tu curva horaria y optimizamos tus potencias para maximizar tu ahorro mensual.",
  },
  {
    id: "1000-3000",
    etiqueta: "1.000 - 3.000€",
    rango: "entre 12.000 y 36.000 € al año",
    msg: "Auditoría exhaustiva de cuartohorarias, penalizaciones de reactiva y oportunidad en mercado indexado vs fijo.",
  },
  {
    id: ">3000",
    etiqueta: "Más de 3.000€",
    rango: "más de 36.000 € al año en energía",
    msg: "Un consultor senior de EMAX revisa tus peajes, maxímetros y coberturas OMIE de forma personalizada.",
  },
];
---

<section class="hero-tarifas-seccion" aria-labelledby="h1-tarifas-luz">
  <!-- Fondo fotográfico fondo_tarifas.jpg oficial -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src={fondoTarifas.src}
      alt=""
      class="hero-bg-img"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <div class="hero-tarifas-contenedor">
    <!-- Columna Izquierda: Mensaje principal y propuesta de valor -->
    <div class="hero-tarifas-col-izq">
      <p class="hero-tarifas-kicker">
        EMAX ENERGÍA · LUZ PARA EMPRESAS <span class="kicker-sep" aria-hidden="true">|</span>
      </p>

      <h1 class="hero-tarifas-titulo" id="h1-tarifas-luz">
        EL ANÁLISIS DE LA<br />
        <span class="titulo-cursiva">factura de luz</span> DE TU<br />
        EMPRESA, POR DENTRO
      </h1>

      <div class="hero-tarifas-subbloque">
        <p class="hero-sub-bold">Está en tu factura.</p>
        <p class="hero-tarifas-desc">
          La leemos y construimos la tarifa que encaja con cómo consume tu empresa. Empieza por lo que pagas hoy.
        </p>
      </div>

      <!-- Píldora de redirección para comunidades o viviendas -->
      <div class="hero-pildora-wrap">
        <a href="/comunidades-de-propietarios" class="btn-comunidad-pildora">
          <span>¿Comunidad de vecinos o vivienda? Empieza aquí</span>
          <span class="btn-pildora-circulo" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3.5 10.5 8 6 12.5"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>

    <!-- Columna Derecha: Tarjeta de cristal interactiva con los 4 tramos de gasto -->
    <div class="hero-tarifas-col-der">
      <div class="hero-tarifas-card-cristal">
        <h2 class="tarifas-card-titulo">¿Cuánto paga tu empresa de luz al mes?</h2>
        <p class="tarifas-card-subtitulo">
          En total, sumando todos tus suministros. Con una cifra aproximada nos basta.
        </p>

        <!-- Rejilla 2x2 de botones de gasto con círculo cian y chevron -->
        <div class="tarifas-tramos-grid">
          {
            tramosGasto.map((t) => (
              <button
                type="button"
                class="btn-tramo-tarifa"
                data-abrir-funnel
                data-tramo-id={t.id}
                data-tramo-label={t.etiqueta}
                data-tramo-rango={t.rango}
                data-tramo-msg={t.msg}
              >
                <span class="btn-txt">{t.etiqueta}</span>
                <span class="btn-circulo" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3.5 10.5 8 6 12.5"></path>
                  </svg>
                </span>
              </button>
            ))
          }
        </div>

        <p class="tarifas-card-nota">
          Tú eliges cómo empezamos: con tu factura, con tu CUPS o con dos datos de tu negocio. El análisis no tiene coste.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     HERO TARIFAS - FONDO fondo_metodo.jpg Y DISEÑO OFICIAL
     ========================================================================== */
  .hero-tarifas-seccion {
    position: relative;
    z-index: 20;
    margin-top: -78px;
    min-height: calc(84vh + 78px);
    display: flex;
    align-items: center;
    padding: calc(78px + 48px) 0 72px;
    background-color: #004aad;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-tarifas-contenedor {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 52px);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 56px);
    align-items: center;
  }

  @media (max-width: 1024px) {
    .hero-tarifas-contenedor {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  /* ==========================================================================
     COLUMNA IZQUIERDA
     ========================================================================== */
  .hero-tarifas-col-izq {
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hero-tarifas-kicker {
    font-family: "Poppins", "Sora", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.78);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .kicker-sep {
    color: #00c2ff;
    font-weight: 300;
    font-size: 1.1em;
    margin-left: 2px;
  }

  .hero-tarifas-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.25rem, 1.75rem + 2.1vw, 3.4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.14;
    margin: 0;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .titulo-cursiva {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: #00c2ff;
    letter-spacing: 0;
    font-size: 1.08em;
  }

  .hero-tarifas-subbloque {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero-sub-bold {
    font-family: "Poppins", "Sora", sans-serif;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.35;
  }

  .hero-tarifas-desc {
    font-family: "Poppins", "Inter", sans-serif;
    font-size: clamp(0.96rem, 0.90rem + 0.3vw, 1.08rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.90);
    font-weight: 400;
    margin: 0;
    max-width: 33rem;
  }

  /* Píldora cian */
  .hero-pildora-wrap {
    margin-top: 6px;
  }

  .btn-comunidad-pildora {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #00c2ff;
    color: #002554;
    padding: 10px 18px 10px 22px;
    border-radius: 999px;
    font-family: "Sora", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(0, 194, 255, 0.35);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-comunidad-pildora:hover {
    background: #38b6ff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 194, 255, 0.5);
    color: #001736;
  }

  .btn-pildora-circulo {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #004aad;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .btn-comunidad-pildora:hover .btn-pildora-circulo {
    transform: translateX(2px);
    background: #002244;
  }

  /* ==========================================================================
     COLUMNA DERECHA: TARJETA DE CRISTAL INTERACTIVA
     ========================================================================== */
  .hero-tarifas-col-der {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 1024px) {
    .hero-tarifas-col-der {
      justify-content: stretch;
    }
  }

  .hero-tarifas-card-cristal {
    width: 100%;
    max-width: 520px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1.5px solid rgba(255, 255, 255, 0.28);
    border-radius: 28px;
    padding: 34px 30px;
    box-shadow:
      0 20px 48px rgba(0, 15, 45, 0.2),
      0 4px 14px rgba(0, 74, 173, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .tarifas-card-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.45rem;
    font-weight: 800;
    color: #00c2ff;
    line-height: 1.25;
    margin: 0 0 10px;
    letter-spacing: -0.015em;
  }

  .tarifas-card-subtitulo {
    font-family: "Inter", sans-serif;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 24px;
  }

  /* Rejilla 2x2 */
  .tarifas-tramos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  @media (max-width: 540px) {
    .tarifas-tramos-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

  .btn-tramo-tarifa {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 13px 14px 13px 18px;
    background: #004aad;
    color: #ffffff;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    font-family: "Sora", sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(0, 74, 173, 0.28);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-tramo-tarifa:hover {
    background: #003c8c;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 74, 173, 0.45);
  }

  .btn-txt {
    letter-spacing: 0.02em;
  }

  .btn-circulo {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #00c2ff;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .btn-tramo-tarifa:hover .btn-circulo {
    transform: translateX(2px);
    background: #ffffff;
    color: #004aad;
  }

  .tarifas-card-nota {
    font-family: "Inter", sans-serif;
    font-size: 0.84rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
    font-weight: 400;
    margin: 22px 0 0;
  }
</style>
