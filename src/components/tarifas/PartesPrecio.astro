<script>
  function setupExclusiveAccordions() {
    const containers = document.querySelectorAll('[data-partes-acordeones]');
    containers.forEach((container) => {
      const items = container.querySelectorAll<HTMLDetailsElement>('details.acordeon-desplegable-item');
      items.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (item.open) {
            items.forEach((otherItem) => {
              if (otherItem !== item && otherItem.open) {
                otherItem.open = false;
              }
            });
          }
        });
      });
    });
  }

  // Inicialización al cargar la página y en transiciones de navegación
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupExclusiveAccordions);
  } else {
    setupExclusiveAccordions();
  }
  document.addEventListener('astro:page-load', setupExclusiveAccordions);
</script>
