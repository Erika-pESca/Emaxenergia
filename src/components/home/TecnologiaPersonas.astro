---
// Componente: "TECNOLOGÍA PARA ANALIZAR. Personas para estar a tu lado."
// Enfoque visual fiel al boceto:
// 1. Cabecera con título Baloo 2, subtítulo azul/cian y párrafos explicativos.
// 2. Escenario central con las 3 tarjetas de atención tecnológica (Teléfono, WhatsApp, Análisis)
//    con efecto glassmorphism, auras brillantes y animación flotante alrededor del eje central.
// 3. Silueta sutil tecnológica preparada para albergar la imagen del teléfono central en cuanto esté disponible.
// 4. Botón inferior izquierdo "Hablar con EMAX" con halo luminoso.
---

<section class="tec-personas" id="soporte">
  <!-- Luces ambientales de fondo estilo tecnológico -->
  <div class="luz-ambiente luz-cyan-der" aria-hidden="true"></div>
  <div class="luz-ambiente luz-azul-izq" aria-hidden="true"></div>

  <!-- Orbes tecnológicos flotantes -->
  <div class="orbe orbe-1" aria-hidden="true"></div>
  <div class="orbe orbe-2" aria-hidden="true"></div>
  <div class="orbe orbe-3" aria-hidden="true"></div>

  <div class="wrap tec-inner">
    <!-- Encabezado superior -->
    <div class="encabezado">
      <h2>TECNOLOGÍA PARA ANALIZAR.</h2>
      <p class="subtitulo">Personas para estar a tu lado.</p>
      <div class="parrafos">
        <p>No queremos que tengas que llamar a un teléfono diferente cada vez que tengas una duda.</p>
        <p>Tu especialista conoce tu empresa, tus suministros y las decisiones que hemos tomado contigo.</p>
      </div>
    </div>

    <!-- Escenario central con las 3 tarjetas flotantes (glassmorphism) -->
    <div class="escenario-central">
      <!-- Foco de luz y halo cian en el centro -->
      <div class="foco-energia" aria-hidden="true"></div>

      <!-- Silueta sutil tecnológica de referencia para el teléfono -->
      <div class="silueta-telefono" aria-hidden="true">
        <div class="telefono-isla"></div>
        <div class="telefono-pantalla"></div>
      </div>

      <!-- Cuadro 1: Teléfono (superior izquierdo) -->
      <article class="cuadro-glass cuadro-telefono">
        <div class="cuadro-aura" aria-hidden="true"></div>
        <div class="cuadro-cuerpo">
          <h3 class="cuadro-titulo">Teléfono</h3>
          <p class="cuadro-desc">Habla con nuestro equipo.</p>
        </div>
      </article>

      <!-- Cuadro 2: WhatsApp (superior derecho) -->
      <article class="cuadro-glass cuadro-whatsapp">
        <div class="cuadro-aura" aria-hidden="true"></div>
        <div class="cuadro-cuerpo">
          <h3 class="cuadro-titulo">WhatsApp</h3>
          <p class="cuadro-desc">Escribe cuando lo necesites.</p>
        </div>
      </article>

      <!-- Cuadro 3: Análisis (inferior izquierdo) -->
      <article class="cuadro-glass cuadro-analisis">
        <div class="cuadro-aura" aria-hidden="true"></div>
        <div class="cuadro-cuerpo">
          <h3 class="cuadro-titulo">Análisis</h3>
          <p class="cuadro-desc">Deja que Maxi revise los datos.</p>
        </div>
      </article>
    </div>

    <!-- Botón CTA inferior izquierdo -->
    <div class="pie-seccion">
      <a href="/#estudio" class="btn-hablar">
        <span>Hablar con EMAX</span>
      </a>
    </div>
  </div>
</section>

<style>
  .tec-personas {
    position: relative;
    overflow: hidden;
    background: #040d1e;
    color: var(--white);
    padding: 104px 0 118px;
  }

  /* Luces ambientales y halos */
  .luz-ambiente {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  /* Gran resplandor cian eléctrico en el lateral derecho */
  .luz-cyan-der {
    width: 620px;
    height: 620px;
    right: -80px;
    top: 18%;
    background: radial-gradient(
      circle,
      rgba(56, 182, 255, 0.45) 0%,
      rgba(0, 102, 255, 0.28) 40%,
      rgba(4, 13, 30, 0.1) 70%,
      transparent 80%
    );
    filter: blur(75px);
    animation: pulsar-foco 10s ease-in-out infinite alternate;
  }

  .luz-azul-izq {
    width: 500px;
    height: 500px;
    left: -140px;
    bottom: 5%;
    background: radial-gradient(
      circle,
      rgba(0, 74, 173, 0.3) 0%,
      rgba(56, 182, 255, 0.16) 45%,
      transparent 75%
    );
    filter: blur(70px);
  }

  /* Orbes tecnológicos */
  .orbe {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .orbe-1 {
    width: 12px;
    height: 12px;
    left: 4%;
    top: 20%;
    background: #38b6ff;
    box-shadow: 0 0 14px #38b6ff;
    animation: flotar-orbe 12s ease-in-out infinite;
  }

  .orbe-2 {
    width: 9px;
    height: 9px;
    right: 18%;
    top: 10%;
    background: #5271ff;
    box-shadow: 0 0 12px #5271ff;
    animation: flotar-orbe 15s ease-in-out infinite reverse;
  }

  .orbe-3 {
    width: 10px;
    height: 10px;
    left: 8%;
    bottom: 12%;
    background: #38b6ff;
    box-shadow: 0 0 12px #38b6ff;
    animation: flotar-orbe 11s ease-in-out infinite 1s;
  }

  .tec-inner {
    position: relative;
    z-index: 1;
  }

  /* Encabezado superior */
  .encabezado {
    max-width: 820px;
  }

  .encabezado h2 {
    font-family: var(--display);
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0;
  }

  .subtitulo {
    margin: 16px 0 0;
    font-family: var(--font);
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    font-weight: 600;
    color: #38b6ff;
    line-height: 1.35;
  }

  .parrafos {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .parrafos p {
    font-family: var(--font);
    font-size: clamp(0.96rem, 1.25vw, 1.05rem);
    font-weight: 400;
    color: rgba(220, 235, 255, 0.78);
    line-height: 1.55;
    max-width: 72ch;
  }

  /* Escenario central con las tarjetas y el teléfono */
  .escenario-central {
    position: relative;
    width: 100%;
    max-width: 580px;
    height: 500px;
    margin: 48px auto 40px;
  }

  /* Foco de luz detrás del teléfono y las tarjetas */
  .foco-energia {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(56, 182, 255, 0.3) 0%,
      rgba(0, 74, 173, 0.2) 50%,
      transparent 75%
    );
    filter: blur(50px);
    pointer-events: none;
    z-index: 0;
  }

  /* Silueta sutil tecnológica de referencia para el teléfono */
  .silueta-telefono {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 215px;
    height: 430px;
    border-radius: 40px;
    background: linear-gradient(
      180deg,
      rgba(11, 27, 54, 0.6) 0%,
      rgba(5, 15, 33, 0.85) 100%
    );
    border: 1.5px solid rgba(120, 205, 255, 0.28);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.65),
      inset 0 0 24px rgba(56, 182, 255, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .telefono-isla {
    position: absolute;
    top: 15px;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 17px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .telefono-pantalla {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.08) 0%,
      transparent 50%
    );
  }

  /* Cuadros glassmorphism */
  .cuadro-glass {
    position: absolute;
    width: 235px;
    z-index: 2;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cuadro-glass:hover {
    transform: translateY(-6px) scale(1.02);
  }

  /* Posiciones exactas del boceto */
  /* Cuadro 1: Teléfono (superior izquierdo, montado sobre el teléfono) */
  .cuadro-telefono {
    top: 50px;
    left: 0;
    animation: flotar-cuadro-1 7s ease-in-out infinite;
  }

  /* Cuadro 2: WhatsApp (superior derecho, montado sobre el teléfono) */
  .cuadro-whatsapp {
    top: 78px;
    right: 0;
    animation: flotar-cuadro-2 8s ease-in-out infinite;
  }

  /* Cuadro 3: Análisis (inferior izquierdo, montado sobre la parte baja del teléfono) */
  .cuadro-analisis {
    bottom: 52px;
    left: 20px;
    animation: flotar-cuadro-3 7.5s ease-in-out infinite;
  }

  /* Aura brillante difusa detrás de cada cuadro */
  .cuadro-aura {
    position: absolute;
    inset: -3px;
    border-radius: 24px;
    background: radial-gradient(
      ellipse at center,
      rgba(56, 182, 255, 0.45) 0%,
      rgba(82, 113, 255, 0.2) 50%,
      transparent 80%
    );
    opacity: 0.4;
    filter: blur(12px);
    z-index: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, filter 0.35s ease;
  }

  .cuadro-glass:hover .cuadro-aura {
    opacity: 0.85;
    filter: blur(18px);
  }

  /* Cuerpo de vidrio translúcido */
  .cuadro-cuerpo {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 22px 24px;
    border-radius: 22px;
    background: linear-gradient(
      135deg,
      rgba(15, 36, 72, 0.72) 0%,
      rgba(7, 20, 44, 0.88) 100%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(120, 205, 255, 0.38);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.45),
      0 0 20px rgba(56, 182, 255, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .cuadro-glass:hover .cuadro-cuerpo {
    border-color: rgba(56, 182, 255, 0.85);
    box-shadow:
      0 22px 48px rgba(0, 0, 0, 0.55),
      0 0 28px rgba(56, 182, 255, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .cuadro-titulo {
    font-family: var(--display);
    font-size: 1.3rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.15;
  }

  .cuadro-desc {
    font-family: var(--font);
    font-size: 0.88rem;
    font-weight: 400;
    color: rgba(220, 235, 255, 0.8);
    margin: 6px 0 0;
    line-height: 1.35;
  }

  /* Botón inferior izquierdo */
  .pie-seccion {
    margin-top: 10px;
    display: flex;
    justify-content: flex-start;
  }

  .btn-hablar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 34px;
    border-radius: 999px;
    background: #004aad;
    color: #ffffff;
    font-family: var(--font);
    font-size: 0.96rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    border: 1px solid rgba(56, 182, 255, 0.65);
    box-shadow:
      0 0 26px rgba(56, 182, 255, 0.45),
      0 4px 14px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-hablar:hover {
    background: #0056c7;
    transform: translateY(-2px);
    box-shadow:
      0 0 36px rgba(56, 182, 255, 0.75),
      0 6px 20px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  /* Animaciones flotantes */
  @keyframes pulsar-foco {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.08);
      opacity: 1;
    }
  }

  @keyframes flotar-cuadro-1 {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes flotar-cuadro-2 {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  @keyframes flotar-cuadro-3 {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  @keyframes flotar-orbe {
    0%, 100% {
      transform: translateY(0);
      opacity: 0.75;
    }
    50% {
      transform: translateY(-20px) scale(1.2);
      opacity: 1;
    }
  }

  /* Responsive */
  @media (max-width: 680px) {
    .tec-personas {
      padding: 72px 0 84px;
    }

    .escenario-central {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin: 36px 0 32px;
    }

    .silueta-telefono {
      display: none;
    }

    .foco-energia {
      display: none;
    }

    .cuadro-glass {
      position: relative;
      top: auto;
      left: auto;
      right: auto;
      bottom: auto;
      width: 100%;
      animation: none;
    }

    .cuadro-cuerpo {
      padding: 18px 20px;
    }

    .btn-hablar {
      width: 100%;
    }
  }
</style>
