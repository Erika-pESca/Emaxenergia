---
// Sección 3: "Maxi hace los números. Una persona de EMAX da la cara."
// Humanización de la marca: combina la potencia analítica de los datos con el asesoramiento
// cercano y directo de un especialista humano con fotografía real y trato profesional.
import { site } from "../../data/site";
import fotoConsultor from "../../imagenes/consultor-emax.jpg";

const funcionesMaxi = [
  { texto: "Lee tu consumo real periodo a periodo y mes a mes.", detalle: "Desglosa curvas de carga cuartohorarias completas." },
  { texto: "Cruza tu potencia contratada con tus maxímetros reales.", detalle: "Detecta kW contratados que nunca llegas a usar." },
  { texto: "Identifica recargos por energía reactiva y excesos.", detalle: "Señala penalizaciones evitables en tu factura." },
];

const funcionesEspecialista = [
  { texto: "Audita y valida los cálculos generados por Maxi.", detalle: "Criterio técnico de auditor colegiado aplicado a tu sector." },
  { texto: "Decide qué conviene cambiar y qué se mantiene.", detalle: "Si tu contrato actual ya es bueno, te lo dice por escrito." },
  { texto: "Te llama por teléfono con tu informe delante.", detalle: "Explicaciones claras, directas y en tu propio idioma." },
];
---

<section class="maxi-humano-seccion" id="equipo">
  <div class="contenedor">
    <div class="seccion-cabecera">
      <div class="kicker-wrap">
        <span class="kicker-punto" aria-hidden="true"></span>
        <span class="kicker-texto">Tecnología de datos + Consultoría humana</span>
      </div>
      <h2 class="seccion-titulo">Maxi hace los números. Una persona de EMAX da la cara.</h2>
      <p class="seccion-subtitulo">
        Maxi no decide por ti. Te da mejores datos para decidir con criterio propio y un especialista asignado a tu lado.
      </p>
    </div>

    <div class="dupla-grid">
      <!-- Tarjeta 1: Maxi (El motor de datos) -->
      <article class="tarjeta-dupla tarjeta-maxi">
        <header class="dupla-header">
          <div class="icono-entidad icono-maxi" aria-hidden="true">
            <span class="letra-m">M</span>
          </div>
          <div>
            <span class="entidad-tipo">Motor algorítmico</span>
            <h3 class="entidad-nombre">Maxi</h3>
          </div>
        </header>

        <p class="entidad-descripcion">
          Algoritmo especializado que procesa miles de lecturas cuartohorarias y cruza peajes oficiales en segundos.
        </p>

        <ul class="funciones-lista" role="list">
          {
            funcionesMaxi.map((f) => (
              <li class="funcion-item">
                <span class="funcion-bullet" aria-hidden="true">✓</span>
                <div>
                  <strong class="funcion-texto">{f.texto}</strong>
                  <span class="funcion-detalle">{f.detalle}</span>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="dupla-footer-nota">
          <span>Precisión analítica matemática sin sesgo comercial</span>
        </div>
      </article>

      <!-- Tarjeta 2: Tu Especialista Humano EMAX (Con fotografía real) -->
      <article class="tarjeta-dupla tarjeta-especialista tarjeta-blanca">
        <header class="dupla-header con-foto">
          <img
            src={fotoConsultor.src}
            alt="Consultor energético de EMAX Energía en oficina"
            class="avatar-foto"
            width={64}
            height={64}
            loading="lazy"
          />
          <div>
            <span class="entidad-tipo destacado-verde">Tu consultor asignado</span>
            <h3 class="entidad-nombre">Tu especialista EMAX</h3>
          </div>
        </header>

        <p class="entidad-descripcion">
          Un consultor energético con nombre y apellidos que conoce tu negocio, da la cara y te acompaña en cada decisión.
        </p>

        <ul class="funciones-lista" role="list">
          {
            funcionesEspecialista.map((f) => (
              <li class="funcion-item">
                <span class="funcion-bullet verde" aria-hidden="true">✓</span>
                <div>
                  <strong class="funcion-texto">{f.texto}</strong>
                  <span class="funcion-detalle">{f.detalle}</span>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="especialista-contacto-box">
          <div class="contacto-directo-info">
            <div class="tel-icono-wrap" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div>
              <strong class="contacto-tel">Teléfono directo: {site.phone}</strong>
              <span class="contacto-sub">Sin centralitas automáticas ni robots</span>
            </div>
          </div>
          <a href="/#estudio" class="boton boton-primario ancho-total">
            Solicitar análisis con especialista
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .maxi-humano-seccion {
    padding: 76px 0 84px;
    background: #ffffff;
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  .seccion-cabecera {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .kicker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radio-pill, 999px);
    background: var(--azul-suave, #edf4fe);
  }

  .kicker-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--azul-900, #004aad);
  }

  .kicker-texto {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--azul-900, #004aad);
  }

  .seccion-titulo {
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.7rem);
    color: var(--tinta, #0f2346);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .seccion-subtitulo {
    font-size: 1.125rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
  }

  .dupla-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: stretch;
  }

  .tarjeta-dupla {
    border-radius: var(--radio-grande, 28px);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
  }

  .tarjeta-maxi {
    background: #f8fbff;
    border: 1.5px solid #d4e2f5;
    box-shadow: 0 8px 24px rgba(15, 35, 70, 0.04);
  }

  .tarjeta-especialista {
    background: #ffffff;
    border: 2px solid var(--azul-900, #004aad);
    box-shadow: 0 16px 44px rgba(0, 74, 173, 0.1);
  }

  .dupla-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .icono-entidad {
    width: 58px;
    height: 58px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  .icono-maxi {
    background: #0f2346;
    color: #38b6ff;
  }

  .letra-m {
    font-family: var(--font-titulos);
    font-weight: 800;
  }

  .avatar-foto {
    width: 58px;
    height: 58px;
    border-radius: 16px;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--azul-900, #004aad);
  }

  .entidad-tipo {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tinta-3, #63738e);
    display: block;
  }

  .entidad-tipo.destacado-verde {
    color: var(--verde-ok, #067647);
  }

  .entidad-nombre {
    font-size: 1.45rem;
    color: var(--tinta, #0f2346);
    font-weight: 800;
  }

  .entidad-descripcion {
    font-size: 0.95rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  .funciones-lista {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 0;
    margin: 0 0 28px;
    list-style: none;
    flex-grow: 1;
  }

  .funcion-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .funcion-bullet {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--azul-suave, #edf4fe);
    color: var(--azul-900, #004aad);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .funcion-bullet.verde {
    background: var(--verde-fondo, #ecfdf3);
    color: var(--verde-ok, #067647);
  }

  .funcion-texto {
    display: block;
    font-size: 0.95rem;
    color: var(--tinta, #0f2346);
    line-height: 1.4;
  }

  .funcion-detalle {
    display: block;
    font-size: 0.84rem;
    color: var(--tinta-3, #63738e);
    margin-top: 2px;
  }

  .dupla-footer-nota {
    padding: 12px 16px;
    background: #ffffff;
    border: 1px solid #dbe6f5;
    border-radius: var(--radio-sm, 8px);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--tinta-2, #3a4b68);
  }

  .especialista-contacto-box {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    background: var(--azul-suave, #edf4fe);
    border-radius: var(--radio-md, 14px);
  }

  .contacto-directo-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tel-icono-wrap {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--azul-900, #004aad);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contacto-tel {
    display: block;
    font-size: 0.95rem;
    color: var(--azul-900, #004aad);
  }

  .contacto-sub {
    display: block;
    font-size: 0.8rem;
    color: var(--tinta-3, #63738e);
  }

  .ancho-total {
    width: 100%;
  }

  @media (max-width: 980px) {
    .dupla-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .tarjeta-dupla {
      padding: 24px 20px;
    }
  }
</style>
