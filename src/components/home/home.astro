---
// Hero Principal EMAX Energía
// Diseñado para captar la atención inmediatamente con:
// 1. Propuesta de valor contundente y selector de factura mensual (Izquierda).
// 2. Tarjeta editorial y humana del Caso Real del Obrador de Panadería (Derecha),
//    con botón que abre la Ventana Emergente Grande (Modal) con la radiografía completa.
import { site } from "../../data/site";
import fotoPanaderia from "../../imagenes/hero-panaderia.jpg";

const tramosGasto = [
  { id: "menos-300", etiqueta: "Menos de 300 €" },
  { id: "300-1000", etiqueta: "300 – 1.000 €" },
  { id: "1000-3000", etiqueta: "1.000 – 3.000 €" },
  { id: "mas-3000", etiqueta: "Más de 3.000 €" },
];
---

<section class="hero-seccion" id="inicio" aria-labelledby="hero-h1">
  <div class="contenedor hero-grid">
    <!-- COLUMNA IZQUIERDA: Propuesta comercial + Selector directo -->
    <div class="hero-propuesta">
      <div class="kicker-tag">
        <span class="kicker-punto" aria-hidden="true"></span>
        <span>Energía para empresas</span>
      </div>

      <h1 id="hero-h1" class="hero-h1">
        La mejor tarifa es la que necesita <span class="h1-azul">tu empresa.</span>
      </h1>

      <p class="hero-subtitulo">
        Y esa no está en ningún catálogo. Analizamos tu suministro y la construimos contigo, a partir de tu consumo real.
      </p>

      <!-- Selector interactivo de gasto mensual -->
      <div class="selector-card" id="estudio">
        <div class="selector-head">
          <span class="selector-badge">Empieza aquí · Sin coste</span>
          <h2 class="selector-pregunta">¿Cuánto paga tu empresa de luz al mes?</h2>
          <p class="selector-ayuda">Aproximado. Si tienes varios suministros, súmalos.</p>
        </div>

        <div class="tramos-lista" role="radiogroup" aria-label="Tramos de gasto mensual de electricidad">
          {
            tramosGasto.map((t) => (
              <button
                type="button"
                class="tramo-item-btn"
                data-tramo-trigger
                data-tramo-nombre={t.etiqueta}
              >
                <span class="tramo-txt">{t.etiqueta}</span>
                <span class="tramo-arrow" aria-hidden="true">→</span>
              </button>
            ))
          }
        </div>

        <!-- Formulario que se despliega al elegir tramo -->
        <form class="selector-form" data-form-tramo hidden>
          <div class="tramo-banner-seleccion">
            <span>Tramo elegido: <strong data-display-tramo>300 – 1.000 €</strong></span>
            <button type="button" class="btn-reset-tramo" data-reset-tramo>Cambiar</button>
          </div>

          <div class="campos-row">
            <input
              type="text"
              name="empresa"
              class="campo-text"
              placeholder="Nombre o empresa"
              required
              aria-label="Tu nombre o empresa"
            />
            <input
              type="tel"
              name="telefono"
              class="campo-text"
              placeholder="Teléfono (ej. 600 000 000)"
              required
              aria-label="Teléfono de contacto"
            />
          </div>

          <button type="submit" class="boton boton-primario ancho-total">
            <span>Pedir informe gratuito</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>

          <div class="exito-box" data-exito-box hidden>
            <span class="exito-icono">✓</span>
            <div>
              <strong>¡Datos recibidos!</strong>
              <p>Un consultor de EMAX te llamará con tu informe delante sin compromiso.</p>
            </div>
          </div>
        </form>

        <p class="selector-footer-nota">
          Después eliges cómo seguimos: una llamada o tu factura.
        </p>

        <div class="badges-confianza">
          <span class="confianza-item">✓ Análisis sin coste</span>
          <span class="confianza-item">✓ Te llama una persona, en tu franja</span>
          <span class="confianza-item">✓ No cambias sin firmarlo</span>
        </div>
      </div>

      <a href="/comunidades-de-propietarios" class="enlace-comunidades">
        ¿Comunidad de vecinos o vivienda? <u>Empieza aquí</u>
      </a>
    </div>

    <!-- COLUMNA DERECHA: Tarjeta Editorial del Caso Real de Panadería -->
    <div class="hero-factura-col">
      <article class="caso-card" aria-label="Caso real auditado: Obrador de panadería">
        <div class="caso-media">
          <img
            src={fotoPanaderia.src}
            alt="Obrador de panadería artesanal auditado por EMAX"
            class="caso-foto"
            width={580}
            height={300}
            loading="eager"
          />
          <div class="caso-tag-flotante">
            <span class="punto-verde" aria-hidden="true"></span>
            <span>Caso real auditado</span>
          </div>
        </div>

        <div class="caso-body">
          <div class="caso-header-info">
            <span class="caso-categoria">Sector Alimentación</span>
            <span class="caso-sep">·</span>
            <span class="caso-peaje">Peaje 3.0TD · Febrero</span>
          </div>

          <h3 class="caso-titulo">Así leemos una factura</h3>
          <p class="caso-subtitulo">Ejemplo · obrador de panadería</p>

          <p class="caso-resumen">
            Horneaban de madrugada con 45 kW contratados a ciegas las 24 horas y tarifa plana: <strong>pagaban de día 23 kW que no usaban jamás</strong>.
          </p>

          <div class="caso-metricas-grid">
            <div class="metrica-caja destacada-verde">
              <span class="metrica-val">-4.850 €</span>
              <span class="metrica-lbl">Ahorro anual conseguido</span>
            </div>
            <div class="metrica-caja">
              <span class="metrica-val">23 kW</span>
              <span class="metrica-lbl">Potencia fantasma recortada</span>
            </div>
          </div>

          <!-- Botón de apertura de la ventana emergente -->
          <div class="caso-acciones">
            <button
              type="button"
              class="btn-abrir-auditoria"
              id="btn-abrir-modal-factura"
              aria-haspopup="dialog"
              aria-controls="modal-auditoria-factura"
            >
              <span>Ver su factura leída, línea a línea</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
            <span class="caso-nota-peajes">Peajes y cargos oficiales de 2026.</span>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- =========================================================================
     VENTANA EMERGENTE GRANDE (MODAL): AUDITORÍA LÍNEA A LÍNEA DE LA FACTURA
     ========================================================================= -->
<div
  class="modal-backdrop"
  id="modal-auditoria-factura"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-factura-titulo"
  hidden
>
  <div class="modal-dialog">
    <!-- Cabecera del Modal -->
    <header class="modal-header">
      <div class="modal-titulares">
        <div class="modal-etiquetas">
          <span class="modal-pill-azul">Auditoría real de factura</span>
          <span class="modal-pill-gris">Peaje 3.0TD · Febrero</span>
        </div>
        <h2 id="modal-factura-titulo" class="modal-titulo">Así leemos una factura</h2>
        <p class="modal-sub">Ejemplo · obrador de panadería</p>
      </div>

      <button
        type="button"
        class="modal-btn-cerrar"
        id="btn-cerrar-modal-factura"
        aria-label="Cerrar ventana emergente"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <!-- Cuerpo del Modal: Cuadrícula ejecutiva con copies exactos -->
    <div class="modal-body">
      <!-- BLOQUE 1: Cuándo consume -->
      <section class="audit-card">
        <div class="audit-card-head">
          <h3 class="audit-card-tit">Cuándo consume</h3>
          <span class="audit-card-vol">10.080 kWh</span>
        </div>

        <div class="audit-barras-lista">
          <div class="audit-fila">
            <span class="audit-sigla">P1</span>
            <div class="audit-track">
              <div class="audit-fill fill-p1" style="width: 26%;"></div>
            </div>
            <span class="audit-cifra">2.600 kWh</span>
          </div>

          <div class="audit-fila">
            <span class="audit-sigla">P2</span>
            <div class="audit-track">
              <div class="audit-fill fill-p2" style="width: 17%;"></div>
            </div>
            <span class="audit-cifra">1.680 kWh</span>
          </div>

          <div class="audit-fila audit-fila-destacada">
            <span class="audit-sigla sigla-p6">P6</span>
            <div class="audit-track">
              <div class="audit-fill fill-p6" style="width: 57%;"></div>
            </div>
            <span class="audit-cifra cifra-p6">5.800 kWh</span>
          </div>
        </div>

        <div class="audit-conclusiones">
          <p class="audit-concl-texto">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="audit-ico-azul" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
            </svg>
            <span>Más de la mitad, de madrugada y en fin de semana: el horno.</span>
          </p>
          <p class="audit-nota-sub">En febrero, el peaje 3.0TD solo tiene P1, P2 y P6.</p>
        </div>
      </section>

      <!-- BLOQUE 2: Potencia -->
      <section class="audit-card">
        <div class="audit-card-head">
          <h3 class="audit-card-tit">Potencia</h3>
          <span class="audit-badge-alerta">Fuga detectada</span>
        </div>

        <div class="audit-barras-lista">
          <div class="audit-fila">
            <span class="audit-lbl-potencia">Contratada</span>
            <div class="audit-track">
              <div class="audit-fill fill-contratada" style="width: 100%;"></div>
            </div>
            <span class="audit-cifra">45 kW</span>
          </div>

          <div class="audit-fila">
            <span class="audit-lbl-potencia">Maxímetro P1 y P2</span>
            <div class="audit-track">
              <div class="audit-fill fill-p2" style="width: 49%;"></div>
            </div>
            <span class="audit-cifra">22 kW</span>
          </div>

          <div class="audit-fila">
            <span class="audit-lbl-potencia">Maxímetro P6</span>
            <div class="audit-track">
              <div class="audit-fill fill-p6" style="width: 89%;"></div>
            </div>
            <span class="audit-cifra">40 kW</span>
          </div>
        </div>

        <div class="audit-caja-alerta">
          <p class="audit-alerta-texto">
            <span class="audit-alerta-ico" aria-hidden="true">!</span>
            <strong>Paga de día 23 kW que no usa.</strong>
          </p>
        </div>
      </section>

      <!-- BLOQUE 3: Energía reactiva 21,34 € en febrero -->
      <section class="audit-card">
        <div class="audit-card-head">
          <h3 class="audit-card-tit">Energía reactiva <span class="cifra-destacada-reactiva">21,34 € en febrero</span></h3>
        </div>

        <div class="audit-reactiva-grid">
          <div class="reactiva-caja-item">
            <span class="r-sigla">P1</span>
            <span class="r-precio">12,96 €</span>
          </div>
          <div class="reactiva-caja-item">
            <span class="r-sigla">P2</span>
            <span class="r-precio">8,38 €</span>
          </div>
        </div>

        <div class="audit-conclusiones">
          <p class="audit-concl-texto-simple">
            Es la de las horas de tienda. En P6 no se factura.
          </p>
        </div>
      </section>

      <!-- BLOQUE 4: Precio 0,1450 €/kWh a cualquier hora -->
      <section class="audit-card">
        <div class="audit-card-head">
          <h3 class="audit-card-tit">Precio <span class="cifra-destacada-tarifa">0,1450 €/kWh a cualquier hora</span></h3>
        </div>

        <div class="audit-precio-comparativa">
          <div class="hora-bloque">
            <span class="hora-badge">5:00</span>
            <span class="hora-coste">0,1450 €</span>
          </div>
          <span class="igual-signo">=</span>
          <div class="hora-bloque">
            <span class="hora-badge">12:00</span>
            <span class="hora-coste">0,1450 €</span>
          </div>
        </div>

        <div class="audit-caja-alerta">
          <p class="audit-alerta-texto">
            <span class="audit-alerta-ico" aria-hidden="true">!</span>
            <strong>Paga igual el kWh de las 5:00 que el de las 12:00.</strong>
          </p>
        </div>
      </section>

      <!-- BLOQUE 5: Qué decidimos -->
      <section class="audit-card audit-card-decision">
        <div class="audit-card-head">
          <h3 class="audit-card-tit">Qué decidimos</h3>
          <span class="audit-badge-verde">Estrategia aplicada</span>
        </div>

        <p class="audit-decision-parrafo">
          Potencia periodo a periodo y precio en seis periodos. El precio fijo se mantiene.
        </p>

        <div class="decision-cta-box">
          <div class="decision-ahorro-wrap">
            <span class="decision-cifra">-4.850 € / año</span>
            <span class="decision-sub">Ahorro conseguido para este negocio sin cambiar su forma de trabajar</span>
          </div>

          <button type="button" class="btn-analizar-desde-modal" id="btn-analizar-desde-modal">
            <span>Analizar mi factura</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </section>
    </div>

    <!-- Pie del Modal -->
    <footer class="modal-footer">
      <span class="modal-legal">Peajes y cargos oficiales de 2026.</span>
      <button type="button" class="btn-modal-cerrar-txt" id="btn-cerrar-modal-factura-secundario">
        Cerrar ventana
      </button>
    </footer>
  </div>
</div>

<script>
  // =========================================================================
  // CONTROL DEL SELECTOR DE TRAMOS (Columna Izquierda)
  // =========================================================================
  const tramoTriggers = document.querySelectorAll("[data-tramo-trigger]");
  const formTramo = document.querySelector("[data-form-tramo]");
  const tramosGrid = document.querySelector(".tramos-lista");
  const displayTramo = document.querySelector("[data-display-tramo]");
  const resetTramoBtn = document.querySelector("[data-reset-tramo]");
  const exitoBox = document.querySelector("[data-exito-box]");

  tramoTriggers.forEach((btn) => {
    btn.addEventListener("click", () => {
      const nombre = btn.getAttribute("data-tramo-nombre") || "";
      if (displayTramo) displayTramo.textContent = nombre;
      if (tramosGrid) (tramosGrid as HTMLElement).style.display = "none";
      if (formTramo) formTramo.removeAttribute("hidden");
    });
  });

  resetTramoBtn?.addEventListener("click", () => {
    if (tramosGrid) (tramosGrid as HTMLElement).style.display = "grid";
    if (formTramo) formTramo.setAttribute("hidden", "true");
  });

  formTramo?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (exitoBox) {
      exitoBox.removeAttribute("hidden");
      const campos = formTramo.querySelector(".campos-row");
      const submitBtn = formTramo.querySelector("button[type='submit']");
      if (campos) (campos as HTMLElement).style.display = "none";
      if (submitBtn) (submitBtn as HTMLElement).style.display = "none";
    }
  });

  // =========================================================================
  // CONTROL DE LA VENTANA EMERGENTE (MODAL AUDITORÍA DE FACTURA)
  // =========================================================================
  const btnAbrirModal = document.getElementById("btn-abrir-modal-factura");
  const modalBackdrop = document.getElementById("modal-auditoria-factura");
  const btnCerrarModal = document.getElementById("btn-cerrar-modal-factura");
  const btnCerrarSecundario = document.getElementById("btn-cerrar-modal-factura-secundario");
  const btnAnalizarDesdeModal = document.getElementById("btn-analizar-desde-modal");

  function abrirModal() {
    if (!modalBackdrop) return;
    modalBackdrop.removeAttribute("hidden");
    document.body.style.overflow = "hidden";
    // Enfocar botón de cierre para accesibilidad
    btnCerrarModal?.focus();
  }

  function cerrarModal() {
    if (!modalBackdrop) return;
    modalBackdrop.setAttribute("hidden", "true");
    document.body.style.overflow = "";
    btnAbrirModal?.focus();
  }

  btnAbrirModal?.addEventListener("click", abrirModal);
  btnCerrarModal?.addEventListener("click", cerrarModal);
  btnCerrarSecundario?.addEventListener("click", cerrarModal);

  // Cerrar al hacer clic en el backdrop exterior
  modalBackdrop?.addEventListener("click", (e) => {
    if (e.target === modalBackdrop) {
      cerrarModal();
    }
  });

  // Cerrar al pulsar la tecla Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modalBackdrop && !modalBackdrop.hasAttribute("hidden")) {
      cerrarModal();
    }
  });

  // Botón dentro del modal "Analizar mi factura"
  btnAnalizarDesdeModal?.addEventListener("click", () => {
    cerrarModal();
    const selectorCard = document.getElementById("estudio");
    if (selectorCard) {
      selectorCard.scrollIntoView({ behavior: "smooth", block: "center" });
      selectorCard.classList.add("selector-resaltado");
      setTimeout(() => {
        selectorCard.classList.remove("selector-resaltado");
      }, 1500);
    }
  });
</script>

<style>
  .hero-seccion {
    padding: 48px 0 68px;
    background: #ffffff;
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  /* ==========================================================================
     COLUMNA IZQUIERDA: PROPUESTA Y SELECTOR
     ========================================================================== */
  .hero-propuesta {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .kicker-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radio-pill, 999px);
    background: var(--azul-suave, #edf4fe);
    width: fit-content;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--azul-900, #004aad);
  }

  .kicker-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--azul-900, #004aad);
  }

  .hero-h1 {
    font-size: clamp(2.2rem, 1.8rem + 2.1vw, 3.4rem);
    color: var(--tinta, #0f2346);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .h1-azul {
    color: var(--azul-900, #004aad);
  }

  .hero-subtitulo {
    font-size: 1.1rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.6;
    max-width: 50ch;
  }

  /* Selector Card */
  .selector-card {
    padding: 26px 24px;
    background: #f8fbff;
    border: 1.5px solid #d4e2f5;
    border-radius: var(--radio-tarjeta, 20px);
    box-shadow: 0 8px 28px rgba(0, 74, 173, 0.06);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: all 0.3s ease;
  }

  .selector-card.selector-resaltado {
    outline: 3px solid var(--azul-900, #004aad);
    box-shadow: 0 0 0 6px rgba(0, 74, 173, 0.2);
  }

  .selector-badge {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--azul-900, #004aad);
  }

  .selector-pregunta {
    font-size: 1.3rem;
    color: var(--tinta, #0f2346);
    font-weight: 800;
    margin: 2px 0 0;
  }

  .selector-ayuda {
    font-size: 0.88rem;
    color: var(--tinta-3, #63738e);
  }

  .tramos-lista {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tramo-item-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 16px;
    background: #ffffff;
    border: 1.5px solid #d4e0f0;
    border-radius: var(--radio-md, 14px);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--tinta, #0f2346);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tramo-item-btn:hover {
    border-color: var(--azul-900, #004aad);
    color: var(--azul-900, #004aad);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 74, 173, 0.12);
  }

  .tramo-arrow {
    font-weight: 700;
    color: var(--azul-900, #004aad);
  }

  .selector-footer-nota {
    font-size: 0.85rem;
    color: var(--tinta-3, #63738e);
  }

  .badges-confianza {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
    border-top: 1px solid var(--linea-fina, #e6edf7);
  }

  .confianza-item {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tinta-2, #3a4b68);
  }

