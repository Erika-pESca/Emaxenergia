---
// Sección: "Si vas a firmar algo, entiéndelo antes."
// Acordeones interactivos de educación energética y transparencia según boceto de Figma

interface GuiaItem {
  id: string;
  pregunta: string;
  tema: string;
  descripcion: string;
  href: string;
}

const guias: GuiaItem[] = [
  {
    id: "factura",
    pregunta: "¿Qué estoy pagando de verdad?",
    tema: "Entender mi factura.",
    descripcion:
      "Aprende a identificar en qué conceptos se divide tu recibo: peajes, cargos, término de energía y potencia para no pagar sobrecostes ocultos ni penalizaciones innecesarias.",
    href: "/guias/factura-luz-empresa",
  },
  {
    id: "potencia",
    pregunta: "¿Pago capacidad que no uso?",
    tema: "Potencia contratada",
    descripcion:
      "Cómo revisar tus maxímetros y cuartohorarias para saber si tu empresa está pagando por una potencia que nunca llega a demandar a la red.",
    href: "/guias/potencia-contratada",
  },
  {
    id: "precio",
    pregunta: "¿Cuál encaja con mi empresa?",
    tema: "Precio fijo o indexado",
    descripcion:
      "Diferencias reales entre la estabilidad presupuestaria de un precio fijo y el ahorro en horas valle de una tarifa indexada al mercado mayorista OMIE.",
    href: "/guias/precio-fijo-o-indexado",
  },
];
---

<section class="guias-acordeon-seccion" id="guias">
  <div class="contenedor">
    <div class="guias-grid-layout">
      <!-- Columna izquierda: Título principal idéntico al boceto -->
      <div class="guias-col-tit">
        <h2 class="guias-tit-principal">
          SI VAS A FIRMAR ALGO,<br />
          <span class="guias-tit-cursiva">entiéndelo antes.</span>
        </h2>
      </div>

      <!-- Columna derecha: Acordeones que se despliegan + botón CTA -->
      <div class="guias-col-acordeones">
        <div class="acordeon-lista" data-acordeon-contenedor>
          {
            guias.map((g, idx) => (
              <div class="acordeon-item" data-acordeon-item>
                <button
                  type="button"
                  class="acordeon-trigger"
                  data-acordeon-trigger
                  aria-expanded="false"
                  aria-controls={`acordeon-panel-${idx}`}
                  id={`acordeon-header-${idx}`}
                >
                  <div class="acordeon-textos">
                    <span class="acordeon-pregunta">{g.pregunta}</span>
                    <span class="acordeon-tema">{g.tema}</span>
                  </div>
                  <span class="acordeon-icono-wrap" aria-hidden="true">
                    <svg
                      class="acordeon-chevron-icon"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </span>
                </button>

                <div
                  class="acordeon-panel"
                  id={`acordeon-panel-${idx}`}
                  role="region"
                  aria-labelledby={`acordeon-header-${idx}`}
                >
                  <div class="acordeon-inner">
                    <p class="acordeon-desc">{g.descripcion}</p>
                    <a href={g.href} class="acordeon-link-guia">
                      <span>Leer guía completa</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Botón CTA tipo píldora -->
        <div class="guias-cta-wrap">
          <a href="/guias" class="btn-todas-guias">
            <span>Todas las guías</span>
            <span class="btn-arrow-circle" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupGuiasAcordeon() {
    const items = document.querySelectorAll<HTMLElement>(".guias-acordeon-seccion [data-acordeon-item]");
    if (!items.length) return;

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>("[data-acordeon-trigger]");
      if (!trigger || trigger.dataset.acordeonReady === "1") return;
      trigger.dataset.acordeonReady = "1";

      trigger.addEventListener("click", () => {
        const isOpen = item.classList.contains("abierto");

        // Cerrar todos los demás acordeones
        items.forEach((otherItem) => {
          otherItem.classList.remove("abierto");
          const otherTrigger = otherItem.querySelector<HTMLButtonElement>("[data-acordeon-trigger]");
          if (otherTrigger) otherTrigger.setAttribute("aria-expanded", "false");
        });

        // Si el actual estaba cerrado, abrirlo
        if (!isOpen) {
          item.classList.add("abierto");
          trigger.setAttribute("aria-expanded", "true");
        }
      });
    });
  }

  setupGuiasAcordeon();
  document.addEventListener("astro:page-load", setupGuiasAcordeon);
</script>

<style>
  /* ==========================================================================
     SECCIÓN GUÍAS / DIVULGACIÓN CON ACORDEONES (FONDO AZUL OSCURO FIGMA)
     ========================================================================== */
  .guias-acordeon-seccion {
    position: relative;
    width: 100%;
    background: #081d3e; /* Mismo azul corporativo elegante del boceto */
    padding: clamp(76px, 9vh, 114px) 0;
    overflow: hidden;
  }

  .contenedor {
    max-width: 1280px;
    width: 100%;
    margin-inline: auto;
    padding-inline: clamp(24px, 5vw, 60px);
  }

  /* Distribución en 2 columnas: Título a la izquierda, Acordeones a la derecha */
  .guias-grid-layout {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  /* Columna izquierda: Título */
  .guias-col-tit {
    max-width: 520px;
  }

  .guias-tit-principal {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.2rem, 3.8vw, 3.4rem);
    color: #ffffff;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .guias-tit-cursiva {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #38b6ff;
    font-size: 1.08em;
  }

  /* Columna derecha: Acordeones */
  .guias-col-acordeones {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .acordeon-lista {
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    width: 100%;
  }

  .acordeon-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    transition: background-color 0.25s ease;
  }

  .acordeon-item:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  /* Encabezado clicable del acordeón */
  .acordeon-trigger {
    width: 100%;
    background: transparent;
    border: none;
    padding: 22px 4px 22px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    cursor: pointer;
    gap: 20px;
    font-family: inherit;
  }

  .acordeon-textos {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .acordeon-pregunta {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.1rem, 1.35vw, 1.3rem);
    font-weight: 700;
    color: #19a9f0;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .acordeon-trigger:hover .acordeon-pregunta {
    color: #38b6ff;
  }

  .acordeon-tema {
    font-family: var(--font-cuerpo, sans-serif);
    font-size: 0.92rem;
    color: #b5c7de;
    line-height: 1.4;
  }

  /* Botón circular con icono + que gira a x al abrirse */
  .acordeon-icono-wrap {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    background: #ffffff;
    color: #081d3e;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.25s ease,
                color 0.25s ease;
  }

  .acordeon-trigger:hover .acordeon-icono-wrap {
    transform: translateY(2px) scale(1.06);
  }

  .acordeon-item.abierto .acordeon-icono-wrap {
    transform: rotate(180deg);
    background: #38b6ff;
    color: #ffffff;
  }

  .acordeon-item.abierto .acordeon-trigger:hover .acordeon-icono-wrap {
    transform: rotate(180deg) translateY(2px) scale(1.06);
  }

  /* Panel desplegable con animación pura CSS moderna (grid 0fr -> 1fr) */
  .acordeon-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.38s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.3s ease;
    opacity: 0;
  }

  .acordeon-item.abierto .acordeon-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .acordeon-inner {
    overflow: hidden;
    padding-bottom: 24px;
    padding-right: 20px;
  }

  .acordeon-desc {
    font-family: var(--font-cuerpo, sans-serif);
    font-size: 0.94rem;
    color: #e2e8f0;
    line-height: 1.6;
    margin: 0 0 14px;
    max-width: 58ch;
  }

  .acordeon-link-guia {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #38b6ff;
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .acordeon-link-guia:hover {
    gap: 12px;
    color: #ffffff;
    text-decoration: underline;
  }

  /* ==========================================================================
     BOTÓN CTA: TODAS LAS GUÍAS
     ========================================================================== */
  .guias-cta-wrap {
    margin-top: 36px;
  }

  .btn-todas-guias {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #004aad;
    color: #ffffff;
    padding: 9px 12px 9px 24px;
    border-radius: 9999px;
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(0, 74, 173, 0.4);
    transition: background-color 0.25s ease,
                transform 0.25s ease,
                box-shadow 0.25s ease;
  }

  .btn-arrow-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #00c2ff;
    color: #081d3e;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease;
  }

  .btn-todas-guias:hover {
    background: #003a88;
    transform: translateY(-2px);
    box-shadow: 0 8px 26px rgba(0, 74, 173, 0.55), 0 0 16px rgba(56, 182, 255, 0.35);
  }

  .btn-todas-guias:hover .btn-arrow-circle {
    transform: translateX(3px);
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 960px) {
    .guias-grid-layout {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .guias-col-tit {
      max-width: 100%;
      text-align: center;
    }

    .guias-cta-wrap {
      display: flex;
      justify-content: center;
    }
  }

  @media (max-width: 600px) {
    .guias-acordeon-seccion {
      padding: 56px 0;
    }

    .acordeon-trigger {
      padding: 18px 0;
    }

    .acordeon-pregunta {
      font-size: 1.05rem;
    }
  }
</style>
