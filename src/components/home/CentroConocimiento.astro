---
// Sección 6: "Si vas a firmar algo, entiéndelo antes."
// Divulgación transparente y educación energética para generar máxima confianza.
interface GuiaItem {
  num: string;
  pregunta: string;
  tema: string;
  descripcion: string;
  href: string;
}

const guias: GuiaItem[] = [
  {
    num: "01",
    pregunta: "¿Qué estoy pagando de verdad?",
    tema: "Entender mi factura",
    descripcion: "Aprende a identificar en qué conceptos se divide tu recibo: peajes, cargos, término de energía y potencia.",
    href: "/guias/factura-luz-empresa",
  },
  {
    num: "02",
    pregunta: "¿Pago capacidad que no uso?",
    tema: "Potencia contratada",
    descripcion: "Cómo revisar tus maxímetros para saber si estás regalando dinero a la distribuidora cada mes.",
    href: "/guias/potencia-contratada",
  },
  {
    num: "03",
    pregunta: "¿Cuál encaja con mi empresa?",
    tema: "Precio fijo o indexado",
    descripcion: "Diferencias reales entre la estabilidad del precio fijo y las oportunidades del mercado mayorista OMIE.",
    href: "/guias/precio-fijo-o-indexado",
  },
  {
    num: "04",
    pregunta: "¿Cómo evitar penalizaciones?",
    tema: "Energía reactiva",
    descripcion: "Descubre si tu maquinaria o motores generan recargos por reactiva y cuándo es rentable una batería.",
    href: "/guias/energia-reactiva",
  },
];
---

<section class="guias-seccion" id="guias">
  <div class="contenedor">
    <div class="seccion-cabecera">
      <div class="kicker-wrap">
        <span class="kicker-punto" aria-hidden="true"></span>
        <span class="kicker-texto">Transparencia y pedagogía</span>
      </div>
      <h2 class="seccion-titulo">Si vas a firmar algo, entiéndelo antes.</h2>
      <p class="seccion-subtitulo">
        Sin tecnicismos oscuros ni letra pequeña. Todo explicado con claridad para que decidas con datos contrastables.
      </p>
    </div>

    <div class="guias-grid">
      {
        guias.map((g) => (
          <a href={g.href} class="guia-tarjeta tarjeta-blanca">
            <div class="guia-top">
              <span class="guia-badge-num">Guía {g.num}</span>
              <span class="guia-pregunta">{g.pregunta}</span>
            </div>
            <h3 class="guia-tema">{g.tema}</h3>
            <p class="guia-desc">{g.descripcion}</p>
            <div class="guia-enlace">
              <span>Leer guía técnica</span>
              <span aria-hidden="true">→</span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="guias-footer">
      <a href="/guias" class="boton boton-secundario">
        Ver todas las guías energéticas
      </a>
    </div>
  </div>
</section>

<style>
  .guias-seccion {
    padding: 76px 0 84px;
    background: #ffffff;
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  .seccion-cabecera {
    text-align: center;
    max-width: 740px;
    margin: 0 auto 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .kicker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radio-pill, 999px);
    background: var(--azul-suave, #edf4fe);
  }

  .kicker-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--azul-900, #004aad);
  }

  .kicker-texto {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--azul-900, #004aad);
  }

  .seccion-titulo {
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.7rem);
    color: var(--tinta, #0f2346);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .seccion-subtitulo {
    font-size: 1.125rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
  }

  .guias-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .guia-tarjeta {
    padding: 28px 24px;
    border-radius: var(--radio-grande, 28px);
    border: 1.5px solid #dce7f5;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .guia-tarjeta:hover {
    transform: translateY(-3px);
    border-color: var(--azul-900, #004aad);
    box-shadow: 0 16px 36px rgba(0, 74, 173, 0.1);
  }

  .guia-top {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .guia-badge-num {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--azul-900, #004aad);
  }

  .guia-pregunta {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--tinta-3, #63738e);
  }

  .guia-tema {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--tinta, #0f2346);
  }

  .guia-desc {
    font-size: 0.88rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.5;
    flex-grow: 1;
  }

  .guia-enlace {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--azul-900, #004aad);
    padding-top: 12px;
    border-top: 1px solid var(--linea-fina, #e6edf7);
  }

  .guia-tarjeta:hover .guia-enlace {
    text-decoration: underline;
  }

  .guias-footer {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .guias-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
