---
// Sección: "¿A qué se dedica TU EMPRESA?"
// Especialización por sectores de negocio con tarjetas visuales según boceto
import imagenPrueba from "../../imagenes/imagen de prueba.png";

interface SectorItem {
  id: string;
  titulo: string;
  desc: string;
}

const sectores: SectorItem[] = [
  {
    id: "hosteleria",
    titulo: "Restaurante u hostelería",
    desc: "Los dos servicios caen en las horas caras, y el frío no para ni el día de cierre.",
  },
  {
    id: "hotel",
    titulo: "Hotel",
    desc: "En febrero sigues pagando la potencia de agosto.",
  },
  {
    id: "supermercado",
    titulo: "Supermercado o alimentación",
    desc: "Tu tienda nunca se apaga: el frío pesa más que los picos.",
  },
  {
    id: "logistica",
    titulo: "Logística y frío",
    desc: "Trabajar de noche no es lo mismo que consumir en P6.",
  },
  {
    id: "industria",
    titulo: "Industria",
    desc: "Un turno más cambia la factura.",
  },
  {
    id: "multisede",
    titulo: "Varios locales o sedes",
    desc: "Un local con la potencia mal ajustada se nota poco. En veinte, se nota en el margen.",
  },
  {
    id: "otro",
    titulo: "Otro negocio",
    desc: "Talleres, clínicas, oficinas, comercios: lo que cuenta es cuándo consumes, no a qué te dedicas.",
  },
];
---

<section class="sectores-seccion" id="sectores">
  <div class="contenedor">
    <!-- Encabezado idéntico al boceto -->
    <header class="sectores-cabecera">
      <div class="sectores-kicker">
        <span>PARA CADA NEGOCIO</span>
        <span class="sectores-kicker-bar" aria-hidden="true">|</span>
      </div>
      <h2 class="sectores-titulo">
        ¿A <span class="sectores-titulo-cursiva">qué se dedica</span> TU<br />
        EMPRESA?
      </h2>
    </header>

    <!-- Grilla de 7 tarjetas: 4 en la fila superior, 3 centradas en la inferior -->
    <div class="sectores-cards-grid">
      {
        sectores.map((s) => (
          <article class="sector-card">
            <!-- Imagen superior con corte diagonal -->
            <div class="sector-card-media">
              <img
                src={imagenPrueba.src}
                alt={s.titulo}
                class="sector-card-img"
                loading="lazy"
              />
            </div>

            <!-- Contenido inferior con botón y textos -->
            <div class="sector-card-body">
              <!-- Curva blanca orgánica idéntica al boceto de Figma -->
              <svg
                class="sector-card-curve"
                viewBox="0 0 300 46"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <path
                  d="M 0,36 C 80,34 160,24 220,13 C 255,7 278,5 292,10 C 297,12 300,15 300,18 L 300,46 L 0,46 Z"
                  fill="#ffffff"
                />
              </svg>

              <div class="sector-card-header">
                <h3 class="sector-card-titulo">{s.titulo}</h3>
                <a
                  href="/#estudio"
                  class="sector-card-btn"
                  aria-label={`Ver solución para ${s.titulo}`}
                  data-abrir-funnel
                  data-tramo-label={s.titulo}
                  data-tramo-rango="Auditoría energética personalizada"
                  data-tramo-msg={`Nos centramos en la operativa de ${s.titulo} para auditar tu potencia, reactiva y periodos.`}
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </a>
              </div>
              <p class="sector-card-desc">{s.desc}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN SECTORES: DISEÑO LIMPIO Y MODERNO SEGÚN BOCETO
     ========================================================================== */
  .sectores-seccion {
    padding: clamp(64px, 8vw, 96px) 0;
    background: #e5e8ee; /* Fondo gris suave idéntico al boceto */
    border-top: 1px solid #d8dee8;
    border-bottom: 1px solid #d8dee8;
  }

  .contenedor {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 40px);
  }

  /* Encabezado */
  .sectores-cabecera {
    text-align: center;
    margin-bottom: clamp(44px, 6vw, 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .sectores-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5d6d84;
  }

  .sectores-kicker-bar {
    color: #38b6ff;
    font-size: 1.15em;
    font-weight: 800;
  }

  .sectores-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    color: #0b1d3a;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .sectores-titulo-cursiva {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #004aad;
    font-size: 1.08em;
  }

  /* ==========================================================================
     GRILLA DE TARJETAS: 4 EN FILA SUPERIOR, 3 EN INFERIOR CENTRADAS
     ========================================================================== */
  .sectores-cards-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(18px, 2vw, 24px);
  }

  .sector-card {
    position: relative;
    width: calc(25% - 18px);
    background: #ffffff;
    border-radius: 28px;
    overflow: hidden;
    border: 1.5px solid rgba(0, 74, 173, 0.08);
    box-shadow: 0 4px 20px rgba(11, 29, 58, 0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s ease;
  }

  /* Resplandor y borde azul a los alrededores al pasar el cursor + agrandamiento dinámico */
  .sector-card:hover {
    transform: translateY(-8px) scale(1.03);
    border-color: #38b6ff;
    box-shadow: 0 20px 42px -6px rgba(0, 74, 173, 0.22),
                0 0 24px rgba(56, 182, 255, 0.42);
    z-index: 5;
  }

  /* Contenedor de imagen */
  .sector-card-media {
    position: relative;
    width: 100%;
    height: 195px;
    background: #cfd6e0;
    overflow: hidden;
  }

  .sector-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }

  .sector-card:hover .sector-card-img {
    transform: scale(1.05);
  }

  /* Cuerpo blanco de la tarjeta con curva superior suave */
  .sector-card-body {
    position: relative;
    background: #ffffff;
    padding: 20px 24px 28px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    z-index: 2;
  }

  .sector-card-curve {
    position: absolute;
    top: -45px;
    left: 0;
    width: 100%;
    height: 46px;
    display: block;
    pointer-events: none;
    z-index: 3;
  }

  .sector-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 12px;
  }

  .sector-card-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #071d49;
    line-height: 1.25;
    margin: 0;
    transition: color 0.25s ease;
  }

  .sector-card:hover .sector-card-titulo {
    color: #004aad;
  }

  /* Botón circular con flecha idéntico al boceto */
  .sector-card-btn {
    width: 48px;
    height: 48px;
    min-width: 48px;
    border-radius: 50%;
    background: #eaf3ff;
    color: #004aad;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  .sector-card:hover .sector-card-btn {
    background: #004aad;
    color: #ffffff;
    transform: scale(1.06);
  }

  .sector-card-desc {
    font-family: var(--font-cuerpo, sans-serif);
    font-size: 0.88rem;
    color: #071d49;
    line-height: 1.5;
    margin: 0;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 1100px) {
    .sector-card {
      width: calc(33.333% - 16px);
    }
  }

  @media (max-width: 820px) {
    .sector-card {
      width: calc(50% - 12px);
    }
  }

  @media (max-width: 560px) {
    .sector-card {
      width: 100%;
      max-width: 360px;
    }

    .sectores-seccion {
      padding: 52px 0;
    }
  }
</style>
