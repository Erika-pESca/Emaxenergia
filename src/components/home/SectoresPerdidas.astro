---
// Sección 5: "¿A qué se dedica tu empresa?"
// Segmentación sectorial profesional: cómo afecta la estructura de consumo a cada tipo de negocio.
interface Sector {
  id: string;
  categoria: string;
  nombre: string;
  dolorClave: string;
  detalle: string;
  enlaceTexto: string;
}

const sectores: Sector[] = [
  {
    id: "restaurantes",
    categoria: "Hostelería",
    nombre: "Restaurantes y cafeterías",
    dolorClave: "Los dos turnos de servicio caen en las horas más caras",
    detalle: "Y la maquinaria de refrigeración no se apaga ni el día de descanso del personal.",
    enlaceTexto: "Ver auditoría para hostelería",
  },
  {
    id: "hoteles",
    categoria: "Alojamientos",
    nombre: "Hoteles y apartamentos",
    dolorClave: "En febrero sigues pagando la potencia de agosto",
    detalle: "La estacionalidad turística no debería encarecer los meses de baja ocupación.",
    enlaceTexto: "Ver auditoría para hoteles",
  },
  {
    id: "supermercados",
    categoria: "Alimentación",
    nombre: "Supermercados y tiendas",
    dolorClave: "Tu tienda nunca se apaga del todo",
    detalle: "Las cámaras de frío y vitrinas pesan más en tu factura que los picos de apertura.",
    enlaceTexto: "Ver auditoría para retail",
  },
  {
    id: "logistica-frio",
    categoria: "Frío industrial",
    nombre: "Logística y congelación",
    dolorClave: "Trabajar de noche no es lo mismo que consumir en P6",
    detalle: "La normativa penaliza fuertemente los desajustes en ciclos continuos de enfriamiento.",
    enlaceTexto: "Ver auditoría de frío",
  },
  {
    id: "industria",
    categoria: "Fabricación",
    nombre: "Industria y talleres",
    dolorClave: "Un turno más cambia completamente la factura",
    detalle: "El arranque de motores pesados y la energía reactiva reducen el margen de cada producto.",
    enlaceTexto: "Ver auditoría para industria",
  },
  {
    id: "varios-locales",
    categoria: "Cadenas",
    nombre: "Empresas con múltiples sedes",
    dolorClave: "Un desajuste en un local se nota poco. En veinte, destruye margen",
    detalle: "Auditar y unificar potencias en toda la red de locales genera ahorros masivos acumulados.",
    enlaceTexto: "Ver auditoría multisede",
  },
];
---

<section class="sectores-seccion" id="sectores">
  <div class="contenedor">
    <div class="seccion-cabecera">
      <div class="kicker-wrap">
        <span class="kicker-punto" aria-hidden="true"></span>
        <span class="kicker-texto">Especialización por sector empresarial</span>
      </div>
      <h2 class="seccion-titulo">¿A qué se dedica tu empresa?</h2>
      <p class="seccion-subtitulo">
        Una nave industrial, un hotel y un restaurante <strong>no se dejan la factura en el mismo sitio.</strong>
      </p>
    </div>

    <div class="sectores-grid">
      {
        sectores.map((s) => (
          <article class="sector-tarjeta tarjeta-blanca">
            <div class="sector-cabecera-tarjeta">
              <span class="sector-categoria-badge">{s.categoria}</span>
              <h3 class="sector-nombre">{s.nombre}</h3>
            </div>

            <p class="sector-dolor">
              "{s.dolorClave}."
            </p>

            <p class="sector-detalle">{s.detalle}</p>

            <div class="sector-accion">
              <a href="/#estudio" class="sector-link">
                <span>{s.enlaceTexto}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }

      <!-- Tarjeta especial: Talleres, clínicas y otros comercios -->
      <article class="sector-tarjeta tarjeta-blanca tarjeta-otro-negocio">
        <div class="sector-cabecera-tarjeta">
          <span class="sector-categoria-badge badge-destacada">Cualquier sector</span>
          <h3 class="sector-nombre">Clínicas, talleres, oficinas y comercios</h3>
        </div>

        <p class="sector-dolor">
          "Lo que cuenta es cuándo consumes, no solo a qué te dedicas."
        </p>

        <p class="sector-detalle">
          Cualquier empresa con suministro 2.0TD, 3.0TD o 6.XTD puede auditar sus excesos y pagar lo que realmente corresponde.
        </p>

        <div class="sector-accion">
          <a href="/#estudio" class="boton boton-primario ancho-total">
            Analizar mi negocio ahora
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .sectores-seccion {
    padding: 76px 0 84px;
    background: #f8fbff;
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  .seccion-cabecera {
    text-align: center;
    max-width: 740px;
    margin: 0 auto 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .kicker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radio-pill, 999px);
    background: #ffffff;
    border: 1px solid #d8e5f5;
  }

  .kicker-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--azul-900, #004aad);
  }

  .kicker-texto {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--azul-900, #004aad);
  }

  .seccion-titulo {
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.7rem);
    color: var(--tinta, #0f2346);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .seccion-subtitulo {
    font-size: 1.125rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
  }

  .sectores-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .sector-tarjeta {
    padding: 30px 26px;
    border-radius: var(--radio-grande, 28px);
    border: 1.5px solid #dce7f5;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
  }

  .sector-cabecera-tarjeta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sector-categoria-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--azul-900, #004aad);
  }

  .sector-categoria-badge.badge-destacada {
    color: var(--verde-ok, #067647);
  }

  .sector-nombre {
    font-size: 1.25rem;
    color: var(--tinta, #0f2346);
    line-height: 1.25;
    font-weight: 800;
  }

  .sector-dolor {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--azul-900, #004aad);
    line-height: 1.4;
  }

  .sector-detalle {
    font-size: 0.9rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
    flex-grow: 1;
  }

  .sector-accion {
    padding-top: 14px;
    border-top: 1px solid var(--linea-fina, #e6edf7);
  }

  .sector-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--azul-900, #004aad);
  }

  .sector-link:hover {
    text-decoration: underline;
  }

  .tarjeta-otro-negocio {
    background: #ffffff;
    border: 2px solid var(--azul-900, #004aad);
    box-shadow: 0 12px 36px rgba(0, 74, 173, 0.08);
  }

  .ancho-total {
    width: 100%;
  }

  @media (max-width: 680px) {
    .sectores-grid {
      grid-template-columns: 1fr;
    }

    .sector-tarjeta {
      padding: 24px 20px;
    }
  }
</style>
