---
// Sección: "¿A qué se dedica TU EMPRESA?"
// Especialización por sectores de negocio con tarjetas visuales según boceto
import imagenPrueba from "../../imagenes/imagen de prueba.png";

interface SectorItem {
  id: string;
  titulo: string;
  desc: string;
}

const sectores: SectorItem[] = [
  {
    id: "hosteleria",
    titulo: "Restaurante u hostelería",
    desc: "Los dos servicios caen en las horas caras, y el frío no para ni el día de cierre.",
  },
  {
    id: "hotel",
    titulo: "Hotel",
    desc: "En febrero sigues pagando la potencia de agosto.",
  },
  {
    id: "supermercado",
    titulo: "Supermercado o alimentación",
    desc: "Tu tienda nunca se apaga: el frío pesa más que los picos.",
  },
  {
    id: "logistica",
    titulo: "Logística y frío",
    desc: "Trabajar de noche no es lo mismo que consumir en P6.",
  },
  {
    id: "industria",
    titulo: "Industria",
    desc: "Un turno más cambia la factura.",
  },
  {
    id: "multisede",
    titulo: "Varios locales o sedes",
    desc: "Un local con la potencia mal ajustada se nota poco. En veinte, se nota en el margen.",
  },
  {
    id: "otro",
    titulo: "Otro negocio",
    desc: "Talleres, clínicas, oficinas, comercios: lo que cuenta es cuándo consumes, no a qué te dedicas.",
  },
];
---

<section class="sectores-seccion" id="sectores">
  <div class="contenedor">
    <!-- Encabezado idéntico al boceto -->
    <header class="sectores-cabecera">
      <div class="sectores-kicker">
        <span>PARA CADA NEGOCIO</span>
        <span class="sectores-kicker-bar" aria-hidden="true">|</span>
      </div>
      <h2 class="sectores-titulo">
        ¿A <span class="sectores-titulo-cursiva">qué se dedica</span> TU<br />
        EMPRESA?
      </h2>
    </header>

    <!-- Grilla de 7 tarjetas: 4 en la fila superior, 3 centradas en la inferior -->
    <div class="sectores-cards-grid">
      {
        sectores.map((s) => (
          <article class="sector-card">
            <!-- Imagen superior con corte diagonal -->
            <div class="sector-card-media">
              <img
                src={imagenPrueba.src}
                alt={s.titulo}
                class="sector-card-img"
                loading="lazy"
              />
            </div>

            <!-- Contenido inferior con botón y textos -->
            <div class="sector-card-body">
              <div class="sector-card-header">
                <h3 class="sector-card-titulo">{s.titulo}</h3>
                <a
                  href="/#estudio"
                  class="sector-card-btn"
                  aria-label={`Ver solución para ${s.titulo}`}
                  data-abrir-funnel
                  data-tramo-label={s.titulo}
                  data-tramo-rango="Auditoría energética personalizada"
                  data-tramo-msg={`Nos centramos en la operativa de ${s.titulo} para auditar tu potencia, reactiva y periodos.`}
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </a>
              </div>
              <p class="sector-card-desc">{s.desc}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN SECTORES: DISEÑO LIMPIO Y MODERNO SEGÚN BOCETO
     ========================================================================== */
  .sectores-seccion {
    padding: clamp(64px, 8vw, 96px) 0;
    background: #e5e8ee; /* Fondo gris suave idéntico al boceto */
    border-top: 1px solid #d8dee8;
    border-bottom: 1px solid #d8dee8;
  }

  .contenedor {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 40px);
  }

  /* Encabezado */
  .sectores-cabecera {
    text-align: center;
    margin-bottom: clamp(44px, 6vw, 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .sectores-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5d6d84;
  }

  .sectores-kicker-bar {
    color: #38b6ff;
    font-size: 1.15em;
    font-weight: 800;
  }

  .sectores-titulo {
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    color: #0b1d3a;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .sectores-titulo-cursiva {
    font-family: var(--font-titulos, "Merriweather", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #004aad;
    font-size: 1.08em;
  }

  /* ==========================================================================
     GRILLA DE TARJETAS: 4 EN FILA SUPERIOR, 3 EN INFERIOR CENTRADAS
     ========================================================================== */
  .sectores-cards-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(18px, 2vw, 24px);
  }

  .sector-card {
    position: relative;
    width: calc(25% - 18px);
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    border: 1.5px solid rgba(0, 74, 173, 0.08);
    box-shadow: 0 4px 18px rgba(11, 29, 58, 0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.35s ease;
  }

  /* Halo y resplandor de luz al pasar el cursor */
  .sector-card:hover {
    transform: translateY(-6px);
    border-color: rgba(56, 182, 255, 0.7);
    box-shadow: 0 16px 36px -4px rgba(0, 74, 173, 0.22),
                0 0 28px 2px rgba(56, 182, 255, 0.40);
  }

  /* Haz de luz (shimmer) que recorre la tarjeta al hacer hover */
  .sector-card::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -70%;
    width: 45%;
    height: 200%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0) 15%,
      rgba(56, 182, 255, 0.35) 45%,
      rgba(255, 255, 255, 0.75) 50%,
      rgba(56, 182, 255, 0.35) 55%,
      rgba(255, 255, 255, 0) 85%,
      transparent 100%
    );
    transform: rotate(25deg);
    opacity: 0;
    pointer-events: none;
    z-index: 10;
  }

  .sector-card:hover::after {
    opacity: 1;
    left: 140%;
    transition: left 0.85s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  /* Contenedor de imagen */
  .sector-card-media {
    position: relative;
    width: 100%;
    height: 165px;
    background: #cfd6e0;
    overflow: hidden;
  }

  .sector-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.45s ease;
  }

  .sector-card:hover .sector-card-img {
    transform: scale(1.06);
  }

  /* Destello luminoso sobre la imagen al hacer hover */
  .sector-card-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 75% 25%,
      rgba(56, 182, 255, 0.45) 0%,
      rgba(0, 74, 173, 0.15) 50%,
      transparent 80%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .sector-card:hover .sector-card-media::after {
    opacity: 1;
  }

  /* Cuerpo blanco de la tarjeta con corte diagonal hacia arriba a la derecha */
  .sector-card-body {
    position: relative;
    background: #ffffff;
    margin-top: -24px;
    clip-path: polygon(0 24px, 100% 0, 100% 100%, 0 100%);
    padding: 24px 20px 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    z-index: 2;
  }

  .sector-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .sector-card-titulo {
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 1.02rem;
    font-weight: 700;
    color: #0b1d3a;
    line-height: 1.3;
    margin: 0;
    transition: color 0.25s ease;
  }

  .sector-card:hover .sector-card-titulo {
    color: #004aad;
  }

  /* Botón circular con flecha y brillo luminoso */
  .sector-card-btn {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    background: #e5f2ff;
    color: #004aad;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .sector-card:hover .sector-card-btn {
    background: #004aad;
    color: #ffffff;
    transform: scale(1.1) translateX(2px);
    box-shadow: 0 0 14px rgba(56, 182, 255, 0.8), 0 0 6px #004aad;
  }

  .sector-card-desc {
    font-family: var(--font-cuerpo, sans-serif);
    font-size: 0.82rem;
    color: #4b5b73;
    line-height: 1.5;
    margin: 0;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 1100px) {
    .sector-card {
      width: calc(33.333% - 16px);
    }
  }

  @media (max-width: 820px) {
    .sector-card {
      width: calc(50% - 12px);
    }
  }

  @media (max-width: 560px) {
    .sector-card {
      width: 100%;
      max-width: 360px;
    }

    .sectores-seccion {
      padding: 52px 0;
    }
  }
</style>
