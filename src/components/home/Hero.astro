---
// Hero Principal EMAX Energía
// Diseñado para captar la atención inmediatamente con:
// 1. Propuesta de valor contundente y selector de factura mensual (Izquierda).
// 2. Radiografía Interactiva del caso real del Obrador de Panadería (Derecha),
//    mostrando exactamente todos los datos del boceto original pero de forma visual,
//    atractiva y estructurada en pestañas para invitar a la lectura.
import { site } from "../../data/site";
import fotoPanaderia from "../../imagenes/hero-panaderia.jpg";

const tramosGasto = [
  { id: "menos-300", etiqueta: "Menos de 300 €" },
  { id: "300-1000", etiqueta: "300 – 1.000 €" },
  { id: "1000-3000", etiqueta: "1.000 – 3.000 €" },
  { id: "mas-3000", etiqueta: "Más de 3.000 €" },
];
---

<section class="hero-seccion" id="inicio" aria-labelledby="hero-h1">
  <div class="contenedor hero-grid">
    <!-- COLUMNA IZQUIERDA: Propuesta comercial + Selector directo -->
    <div class="hero-propuesta">
      <div class="kicker-tag">
        <span class="kicker-punto" aria-hidden="true"></span>
        <span>Energía para empresas</span>
      </div>

      <h1 id="hero-h1" class="hero-h1">
        La mejor tarifa es la que necesita <span class="h1-azul">tu empresa.</span>
      </h1>

      <p class="hero-subtitulo">
        Y esa no está en ningún catálogo. Analizamos tu suministro y la construimos contigo, a partir de tu consumo real.
      </p>

      <!-- Selector interactivo de gasto mensual -->
      <div class="selector-card" id="estudio">
        <div class="selector-head">
          <span class="selector-badge">Empieza aquí · Sin coste</span>
          <h2 class="selector-pregunta">¿Cuánto paga tu empresa de luz al mes?</h2>
          <p class="selector-ayuda">Aproximado. Si tienes varios suministros, súmalos.</p>
        </div>

        <div class="tramos-lista" role="radiogroup" aria-label="Tramos de gasto mensual de electricidad">
          {
            tramosGasto.map((t) => (
              <button
                type="button"
                class="tramo-item-btn"
                data-tramo-trigger
                data-tramo-nombre={t.etiqueta}
              >
                <span class="tramo-txt">{t.etiqueta}</span>
                <span class="tramo-arrow" aria-hidden="true">→</span>
              </button>
            ))
          }
        </div>

        <!-- Formulario que se despliega al elegir tramo -->
        <form class="selector-form" data-form-tramo hidden>
          <div class="tramo-banner-seleccion">
            <span>Tramo elegido: <strong data-display-tramo>300 – 1.000 €</strong></span>
            <button type="button" class="btn-reset-tramo" data-reset-tramo>Cambiar</button>
          </div>

          <div class="campos-row">
            <input
              type="text"
              name="empresa"
              class="campo-text"
              placeholder="Nombre o empresa"
              required
              aria-label="Tu nombre o empresa"
            />
            <input
              type="tel"
              name="telefono"
              class="campo-text"
              placeholder="Teléfono (ej. 600 000 000)"
              required
              aria-label="Teléfono de contacto"
            />
          </div>

          <button type="submit" class="boton boton-primario ancho-total">
            <span>Pedir informe gratuito</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>

          <div class="exito-box" data-exito-box hidden>
            <span class="exito-icono">✓</span>
            <div>
              <strong>¡Datos recibidos!</strong>
              <p>Un consultor de EMAX te llamará con tu informe delante sin compromiso.</p>
            </div>
          </div>
        </form>

        <p class="selector-footer-nota">
          Después eliges cómo seguimos: una llamada explicativa o tu factura.
        </p>

        <div class="badges-confianza">
          <span class="confianza-item">✓ Análisis sin coste</span>
          <span class="confianza-item">✓ Te llama una persona, en tu franja</span>
          <span class="confianza-item">✓ No cambias sin firmarlo</span>
        </div>
      </div>

      <a href="/comunidades-de-propietarios" class="enlace-comunidades">
        ¿Comunidad de vecinos o vivienda? <u>Empieza aquí</u>
      </a>
    </div>

    <!-- COLUMNA DERECHA: Radiografía Interactiva de Factura (Obrador de panadería) -->
    <div class="hero-factura-col">
      <aside class="radiografia-card" aria-label="Auditoría real de ejemplo: Obrador de panadería">
        <!-- Cabecera de la auditoría -->
        <header class="radiografia-header">
          <div class="radiografia-intro">
            <div class="radiografia-subhead">
              <span class="tag-auditoria">Auditoría real</span>
              <span class="tag-peaje">Peaje 3.0TD · Febrero 2026</span>
            </div>
            <h3 class="radiografia-titulo">Así leemos una factura</h3>
            <p class="radiografia-sub">Ejemplo real · Obrador de panadería artesanal</p>
          </div>
          <div class="foto-mini-wrap">
            <img
              src={fotoPanaderia.src}
              alt="Obrador de panadería auditado"
              class="foto-mini"
              width={72}
              height={72}
              loading="eager"
            />
          </div>
        </header>

        <!-- Navegador interactivo de hallazgos (Tabs para explorar) -->
        <nav class="auditoria-tabs" role="tablist" aria-label="Pestañas de la auditoría de factura">
          <button type="button" class="tab-btn activo" data-tab="tab-consumo" role="tab" aria-selected="true">
            <span>1. Horarios</span>
          </button>
          <button type="button" class="tab-btn" data-tab="tab-potencia" role="tab" aria-selected="false">
            <span>2. Potencia</span>
            <span class="tab-alerta-dot" title="Sobrecoste detectado">!</span>
          </button>
          <button type="button" class="tab-btn" data-tab="tab-reactiva" role="tab" aria-selected="false">
            <span>3. Reactiva / Precio</span>
          </button>
          <button type="button" class="tab-btn" data-tab="tab-solucion" role="tab" aria-selected="false">
            <span>4. Solución</span>
          </button>
        </nav>

        <!-- CONTENIDO INTERACTIVO DE LAS PESTAÑAS -->
        <div class="auditoria-paneles">
          <!-- PANEL 1: Cuándo consume -->
          <div class="panel-contenido activo" id="tab-consumo" role="tabpanel">
            <div class="panel-head">
              <h4 class="panel-tit">Cuándo consume</h4>
              <span class="badge-panel">Volumen total: 10.080 kWh</span>
            </div>

            <!-- Gráfico de barras proporcionales -->
            <div class="desglose-periodos">
              <div class="periodo-fila">
                <div class="p-etiqueta">
                  <span class="p-sigla">P1</span>
                  <span class="p-nombre">Punta (Tienda)</span>
                </div>
                <div class="p-barra-track">
                  <div class="p-barra-fill p1-fill" style="width: 26%;"></div>
                </div>
                <span class="p-kwh">2.600 kWh</span>
              </div>

              <div class="periodo-fila">
                <div class="p-etiqueta">
                  <span class="p-sigla">P2</span>
                  <span class="p-nombre">Llano</span>
                </div>
                <div class="p-barra-track">
                  <div class="p-barra-fill p2-fill" style="width: 17%;"></div>
                </div>
                <span class="p-kwh">1.680 kWh</span>
              </div>

              <div class="periodo-fila destacada-p6">
                <div class="p-etiqueta">
                  <span class="p-sigla">P6</span>
                  <span class="p-nombre">Valle / Noche (Hornos)</span>
                </div>
                <div class="p-barra-track">
                  <div class="p-barra-fill p6-fill" style="width: 57%;"></div>
                </div>
                <span class="p-kwh">5.800 kWh</span>
              </div>
            </div>

            <div class="caja-revelacion">
              <p class="revelacion-texto">
                <span class="revelacion-ico" aria-hidden="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                  </svg>
                </span>
                <strong>Más de la mitad se produce de madrugada y en fin de semana: el horno.</strong>
              </p>
              <p class="revelacion-nota">En febrero, el peaje 3.0TD solo tiene P1, P2 y P6.</p>
            </div>
          </div>

          <!-- PANEL 2: Potencia -->
          <div class="panel-contenido" id="tab-potencia" role="tabpanel" hidden>
            <div class="panel-head">
              <h4 class="panel-tit">Potencia contratada vs. uso real</h4>
              <span class="badge-alerta-roja">Fuga de margen</span>
            </div>

            <div class="potencia-comparador">
              <div class="potencia-fila-dato">
                <div class="dato-info">
                  <span class="dato-lbl">Contratada en catálogo</span>
                  <span class="dato-val">45 kW</span>
                </div>
                <div class="dato-barra"><div class="barra-contratada"></div></div>
              </div>

              <div class="potencia-fila-dato">
                <div class="dato-info">
                  <span class="dato-lbl">Maxímetro P1 y P2 (Horas diurnas)</span>
                  <span class="dato-val">22 kW</span>
                </div>
                <div class="dato-barra"><div class="barra-maximetro-dia" style="width: 48%;"></div></div>
              </div>

              <div class="potencia-fila-dato">
                <div class="dato-info">
                  <span class="dato-lbl">Maxímetro P6 (Madrugada con hornos)</span>
                  <span class="dato-val">40 kW</span>
                </div>
                <div class="dato-barra"><div class="barra-maximetro-noche" style="width: 88%;"></div></div>
              </div>
            </div>

            <div class="caja-alerta-fuga">
              <div class="fuga-badge">Sobrecoste evitable</div>
              <p class="fuga-texto">
                <span class="fuga-ico" aria-hidden="true">!</span>
                <strong>Paga de día 23 kW que no usa jamás.</strong>
              </p>
              <p class="fuga-sub">
                Tiene contratada la potencia del horno las 24 horas, tirando dinero en horas de tienda.
              </p>
            </div>
          </div>

          <!-- PANEL 3: Reactiva y Precio plano -->
          <div class="panel-contenido" id="tab-reactiva" role="tabpanel" hidden>
            <div class="panel-head">
              <h4 class="panel-tit">Reactiva y precio del kWh</h4>
            </div>

            <div class="reactiva-bloque">
              <div class="reactiva-cabecera">
                <span class="reactiva-tit">Energía reactiva facturada:</span>
                <span class="reactiva-total">21,34 € en febrero</span>
              </div>
              <div class="reactiva-desglose">
                <span class="r-periodo">P1: 12,96 €</span>
                <span class="r-sep">·</span>
                <span class="r-periodo">P2: 8,38 €</span>
                <span class="r-nota">(En P6 no se factura)</span>
              </div>
              <p class="reactiva-explicacion">
                Es la reactiva de los motores en horas de tienda.
              </p>
            </div>

            <div class="precio-plano-bloque">
              <div class="precio-head">
                <span class="precio-lbl">Precio actual del contrato</span>
                <span class="precio-cifra">0,1450 €/kWh</span>
                <span class="precio-tag">A cualquier hora</span>
              </div>

              <div class="reloj-comparativa">
                <div class="reloj-item">
                  <span class="hora-ico">05:00 AM</span>
                  <span class="hora-precio">0,1450 €</span>
                </div>
                <span class="igual-signo">=</span>
                <div class="reloj-item">
                  <span class="hora-ico">12:00 PM</span>
                  <span class="hora-precio">0,1450 €</span>
                </div>
              </div>

              <p class="precio-conclusion">
                <span class="fuga-ico" aria-hidden="true">!</span>
                <strong>Paga igual el kWh de las 5:00 de la madrugada que el de las 12:00 del mediodía.</strong>
              </p>
            </div>
          </div>

          <!-- PANEL 4: Qué decidimos juntos -->
          <div class="panel-contenido" id="tab-solucion" role="tabpanel" hidden>
            <div class="panel-head">
              <h4 class="panel-tit">Qué decidimos juntos</h4>
              <span class="badge-verde-solucion">Estrategia aplicada</span>
            </div>

            <div class="solucion-tarjeta">
              <div class="solucion-check-item">
                <span class="check-circulo">✓</span>
                <div>
                  <strong>Potencia ajustada periodo a periodo:</strong>
                  <p>22 kW de día y 40 kW de noche. Cero kW fantasma pagados.</p>
                </div>
              </div>

              <div class="solucion-check-item">
                <span class="check-circulo">✓</span>
                <div>
                  <strong>Precio en seis periodos diferenciados:</strong>
                  <p>Aprovechando que más del 50% del consumo va al periodo más barato.</p>
                </div>
              </div>

              <div class="solucion-check-item">
                <span class="check-circulo">✓</span>
                <div>
                  <strong>El precio fijo se mantiene:</strong>
                  <p>Sin incertidumbre ni volatilidad de mercado para el negocio.</p>
                </div>
              </div>
            </div>

            <div class="solucion-resultado-fila">
              <span class="ahorro-anual-cifra">-4.850 € / año</span>
              <span class="ahorro-anual-lbl">Ahorro conseguido para el obrador</span>
            </div>
          </div>
        </div>

        <!-- Pie de la auditoría con llamada al detalle -->
        <footer class="radiografia-footer">
          <a href="/#estudio" class="btn-ver-factura">
            <span>Ver su factura leída, línea a línea</span>
            <span aria-hidden="true">→</span>
          </a>
          <span class="peajes-nota">Peajes y cargos oficiales de 2026.</span>
        </footer>
      </aside>
    </div>
  </div>
</section>

<script>
  // Control de las pestañas interactivas de la auditoría
  const tabButtons = document.querySelectorAll(".auditoria-tabs .tab-btn");
  const tabPaneles = document.querySelectorAll(".auditoria-paneles .panel-contenido");

  tabButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-tab");

      // Actualizar estado botones
      tabButtons.forEach((b) => {
        b.classList.remove("activo");
        b.setAttribute("aria-selected", "false");
      });
      btn.classList.add("activo");
      btn.setAttribute("aria-selected", "true");

      // Actualizar paneles visibles
      tabPaneles.forEach((panel) => {
        if (panel.id === targetId) {
          panel.classList.add("activo");
          panel.removeAttribute("hidden");
        } else {
          panel.classList.remove("activo");
          panel.setAttribute("hidden", "true");
        }
      });
    });
  });

  // Control del selector de tramos en la columna izquierda
  const tramoTriggers = document.querySelectorAll("[data-tramo-trigger]");
  const formTramo = document.querySelector("[data-form-tramo]");
  const tramosGrid = document.querySelector(".tramos-lista");
  const displayTramo = document.querySelector("[data-display-tramo]");
  const resetTramoBtn = document.querySelector("[data-reset-tramo]");
  const exitoBox = document.querySelector("[data-exito-box]");

  tramoTriggers.forEach((btn) => {
    btn.addEventListener("click", () => {
      const nombre = btn.getAttribute("data-tramo-nombre") || "";
      if (displayTramo) displayTramo.textContent = nombre;
      if (tramosGrid) (tramosGrid as HTMLElement).style.display = "none";
      if (formTramo) formTramo.removeAttribute("hidden");
    });
  });

  resetTramoBtn?.addEventListener("click", () => {
    if (tramosGrid) (tramosGrid as HTMLElement).style.display = "grid";
    if (formTramo) formTramo.setAttribute("hidden", "true");
  });

  formTramo?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (exitoBox) {
      exitoBox.removeAttribute("hidden");
      const campos = formTramo.querySelector(".campos-row");
      const submitBtn = formTramo.querySelector("button[type='submit']");
      if (campos) (campos as HTMLElement).style.display = "none";
      if (submitBtn) (submitBtn as HTMLElement).style.display = "none";
    }
  });
</script>

<style>
  .hero-seccion {
    padding: 48px 0 68px;
    background: #ffffff;
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 48px;
    align-items: start;
  }

  /* Columna Izquierda */
  .hero-propuesta {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .kicker-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radio-pill, 999px);
    background: var(--azul-suave, #edf4fe);
    width: fit-content;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--azul-900, #004aad);
  }

  .kicker-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--azul-900, #004aad);
  }

  .hero-h1 {
    font-size: clamp(2.2rem, 1.8rem + 2.1vw, 3.4rem);
    color: var(--tinta, #0f2346);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .h1-azul {
    color: var(--azul-900, #004aad);
  }

  .hero-subtitulo {
    font-size: 1.1rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.6;
    max-width: 50ch;
  }

  /* Selector Card */
  .selector-card {
    padding: 26px 24px;
    background: #f8fbff;
    border: 1.5px solid #d4e2f5;
    border-radius: var(--radio-tarjeta, 20px);
    box-shadow: 0 8px 28px rgba(0, 74, 173, 0.06);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .selector-badge {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--azul-900, #004aad);
  }

  .selector-pregunta {
    font-size: 1.3rem;
    color: var(--tinta, #0f2346);
    font-weight: 800;
    margin: 2px 0 0;
  }

  .selector-ayuda {
    font-size: 0.88rem;
    color: var(--tinta-3, #63738e);
  }

  .tramos-lista {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tramo-item-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 16px;
    background: #ffffff;
    border: 1.5px solid #d4e0f0;
    border-radius: var(--radio-md, 14px);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--tinta, #0f2346);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tramo-item-btn:hover {
    border-color: var(--azul-900, #004aad);
    color: var(--azul-900, #004aad);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 74, 173, 0.12);
  }

  .tramo-arrow {
    font-weight: 700;
    color: var(--azul-900, #004aad);
  }

  .selector-footer-nota {
    font-size: 0.85rem;
    color: var(--tinta-3, #63738e);
  }

  .badges-confianza {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
    border-top: 1px solid var(--linea-fina, #e6edf7);
  }

  .confianza-item {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tinta-2, #3a4b68);
  }

  .enlace-comunidades {
    font-size: 0.88rem;
    color: var(--tinta-3, #63738e);
    padding-left: 4px;
  }

  .enlace-comunidades u {
    color: var(--azul-900, #004aad);
    font-weight: 600;
  }

  /* Form desplegable */
  .selector-form {
    padding: 16px;
    background: #ffffff;
    border: 1px solid #d8e4f3;
    border-radius: var(--radio-md, 14px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tramo-banner-seleccion {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--tinta, #0f2346);
  }

  .btn-reset-tramo {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--azul-900, #004aad);
    text-decoration: underline;
  }

  .campos-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .campo-text {
    height: 46px;
    padding: 0 14px;
    border: 1.5px solid #d0deef;
    border-radius: var(--radio-sm, 8px);
    font-family: inherit;
    font-size: 0.92rem;
    outline: none;
  }

  .campo-text:focus {
    border-color: var(--azul-900, #004aad);
  }

  .exito-box {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: var(--verde-fondo, #ecfdf3);
    border: 1px solid var(--verde-borde, #abefc6);
    border-radius: var(--radio-sm, 8px);
    font-size: 0.88rem;
    color: var(--verde-ok, #067647);
  }

  .exito-icono {
    font-size: 1.2rem;
    font-weight: 800;
  }

  /* ==========================================================================
     COLUMNA DERECHA: RADIOGRAFÍA INTERACTIVA DE FACTURA
     ========================================================================== */
  .hero-factura-col {
    position: relative;
  }

  .radiografia-card {
    background: #ffffff;
    border: 1.5px solid #d6e2f2;
    border-radius: var(--radio-grande, 28px);
    box-shadow: 0 16px 44px rgba(15, 35, 70, 0.09);
