<script>
  // =========================================================================
  // INTERACCIÓN DE TARJETAS TÁCTILES / MÓVIL
  // =========================================================================
  const cardsFactura = document.querySelectorAll<HTMLElement>(".fac-card");
  cardsFactura.forEach((card) => {
    card.addEventListener("click", () => {
      card.classList.toggle("is-active");
    });
    card.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        card.classList.toggle("is-active");
      }
    });
  });

  // =========================================================================
  // CONTROL DEL MODAL FUNNEL
  // =========================================================================
  const modalFunnel = document.getElementById("modal-funnel");
  const btnCerrarFunnel = document.getElementById("btn-cerrar-funnel");
  const btnFinalizarFunnel = document.getElementById("btn-finalizar-funnel");

  const pasoVistas = {
    1: document.getElementById("fn-paso-1"),
    2: document.getElementById("fn-paso-2"),
    3: document.getElementById("fn-paso-3"),
    4: document.getElementById("fn-paso-4"),
  };

  const etapaIndicadores = document.querySelectorAll("[data-etapa-indicador]");

  function irAlPaso(numPaso: number) {
    Object.keys(pasoVistas).forEach((key) => {
      const vista = pasoVistas[Number(key) as 1 | 2 | 3 | 4];
      if (vista) {
        if (Number(key) === numPaso) {
          vista.removeAttribute("hidden");
        } else {
          vista.setAttribute("hidden", "true");
        }
      }
    });

    etapaIndicadores.forEach((ind) => {
      const idx = Number(ind.getAttribute("data-etapa-indicador"));
      if (idx === numPaso) {
        ind.classList.add("activa");
      } else {
        ind.classList.remove("activa");
      }
    });
  }

  function abrirModalFunnel(btn?: HTMLButtonElement | null) {
    if (!modalFunnel) return;
    irAlPaso(1);
    modalFunnel.removeAttribute("hidden");
    document.body.style.overflow = "hidden";
  }

  function cerrarModalFunnel() {
    if (!modalFunnel) return;
    modalFunnel.setAttribute("hidden", "true");
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest<HTMLButtonElement>("[data-abrir-funnel]");
    if (btn) {
      abrirModalFunnel(btn);
    }
  });

  btnCerrarFunnel?.addEventListener("click", cerrarModalFunnel);
  btnFinalizarFunnel?.addEventListener("click", cerrarModalFunnel);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modalFunnel && !modalFunnel.hasAttribute("hidden")) {
      cerrarModalFunnel();
    }
  });

  modalFunnel?.addEventListener("click", (e) => {
    if (e.target === modalFunnel) {
      cerrarModalFunnel();
    }
  });

  // Paso 1 -> Suministros
  document.querySelectorAll("[data-elegir-suministro]").forEach((b) => {
    b.addEventListener("click", () => irAlPaso(2));
  });

  // Paso 2 -> Canales
  document.querySelectorAll("[data-elegir-canal]").forEach((b) => {
    b.addEventListener("click", () => irAlPaso(3));
  });

  // Botones de vuelta
  document.querySelectorAll("[data-ir-paso]").forEach((b) => {
    b.addEventListener("click", () => {
      const target = Number(b.getAttribute("data-ir-paso")) || 1;
      irAlPaso(target);
    });
  });

  // Paso 3 -> Envío
  document.getElementById("fn-form-datos")?.addEventListener("submit", (e) => {
    e.preventDefault();
    irAlPaso(4);
  });

  // Control manual para el botón 'Pausar' / 'Reanudar' del carrusel de logos
  const btnPausarCarrusel = document.getElementById("btn-pausar-carrusel");
  const trackCarrusel = document.getElementById("carrusel-logos-track");
  if (btnPausarCarrusel && trackCarrusel) {
    btnPausarCarrusel.addEventListener("click", () => {
      const isPaused = trackCarrusel.classList.toggle("is-paused");
      btnPausarCarrusel.textContent = isPaused ? "Reanudar" : "Pausar";
      btnPausarCarrusel.setAttribute("aria-pressed", isPaused ? "true" : "false");
    });
  }
</script>

