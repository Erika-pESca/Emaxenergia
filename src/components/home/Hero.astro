---
// Primer bloque del inicio. El fondo de puntos se mueve para llamar la atención.
import Estudio from "./Estudio.astro";
---

<section class="hero">
  <canvas class="particulas" data-particulas aria-hidden="true"></canvas>
  <div class="luz luz-a" aria-hidden="true"></div>
  <div class="luz luz-b" aria-hidden="true"></div>
  <div class="luz luz-c" aria-hidden="true"></div>

  <div class="wrap hero-grid">
    <div class="mensaje">
      <p class="etiqueta">Energía para empresas</p>
      <h1>Cada euro que pagas de más en luz sale de tu margen.</h1>
      <p class="texto">
        No necesitas otra tarifa de catálogo. Necesitas saber si lo que estás pagando tiene sentido
        para tu empresa.
      </p>
      <p class="aprox">Eso son aproximadamente:</p>
      <p class="cifra">6.000 €/año</p>
      <p class="nota">Cada euro que pagas de más sale directamente de tu margen.</p>
    </div>
    <Estudio />
  </div>

  <div class="ruta-banda">
    <div class="wrap">
      <ul class="ruta">
        <li>
          <span class="ruta-punto" aria-hidden="true"></span>
          <span>Primero analizamos</span>
        </li>
        <li>
          <span class="ruta-punto" aria-hidden="true"></span>
          <span>Después diseñamos</span>
        </li>
        <li>
          <span class="ruta-punto" aria-hidden="true"></span>
          <span>Un experto valida</span>
        </li>
        <li>
          <span class="ruta-punto" aria-hidden="true"></span>
          <span>Tú decides</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  const canvas = document.querySelector("[data-particulas]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (canvas instanceof HTMLCanvasElement && !reduce) {
    const ctx = canvas.getContext("2d");
    const hero = canvas.parentElement;
    if (ctx && hero) {
      const dots = [];
      let width = 0;
      let height = 0;
      let frame = 0;

      const resize = () => {
        const rect = hero.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = rect.width;
        height = rect.height;
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = width < 700 ? 40 : 78;
        dots.length = 0;
        for (let i = 0; i < count; i += 1) {
          dots.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.4,
            vy: (Math.random() - 0.5) * 0.4,
            r: Math.random() < 0.22 ? 3.8 : Math.random() * 1.8 + 1.4,
          });
        }
      };

      const draw = () => {
        ctx.clearRect(0, 0, width, height);
        for (const dot of dots) {
          dot.x += dot.vx;
          dot.y += dot.vy;
          if (dot.x < 0 || dot.x > width) dot.vx *= -1;
          if (dot.y < 0 || dot.y > height) dot.vy *= -1;
        }
        const reach = width < 700 ? 100 : 150;
        ctx.lineWidth = 1.25;
        ctx.shadowColor = "rgba(56, 182, 255, 0.85)";
        for (let i = 0; i < dots.length; i += 1) {
          for (let j = i + 1; j < dots.length; j += 1) {
            const a = dots[i];
            const b = dots[j];
            const dist = Math.hypot(a.x - b.x, a.y - b.y);
            if (dist < reach) {
              ctx.shadowBlur = 0;
              ctx.strokeStyle = `rgba(120, 214, 255, ${(1 - dist / reach) * 0.7})`;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }
        }
        for (const dot of dots) {
          ctx.shadowBlur = 14;
          ctx.fillStyle = "rgba(220, 248, 255, 0.95)";
          ctx.beginPath();
          ctx.arc(dot.x, dot.y, dot.r, 0, Math.PI * 2);
          ctx.fill();
        }
        frame = requestAnimationFrame(draw);
      };

      resize();
      draw();
      const observer = new ResizeObserver(resize);
      observer.observe(hero);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) cancelAnimationFrame(frame);
        else draw();
      });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 64px 0 0;
    color: var(--white);
    background: #071a33;
  }

  .particulas,
  .luz {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .particulas {
    z-index: 1;
  }

  .luz {
    z-index: 0;
    border-radius: 50%;
    filter: blur(30px);
  }

  .luz-a {
    width: 52%;
    height: 90%;
    left: -6%;
    top: -8%;
    background: radial-gradient(circle, rgba(56, 182, 255, 0.5), rgba(82, 113, 255, 0.16) 42%, transparent 70%);
    animation: flotar 16s ease-in-out infinite;
  }

  .luz-b {
    width: 28%;
    height: 46%;
    left: 18%;
    top: 28%;
    background: radial-gradient(circle, rgba(82, 113, 255, 0.35), transparent 70%);
    animation: flotar 22s ease-in-out infinite reverse;
  }

  .luz-c {
    width: 38%;
    height: 60%;
    right: -8%;
    top: 20%;
    background: radial-gradient(circle, rgba(56, 182, 255, 0.32), rgba(82, 113, 255, 0.14) 45%, transparent 70%);
    animation: flotar 18s ease-in-out infinite 3s;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 36px;
    align-items: center;
  }

  .etiqueta {
    display: inline-flex;
    margin-bottom: 22px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(214, 224, 245, 0.88);
    color: #1a2744;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    font-size: clamp(2.5rem, 4.4vw, 4.3rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .texto {
    max-width: 36ch;
    margin-top: 22px;
    font-size: 1.05rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.88);
  }

  .aprox {
    margin-top: 28px;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .cifra {
    margin-top: 4px;
    font-family: var(--display);
    font-size: clamp(2.8rem, 5vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .nota {
    margin-top: 10px;
    color: var(--cyan);
    font-size: 0.98rem;
  }

  .ruta-banda {
    position: relative;
    z-index: 2;
    margin-top: 64px;
    padding: 22px 0 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(3, 11, 26, 0.65);
    backdrop-filter: blur(8px);
  }

  .ruta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .ruta li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .ruta-punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
    flex-shrink: 0;
  }

  @keyframes flotar {
    50% {
      transform: translate(36px, 24px) scale(1.08);
    }
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: 14ch;
    }

    .ruta {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  }

  @media (max-width: 540px) {
    .ruta {
      grid-template-columns: 1fr;
      gap: 12px;
      text-align: left;
    }

    .ruta li {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .luz-a,
    .luz-b,
    .luz-c {
      animation: none;
    }

    .particulas {
      display: none;
    }
  }
</style>
