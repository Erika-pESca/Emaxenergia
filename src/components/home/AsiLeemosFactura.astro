---
// AsiLeemosFactura.astro
// Bloque 2: Auditoría real interactiva ("Así leemos una factura · Ejemplo: obrador de panadería")
// Organizado fielmente según el flujo editorial de Inicio Emax Energía.html:
// - Izquierda: Factura fija (sticky) con 4 zonas de análisis (Consumo, Potencia, Reactiva, Precio)
// - Derecha: Scrollytelling con 4 hallazgos en tipografía Sora + Inter, cifras destacadas y acordiones técnicos
// - Cierre: Veredicto técnico con decisiones, tarjeta de ahorro (-4.850 €/año) y CTA al funnel modal
---

<section class="como-leemos-seccion" id="como-leemos" aria-labelledby="leemos-titulo">
  <div class="contenedor">
    <!-- Encabezado editorial -->
    <header class="leemos-intro">
      <div class="leemos-badge">
        <span class="badge-punto" aria-hidden="true"></span>
        <span>Ejemplo real · Obrador de panadería</span>
      </div>
      <h2 id="leemos-titulo" class="leemos-h2">Así leemos una factura</h2>
      <p class="leemos-bajada">
        Cuatro cosas que miramos en cada factura, siempre en el mismo orden. Esta es la de febrero de una panadería que enciende el horno de madrugada.
      </p>
    </header>

    <!-- Escenario en dos columnas: Factura fija a la izquierda + Hallazgos a la derecha -->
    <div class="leemos-escenario">
      <!-- COLUMNA IZQUIERDA: Factura técnica fija (Sticky) -->
      <aside class="factura-col">
        <div class="factura-tarjeta" id="factura-sheet" aria-label="Factura técnica auditada de febrero">
          <div class="factura-cabecera">
            <span class="factura-cab-tit">Factura · Febrero</span>
            <span class="factura-cab-peaje">Peaje 3.0TD</span>
          </div>

          <!-- Zona 1: Cuándo consume -->
          <section class="factura-zona z-consumo on" data-paso="0" data-note="El horno">
            <h4 class="zona-titulo">
              <span>Cuándo consume</span>
              <span class="zona-sub">10.080 kWh total</span>
            </h4>
            <div class="factura-fila">
              <span class="fila-lbl">P1</span>
              <span class="fila-barra"><i style="--w: 44.8%;"></i></span>
              <span class="fila-val">2.600 kWh</span>
            </div>
            <div class="factura-fila">
              <span class="fila-lbl">P2</span>
              <span class="fila-barra"><i style="--w: 29%;"></i></span>
              <span class="fila-val">1.680 kWh</span>
            </div>
            <div class="factura-fila fila-destacada">
              <span class="fila-lbl"><b>P6</b></span>
              <span class="fila-barra barra-cian"><i style="--w: 100%;"></i></span>
              <span class="fila-val">5.800 kWh</span>
            </div>
          </section>

          <!-- Zona 2: Potencia -->
          <section class="factura-zona z-potencia" data-paso="1" data-note="23 kW de más">
            <h4 class="zona-titulo">
              <span>Potencia</span>
              <span class="zona-sub">Contratada vs Real</span>
            </h4>
            <div class="factura-fila">
              <span class="fila-lbl">Contratada</span>
              <span class="fila-barra"><i style="--w: 100%;"></i></span>
              <span class="fila-val">45 kW</span>
            </div>
            <div class="factura-fila fila-destacada">
              <span class="fila-lbl"><b>Maxímetro P1 y P2</b></span>
              <span class="fila-barra barra-hueco barra-cian"><i style="--w: 48.9%;"></i></span>
              <span class="fila-val">22 kW</span>
            </div>
            <div class="factura-fila">
              <span class="fila-lbl">Maxímetro P6</span>
              <span class="fila-barra barra-hueco"><i style="--w: 88.9%;"></i></span>
              <span class="fila-val">40 kW</span>
            </div>
          </section>

          <!-- Zona 3: Energía reactiva -->
          <section class="factura-zona z-reactiva" data-paso="2" data-note="21,34 € evitable">
            <h4 class="zona-titulo">
              <span>Energía reactiva</span>
              <span class="zona-sub">21,34 € en febrero</span>
            </h4>
            <div class="factura-fila">
              <span class="fila-lbl">P1</span>
              <span class="fila-barra"><i style="--w: 100%;"></i></span>
              <span class="fila-val">12,96 €</span>
            </div>
            <div class="factura-fila">
              <span class="fila-lbl">P2</span>
              <span class="fila-barra"><i style="--w: 64.7%;"></i></span>
              <span class="fila-val">8,38 €</span>
            </div>
          </section>

          <!-- Zona 4: Precio -->
          <section class="factura-zona z-precio" data-paso="3" data-note="Mismo precio">
            <h4 class="zona-titulo">
              <span>Precio</span>
              <span class="zona-sub">0,1450 €/kWh plana</span>
            </h4>
            <div class="factura-cronologia" role="img" aria-label="Línea 24 horas con el mismo precio a las 5:00 y a las 12:00">
              <span class="crono-marca crono-ini">0:00</span>
              <span class="crono-marca crono-pote" style="left: 20.8%;">5:00</span>
              <span class="crono-marca crono-pote" style="left: 50%;">12:00</span>
              <span class="crono-marca crono-fin">24:00</span>
            </div>
            <p class="crono-nota">Tarifa plana sin diferenciar horas caras y baratas.</p>
          </section>
        </div>
      </aside>

      <!-- COLUMNA DERECHA: Pasos interactivos (Scrollytelling) -->
      <div class="pasos-col">
        <div class="pasos-carril" id="pasos-carril">
          <!-- Paso 1: Consumo -->
          <article class="paso-tarjeta on" data-paso-idx="0">
            <p class="paso-etiqueta">01 · Consumo</p>
            <h3 class="paso-titulo">¿A qué hora consume?</h3>
            <div class="paso-gran-cifra">
              <strong class="cifra-valor">58 %</strong>
              <span class="cifra-desc">de su energía se gasta en P6: madrugada y fin de semana</span>
            </div>
            <p class="paso-cuerpo">
              Más de la mitad, de madrugada y en fin de semana: el horno. Una tarifa pensada para el horario de oficina no encaja con este negocio.
            </p>
            <details class="paso-detalle">
              <summary>Ver desglose técnico de peaje</summary>
              <p>
                En febrero, el peaje 3.0TD solo tiene P1, P2 y P6. Consumo auditado: P1 2.600 kWh, P2 1.680 kWh y P6 5.800 kWh. Total mensual: 10.080 kWh.
              </p>
            </details>
          </article>

          <!-- Paso 2: Potencia -->
          <article class="paso-tarjeta" data-paso-idx="1">
            <p class="paso-etiqueta">02 · Potencia</p>
            <h3 class="paso-titulo">¿Paga potencia que no usa?</h3>
            <div class="paso-gran-cifra">
              <strong class="cifra-valor">23 kW</strong>
              <span class="cifra-desc">contratados de día que nunca llega a usar</span>
            </div>
            <p class="paso-cuerpo">
              Tiene contratados 45 kW todo el día, pero en horas de tienda su máximo es 22 kW. Solo de madrugada se acerca a los 40 kW.
            </p>
            <details class="paso-detalle">
              <summary>Ver desglose técnico de maxímetros</summary>
              <p>
                Potencia contratada: 45 kW. Maxímetro en P1 y P2: 22 kW. Maxímetro en P6: 40 kW. La diferencia innecesaria de día es de 45 − 22 = 23 kW facturados cada mes sin aprovecharse.
              </p>
            </details>
          </article>

          <!-- Paso 3: Reactiva -->
          <article class="paso-tarjeta" data-paso-idx="2">
            <p class="paso-etiqueta">03 · Energía reactiva</p>
            <h3 class="paso-titulo">¿Por qué le cobran reactiva?</h3>
            <div class="paso-gran-cifra">
              <strong class="cifra-valor">21,34 €</strong>
              <span class="cifra-desc">de penalización por reactiva solo en febrero</span>
            </div>
            <p class="paso-cuerpo">
              Sale de las horas de tienda, en P1 y P2. En P6, donde está el horno principal, no se factura.
            </p>
            <details class="paso-detalle">
              <summary>Ver desglose técnico de recargos</summary>
              <p>
                Periodo P1: 12,96 €. Periodo P2: 8,38 €. Total febrero: 21,34 €. Con compensación o ajuste de batería de condensadores se elimina al 100%.
              </p>
            </details>
          </article>

          <!-- Paso 4: Precio -->
          <article class="paso-tarjeta" data-paso-idx="3">
            <p class="paso-etiqueta">04 · Precio</p>
            <h3 class="paso-titulo">¿Cuánto paga cada kWh?</h3>
            <div class="paso-gran-cifra">
              <strong class="cifra-valor">0,1450 €</strong>
              <span class="cifra-desc">por kWh, a cualquier hora sin discriminar</span>
            </div>
            <p class="paso-cuerpo">
              Paga igual el kWh de las 5:00 que el de las 12:00, aunque su consumo de madrugada y el de mediodía no se parecen en nada.
            </p>
            <details class="paso-detalle">
              <summary>Ver desglose técnico de coste horario</summary>
              <p>
                Precio único contratado: 0,1450 €/kWh en todos los periodos. Al pasar a una tarifa con precio horario o 6 periodos reales, las horas del horno bajan drásticamente de coste.
              </p>
            </details>
          </article>
        </div>

        <!-- Indicadores para navegación táctil en móvil -->
        <div class="pasos-dots" role="group" aria-label="Seleccionar paso de la factura">
          <button class="dot-btn" type="button" aria-label="Paso 1: Consumo" aria-current="true" data-dot-idx="0"></button>
          <button class="dot-btn" type="button" aria-label="Paso 2: Potencia" aria-current="false" data-dot-idx="1"></button>
          <button class="dot-btn" type="button" aria-label="Paso 3: Reactiva" aria-current="false" data-dot-idx="2"></button>
          <button class="dot-btn" type="button" aria-label="Paso 4: Precio" aria-current="false" data-dot-idx="3"></button>
        </div>
      </div>
    </div>
  </div>

  <!-- Cierre: Veredicto técnico a pantalla completa (Full Width) -->
  <section class="leemos-veredicto-full" aria-labelledby="veredicto-titulo">
    <div class="contenedor-veredicto">
      <div class="veredicto-grid">
        <div class="veredicto-decisiones">
          <h3 id="veredicto-titulo" class="veredicto-h3">Qué decidimos para este caso</h3>
          <dl class="veredicto-lista">
            <div class="veredicto-item">
              <dt>Potencia periodo a periodo</dt>
              <dd>Contratamos lo que usa en cada periodo, no 45 kW para todo el día.</dd>
            </div>
            <div class="veredicto-item">
              <dt>Precio en seis periodos</dt>
              <dd>Cada franja tiene su propio precio, según cuándo consume realmente.</dd>
            </div>
          </dl>
          <p class="veredicto-fijo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>El precio fijo se mantiene sin penalizaciones.</span>
          </p>
        </div>

        <!-- Tarjeta de Ahorro estimado auditado -->
        <div class="veredicto-ahorro">
          <span class="ahorro-tag">Optimización aplicada</span>
          <p class="ahorro-label">Ahorro estimado en este suministro</p>
          <div class="ahorro-cifra">-4.850&nbsp;€<span class="ahorro-año">/año</span></div>
          <p class="ahorro-nota">
            Calculado con los peajes y cargos oficiales de 2026. Auditoría técnica sin coste.
          </p>
        </div>

        <!-- Fila de llamada a la acción -->
        <div class="veredicto-cta-fila">
          <button
            type="button"
            class="btn-cta-factura"
            data-abrir-funnel
            data-tramo-id="300-1000"
            data-tramo-label="300 – 1.000 €"
            data-tramo-rango="entre 3.600 y 12.000 € al año en luz"
            data-tramo-msg="Analizamos tu factura con el mismo rigor y transparencia que en este caso real de panadería."
          >
            <span>Ver su factura leída, línea a línea</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>

          <p class="veredicto-garantia">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>Análisis sin coste · Te llama una persona especializada, en la franja que elijas</span>
          </p>
        </div>
      </div>
    </div>
  </section>
</section>

<style>
  /* ==========================================================================
     SECCIÓN "ASÍ LEEMOS UNA FACTURA" (Diseño Suizo / Editorial Corporativo)
     Tipografía Sora (Titulares / Cifras) + Inter (Cuerpo técnico)
     ========================================================================== */
  .como-leemos-seccion {
    background: #f4f8fc;
    padding: clamp(56px, 7vw, 96px) 0 clamp(64px, 8vw, 108px);
    border-top: 1px solid #e2ecf7;
    border-bottom: 1px solid #e2ecf7;
    position: relative;
  }

  .contenedor {
    max-width: 1140px;
    margin-inline: auto;
    padding-inline: clamp(18px, 4vw, 40px);
  }

  /* Intro */
  .leemos-intro {
    max-width: 680px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .leemos-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #e6f2ff;
    color: var(--azul-900, #004aad);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
    border: 1px solid #cce3fd;
  }

  .badge-punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cyan-400, #38b6ff);
  }

  .leemos-h2 {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    font-weight: 700;
    color: var(--tinta, #0f2346);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .leemos-bajada {
    font-size: 1.12rem;
    line-height: 1.55;
    color: var(--tinta-2, #3a4b68);
    margin: 0;
  }

  /* Escenario en 2 columnas */
  .leemos-escenario {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5vw, 68px);
    align-items: start;
  }

  /* Factura Sticky Izquierda */
  .factura-col {
    min-width: 0;
    align-self: stretch;
    height: 100%;
  }

  .factura-tarjeta {
    position: -webkit-sticky;
    position: sticky;
    top: 96px;
    z-index: 10;
    background: #ffffff;
    border: 1px solid #d4e2f2;
    border-radius: 18px;
    box-shadow: 0 10px 36px -4px rgba(15, 35, 70, 0.12), 0 2px 8px rgba(15, 35, 70, 0.04);
    padding: clamp(20px, 2.5vw, 28px);
    display: grid;
    gap: 16px;
    transition: box-shadow 0.25s ease, transform 0.2s ease;
  }

  .factura-cabecera {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px dashed #d6e2f0;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tinta-3, #63738e);
  }

  .factura-cab-peaje {
    background: #f0f5fc;
    color: var(--azul-900, #004aad);
    padding: 3px 8px;
    border-radius: 6px;
  }

  /* Zonas de la factura con marcador interactivo amarillo */
  .factura-zona {
    position: relative;
    padding: 13px 15px;
    border-radius: 14px 10px 16px 9px / 10px 16px 9px 14px;
    background: #ffffff;
    box-shadow: 0 0 0 0 transparent;
    transition: box-shadow 0.25s ease, opacity 0.25s ease, transform 0.25s ease;
  }

  .factura-tarjeta.focus .factura-zona:not(.on) {
    opacity: 0.42;
  }

  .factura-zona.on {
    opacity: 1;
    background: #ffffff;
    box-shadow: 0 0 0 3.5px #ffc21a, 0 10px 28px -4px rgba(14, 27, 61, 0.15);
    transform: rotate(-0.35deg) scale(1.015);
    z-index: 4;
  }

  .factura-zona.on .fila-barra i {
    filter: brightness(1.15);
    box-shadow: 0 0 8px rgba(0, 74, 173, 0.4);
  }

  .factura-zona.on .fila-val {
    color: var(--azul-900, #004aad);
    font-weight: 800;
  }

  /* Badge rotado tipo nota adhesiva en amarillo marcador */
  .factura-zona::after {
    content: attr(data-note);
    position: absolute;
    top: -12px;
    right: 14px;
    background: #ffc21a;
    color: #0e1b3d;
    font-family: var(--font-titulos, "Sora", sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 4px 10px;
    border-radius: 6px;
    box-shadow: 0 3px 8px rgba(255, 194, 26, 0.4);
    transform: rotate(2deg);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
    z-index: 5;
  }

  .factura-zona.on::after {
    opacity: 1;
    transform: rotate(2deg) translateY(0);
  }

  .zona-titulo {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.96rem;
    font-weight: 700;
    color: var(--tinta, #0f2346);
    margin: 0 0 10px;
  }

  .zona-sub {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--tinta-3, #63738e);
  }

  /* Filas de valores con barras */
  .factura-fila {
    display: grid;
    grid-template-columns: 2.2rem 1fr 6.2rem;
    align-items: center;
    gap: 10px;
    font-size: 0.84rem;
    padding: 3px 0;
  }

  .z-potencia .factura-fila {
    grid-template-columns: 7.2rem 1fr 4rem;
  }

  .z-reactiva .factura-fila {
    grid-template-columns: 2.2rem 1fr 5rem;
  }

  .fila-lbl {
    color: var(--tinta-2, #3a4b68);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .fila-destacada .fila-lbl {
    color: var(--azul-900, #004aad);
    font-weight: 700;
  }

  .fila-barra {
    height: 10px;
    background: #e8f0fa;
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .fila-barra i {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    background: var(--azul-900, #004aad);
    border-radius: 999px;
  }

  .barra-cian i {
    background: var(--cyan-400, #38b6ff);
  }

  .barra-hueco {
    background: repeating-linear-gradient(135deg, #d8e5f5 0 3px, transparent 3px 6px);
  }

  .fila-val {
    text-align: right;
    font-weight: 600;
    color: var(--tinta, #0f2346);
    font-variant-numeric: tabular-nums;
  }

  .fila-destacada .fila-val {
    color: var(--azul-900, #004aad);
    font-weight: 700;
  }

  /* Cronología de 24h para el Precio */
  .factura-cronologia {
    position: relative;
    height: 34px;
    margin: 8px 4px 4px;
  }

  .factura-cronologia::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 7px;
    height: 3px;
    background: var(--azul-900, #004aad);
    border-radius: 2px;
  }

  .crono-marca {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    padding-top: 16px;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--azul-900, #004aad);
    font-variant-numeric: tabular-nums;
  }

  .crono-marca::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 1px;
    width: 2px;
    height: 14px;
    background: var(--azul-900, #004aad);
    transform: translateX(-50%);
  }

  .crono-ini {
    left: 0;
    transform: none;
    color: var(--tinta-3, #63738e);
  }

  .crono-ini::before {
    display: none;
  }

  .crono-fin {
    left: 100%;
    transform: translateX(-100%);
    color: var(--tinta-3, #63738e);
  }

  .crono-fin::before {
    display: none;
  }

  .crono-nota {
    font-size: 0.78rem;
    color: var(--tinta-3, #63738e);
    margin: 6px 0 0;
    line-height: 1.35;
  }

  /* Columna Derecha: Pasos Scrollytelling */
  .pasos-col {
    min-width: 0;
  }

  .pasos-carril {
    position: relative;
  }

  .paso-tarjeta {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    padding-block: 2.8rem;
    opacity: 0.35;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .paso-tarjeta.on {
    opacity: 1;
    transform: translateY(0);
  }

  .paso-tarjeta:last-child {
    min-height: 52vh;
  }

  .paso-etiqueta {
    margin: 0;
    font-family: var(--font-titulos, "Sora", sans-serif);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--azul-900, #004aad);
  }

  .paso-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
