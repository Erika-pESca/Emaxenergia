  /* ==========================================================================
     RESPONSIVE (Móvil y Tablet)
     La factura se queda arriba compacta y los pasos se vuelven carrusel táctil
     ========================================================================== */
  @media (max-width: 899px) {
    .leemos-escenario {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .factura-tarjeta {
      position: static;
    }

    .pasos-carril {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: 8px;
    }

    .pasos-carril::-webkit-scrollbar {
      display: none;
    }

    .paso-tarjeta {
      flex: 0 0 90%;
      scroll-snap-align: start;
      min-height: 0;
      opacity: 1;
      transform: none;
      background: #ffffff;
      border: 1px solid #d4e2f2;
      border-radius: 16px;
      padding: 22px;
      box-sizing: border-box;
      justify-content: flex-start;
    }

    .paso-tarjeta:last-child {
      min-height: 0;
    }

    .cifra-valor {
      font-size: clamp(3rem, 16vw, 4.2rem);
    }

    .pasos-dots {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin-top: 14px;
    }

    .dot-btn {
      width: 32px;
      height: 32px;
      border: 0;
      background: none;
      padding: 0;
      display: grid;
      place-items: center;
      cursor: pointer;
    }

    .dot-btn::before {
      content: "";
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: #cfdeee;
      transition: width 0.2s, background-color 0.2s;
    }

    .dot-btn[aria-current="true"]::before {
      width: 26px;
      background: var(--azul-900, #004aad);
    }

    .veredicto-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .factura-zona,
    .paso-tarjeta,
    .btn-cta-factura {
      transition: none !important;
    }
  }
</style>

<script>
  // Control interactivo de Scrollytelling para "Así leemos una factura"
  (function initScrollytelling() {
    const pasos = Array.from(document.querySelectorAll<HTMLElement>(".paso-tarjeta"));
    const zonas = Array.from(document.querySelectorAll<HTMLElement>(".factura-zona"));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".dot-btn"));
    const sheet = document.getElementById("factura-sheet");
    const carril = document.getElementById("pasos-carril");
    const mqMobile = window.matchMedia("(max-width: 899px)");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    sheet?.classList.add("focus");

    let pasoActual = 0;

    function activarPaso(index: number) {
      if (index === pasoActual || index < 0 || index >= pasos.length) return;
      pasoActual = index;

      pasos.forEach((p, idx) => {
        p.classList.toggle("on", idx === index);
      });

      zonas.forEach((z, idx) => {
        z.classList.toggle("on", idx === index);
      });

      dots.forEach((d, idx) => {
        d.setAttribute("aria-current", idx === index ? "true" : "false");
      });
    }

    // Clic directo en las zonas de la factura para saltar a ese paso
    zonas.forEach((zona, idx) => {
      zona.style.cursor = "pointer";
      zona.addEventListener("click", () => {
        const behavior = prefersReducedMotion ? "auto" : "smooth";
        if (mqMobile.matches && carril) {
          carril.scrollTo({ left: pasos[idx].offsetLeft, behavior });
        } else {
          pasos[idx].scrollIntoView({ behavior, block: "center" });
        }
        activarPaso(idx);
      });
    });

    // Detección precisa de scroll en desktop
    function calcularPasoActivoPorScroll() {
      if (mqMobile.matches) return;
      const viewportCenter = window.innerHeight * 0.45;
      let pasoMasCercano = 0;
      let menorDistancia = Infinity;

      pasos.forEach((p, idx) => {
        const rect = p.getBoundingClientRect();
        // Centro relativo de la tarjeta del paso
        const pasoCentro = rect.top + rect.height * 0.35;
        const distancia = Math.abs(pasoCentro - viewportCenter);

        if (distancia < menorDistancia) {
          menorDistancia = distancia;
          pasoMasCercano = idx;
        }
      });

      activarPaso(pasoMasCercano);
    }

    // Escuchador de scroll de ventana de alta frecuencia
    window.addEventListener("scroll", calcularPasoActivoPorScroll, { passive: true });
    // Ejecutar al cargar para asegurar que el primer paso esté activo
    calcularPasoActivoPorScroll();

    // Scroll táctil en móvil
    carril?.addEventListener(
      "scroll",
      () => {
        if (!mqMobile.matches) return;
        const scrollLeft = carril.scrollLeft;
        let mejorPaso = 0;
        let menorDistancia = Infinity;

        if (scrollLeft + carril.clientWidth >= carril.scrollWidth - 6) {
          mejorPaso = pasos.length - 1;
        } else {
          pasos.forEach((p, idx) => {
            const dist = Math.abs(p.offsetLeft - scrollLeft);
            if (dist < menorDistancia) {
              menorDistancia = dist;
              mejorPaso = idx;
            }
          });
        }
        activarPaso(mejorPaso);
      },
      { passive: true }
    );

    // Clic en los dots de móvil
    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        const behavior = prefersReducedMotion ? "auto" : "smooth";
        if (mqMobile.matches && carril) {
          carril.scrollTo({ left: pasos[idx].offsetLeft, behavior });
        } else {
          pasos[idx].scrollIntoView({ behavior, block: "center" });
        }
      });
    });
  })();
</script>
