---
// AsiLeemosFactura.astro
// Sección dedicada: Así leemos tu factura · Ejemplo real: obrador de panadería
// Basado en el diseño limpio, sobrio y corporativo con acordeones exclusivos.
---

<section class="como-leemos-seccion" id="como-leemos" aria-labelledby="leemos-titulo">
  <div class="contenedor">
    <!-- Encabezado editorial -->
    <header class="leemos-intro">
      <div class="leemos-badge">
        <span class="badge-punto" aria-hidden="true"></span>
        <span>Ejemplo real · Obrador de panadería</span>
      </div>
      <h2 id="leemos-titulo" class="leemos-h2">Así leemos tu factura</h2>
      <p class="leemos-bajada">
        Cuatro cosas que miramos en cada factura, siempre en el mismo orden. Esta es la de febrero de una panadería que enciende el horno de madrugada.
      </p>
    </header>

    <!-- Contenedor centrado para la tarjeta de auditoría técnica -->
    <div class="leemos-tarjeta-wrap">
      <figure class="lh" id="lectura" aria-labelledby="lh-t">
        <div class="lh__cab">
          <p class="lh__t" id="lh-t">Así leemos tu factura</p>
          <span class="lh__ej">Ejemplo real · obrador de panadería</span>
        </div>

        <!-- 1. Cuándo consume -->
        <details class="fila" name="lectura">
          <summary>
            <span class="fila__t">Cuándo consume</span>
            <span class="fila__f"><small>P6</small>5.800 kWh</span>
            <span class="fila__s">Más de la mitad, de madrugada y en fin de semana: el horno.</span>
            <svg class="fila__c" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
              <path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <div class="fila__cuerpo">
            <ul class="barras">
              <li><span class="p">P1</span><span class="pista"><span class="barra" style="--w:44.8%"></span></span><span class="valor">2.600 kWh</span></li>
              <li><span class="p">P2</span><span class="pista"><span class="barra" style="--w:29%"></span></span><span class="valor">1.680 kWh</span></li>
              <li class="dest"><span class="p">P6</span><span class="pista"><span class="barra" style="--w:100%"></span></span><span class="valor">5.800 kWh</span></li>
            </ul>
            <p class="nota">En febrero, el peaje 3.0TD solo tiene P1, P2 y P6.</p>
          </div>
        </details>

        <!-- 2. Potencia (Clave - Abierta por defecto) -->
        <details class="fila fila--clave" name="lectura" open>
          <summary>
            <span class="fila__t">Potencia</span>
            <span class="fila__f">23 kW</span>
            <span class="fila__s">Paga de día 23 kW que no usa.</span>
            <svg class="fila__c" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
              <path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <div class="fila__cuerpo">
            <ul class="barras barras--ancho">
              <li><span class="p">Contratada</span><span class="pista"><span class="barra" style="--w:100%"></span></span><span class="valor">45 kW</span></li>
              <li class="dest"><span class="p">Maxímetro P1 y P2</span><span class="pista pista--hueco"><span class="barra" style="--w:48.9%"></span></span><span class="valor">22 kW</span></li>
              <li><span class="p">Maxímetro P6</span><span class="pista pista--hueco"><span class="barra" style="--w:88.9%"></span></span><span class="valor">40 kW</span></li>
            </ul>
          </div>
        </details>

        <!-- 3. Reactiva -->
        <details class="fila" name="lectura">
          <summary>
            <span class="fila__t">Energía reactiva</span>
            <span class="fila__f"><small>en febrero</small>21,34 €</span>
            <span class="fila__s">Es la de las horas de tienda. En P6 no se factura.</span>
            <svg class="fila__c" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
              <path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <div class="fila__cuerpo">
            <ul class="barras">
              <li><span class="p">P1</span><span class="pista"><span class="barra" style="--w:100%"></span></span><span class="valor">12,96 €</span></li>
              <li><span class="p">P2</span><span class="pista"><span class="barra" style="--w:64.7%"></span></span><span class="valor">8,38 €</span></li>
            </ul>
          </div>
        </details>

        <!-- 4. Precio -->
        <details class="fila" name="lectura">
          <summary>
            <span class="fila__t">Precio</span>
            <span class="fila__f"><small>a cualquier hora</small>0,1450 €/kWh</span>
            <span class="fila__s">Paga igual el kWh de las 5:00 que el de las 12:00.</span>
            <svg class="fila__c" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
              <path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <div class="fila__cuerpo">
            <div class="precio" aria-hidden="true">
              <span class="precio__linea"></span>
              <span class="precio__marca" style="--x:20.8%"><i>5:00</i></span>
              <span class="precio__marca" style="--x:50%"><i>12:00</i></span>
            </div>
          </div>
        </details>

        <!-- Qué decidimos -->
        <div class="decide">
          <p class="decide__t">Qué decidimos</p>
          <p class="decide__s">Potencia periodo a periodo y precio en seis periodos. El precio fijo se mantiene.</p>
          <a class="decide__ver" href="/diagnostico#factura-obrador">Ver su factura leída, línea a línea →</a>
        </div>
        <figcaption class="lh__pie">Peajes y cargos oficiales de 2026.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN "ASÍ LEEMOS TU FACTURA" (Diseño sobrio y limpio)
     ========================================================================== */
  .como-leemos-seccion {
    background: #f4f8fc;
    padding: clamp(54px, 7vw, 84px) 0;
    border-bottom: 1px solid #dce8f5;
  }

  .contenedor {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(18px, 4vw, 40px);
  }

  /* Intro */
  .leemos-intro {
    text-align: center;
    max-width: 680px;
    margin: 0 auto clamp(32px, 4vw, 48px);
  }

  .leemos-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #e6f2ff;
    color: var(--azul-900, #004aad);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .badge-punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--azul-900, #004aad);
  }

  .leemos-h2 {
    font-family: var(--font-titulos, "Sora", sans-serif);
    font-size: clamp(2rem, 1.6rem + 1.8vw, 2.75rem);
    font-weight: 700;
    color: var(--tinta, #0f2346);
    line-height: 1.15;
    margin: 0 0 12px;
    text-wrap: balance;
  }

  .leemos-bajada {
    font-family: var(--font-texto, "Inter", sans-serif);
    font-size: 1.05rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
    margin: 0;
    text-wrap: balance;
  }

  /* Contenedor de la tarjeta */
  .leemos-tarjeta-wrap {
    max-width: 780px;
    margin: 0 auto;
  }

  /* Tarjeta de factura (Diseño original limpio) */
  .lh {
    margin: 0;
    background: #ffffff;
    border: 1px solid #dbe6f4;
    border-top: 3.5px solid var(--azul-900, #004aad);
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 8px 30px rgba(15, 35, 70, 0.06);
  }

  @media (min-width: 768px) {
    .lh {
      padding: 28px 32px 22px;
    }
  }

  .lh__cab {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding-bottom: 16px;
  }

  .lh__t {
    margin: 0;
    font-family: var(--font-titulos, "Sora", sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--tinta, #0f2346);
  }

  .lh__ej {
    padding: 2px 10px;
    border-radius: 999px;
    background: #e5f1ff;
    color: var(--azul-900, #004aad);
    font-family: var(--font-titulos, "Sora", sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .fila {
    border-top: 1px solid #d8e4f2;
  }

  .fila summary {
    list-style: none;
    cursor: pointer;
    padding: 16px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 22px;
    grid-template-areas: "t f c" "s s c";
    column-gap: 12px;
    row-gap: 3px;
    align-items: center;
    user-select: none;
  }

  .fila summary::-webkit-details-marker {
    display: none;
  }

  .fila summary:focus-visible {
    outline: 2px solid var(--azul-900, #004aad);
    outline-offset: 2px;
    border-radius: 6px;
  }

  .fila__t {
    grid-area: t;
    font-family: var(--font-texto, "Inter", sans-serif);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--tinta-2, #4a5e7d);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: color 0.15s;
  }

  .fila__f {
    grid-area: f;
    text-align: right;
    font-family: var(--font-titulos, "Sora", sans-serif);
    font-size: 1.2rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--tinta, #0f2346);
    line-height: 1.1;
  }

  .fila__f small {
    display: block;
    margin-bottom: 2px;
    font-family: var(--font-texto, "Inter", sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--tinta-3, #63738e);
  }

  .fila__s {
    grid-area: s;
    font-family: var(--font-texto, "Inter", sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--tinta, #0f2346);
  }

  .fila__c {
    grid-area: c;
    justify-self: end;
    color: var(--azul-900, #004aad);
    transition: transform 0.25s ease;
  }

  .fila[open] .fila__c {
    transform: rotate(180deg);
  }

  .fila summary:hover .fila__t {
    color: var(--azul-900, #004aad);
  }

  /* Potencia: Cifra grande y marcador corporativo */
  .fila--clave .fila__f {
    font-size: 1.95rem;
    font-weight: 800;
    color: var(--azul-900, #004aad);
    letter-spacing: -0.02em;
  }

  .fila--clave .fila__s {
    display: inline;
    justify-self: start;
    background: #e2f0ff;
    padding: 2px 10px;
    border-radius: 0 6px 6px 0;
    border-left: 3.5px solid var(--azul-900, #004aad);
    color: var(--azul-900, #004aad);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .fila--clave summary {
    grid-template-areas: "t f c" "s f c";
  }

  .fila__cuerpo {
    padding: 6px 0 18px;
  }

  .barras {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .barras li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) 6.4rem;
    align-items: center;
    gap: 10px;
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
  }

  .barras--ancho li {
    grid-template-columns: 7.2rem minmax(0, 1fr) 3.8rem;
  }

  .barras .p {
    color: var(--tinta-2, #4a5e7d);
    font-size: 0.82rem;
    font-family: var(--font-texto, "Inter", sans-serif);
    white-space: nowrap;
  }

  .barras .valor {
    text-align: right;
    font-weight: 600;
    color: var(--tinta, #0f2346);
  }

  .barras .dest .p {
    color: var(--azul-900, #004aad);
    font-weight: 700;
  }

  .barras .dest .valor {
    color: var(--azul-900, #004aad);
    font-weight: 700;
  }

  .pista {
    height: 10px;
    background: #e6eff8;
    border-radius: 999px;
    overflow: hidden;
  }

  .pista--hueco {
    background: repeating-linear-gradient(135deg, transparent 0 3px, #cfdeef 3px 5px);
  }

  .barra {
    display: block;
    height: 100%;
    width: var(--w);
    background: var(--azul-900, #004aad);
    border-radius: 999px;
  }

  .dest .barra {
    background: var(--cyan-400, #38b6ff);
  }

  .nota {
    margin: 10px 0 0;
    font-size: 0.82rem;
    color: var(--tinta-3, #63738e);
    line-height: 1.4;
  }

  .precio {
    position: relative;
    height: 34px;
    margin: 8px 0 4px;
  }

  .precio__linea {
    position: absolute;
    left: 0;
    right: 0;
    top: 8px;
    height: 3px;
    background: var(--azul-900, #004aad);
    border-radius: 2px;
  }

  .precio__marca {
    position: absolute;
    left: var(--x);
    top: 2px;
    width: 2px;
    height: 16px;
    background: var(--cyan-400, #38b6ff);
  }

  .precio__marca i {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-titulos, "Sora", sans-serif);
    font-size: 0.74rem;
    font-style: normal;
    color: var(--azul-900, #004aad);
    font-weight: 600;
    white-space: nowrap;
  }

  .decide {
    border-top: 1px solid #d8e4f2;
    padding: 18px 0 14px;
  }

  .decide__t {
    margin: 0;
    font-family: var(--font-texto, "Inter", sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--azul-900, #004aad);
  }

  .decide__s {
    margin: 4px 0 0;
    font-family: var(--font-texto, "Inter", sans-serif);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--tinta, #0f2346);
    line-height: 1.45;
  }

  .decide__ver {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-family: var(--font-titulos, "Sora", sans-serif);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--azul-900, #004aad);
    text-decoration: none;
    transition: color 0.15s, transform 0.15s;
  }

  .decide__ver:hover {
    color: var(--azul-900-hover, #003c8c);
    transform: translateX(3px);
  }

  .lh__pie {
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid #d8e4f2;
    font-size: 0.78rem;
    color: var(--tinta-3, #63738e);
  }

  @media (prefers-reduced-motion: no-preference) {
    .fila[open] .barra {
      animation: crece 0.45s ease-out both;
    }
    @keyframes crece {
      from {
        width: 0;
      }
    }
  }
</style>
