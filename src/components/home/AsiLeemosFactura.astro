  .leemos-veredicto-full {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    margin-top: clamp(56px, 7vw, 92px);
    margin-bottom: calc(-1 * clamp(64px, 8vw, 108px));
    padding: clamp(64px, 7vw, 96px) 0;
