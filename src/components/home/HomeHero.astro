---
import StudyForm from "./StudyForm.astro";

const steps = [
  "Primero analizamos",
  "Después diseñamos",
  "Un experto valida",
  "Tú decides",
];
---

<section class="hero" aria-labelledby="home-h1">
  <div class="glow glow-left"></div>
  <div class="glow glow-right"></div>
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="badge">Energía para empresas</p>
      <h1 id="home-h1">Cada euro que pagas de más en luz sale de tu margen.</h1>
      <p class="lead">
        No necesitas otra tarifa de catálogo. Necesitas saber si lo que estás pagando tiene sentido para tu empresa.
      </p>
      <p class="metric-label">Eso son aproximadamente:</p>
      <p class="metric">6.000 €/año</p>
      <p class="metric-note">Cada euro que pagas de más sale directamente de tu margen.</p>
    </div>
    <StudyForm />
  </div>
  <ol class="process wrap">
    {steps.map((step) => <li>{step}</li>)}
  </ol>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(1200px 500px at 10% 20%, #123a7a 0%, transparent 55%),
      radial-gradient(900px 480px at 92% 80%, #0b6cb8 0%, transparent 50%),
      linear-gradient(180deg, var(--navy-mid), var(--navy-deep));
    color: var(--white);
    padding: 48px 0 36px;
  }

  .glow {
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    filter: blur(40px);
    pointer-events: none;
  }

  .glow-left {
    left: -80px;
    top: 80px;
    background: rgba(30, 130, 255, 0.28);
  }

  .glow-right {
    right: -60px;
    bottom: -80px;
    background: rgba(62, 200, 255, 0.35);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .badge {
    display: inline-flex;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: rgba(180, 210, 255, 0.18);
    color: #d7e7ff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 22px 0 18px;
    font-size: clamp(2.1rem, 4vw, 3.35rem);
    font-weight: 800;
    text-transform: uppercase;
    max-width: 12ch;
  }

  .lead {
    max-width: 36ch;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.05rem;
  }

  .metric-label {
    margin-top: 28px;
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.78);
  }

  .metric {
    font-family: var(--display);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: 800;
    margin: 6px 0;
  }

  .metric-note {
    font-style: italic;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.95rem;
  }

  .process {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    list-style: none;
    margin: 48px auto 0;
    padding: 8px 0 0;
    font-weight: 700;
    font-size: 0.95rem;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .process {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: none;
    }
  }
</style>
