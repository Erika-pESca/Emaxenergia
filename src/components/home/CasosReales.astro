---
// Componente: "NO QUEREMOS QUE NOS CREAS PORQUE LO DECIMOS NOSOTROS."
// Sección de casos y evidencias verificables EMAX.
//
// 1. Título Baloo 2 en azul corporativo (#004aad) de gran escala e impacto.
// 2. Subtítulo Poppins: "Queremos enseñarte lo que encontramos."
// 3. Rejilla de 5 tarjetas satinadas (3 en la primera fila, 2 en la segunda):
//    - Sector
//    - Problema
//    - Qué encontramos
//    - Qué hicimos
//    - Resultado verificable
// 4. Cada tarjeta cuenta con un círculo azul corporativo y el texto de rigor:
//    "Publicaremos aquí casos verificables. No mostramos datos inventados."
// 5. Botón inferior "Ver historias reales" con estética píldora azul.
// 6. Orbe de luz cian/azul resplandeciente en el espacio derecho.

interface TarjetaCaso {
  id: string;
  titulo: string;
  descripcion: string;
}

const casos: TarjetaCaso[] = [
  {
    id: "sector",
    titulo: "Sector",
    descripcion: "Publicaremos aquí casos verificables. No mostramos datos inventados.",
  },
  {
    id: "problema",
    titulo: "Problema",
    descripcion: "Publicaremos aquí casos verificables. No mostramos datos inventados.",
  },
  {
    id: "encontramos",
    titulo: "Qué encontramos",
    descripcion: "Publicaremos aquí casos verificables. No mostramos datos inventados.",
  },
  {
    id: "hicimos",
    titulo: "Qué hicimos",
    descripcion: "Publicaremos aquí casos verificables. No mostramos datos inventados.",
  },
  {
    id: "resultado",
    titulo: "Resultado verificable",
    descripcion: "Publicaremos aquí casos verificables. No mostramos datos inventados.",
  },
];
---

<section class="casos-seccion" id="casos">
  <!-- Halos ambientales de luz en el fondo claro -->
  <div class="halo-ambiente halo-cyan-izq" aria-hidden="true"></div>

  <div class="wrap casos-inner">
    <!-- Orbe azul/cian brillante en la zona derecha alineado al wrap -->
    <div class="halo-ambiente halo-orb-der" aria-hidden="true"></div>

    <!-- Encabezado superior -->
    <div class="encabezado">
      <h2 class="titulo-casos">NO QUEREMOS QUE NOS CREAS PORQUE LO DECIMOS NOSOTROS.</h2>
      <p class="subtitulo-casos">Queremos enseñarte lo que encontramos.</p>
    </div>

    <!-- Rejilla con las 5 tarjetas (3 + 2) -->
    <div class="rejilla-casos">
      {
        casos.map((item, index) => (
          <article class={`tarjeta-caso tarjeta-${item.id}`} style={`--i: ${index};`}>
            <div class="caso-cabecera">
              <span class="punto-azul" aria-hidden="true"></span>
              <h3 class="caso-titulo">{item.titulo}</h3>
            </div>
            <p class="caso-desc">{item.descripcion}</p>
          </article>
        ))
      }
    </div>

    <!-- Botón inferior izquierdo -->
    <div class="accion-wrap">
      <a href="/casos-de-exito" class="btn-historias">
        <span>Ver historias reales</span>
      </a>
    </div>
  </div>
</section>

<style>
  .casos-seccion {
    position: relative;
    overflow: hidden;
    background: #ffffff;
    color: var(--ink);
    padding: 104px 0 114px;
    scroll-margin-top: var(--header-h);
  }

  /* Halos ambientales suaves en el fondo claro */
  .halo-ambiente {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .halo-cyan-izq {
    width: 440px;
    height: 440px;
    left: -120px;
    top: -60px;
    background: radial-gradient(
      circle,
      rgba(56, 182, 255, 0.28) 0%,
      rgba(82, 113, 255, 0.12) 45%,
      transparent 70%
    );
    filter: blur(65px);
    z-index: 0;
  }

  /* Orbe azul/cian brillante visible a la derecha de las tarjetas */
  .halo-orb-der {
    width: 260px;
    height: 260px;
    right: clamp(10px, 4vw, 70px);
    top: 56%;
    transform: translateY(-50%);
    background: radial-gradient(
      circle,
      rgba(56, 182, 255, 0.72) 0%,
      rgba(0, 102, 255, 0.4) 45%,
      rgba(82, 113, 255, 0.18) 65%,
      transparent 75%
    );
    filter: blur(42px);
    z-index: 0;
    animation: pulsar-orb 7s ease-in-out infinite alternate;
  }

  @keyframes pulsar-orb {
    0% {
      transform: translateY(-50%) scale(0.94);
      opacity: 0.85;
    }
    100% {
      transform: translateY(-50%) scale(1.06);
      opacity: 1;
    }
  }

  .casos-inner {
    position: relative;
    z-index: 1;
  }

  /* Encabezado */
  .encabezado {
    max-width: 860px;
    margin-bottom: 40px;
  }

  .titulo-casos {
    font-family: var(--display);
    font-size: clamp(2.2rem, 3.8vw, 3.3rem);
    font-weight: 800;
    color: #004aad;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0;
  }

  .subtitulo-casos {
    margin: 14px 0 0;
    font-family: var(--font);
    font-size: clamp(1.15rem, 1.7vw, 1.35rem);
    font-weight: 400;
    color: #2a3852;
    line-height: 1.35;
  }

  /* Rejilla de 5 tarjetas en 3 columnas (3 arriba, 2 abajo) */
  .rejilla-casos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 940px;
  }

  /* Tarjeta metálica satinada / gris perla */
  .tarjeta-caso {
    position: relative;
    background: linear-gradient(145deg, #d3d7e1 0%, #c4cad5 100%);
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 18px;
    padding: 22px 18px 20px;
    box-shadow:
      0 10px 24px rgba(10, 30, 60, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .tarjeta-caso:hover {
    transform: translateY(-4px);
    box-shadow:
      0 16px 32px rgba(10, 30, 60, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    border-color: rgba(56, 182, 255, 0.6);
  }

  /* Cabecera interna: círculo azul + título */
  .caso-cabecera {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .punto-azul {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #004aad;
    box-shadow: 0 2px 8px rgba(0, 74, 173, 0.35);
    flex-shrink: 0;
  }

  .caso-titulo {
    font-family: var(--font);
    font-size: 0.96rem;
    font-weight: 700;
    color: #004aad;
    margin: 0;
    line-height: 1.25;
  }

  /* Texto de rigor verificable */
  .caso-desc {
    font-family: var(--font);
    font-size: 0.84rem;
    font-weight: 400;
    line-height: 1.45;
    color: #435269;
    margin: 0;
  }

  /* Botón inferior */
  .accion-wrap {
    margin-top: 34px;
  }

  .btn-historias {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border-radius: 999px;
    background: #00367f;
    color: #ffffff;
    font-family: var(--font);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    box-shadow:
      0 4px 16px rgba(0, 54, 127, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-historias:hover {
    background: #00439c;
    transform: translateY(-2px);
    box-shadow:
      0 8px 24px rgba(0, 54, 127, 0.45),
      0 0 20px rgba(56, 182, 255, 0.4);
  }

  /* Responsive */
  @media (max-width: 680px) {
    .casos-seccion {
      padding: 72px 0 80px;
    }

    .rejilla-casos {
      grid-template-columns: 1fr;
    }

    .halo-orb-der {
      opacity: 0.35;
      right: -40px;
    }

    .btn-historias {
      width: 100%;
    }
  }
</style>
