---
// Sección 7 (Cierre final antes del Footer): "La tarifa no se elige: se construye."
// Cierre comercial amigable y definitivo para capturar al usuario antes del pie de página.
import { site } from "../../data/site";

const tramosCierre = [
  { etiqueta: "Menos de 300 €", valor: "<300" },
  { etiqueta: "300 – 1.000 €", valor: "300-1000" },
  { etiqueta: "1.000 – 3.000 €", valor: "1000-3000" },
  { etiqueta: "Más de 3.000 €", valor: ">3000" },
];
---

<section class="cierre-seccion" id="cierre-ventas">
  <div class="contenedor">
    <div class="cierre-caja tarjeta-blanca">
      <div class="cierre-header">
        <div class="kicker-wrap">
          <span class="kicker-punto" aria-hidden="true"></span>
          <span class="kicker-texto">Empieza hoy mismo</span>
        </div>
        <h2 class="cierre-titulo">La tarifa no se elige: se construye.</h2>
        <p class="cierre-subtitulo">
          Nosotros la construimos con tus datos reales. Empieza por lo que pagas al mes.
        </p>
      </div>

      <div class="cierre-caminos-grid">
        <!-- Camino A: Quiero los números -->
        <div class="camino-card">
          <div class="camino-top">
            <span class="camino-badge-step">Opción A</span>
            <h3 class="camino-tit">Quiero los números</h3>
            <p class="camino-desc">¿Cuánto paga tu empresa de luz al mes aproximadamente?</p>
          </div>

          <div class="tramos-cierre-lista">
            {
              tramosCierre.map((t) => (
                <a href="/#estudio" class="tramo-cierre-btn">
                  <span>{t.etiqueta}</span>
                  <span aria-hidden="true">→</span>
                </a>
              ))
            }
          </div>
        </div>

        <!-- Camino B: Quiero hablar directo -->
        <div class="camino-card camino-telefono">
          <div class="camino-top">
            <span class="camino-badge-step destacada">Opción B</span>
            <h3 class="camino-tit">Prefiero hablar con un especialista</h3>
            <p class="camino-desc">Llámanos ahora mismo o solicita llamada directa en tu horario preferido.</p>
          </div>

          <div class="telefono-destacado-box">
            <span class="tel-label">Línea directa para empresas</span>
            <a href={site.phoneHref} class="tel-enlace-grande">
              {site.phone}
            </a>
            <span class="tel-horario">{site.horario}</span>
          </div>

          <a href="/contacto" class="boton boton-primario ancho-total">
            Solicitar llamada gratuita
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cierre-seccion {
    padding: 76px 0 84px;
    background: #ffffff;
  }

  .cierre-caja {
    padding: 56px 44px;
    border-radius: var(--radio-grande, 28px);
    border: 1.5px solid #d4e2f5;
    background: #f8fbff;
  }

  .cierre-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .kicker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radio-pill, 999px);
    background: #ffffff;
    border: 1px solid #d8e5f5;
  }

  .kicker-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--azul-900, #004aad);
  }

  .kicker-texto {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--azul-900, #004aad);
  }

  .cierre-titulo {
    font-size: clamp(2rem, 1.6rem + 1.8vw, 2.9rem);
    color: var(--tinta, #0f2346);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .cierre-subtitulo {
    font-size: 1.15rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
  }

  .cierre-caminos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .camino-card {
    padding: 32px 28px;
    background: #ffffff;
    border: 1.5px solid #d6e2f2;
    border-radius: var(--radio-grande, 28px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }

  .camino-top {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .camino-badge-step {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--azul-900, #004aad);
  }

  .camino-badge-step.destacada {
    color: var(--verde-ok, #067647);
  }

  .camino-tit {
    font-size: 1.35rem;
    color: var(--tinta, #0f2346);
    font-weight: 800;
    margin: 0;
  }

  .camino-desc {
    font-size: 0.9rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.45;
  }

  .tramos-cierre-lista {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tramo-cierre-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--fondo, #f4f7fb);
    border: 1.5px solid #d6e0ee;
    border-radius: var(--radio-md, 14px);
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--tinta, #0f2346);
    transition: all 0.15s ease;
  }

  .tramo-cierre-btn:hover {
    background: #ffffff;
    border-color: var(--azul-900, #004aad);
    color: var(--azul-900, #004aad);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 74, 173, 0.12);
  }

  .camino-telefono {
    border: 2px solid var(--azul-900, #004aad);
    box-shadow: 0 12px 32px rgba(0, 74, 173, 0.08);
  }

  .telefono-destacado-box {
    padding: 18px 20px;
    background: var(--azul-suave, #edf4fe);
    border-radius: var(--radio-md, 14px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
  }

  .tel-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--azul-900, #004aad);
  }

  .tel-enlace-grande {
    font-family: var(--font-titulos);
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--tinta, #0f2346);
    line-height: 1.1;
  }

  .tel-enlace-grande:hover {
    color: var(--azul-900, #004aad);
  }

  .tel-horario {
    font-size: 0.8rem;
    color: var(--tinta-3, #63738e);
  }

  .ancho-total {
    width: 100%;
  }

  @media (max-width: 980px) {
    .cierre-caja {
      padding: 32px 20px;
    }

    .cierre-caminos-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .tramos-cierre-lista {
      grid-template-columns: 1fr;
    }
  }
</style>
