---
// Sección 4: "Tú haces tres cosas. Del resto nos encargamos."
// Proceso sin fricción en 3 pasos + Los 4 compromisos de transparencia de EMAX.
import { site } from "../../data/site";

const pasos = [
  {
    num: "1",
    titulo: "Nos dices cuánto paga tu empresa",
    desc: "Con una cifra aproximada al mes nos basta para empezar. Si tienes varios locales o suministros, los sumamos.",
  },
  {
    num: "2",
    titulo: "Un consultor te llama en tu franja horaria",
    desc: "Te llamamos con tu informe delante para explicarte lo que hemos visto en tu factura, no para leerte una oferta comercial agresiva.",
  },
  {
    num: "3",
    titulo: "Decides tú con los números por delante",
    desc: "No te prometemos ahorro antes de leer tu factura. Te enseñamos los números con total claridad antes de pedirte que cambies.",
  },
];

const compromisos = [
  {
    titulo: "Primero, el informe",
    desc: "Leemos tu consumo, tu potencia y tu reactiva antes de hablar de tarifa. Todo documentado.",
  },
  {
    titulo: "Por escrito y para ti",
    desc: "Te mandamos el informe técnico completo y te lo quedas para siempre, decidas lo que decidas.",
  },
  {
    titulo: "Si no compensa, te lo decimos",
    desc: "Si tu contrato actual ya es el más óptimo, te lo decimos con honestidad en lugar de cambiarte por cambiar.",
  },
  {
    titulo: "Sin tu firma no cambia nada",
    desc: "Pedir el análisis no toca tu contrato, no corta la luz ni te cambia de compañía sin tu consentimiento expreso.",
  },
];
---

<section class="proceso-seccion" id="como-funciona">
  <div class="contenedor">
    <div class="seccion-cabecera">
      <div class="kicker-wrap">
        <span class="kicker-punto" aria-hidden="true"></span>
        <span class="kicker-texto">Proceso en 3 pasos sencillos</span>
      </div>
      <h2 class="seccion-titulo">Tú haces tres cosas. Del resto nos encargamos.</h2>
      <p class="seccion-subtitulo">
        Sin burocracia, sin trámites tediosos y sin sorpresas en tu suministro eléctrico.
      </p>
    </div>

    <!-- Pasos numerados estilo tarjeta limpia -->
    <div class="pasos-grid">
      {
        pasos.map((paso) => (
          <article class="paso-card tarjeta-blanca">
            <div class="paso-top">
              <span class="paso-circulo-num">{paso.num}</span>
              <span class="paso-fase-etiqueta">Fase {paso.num}</span>
            </div>
            <h3 class="paso-titulo">{paso.titulo}</h3>
            <p class="paso-desc">{paso.desc}</p>
          </article>
        ))
      }
    </div>

    <!-- Compromisos de transparencia -->
    <div class="compromisos-caja">
      <div class="compromisos-intro">
        <span class="badge badge-verde">Nuestra palabra y compromiso</span>
        <h3 class="compromisos-tit">Sin promesas al aire. Hechos contrastables.</h3>
      </div>

      <div class="compromisos-grid">
        {
          compromisos.map((c) => (
            <div class="compromiso-item">
              <span class="compromiso-check" aria-hidden="true">✓</span>
              <div>
                <h4 class="compromiso-item-tit">{c.titulo}</h4>
                <p class="compromiso-item-desc">{c.desc}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="compromisos-cta-fila">
        <a href="/#estudio" class="boton boton-primario">
          Analizar mi factura sin compromiso
        </a>
        <a href={site.phoneHref} class="boton boton-secundario">
          <span>O llámanos directo al <strong>{site.phone}</strong></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .proceso-seccion {
    padding: 76px 0 84px;
    background: #ffffff;
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  .seccion-cabecera {
    text-align: center;
    max-width: 740px;
    margin: 0 auto 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .kicker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radio-pill, 999px);
    background: var(--azul-suave, #edf4fe);
  }

  .kicker-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--azul-900, #004aad);
  }

  .kicker-texto {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--azul-900, #004aad);
  }

  .seccion-titulo {
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.7rem);
    color: var(--tinta, #0f2346);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .seccion-subtitulo {
    font-size: 1.125rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
  }

  .pasos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 48px;
  }

  .paso-card {
    padding: 32px 28px;
    border-radius: var(--radio-grande, 28px);
    border: 1.5px solid #d8e4f3;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .paso-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .paso-circulo-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--azul-900, #004aad);
    color: #ffffff;
    font-family: var(--font-titulos);
    font-size: 1.35rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .paso-fase-etiqueta {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tinta-3, #63738e);
  }

  .paso-titulo {
    font-size: 1.25rem;
    color: var(--tinta, #0f2346);
    line-height: 1.3;
    font-weight: 700;
  }

  .paso-desc {
    font-size: 0.925rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
  }

  /* Caja de compromisos */
  .compromisos-caja {
    padding: 36px 32px;
    background: #f8fbff;
    border: 1.5px solid #d0deef;
    border-radius: var(--radio-grande, 28px);
  }

  .compromisos-intro {
    text-align: center;
    margin-bottom: 32px;
  }

  .compromisos-tit {
    font-size: 1.5rem;
    color: var(--tinta, #0f2346);
    font-weight: 800;
    margin-top: 10px;
  }

  .compromisos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 36px;
    margin-bottom: 36px;
  }

  .compromiso-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .compromiso-check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--verde-fondo, #ecfdf3);
    color: var(--verde-ok, #067647);
    border: 1px solid var(--verde-borde, #abefc6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .compromiso-item-tit {
    font-size: 1rem;
    font-weight: 700;
    color: var(--tinta, #0f2346);
    margin-bottom: 4px;
  }

  .compromiso-item-desc {
    font-size: 0.88rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.5;
  }

  .compromisos-cta-fila {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--linea, #d6e0ee);
    flex-wrap: wrap;
  }

  @media (max-width: 980px) {
    .pasos-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .compromisos-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .compromisos-caja {
      padding: 24px 20px;
    }

    .compromisos-cta-fila {
      flex-direction: column;
      width: 100%;
    }

    .compromisos-cta-fila .boton {
      width: 100%;
    }
  }
</style>
