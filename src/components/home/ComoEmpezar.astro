---
import { site } from "../../data/site";
import consultorImg from "../../imagenes/consultor-emax.jpg";

const pasos = [
  {
    num: "1",
    titulo: "Nos dices cuánto paga tu empresa al mes.",
    desc: "Con una cifra aproximada nos basta.",
  },
  {
    num: "2",
    titulo: "Un consultor te llama en la franja que elijas, con tu informe delante.",
    desc: "Te llamamos para explicarte lo que hemos visto, no para leerte una oferta.",
  },
  {
    num: "3",
    titulo: "Decides tú, con la propuesta delante.",
    desc: "Te enseñamos los números con total claridad antes de pedirte que cambies.",
  },
];

const compromisos = [
  {
    num: "01",
    icono: "doc-search",
    titulo: "Primero, el informe.",
    desc: "Leemos tu consumo, tu potencia y tu reactiva antes de hablar de tarifa.",
  },
  {
    num: "02",
    icono: "pen",
    titulo: "Por escrito.",
    desc: "Te mandamos el informe y te lo quedas, decidas lo que decidas.",
  },
  {
    num: "03",
    icono: "chart-bars",
    titulo: "Si no compensa, te lo decimos.",
    desc: "Si tu contrato actual ya encaja con cómo consume tu empresa, el informe te lo dice en lugar de proponerte otra tarifa.",
  },
  {
    num: "04",
    icono: "doc-lock",
    titulo: "Sin tu firma no cambia nada.",
    desc: "Pedir el análisis no toca tu contrato ni te cambia de compañía.",
  },
];
---

<section class="proceso-seccion" id="como-funciona">
  <div class="contenedor">
    <!-- BLOQUE 1: PROCESO EN 3 PASOS CON LÍNEA DINÁMICA -->
    <header class="proceso-cabecera">
      <span class="proceso-kicker">¿CÓMO CAMBIARTE?</span>
      <h2 class="proceso-titulo">
        TÚ HACES TRES COSAS.<br />
        DEL <span class="proceso-titulo-cursiva">nos encargamos.</span>
      </h2>
    </header>

    <div class="timeline-widget" data-timeline-widget>
      <!-- Línea conectora horizontal con gradiente dinámico, nodo luminoso y botón final tipo píldora -->
      <div class="timeline-track" aria-hidden="true">
        <div class="timeline-base-line"></div>
        <div class="timeline-fill-line" data-timeline-fill></div>
        <div class="timeline-glow-cursor" data-timeline-cursor></div>
      </div>

      <!-- Botón final al extremo derecho de la línea -->
      <div class="timeline-btn-final-wrap">
        <button
          type="button"
          class="btn-timeline-final"
          data-btn-probar
          data-abrir-funnel
          data-tramo-id="general"
          data-tramo-label="Probar gratis"
          data-tramo-rango="Auditoría energética gratuita"
          data-tramo-msg="Analizamos tu factura técnica sin compromiso y te explicamos cómo optimizar tu potencia y periodos."
        >
          <span>Probar</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>

      <!-- Los 3 pasos -->
      <div class="pasos-row">
        {
          pasos.map((paso, idx) => (
            <button
              type="button"
              class={`paso-col ${idx === 0 ? "active" : ""}`}
              data-step-btn={idx}
              aria-label={`Paso ${paso.num}: ${paso.titulo}`}
            >
              <div class="paso-circulo-wrap">
                <span class="paso-circulo-num">{paso.num}</span>
                <span class="paso-circulo-glow" aria-hidden="true"></span>
              </div>
              <div class="paso-textos">
                <h3 class="paso-titulo">{paso.titulo}</h3>
                <p class="paso-desc">{paso.desc}</p>
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- BLOQUE 2: COMPROMISOS Y GARANTÍAS (A PANTALLA COMPLETA DE BORDE A BORDE) -->
<section class="compromisos-seccion" id="transparencia">
  <!-- Círculo decorativo en la esquina superior derecha con imagen del consultor -->
  <div class="compromisos-circulo-decor" aria-hidden="true">
    <img
      src={consultorImg.src}
      alt="Consultor energético de EMAX"
      class="compromisos-circulo-img"
      loading="lazy"
    />
    <div class="compromisos-circulo-overlay"></div>
  </div>

  <div class="compromisos-contenedor">
    <header class="compromisos-cabecera">
      <div class="compromisos-kicker">
        <span>TRANSPARENCIA REAL</span>
        <span class="compromisos-kicker-bar" aria-hidden="true">|</span>
      </div>
      <h3 class="compromisos-tit-principal">
        NO TE PROMETEMOS<br />
        AHORRO ANTES DE <span class="compromisos-tit-cursiva">leer</span><br />
        <span class="compromisos-tit-cursiva">tu factura.</span>
      </h3>
      <p class="compromisos-sub-principal">
        Te enseñamos los números antes de pedirte que cambies.
      </p>
    </header>

    <div class="compromisos-grid-cuatro">
      {
        compromisos.map((c) => (
          <article class="compromiso-card">
            <div class="compromiso-badge-wrap">
              <div class="compromiso-badge-icon" aria-hidden="true">
                {c.icono === "doc-search" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <circle cx="11.5" cy="14.5" r="2.8" />
                    <line x1="13.5" y1="16.5" x2="16" y2="19" />
                  </svg>
                )}
                {c.icono === "pen" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
                  </svg>
                )}
                {c.icono === "chart-bars" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="6" y1="20" x2="6" y2="15" />
                    <line x1="12" y1="20" x2="12" y2="9" />
                    <line x1="18" y1="20" x2="18" y2="4" />
                  </svg>
                )}
                {c.icono === "doc-lock" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <rect x="9" y="13" width="6" height="5" rx="1" />
                    <path d="M10.5 13v-1.8a1.5 1.5 0 0 1 3 0V13" />
                  </svg>
                )}
              </div>
              <span class="compromiso-badge-num">{c.num}</span>
            </div>

            <h4 class="compromiso-card-tit">{c.titulo}</h4>
            <p class="compromiso-card-desc">{c.desc}</p>
          </article>
        ))
      }
    </div>

    <footer class="compromisos-cta-footer">
      <a href="/#estudio" class="boton-cta-analizar">
        <span>Analizar mi factura</span>
        <span class="cta-arrow-circle" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </span>
      </a>
      <span class="cta-tel-texto">
        o llámanos al <a href={site.phoneHref} class="cta-tel-link">{site.phone}</a>
      </span>
    </footer>
  </div>
</section>

<script>
  // Bloqueo suave estilo Satia: la página se detiene en la sección y el scroll
  // hace avanzar la línea 1 → 2 → 3 → Probar. Al terminar, la página sigue bajando.
  function setupScrollLockTimeline() {
    const section = document.getElementById("como-funciona");
    const widget = document.querySelector<HTMLElement>("[data-timeline-widget]");
    if (!section || !widget) return;
    if (section.dataset.lockInit === "1") return;
    section.dataset.lockInit = "1";

    const fillLine = widget.querySelector<HTMLElement>("[data-timeline-fill]");
    const cursor = widget.querySelector<HTMLElement>("[data-timeline-cursor]");
    const buttons = Array.from(widget.querySelectorAll<HTMLButtonElement>("[data-step-btn]"));
    const btnProbar = widget.querySelector<HTMLButtonElement>("[data-btn-probar]");

    const TOP_BAR_H = 76; // altura de la barra superior fija
    const SPEED = 520; // px de rueda necesarios para recorrer toda la línea
    const COOLDOWN = 520; // ms que se absorbe la inercia al terminar/volver al inicio

    let target = 0; // progreso objetivo (0..1)
    let current = 0; // progreso pintado (se interpola suavemente)
    let lineRaf = 0;
    let glideRaf = 0;
    let isGliding = false;
    let cooldownUntil = 0;
    let lastOff = Infinity;

    const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
    const isDesktop = () => window.innerWidth > 900;
    const offset = () => section.getBoundingClientRect().top - TOP_BAR_H;
    const jumpTo = (y: number) => window.scrollTo({ top: y, behavior: "instant" as ScrollBehavior });

    function renderUI(p: number) {
      const pct = (p * 100).toFixed(2);
      if (fillLine) fillLine.style.width = `${pct}%`;
      if (cursor) {
        cursor.style.left = `${pct}%`;
        cursor.style.opacity = p > 0.01 ? "1" : "0.3";
      }

      const thresholds = [0.0, 0.38, 0.74];
      buttons.forEach((btn, i) => {
        btn.classList.toggle("active", p >= thresholds[i]);
        const isCurrent =
          (i === 0 && p < 0.38) ||
          (i === 1 && p >= 0.38 && p < 0.74) ||
          (i === 2 && p >= 0.74 && p < 0.94);
        btn.classList.toggle("current", isCurrent);
      });

      if (btnProbar) btnProbar.classList.toggle("active", p >= 0.94);
    }

    // Interpolación suave de la línea (sin saltos entre impulsos de rueda)
    function lineTick() {
      current += (target - current) * 0.12;
      if (Math.abs(target - current) < 0.0015) current = target;
      renderUI(current);
      lineRaf = current !== target ? requestAnimationFrame(lineTick) : 0;
    }

    function setTarget(v: number, immediate = false) {
      target = clamp01(v);
      if (immediate) {
        current = target;
        renderUI(current);
        return;
      }
      if (!lineRaf) lineRaf = requestAnimationFrame(lineTick);
    }

    // Desliza la página con ease-out hasta dejar la sección justo bajo la barra
    function glideToPin(duration = 380) {
      cancelAnimationFrame(glideRaf);
      const startY = window.scrollY;
      const dist = offset();
      if (Math.abs(dist) < 1) return;
      const t0 = performance.now();
      isGliding = true;
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        jumpTo(startY + dist * eased);
        if (t < 1) {
          glideRaf = requestAnimationFrame(step);
        } else {
          isGliding = false;
        }
      };
      glideRaf = requestAnimationFrame(step);
    }

    // Lógica común para rueda y touch. Devuelve true si se consume el gesto.
    function consume(d: number): boolean {
      if (!isDesktop() || !d) return false;
      const now = performance.now();
      const off = offset();
      const pinned = Math.abs(off) <= 2;

      // Mientras se desliza hasta la posición, el gesto alimenta la línea
      if (isGliding) {
        if ((d > 0 && target < 1) || (d < 0 && target > 0)) setTarget(target + d / SPEED);
        return true;
      }

      // Absorber la inercia del trackpad justo al terminar
      if (now < cooldownUntil) return true;

      if (d > 0 && target < 1) {
        if (pinned) {
          setTarget(target + d / SPEED);
          if (target >= 1) cooldownUntil = now + COOLDOWN;
          return true;
        }
        // Este impulso cruzaría la posición: frenamos suavemente en ella
        if (off > 0 && off <= d + 6) {
          glideToPin(Math.min(420, 180 + off * 2));
          return true;
        }
      }

      if (d < 0 && target > 0) {
        if (pinned) {
          setTarget(target + d / SPEED);
          if (target <= 0) cooldownUntil = now + COOLDOWN;
          return true;
        }
        if (off < 0 && off >= d - 6) {
          glideToPin(Math.min(420, 180 + Math.abs(off) * 2));
          return true;
        }
      }

      return false;
    }

    function normDelta(e: WheelEvent) {
      if (e.deltaMode === 1) return e.deltaY * 16;
      if (e.deltaMode === 2) return e.deltaY * window.innerHeight;
      return e.deltaY;
    }

    window.addEventListener(
      "wheel",
      (e) => {
        if (consume(normDelta(e))) e.preventDefault();
      },
      { passive: false }
    );

    let lastTouchY = 0;
    window.addEventListener(
      "touchstart",
      (e) => {
        if (e.touches.length === 1) lastTouchY = e.touches[0].clientY;
      },
      { passive: true }
    );
    window.addEventListener(
      "touchmove",
      (e) => {
        if (e.touches.length !== 1) return;
        const y = e.touches[0].clientY;
        const d = lastTouchY - y;
        lastTouchY = y;
        if (consume(d * 1.4)) e.preventDefault();
      },
      { passive: false }
    );

    // Red de seguridad: si la inercia nativa se pasa un poco de la posición,
    // la corregimos en el mismo frame (imperceptible). Si se salta la sección
    // entera (barra de scroll, teclado, enlace), sincronizamos el estado.
    window.addEventListener(
      "scroll",
      () => {
        const off = offset();
        if (isDesktop() && !isGliding) {
          if (target < 1 && lastOff > 2 && off < 2 && off > -160) {
            jumpTo(window.scrollY + off);
            lastOff = 0;
            return;
          }
          if (target > 0 && lastOff < -2 && off > -2 && off < 160) {
            jumpTo(window.scrollY + off);
            lastOff = 0;
            return;
          }
        }
        const rect = section.getBoundingClientRect();
        if (rect.bottom < TOP_BAR_H && target < 1) setTarget(1, true);
        else if (rect.top > window.innerHeight && target > 0) setTarget(0, true);
        lastOff = off;
      },
      { passive: true }
    );

    // Clics directos en los pasos
    buttons.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        setTarget(idx === 0 ? 0 : idx === 1 ? 0.42 : 0.82);
      });
    });

    if (btnProbar) {
      btnProbar.addEventListener("click", () => setTarget(1));
    }

    // Estado inicial según la posición de carga
    const r = section.getBoundingClientRect();
    setTarget(r.bottom < TOP_BAR_H ? 1 : 0, true);
    lastOff = offset();
  }

  // Inicializar al cargar y en cambios de página de Astro
  setupScrollLockTimeline();
  document.addEventListener("astro:page-load", setupScrollLockTimeline);
</script>

<style>
  /* ==========================================================================
     SECCIÓN COMPACTA SIN ESPACIO VACÍO:
     La pantalla interactúa limpiamente con los pasos 1, 2, 3 hasta Probar
     ========================================================================== */
  .proceso-seccion {
    padding: clamp(48px, 5.5vw, 64px) 0 clamp(40px, 4.5vw, 52px);
    background: #e4e7ec;
    border-top: 1px solid #d5d9e0;
    position: relative;
  }

  .contenedor {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 40px);
  }

  /* Encabezado centrado idéntico al boceto */
  .proceso-cabecera {
    margin-bottom: clamp(40px, 5vw, 52px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .proceso-kicker {
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 0.70rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5b6678;
    padding-right: 8px;
    border-right: 3px solid #38b6ff;
  }

  .proceso-titulo {
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    color: #0f2346;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .proceso-titulo-cursiva {
    font-family: var(--font-titulos, "Merriweather", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #004aad;
    font-size: 1.15em;
  }

  /* ==========================================================================
     TIMELINE WIDGET CON LÍNEA DINÁMICA (ESTILO SATIA)
     ========================================================================== */
  .timeline-widget {
    position: relative;
    margin-bottom: 0;
  }

  /* Pista de la línea horizontal */
  .timeline-track {
    position: absolute;
    top: 24px; /* Centrado con el círculo de 48px */
    left: 24px;
    right: 32px;
    height: 3px;
    z-index: 1;
    pointer-events: none;
  }

  /* Botón píldora interactivo al final de la línea: colorido, llamativo y bien separado */
  .timeline-btn-final-wrap {
    position: absolute;
    top: 24px;
    right: -48px; /* Más separado para no invadir el paso 3 */
    transform: translateY(-50%);
    z-index: 4;
  }

  .btn-timeline-final {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #004aad;
    color: #ffffff;
    border: 1.5px solid rgba(56, 182, 255, 0.45);
    border-radius: 9999px;
    padding: 8px 20px;
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0, 74, 173, 0.38), 0 0 12px rgba(56, 182, 255, 0.25);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-timeline-final:hover,
  .btn-timeline-final.active {
    background: #003a88;
    border-color: #38b6ff;
    box-shadow: 0 0 0 3px rgba(56, 182, 255, 0.4), 0 8px 26px rgba(0, 74, 173, 0.55), 0 0 18px rgba(56, 182, 255, 0.4);
    transform: translateY(-2px) scale(1.05);
  }

  .btn-timeline-final svg {
    color: #38b6ff;
    transition: transform 0.2s ease;
  }

  .btn-timeline-final:hover svg,
  .btn-timeline-final.active svg {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .timeline-btn-final-wrap {
      display: none;
    }
  }

  /* Línea base gris apagada */
  .timeline-base-line {
    position: absolute;
    inset: 0;
    background: #d8e4f3;
    border-radius: 99px;
  }

  /* Línea de relleno que cambia de color dinámicamente con gradiente */
  .timeline-fill-line {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #004aad 0%, #19a9f0 50%, #12b76a 100%);
    border-radius: 99px;
    will-change: width;
    box-shadow: 0 0 14px rgba(25, 169, 240, 0.5);
  }

  /* Nodo cursor neón que viaja en la punta de la línea */
  .timeline-glow-cursor {
    position: absolute;
    top: 50%;
    left: 0%;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(25, 169, 240, 0.5),
                0 0 16px 4px rgba(25, 169, 240, 0.85);
    transition: opacity 0.2s ease;
    will-change: left;
    z-index: 2;
  }

  /* Fila de los 3 pasos */
  .pasos-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 48px);
    position: relative;
    z-index: 3;
  }

  /* Botón interactivo por paso */
  .paso-col {
    background: transparent;
    border: none;
    padding: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.2s ease;
  }

  .paso-col:hover {
    transform: translateY(-2px);
  }

  /* Círculo numérico con estados originales dinámicos */
  .paso-circulo-wrap {
    position: relative;
    margin-bottom: 22px;
  }

  .paso-circulo-num {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #c2d3ea;
    color: #63738e;
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .paso-circulo-glow {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.45s ease, transform 0.45s ease;
    z-index: 1;
    transform: scale(0.8);
  }

  /* Estados activos por paso: Colores diferenciados originales */
  /* Paso 1: Azul Real EMAX */
  .paso-col[data-step-btn="0"].active .paso-circulo-num {
    background: #004aad;
    border-color: #004aad;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 74, 173, 0.35);
  }
  .paso-col[data-step-btn="0"].current .paso-circulo-glow {
    opacity: 1;
    background: radial-gradient(circle, rgba(0, 74, 173, 0.25) 0%, transparent 70%);
    transform: scale(1.25);
  }

  /* Paso 2: Cian Eléctrico */
  .paso-col[data-step-btn="1"].active .paso-circulo-num {
    background: #19a9f0;
    border-color: #19a9f0;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(25, 169, 240, 0.45);
  }
  .paso-col[data-step-btn="1"].current .paso-circulo-glow {
    opacity: 1;
    background: radial-gradient(circle, rgba(25, 169, 240, 0.3) 0%, transparent 70%);
