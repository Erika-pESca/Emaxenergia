---
import { site } from "../../data/site";
import consultorImg from "../../imagenes/consultor-emax.jpg";

const pasos = [
  {
    num: "1",
    titulo: "Nos dices cuánto paga tu empresa al mes.",
    desc: "Con una cifra aproximada nos basta.",
  },
  {
    num: "2",
    titulo: "Un consultor te llama en la franja que elijas, con tu informe delante.",
    desc: "Te llamamos para explicarte lo que hemos visto, no para leerte una oferta.",
  },
  {
    num: "3",
    titulo: "Decides tú, con la propuesta delante.",
    desc: "Te enseñamos los números con total claridad antes de pedirte que cambies.",
  },
];

const compromisos = [
  {
    num: "01",
    icono: "doc-search",
    titulo: "Primero, el informe.",
    desc: "Leemos tu consumo, tu potencia y tu reactiva antes de hablar de tarifa.",
  },
  {
    num: "02",
    icono: "pen",
    titulo: "Por escrito.",
    desc: "Te mandamos el informe y te lo quedas, decidas lo que decidas.",
  },
  {
    num: "03",
    icono: "chart-bars",
    titulo: "Si no compensa, te lo decimos.",
    desc: "Si tu contrato actual ya encaja con cómo consume tu empresa, el informe te lo dice en lugar de proponerte otra tarifa.",
  },
  {
    num: "04",
    icono: "doc-lock",
    titulo: "Sin tu firma no cambia nada.",
    desc: "Pedir el análisis no toca tu contrato ni te cambia de compañía.",
  },
];
---

<section class="proceso-seccion" id="como-funciona">
  <div class="contenedor">
    <!-- BLOQUE 1: PROCESO EN 3 PASOS CON LÍNEA DINÁMICA -->
    <header class="proceso-cabecera">
      <span class="proceso-kicker">¿CÓMO CAMBIARTE?</span>
      <h2 class="proceso-titulo">
        TÚ HACES TRES COSAS.<br />
        DEL <span class="proceso-titulo-cursiva">nos encargamos.</span>
      </h2>
    </header>

    <div class="timeline-widget" data-timeline-widget>
      <!-- Línea conectora horizontal con gradiente dinámico, nodo luminoso y botón final tipo píldora -->
      <div class="timeline-track" aria-hidden="true">
        <div class="timeline-base-line"></div>
        <div class="timeline-fill-line" data-timeline-fill></div>
        <div class="timeline-glow-cursor" data-timeline-cursor></div>
      </div>

      <!-- Botón final al extremo derecho de la línea -->
      <div class="timeline-btn-final-wrap">
        <button
          type="button"
          class="btn-timeline-final"
          data-abrir-funnel
          data-tramo-id="general"
          data-tramo-label="Probar gratis"
          data-tramo-rango="Auditoría energética gratuita"
          data-tramo-msg="Analizamos tu factura técnica sin compromiso y te explicamos cómo optimizar tu potencia y periodos."
        >
          <span>Probar</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>

      <!-- Los 3 pasos -->
      <div class="pasos-row">
        {
          pasos.map((paso, idx) => (
            <button
              type="button"
              class={`paso-col ${idx === 0 ? "active" : ""}`}
              data-step-btn={idx}
              aria-label={`Paso ${paso.num}: ${paso.titulo}`}
            >
              <div class="paso-circulo-wrap">
                <span class="paso-circulo-num">{paso.num}</span>
                <span class="paso-circulo-glow" aria-hidden="true"></span>
              </div>
              <div class="paso-textos">
                <h3 class="paso-titulo">{paso.titulo}</h3>
                <p class="paso-desc">{paso.desc}</p>
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- BLOQUE 2: COMPROMISOS Y GARANTÍAS (A PANTALLA COMPLETA DE BORDE A BORDE) -->
<section class="compromisos-seccion" id="transparencia">
  <!-- Círculo decorativo en la esquina superior derecha con imagen del consultor -->
  <div class="compromisos-circulo-decor" aria-hidden="true">
    <img
      src={consultorImg.src}
      alt="Consultor energético de EMAX"
      class="compromisos-circulo-img"
      loading="lazy"
    />
    <div class="compromisos-circulo-overlay"></div>
  </div>

  <div class="compromisos-contenedor">
    <header class="compromisos-cabecera">
      <div class="compromisos-kicker">
        <span>TRANSPARENCIA REAL</span>
        <span class="compromisos-kicker-bar" aria-hidden="true">|</span>
      </div>
      <h3 class="compromisos-tit-principal">
        NO TE PROMETEMOS<br />
        AHORRO ANTES DE <span class="compromisos-tit-cursiva">leer</span><br />
        <span class="compromisos-tit-cursiva">tu factura.</span>
      </h3>
      <p class="compromisos-sub-principal">
        Te enseñamos los números antes de pedirte que cambies.
      </p>
    </header>

    <div class="compromisos-grid-cuatro">
      {
        compromisos.map((c) => (
          <article class="compromiso-card">
            <div class="compromiso-badge-wrap">
              <div class="compromiso-badge-icon" aria-hidden="true">
                {c.icono === "doc-search" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <circle cx="11.5" cy="14.5" r="2.8" />
                    <line x1="13.5" y1="16.5" x2="16" y2="19" />
                  </svg>
                )}
                {c.icono === "pen" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
                  </svg>
                )}
                {c.icono === "chart-bars" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="6" y1="20" x2="6" y2="15" />
                    <line x1="12" y1="20" x2="12" y2="9" />
                    <line x1="18" y1="20" x2="18" y2="4" />
                  </svg>
                )}
                {c.icono === "doc-lock" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <rect x="9" y="13" width="6" height="5" rx="1" />
                    <path d="M10.5 13v-1.8a1.5 1.5 0 0 1 3 0V13" />
                  </svg>
                )}
              </div>
              <span class="compromiso-badge-num">{c.num}</span>
            </div>

            <h4 class="compromiso-card-tit">{c.titulo}</h4>
            <p class="compromiso-card-desc">{c.desc}</p>
          </article>
        ))
      }
    </div>

    <footer class="compromisos-cta-footer">
      <a href="/#estudio" class="boton-cta-analizar">
        <span>Analizar mi factura</span>
        <span class="cta-arrow-circle" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </span>
      </a>
      <span class="cta-tel-texto">
        o llámanos al <a href={site.phoneHref} class="cta-tel-link">{site.phone}</a>
      </span>
    </footer>
  </div>
</section>

<script>
  // Control en tiempo real: la línea avanza al bajar y retrocede al subir con el scroll
  function setupScrollTimeline() {
    const widget = document.querySelector<HTMLElement>("[data-timeline-widget]");
    if (!widget) return;

    const fillLine = widget.querySelector<HTMLElement>("[data-timeline-fill]");
    const cursor = widget.querySelector<HTMLElement>("[data-timeline-cursor]");
    const buttons = Array.from(widget.querySelectorAll<HTMLButtonElement>("[data-step-btn]"));

    let isTicking = false;

    function onScrollUpdate() {
      const rect = widget.getBoundingClientRect();
      const vh = window.innerHeight;

      // Rango de activación proporcional dentro de la vista:
      // Empieza cuando el widget entra por el 78% inferior de la pantalla
      // Llega al 100% cuando el widget alcanza el 26% superior
      const startY = vh * 0.78;
      const endY = vh * 0.26;

      const rawP = (startY - rect.top) / (startY - endY);
      const p = Math.max(0, Math.min(1, rawP));

      const pct = (p * 100).toFixed(2);

      // Ancho de la línea y posición del cursor en tiempo real (avanza y retrocede)
      if (fillLine) {
        fillLine.style.width = `${pct}%`;
      }
      if (cursor) {
        cursor.style.left = `${pct}%`;
        cursor.style.opacity = p > 0.02 ? "1" : "0.3";
      }

      // Umbrales para activar cada paso dinámicamente:
      // Paso 1: activo desde el principio
      // Paso 2: activo al llegar a la mitad (~46%)
      // Paso 3: activo al llegar al final (~92%)
      const thresholds = [0.02, 0.46, 0.92];
      buttons.forEach((btn, i) => {
        const isReached = p >= thresholds[i];
        btn.classList.toggle("active", isReached);

        const isCurrent =
          (i === 0 && p < 0.46) ||
          (i === 1 && p >= 0.46 && p < 0.92) ||
          (i === 2 && p >= 0.92);
        btn.classList.toggle("current", isCurrent);
      });
    }

    function requestTick() {
      if (!isTicking) {
        isTicking = true;
        requestAnimationFrame(() => {
          onScrollUpdate();
          isTicking = false;
        });
      }
    }

    // Permitir clic en un paso para navegar suavemente a esa altura
    buttons.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        const vh = window.innerHeight;
        const startY = vh * 0.78;
        const endY = vh * 0.26;
        const targetP = idx === 0 ? 0.05 : idx === 1 ? 0.52 : 0.98;

        const currentRectTop = widget.getBoundingClientRect().top;
        const desiredRectTop = startY - targetP * (startY - endY);
        const delta = currentRectTop - desiredRectTop;

        window.scrollBy({
          top: delta,
          behavior: "smooth",
        });
      });
    });

    window.addEventListener("scroll", requestTick, { passive: true });
    window.addEventListener("resize", requestTick, { passive: true });

    onScrollUpdate();
  }

  // Inicializar al cargar y en cambios de página de Astro
  setupScrollTimeline();
  document.addEventListener("astro:page-load", setupScrollTimeline);
</script>

<style>
  /* ==========================================================================
     SECCIÓN PRINCIPAL: COMPACTA, ELEGANTE Y PROPORCIONADA
     ========================================================================== */
  .proceso-seccion {
    padding: clamp(56px, 7vw, 84px) 0 clamp(64px, 8vw, 92px);
    background: #e4e7ec;
    border-top: 1px solid #d5d9e0;
    border-bottom: 1px solid #d5d9e0;
  }

  .contenedor {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 40px);
  }

  /* Encabezado centrado idéntico al boceto */
  .proceso-cabecera {
    margin-bottom: clamp(44px, 6vw, 60px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .proceso-kicker {
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 0.70rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5b6678;
    padding-right: 8px;
    border-right: 3px solid #38b6ff;
  }

  .proceso-titulo {
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    color: #0f2346;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .proceso-titulo-cursiva {
    font-family: var(--font-titulos, "Merriweather", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #004aad;
    font-size: 1.15em;
  }

  /* ==========================================================================
     TIMELINE WIDGET CON LÍNEA DINÁMICA (ESTILO SATIA)
     ========================================================================== */
  .timeline-widget {
    position: relative;
    margin-bottom: clamp(48px, 6vw, 64px);
  }

  /* Pista de la línea horizontal */
  .timeline-track {
    position: absolute;
    top: 24px; /* Centrado con el círculo de 48px */
    left: 24px;
    right: 32px;
    height: 3px;
    z-index: 1;
    pointer-events: none;
  }

  /* Botón píldora interactivo al final de la línea: colorido, llamativo y bien separado */
  .timeline-btn-final-wrap {
    position: absolute;
    top: 24px;
    right: -48px; /* Más separado para no invadir el paso 3 */
    transform: translateY(-50%);
    z-index: 4;
  }

  .btn-timeline-final {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #004aad;
    color: #ffffff;
    border: 1.5px solid rgba(56, 182, 255, 0.45);
    border-radius: 9999px;
    padding: 8px 20px;
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0, 74, 173, 0.38), 0 0 12px rgba(56, 182, 255, 0.25);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-timeline-final:hover {
    background: #003a88;
    border-color: #38b6ff;
    box-shadow: 0 8px 26px rgba(0, 74, 173, 0.55), 0 0 18px rgba(56, 182, 255, 0.4);
    transform: translateY(-2px) scale(1.04);
  }

  .btn-timeline-final svg {
    color: #38b6ff;
    transition: transform 0.2s ease;
  }

  .btn-timeline-final:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .timeline-btn-final-wrap {
      display: none;
    }
  }

  /* Línea base gris apagada */
  .timeline-base-line {
    position: absolute;
    inset: 0;
    background: #d8e4f3;
    border-radius: 99px;
  }

  /* Línea de relleno que cambia de color dinámicamente con gradiente */
  .timeline-fill-line {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #004aad 0%, #19a9f0 50%, #12b76a 100%);
    border-radius: 99px;
    transition: width 0.1s ease-out;
    box-shadow: 0 0 14px rgba(25, 169, 240, 0.5);
  }

  /* Nodo cursor neón que viaja en la punta de la línea */
  .timeline-glow-cursor {
    position: absolute;
    top: 50%;
    left: 0%;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(25, 169, 240, 0.5),
                0 0 16px 4px rgba(25, 169, 240, 0.85);
    transition: left 0.1s ease-out, opacity 0.2s ease;
    z-index: 2;
  }

  /* Fila de los 3 pasos */
  .pasos-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 48px);
    position: relative;
    z-index: 3;
  }

  /* Botón interactivo por paso */
  .paso-col {
    background: transparent;
    border: none;
    padding: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.2s ease;
  }

  .paso-col:hover {
    transform: translateY(-2px);
  }

  /* Círculo numérico con estados originales dinámicos */
  .paso-circulo-wrap {
    position: relative;
    margin-bottom: 22px;
  }

  .paso-circulo-num {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #c2d3ea;
    color: #63738e;
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .paso-circulo-glow {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.45s ease, transform 0.45s ease;
    z-index: 1;
    transform: scale(0.8);
  }

  /* Estados activos por paso: Colores diferenciados originales */
  /* Paso 1: Azul Real EMAX */
  .paso-col[data-step-btn="0"].active .paso-circulo-num {
    background: #004aad;
    border-color: #004aad;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 74, 173, 0.35);
  }
  .paso-col[data-step-btn="0"].current .paso-circulo-glow {
    opacity: 1;
    background: radial-gradient(circle, rgba(0, 74, 173, 0.25) 0%, transparent 70%);
    transform: scale(1.25);
  }

  /* Paso 2: Cian Eléctrico */
  .paso-col[data-step-btn="1"].active .paso-circulo-num {
    background: #19a9f0;
    border-color: #19a9f0;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(25, 169, 240, 0.45);
  }
  .paso-col[data-step-btn="1"].current .paso-circulo-glow {
    opacity: 1;
    background: radial-gradient(circle, rgba(25, 169, 240, 0.3) 0%, transparent 70%);
    transform: scale(1.25);
  }

  /* Paso 3: Verde Éxito */
  .paso-col[data-step-btn="2"].active .paso-circulo-num {
    background: #12b76a;
    border-color: #12b76a;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(18, 183, 106, 0.45);
  }
  .paso-col[data-step-btn="2"].current .paso-circulo-glow {
    opacity: 1;
    background: radial-gradient(circle, rgba(18, 183, 106, 0.3) 0%, transparent 70%);
    transform: scale(1.25);
  }

  /* Textos de los pasos con animación dinámica: tenue/clarito si no está activo, nítido y claro cuando se activa */
  .paso-textos {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    opacity: 0.35;
    transform: translateY(4px);
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .paso-col.active .paso-textos,
  .paso-col:hover .paso-textos {
    opacity: 1;
    transform: translateY(0);
  }

  .paso-titulo {
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    color: #0f2346;
    line-height: 1.38;
    font-weight: 700;
    letter-spacing: 0.01em;
    margin: 0 0 8px;
    max-width: 28ch;
    transition: color 0.35s ease;
  }

  .paso-col.active .paso-titulo {
    color: #004aad;
  }

  .paso-desc {
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: #475569;
    line-height: 1.5;
    margin: 0;
    max-width: 28ch;
  }

  /* ==========================================================================
     BLOQUE 2: COMPROMISOS Y GARANTÍAS (SECCIÓN COMPLETA DE BORDE A BORDE)
     ========================================================================== */
  .compromisos-seccion {
    position: relative;
    width: 100%;
    min-height: 100vh; /* Ocupa toda la pantalla */
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #081d3e; /* Fondo azul oscuro corporativo de borde a borde */
    padding: clamp(64px, 8vh, 100px) 0;
    overflow: hidden;
    box-sizing: border-box;
  }

  .compromisos-contenedor {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: clamp(24px, 5vw, 64px);
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Círculo decorativo en la esquina superior derecha con imagen del consultor */
  .compromisos-circulo-decor {
    position: absolute;
    top: -40px;
    right: -30px;
    width: clamp(380px, 42vw, 620px);
    height: clamp(380px, 42vw, 620px);
    border-radius: 50%;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
    background: #d4dbe4;
  }

  .compromisos-circulo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 10%;
    display: block;
  }

  .compromisos-circulo-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 60% 35%,
      rgba(8, 29, 62, 0.08) 0%,
      rgba(8, 29, 62, 0.35) 75%,
      rgba(8, 29, 62, 0.68) 100%
    );
  }

  /* Encabezado del bloque */
  .compromisos-cabecera {
    position: relative;
    z-index: 2;
    max-width: 680px;
    margin-bottom: clamp(48px, 6vw, 68px);
  }

  .compromisos-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display, "Sora", sans-serif);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6da2db;
    margin-bottom: 14px;
  }

  .compromisos-kicker-bar {
    color: #38b6ff;
    font-size: 1.15em;
    font-weight: 800;
  }

  .compromisos-tit-principal {
    font-family: var(--font-display, "Sora", sans-serif);
