---
// Componente: "¿CÓMO QUIERES EMPEZAR?"
// Sección de conversión y puntos de entrada a la experiencia EMAX.
//
// 1. Título Baloo 2 en mayúsculas blancas: "¿CÓMO QUIERES EMPEZAR?".
// 2. Tres tarjetas verticales glassmorphic de alta tecnología:
//    - "QUIERO LOS NÚMEROS" (Tengo una factura, CUPS o puedo empezar sin ellos.) -> [Generar mi estudio]
//    - "QUIERO HABLAR" (Prefiero explicarlo a una persona.) -> [Que me llamen]
//    - "QUIERO ESCRIBIR" (Quiero contarlo ahora.) -> [Abrir Whatsapp]
// 3. Botones tipo píldora azul luminosa con borde y resplandor cian.
// 4. Portal toroidal luminoso cian en el lateral derecho y luz ambiental azul inferior izquierda.

interface OpcionEmpezar {
  id: string;
  titulo: string;
  descripcion: string;
  botonTexto: string;
  botonHref: string;
  esExterno?: boolean;
}

const opciones: OpcionEmpezar[] = [
  {
    id: "numeros",
    titulo: "QUIERO LOS NÚMEROS",
    descripcion: "Tengo una factura, CUPS o puedo empezar sin ellos.",
    botonTexto: "Generar mi estudio",
    botonHref: "/#estudio",
  },
  {
    id: "hablar",
    titulo: "QUIERO HABLAR",
    descripcion: "Prefiero explicarlo a una persona.",
    botonTexto: "Que me llamen",
    botonHref: "/contacto",
  },
  {
    id: "escribir",
    titulo: "QUIERO ESCRIBIR",
    descripcion: "Quiero contarlo ahora.",
    botonTexto: "Abrir Whatsapp",
    botonHref: "https://wa.me/34900000000",
    esExterno: true,
  },
];
---

<section class="como-empezar" id="empezar">
  <!-- Portal toroidal de luz cian en el lateral derecho -->
  <div class="portal-luz" aria-hidden="true">
    <div class="portal-halo"></div>
    <div class="portal-circulo"></div>
  </div>

  <!-- Luces ambientales de fondo -->
  <div class="luz-ambiente luz-azul-izq" aria-hidden="true"></div>

  <div class="wrap empezar-inner">
    <!-- Encabezado superior -->
    <div class="encabezado">
      <h2 class="titulo-empezar">¿CÓMO QUIERES EMPEZAR?</h2>
    </div>

    <!-- Rejilla con las 3 tarjetas verticales -->
    <div class="rejilla-opciones">
      {
        opciones.map((item, index) => (
          <article class={`tarjeta-empezar tarjeta-${item.id}`} style={`--i: ${index};`}>
            <!-- Aura brillante de la tarjeta -->
            <div class="tarjeta-aura" aria-hidden="true"></div>
            <div class="tarjeta-borde-luz" aria-hidden="true"></div>

            <!-- Contenido de la tarjeta -->
            <div class="tarjeta-cuerpo">
              <div class="tarjeta-info">
                <h3 class="opcion-titulo">{item.titulo}</h3>
                <p class="opcion-desc">{item.descripcion}</p>
              </div>

              <div class="tarjeta-cta">
                <a
                  href={item.botonHref}
                  target={item.esExterno ? "_blank" : undefined}
                  rel={item.esExterno ? "noopener noreferrer" : undefined}
                  class="btn-opcion"
                >
                  <span>{item.botonTexto}</span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .como-empezar {
    position: relative;
    overflow: hidden;
    background: #040d1e;
    color: var(--white);
    padding: 104px 0 120px;
    scroll-margin-top: var(--header-h);
  }

  /* Portal toroidal de luz cian en el lateral derecho (donut de energía) */
  .portal-luz {
    position: absolute;
    width: 380px;
    height: 380px;
    right: clamp(10px, 5vw, 90px);
    top: 52%;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .portal-halo {
    position: absolute;
    width: 440px;
    height: 440px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      transparent 35%,
      rgba(56, 182, 255, 0.42) 60%,
      rgba(0, 102, 255, 0.22) 75%,
      transparent 85%
    );
    filter: blur(28px);
  }

  .portal-circulo {
    position: relative;
    width: 290px;
    height: 290px;
    border-radius: 50%;
    border: 42px solid rgba(56, 182, 255, 0.88);
    box-shadow:
      0 0 40px rgba(56, 182, 255, 0.95),
      0 0 90px rgba(0, 114, 255, 0.7),
      inset 0 0 32px rgba(56, 182, 255, 0.85),
      inset 0 0 65px rgba(0, 114, 255, 0.55);
    filter: blur(10px);
    animation: pulsar-portal 8s ease-in-out infinite alternate;
  }

  /* Luz ambiental inferior izquierda */
  .luz-ambiente {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .luz-azul-izq {
    width: 480px;
    height: 480px;
    left: -120px;
    bottom: -90px;
    background: radial-gradient(
      circle,
      rgba(0, 102, 255, 0.6) 0%,
      rgba(56, 182, 255, 0.3) 45%,
      transparent 70%
    );
    filter: blur(70px);
  }

  .empezar-inner {
    position: relative;
    z-index: 1;
  }

  /* Encabezado */
  .encabezado {
    max-width: 820px;
    margin-bottom: 46px;
  }

  .titulo-empezar {
    font-family: var(--display);
    font-size: clamp(2.3rem, 4vw, 3.4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0;
  }

  /* Rejilla de 3 tarjetas verticales */
  .rejilla-opciones {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 960px;
  }

  /* Tarjeta vertical */
  .tarjeta-empezar {
    position: relative;
    min-height: 380px;
    border-radius: 22px;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tarjeta-empezar:hover {
    transform: translateY(-6px);
  }

  /* Aura detrás de la tarjeta */
  .tarjeta-aura {
    position: absolute;
    inset: -3px;
    border-radius: 24px;
    background: radial-gradient(
      ellipse at top,
      rgba(56, 182, 255, 0.3) 0%,
      rgba(0, 74, 173, 0.15) 50%,
      transparent 75%
    );
    opacity: 0.35;
    filter: blur(14px);
    z-index: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .tarjeta-empezar:hover .tarjeta-aura {
    opacity: 0.85;
  }

  /* Borde fino iluminado */
  .tarjeta-borde-luz {
    position: absolute;
    inset: 0;
    border-radius: 22px;
    border: 1px solid rgba(120, 205, 255, 0.32);
    pointer-events: none;
    z-index: 2;
    transition: border-color 0.35s ease;
  }

  .tarjeta-empezar:hover .tarjeta-borde-luz {
    border-color: rgba(56, 182, 255, 0.8);
  }

  /* En la tercera tarjeta el resplandor interactúa con el portal cercano */
  .tarjeta-escribir .tarjeta-borde-luz {
    border-color: rgba(120, 205, 255, 0.6);
  }

  /* Cuerpo de la tarjeta con estilo Glassmorphic Dark Tech */
  .tarjeta-cuerpo {
    position: relative;
    z-index: 1;
    height: 100%;
    min-height: 380px;
    padding: 30px 22px 24px;
    border-radius: 22px;
    background: linear-gradient(
      180deg,
      rgba(8, 22, 48, 0.72) 0%,
      rgba(5, 14, 32, 0.9) 100%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
      0 20px 48px rgba(0, 0, 0, 0.5),
      0 0 20px rgba(56, 182, 255, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .tarjeta-escribir .tarjeta-cuerpo {
    background: linear-gradient(
      180deg,
      rgba(10, 28, 62, 0.78) 0%,
      rgba(5, 16, 38, 0.94) 100%
    );
    box-shadow:
      0 20px 48px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(56, 182, 255, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }

  /* Bloque de texto */
  .tarjeta-info {
    margin-bottom: 22px;
  }

  .opcion-titulo {
    font-family: var(--font);
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0 0 8px;
    line-height: 1.25;
  }

  .opcion-desc {
    font-family: var(--font);
    font-size: 0.84rem;
    font-weight: 400;
    line-height: 1.45;
    color: rgba(220, 235, 255, 0.76);
    margin: 0;
  }

  /* Botón inferior */
  .tarjeta-cta {
    width: 100%;
  }

  .btn-opcion {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 11px 16px;
    border-radius: 999px;
    background: linear-gradient(135deg, #002e6e 0%, #0050b8 100%);
    border: 1px solid rgba(56, 182, 255, 0.6);
    box-shadow:
      0 0 20px rgba(0, 102, 255, 0.5),
      0 0 10px rgba(56, 182, 255, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    color: #ffffff;
    font-family: var(--font);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    text-align: center;
  }

  .btn-opcion:hover {
    background: linear-gradient(135deg, #003a88 0%, #0060db 100%);
    transform: translateY(-2px);
    box-shadow:
      0 0 30px rgba(56, 182, 255, 0.75),
      0 4px 16px rgba(0, 0, 0, 0.4);
  }

  /* Animación del portal */
  @keyframes pulsar-portal {
    0% {
      transform: scale(0.96);
      opacity: 0.85;
    }
    100% {
      transform: scale(1.04);
      opacity: 1;
    }
  }

  /* Responsive */
  @media (max-width: 680px) {
    .como-empezar {
      padding: 72px 0 84px;
    }

    .rejilla-opciones {
      grid-template-columns: 1fr;
    }

    .tarjeta-empezar {
      min-height: 290px;
    }

    .tarjeta-cuerpo {
      min-height: 290px;
    }
  }
</style>
