---
// Franja de Garantías en Movimiento Continuo (Ticker / Marquee Infinito)
// Estilo idéntico a la captura: fondo menta suave, tipografía mayúscula nítida y rombo separador.
const itemsGarantia = [
  "SIN EXTRAS QUE NO PEDISTE",
  "SIN CORTES DE LUZ",
  "SIN PERMANENCIA",
  "SIN LETRA PEQUEÑA",
  "ASESOR PERSONAL ASIGNADO",
  "INFORME TÉCNICO GRATUITO",
  "SIN SUBIDAS INESPERADAS",
  "CERO PAPELEOS",
];
---

<section class="cinta-ticker-seccion" aria-label="Compromisos y garantías comerciales de EMAX">
  <div class="ticker-contenedor">
    <div class="ticker-track">
      <!-- Primer grupo -->
      <div class="ticker-grupo">
        {
          itemsGarantia.map((item) => (
            <span class="ticker-elemento">
              <span class="ticker-texto">{item}</span>
              <span class="ticker-rombo" aria-hidden="true">✦</span>
            </span>
          ))
        }
      </div>

      <!-- Segundo grupo clonado para el bucle circular infinito sin saltos -->
      <div class="ticker-grupo" aria-hidden="true">
        {
          itemsGarantia.map((item) => (
            <span class="ticker-elemento">
              <span class="ticker-texto">{item}</span>
              <span class="ticker-rombo" aria-hidden="true">✦</span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cinta-ticker-seccion {
    background: #edf4fe; /* Azul suave corporativo EMAX */
    border-top: 1px solid #d4e3f7;
    border-bottom: 1px solid #d4e3f7;
    padding: 13px 0;
    overflow: hidden;
    user-select: none;
    position: relative;
  }

  .ticker-contenedor {
    width: 100%;
    overflow: hidden;
    display: flex;
  }

  .ticker-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: circularMarquee 32s linear infinite;
  }

  .ticker-track:hover {
    animation-play-state: paused;
  }

  .ticker-grupo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .ticker-elemento {
    display: inline-flex;
    align-items: center;
  }

  .ticker-texto {
    font-family: var(--font-titulos, "Sora", sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #004aad; /* Azul principal EMAX */
    transition: color 0.15s ease;
  }

  .ticker-rombo {
    display: inline-block;
    margin: 0 32px;
    color: #38b6ff; /* Cian eléctrico EMAX */
    font-size: 0.8rem;
    line-height: 1;
  }

  /* Animación continua en bucle infinito (movimiento continuo hacia la izquierda) */
  @keyframes circularMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
      overflow-x: auto;
    }
  }

  @media (max-width: 600px) {
    .cinta-ticker-seccion {
      padding: 11px 0;
    }

    .ticker-texto {
      font-size: 0.76rem;
      letter-spacing: 0.06em;
    }

    .ticker-rombo {
      margin: 0 20px;
      font-size: 0.7rem;
    }
  }
</style>
