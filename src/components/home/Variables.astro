---
// Sección 2: "Cambiar de compañía es fácil. Saber si te conviene, no tanto."
// Comparativa comercial transparente entre los atajos del mercado y el método real de EMAX.
// Diseño limpio, humano y sin sobrecarga de animación.
const atajos = [
  "Elegir de un catálogo estándar sin ver tu curva.",
  "Aplicar la regla genérica de tu tipo de negocio.",
  "Renovar por inercia porque llega la fecha de vencimiento.",
  "Aceptar una oferta comercial antes de que nadie haya leído tu factura.",
];

const pilaresEmax = [
  {
    titulo: "Cuánto y cuándo consume tu empresa",
    desc: "Tu consumo por periodos y por meses, traducido a las horas reales de tu negocio: cuánto va a horas caras y cuánto a baratas.",
    icono: "📊",
  },
  {
    titulo: "Tu potencia contratada vs. real",
    desc: "La potencia que tienes en cada periodo frente a la que usas de verdad. Si te sobra, si te falta y si estás pagando penalizaciones por excesos.",
    icono: "⚡",
  },
  {
    titulo: "Tu energía reactiva",
    desc: "Si la pagas en factura, en qué periodos ocurre, cuánto te cuesta al año y si compensa instalar una batería de condensadores.",
    icono: "🔋",
  },
  {
    titulo: "Tu propuesta de tarifa a medida",
    desc: "La tarifa que resulta de cruzar los tres datos anteriores: estructura de precios, optimización de potencias y condiciones transparentes.",
    icono: "🎯",
  },
];
---

<section class="comparativa-seccion" id="metodo-comparativa">
  <div class="contenedor">
    <div class="seccion-cabecera">
      <span class="badge badge-azul">El problema del mercado</span>
      <h2 class="seccion-titulo">Cambiar de compañía es fácil. Saber si te conviene, no tanto.</h2>
      <p class="seccion-subtitulo">
        El precio del kWh es lo primero que se suele mirar y <strong>lo último que conviene decidir.</strong>
      </p>
    </div>

    <div class="comparativa-grid">
      <!-- Columna 1: Los atajos habituales (Mercado tradicional) -->
      <article class="tarjeta-comparativa tarjeta-atajos">
        <header class="tarjeta-cabecera">
          <span class="badge-alerta">Lo que suele pasar</span>
          <h3 class="tarjeta-tit">Los atajos habituales</h3>
          <p class="tarjeta-desc">Cómo contrata la mayoría de empresas antes de conocernos:</p>
        </header>

        <ul class="lista-atajos" role="list">
          {
            atajos.map((item) => (
              <li class="item-atajo">
                <span class="icono-cruz" aria-hidden="true">✕</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <footer class="atajos-footer">
          <p class="atajos-conclusion">
            <span class="alerta-icono" aria-hidden="true">!</span>
            <strong>Si empiezas por el precio, comparas sin saber qué compras.</strong>
          </p>
        </footer>
      </article>

      <!-- Columna 2: Lo que miramos nosotros (EMAX) -->
      <article class="tarjeta-comparativa tarjeta-emax tarjeta-blanca">
        <header class="tarjeta-cabecera">
          <span class="badge badge-verde">El diagnóstico EMAX</span>
          <h3 class="tarjeta-tit">Lo que miramos nosotros</h3>
          <p class="tarjeta-desc">Antes de proponerte una tarifa, auditamos estos 4 factores:</p>
        </header>

        <div class="lista-pilares">
          {
            pilaresEmax.map((pilar, index) => (
              <div class="pilar-item">
                <span class="pilar-num">0{index + 1}</span>
                <div class="pilar-info">
                  <h4 class="pilar-tit">{pilar.titulo}</h4>
                  <p class="pilar-desc">{pilar.desc}</p>
                </div>
              </div>
            ))
          }
        </div>

        <footer class="emax-footer">
          <div class="metodo-pasos-resumen">
            <span class="paso-tag">Diagnóstico</span>
            <span class="flecha-paso">→</span>
            <span class="paso-tag">Estrategia</span>
            <span class="flecha-paso">→</span>
            <span class="paso-tag destacado">Tarifa a medida</span>
          </div>

          <div class="emax-acciones">
            <a href="/metodo" class="boton boton-secundario">Ver el método completo</a>
            <a href="/#estudio" class="boton boton-primario">Analizar mi factura</a>
          </div>
        </footer>
      </article>
    </div>
  </div>
</section>

<style>
  .comparativa-seccion {
    padding: 72px 0 80px;
    background: #f4f8fc;
  }

  .seccion-cabecera {
    text-align: center;
    max-width: 740px;
    margin: 0 auto 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .seccion-titulo {
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.7rem);
    color: var(--tinta, #0f2346);
  }

  .seccion-subtitulo {
    font-size: 1.125rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
  }

  .comparativa-grid {
    display: grid;
    grid-template-columns: 0.88fr 1.12fr;
    gap: 32px;
    align-items: stretch;
  }

  /* Tarjeta de atajos */
  .tarjeta-comparativa {
    border-radius: var(--radio-grande, 28px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .tarjeta-atajos {
    background: #ffffff;
    border: 1.5px solid var(--linea, #d6e0ee);
    padding: 36px 30px;
    box-shadow: 0 4px 20px rgba(15, 35, 70, 0.04);
  }

  .badge-alerta {
    display: inline-block;
    padding: 4px 10px;
    border-radius: var(--radio-pill, 999px);
    background: #fff1f0;
    color: #cf1322;
    border: 1px solid #ffa39e;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .tarjeta-tit {
    font-size: 1.65rem;
    color: var(--tinta, #0f2346);
    margin-bottom: 6px;
  }

  .tarjeta-desc {
    font-size: 0.95rem;
    color: var(--tinta-3, #63738e);
    margin-bottom: 24px;
  }

  .lista-atajos {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 0;
    margin: 0 0 32px;
    list-style: none;
  }

  .item-atajo {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.975rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.45;
  }

  .icono-cruz {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fee4e2;
    color: #d92d20;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .atajos-footer {
    padding: 16px;
    background: #ffffff;
    border-radius: var(--radio-md, 14px);
    border: 1px dashed #d0dbe9;
  }

  .atajos-conclusion {
    font-size: 0.92rem;
    color: var(--tinta, #0f2346);
    line-height: 1.45;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .alerta-icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fee4e2;
    color: #d92d20;
    font-size: 0.8rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  /* Tarjeta EMAX */
  .tarjeta-emax {
    padding: 36px 32px;
    border: 2px solid var(--azul-900, #004aad);
    box-shadow: 0 16px 44px rgba(0, 74, 173, 0.1);
  }

  .lista-pilares {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 32px;
  }

  .pilar-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 12px 16px;
    background: var(--fondo, #f4f7fb);
    border-radius: var(--radio-md, 14px);
    transition: background 0.15s ease;
  }

  .pilar-item:hover {
    background: var(--azul-suave, #edf4fe);
  }

  .pilar-num {
    font-family: var(--font-titulos);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--azul-900, #004aad);
    line-height: 1;
    margin-top: 2px;
  }

  .pilar-tit {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--tinta, #0f2346);
    margin-bottom: 4px;
  }

  .pilar-desc {
    font-size: 0.88rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.45;
  }

  .emax-footer {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--linea-fina, #e6edf7);
  }

  .metodo-pasos-resumen {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .paso-tag {
    padding: 4px 12px;
    border-radius: var(--radio-pill, 999px);
    background: var(--fondo, #f4f7fb);
    color: var(--tinta-2, #3a4b68);
  }

  .paso-tag.destacado {
    background: var(--azul-resalte, #ddf1ff);
    color: var(--azul-900, #004aad);
  }

  .flecha-paso {
    color: var(--tinta-3, #63738e);
  }

  .emax-acciones {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 980px) {
    .comparativa-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .tarjeta-atajos,
    .tarjeta-emax {
      padding: 24px 20px;
    }

    .emax-acciones {
      flex-direction: column;
    }

    .emax-acciones .boton {
      width: 100%;
    }
  }
</style>
