---
// Componente: "NO TE PROMETEMOS AHORRO ANTES DE ANALIZARTE."
// Sección de transparencia, rigor y compromiso energético EMAX.
//
// 1. Título Baloo 2 en azul corporativo (#004aad) de gran impacto.
// 2. Subtítulo Poppins: "Te enseñamos los números antes de pedirte que cambies."
// 3. Rejilla de 4 tarjetas con imagen de fondo y cartela inferior glassmorphic:
//    - Mismo consumo (Comparamos escenarios equivalentes.)
//    - Condiciones claras (Sabes exactamente qué estamos comparando.)
//    - Por escrito (Cuando existe una mejora, queda documentada.)
//    - Sin cambios absurdos (Si no merece la pena cambiar, te lo decimos.)
// 4. Botón inferior izquierdo "Quiero una respuesta clara" con halo luminoso.
import imagenPrueba from "../../imagenes/imagen de prueba.png";

interface TarjetaCompromiso {
  titulo: string;
  descripcion: string;
}

const tarjetas: TarjetaCompromiso[] = [
  {
    titulo: "Mismo consumo",
    descripcion: "Comparamos escenarios equivalentes.",
  },
  {
    titulo: "Condiciones claras",
    descripcion: "Sabes exactamente qué estamos comparando.",
  },
  {
    titulo: "Por escrito",
    descripcion: "Cuando existe una mejora, queda documentada.",
  },
  {
    titulo: "Sin cambios absurdos",
    descripcion: "Si no merece la pena cambiar, te lo decimos.",
  },
];
---

<section class="compromiso-seccion" id="compromiso">
  <!-- Halos ambientales de luz en los extremos (cian a la izquierda y azul a la derecha) -->
  <div class="halo-ambiente halo-cyan-izq" aria-hidden="true"></div>
  <div class="halo-ambiente halo-azul-der" aria-hidden="true"></div>

  <div class="wrap compromiso-inner">
    <!-- Encabezado superior -->
    <div class="encabezado">
      <h2 class="titulo-compromiso">NO TE PROMETEMOS AHORRO ANTES DE ANALIZARTE.</h2>
      <p class="subtitulo-compromiso">Te enseñamos los números antes de pedirte que cambies.</p>
    </div>

    <!-- Rejilla con las 4 tarjetas -->
    <div class="rejilla-tarjetas">
      {
        tarjetas.map((item, index) => (
          <article class="tarjeta-compromiso" style={`--i: ${index};`}>
            <!-- Aura brillante al hover -->
            <div class="tarjeta-aura" aria-hidden="true"></div>

            <!-- Borde con relieve suave -->
            <div class="tarjeta-borde" aria-hidden="true"></div>

            <!-- Contenedor de la tarjeta -->
            <div class="tarjeta-cuerpo">
              <!-- Imagen de fondo -->
              <div class="tarjeta-img-wrap">
                <img
                  src={imagenPrueba.src}
                  alt={item.titulo}
                  width={imagenPrueba.width}
                  height={imagenPrueba.height}
                  loading="lazy"
                />
                <div class="tarjeta-filtro-img" aria-hidden="true"></div>
              </div>

              <!-- Cartela inferior glassmorphism -->
              <div class="panel-glass">
                <h3 class="panel-titulo">{item.titulo}</h3>
                <p class="panel-desc">{item.descripcion}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Botón CTA inferior izquierdo -->
    <div class="pie-seccion">
      <a href="/#estudio" class="btn-respuesta">
        <span>Quiero una respuesta clara</span>
      </a>
    </div>
  </div>
</section>

<style>
  .compromiso-seccion {
    position: relative;
    overflow: hidden;
    background: #ffffff;
    color: #1e293b;
    padding: 96px 0 110px;
    scroll-margin-top: var(--header-h);
  }

  /* Halos ambientales suaves en tonos cian y azul */
  .halo-ambiente {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .halo-cyan-izq {
    width: 580px;
    height: 580px;
    left: -160px;
    top: 25%;
    background: radial-gradient(
      circle,
      rgba(56, 182, 255, 0.45) 0%,
      rgba(82, 113, 255, 0.18) 45%,
      transparent 72%
    );
    filter: blur(85px);
    animation: pulsar-halo 8s ease-in-out infinite alternate;
  }

  .halo-azul-der {
    width: 620px;
    height: 620px;
    right: -120px;
    bottom: 5%;
    background: radial-gradient(
      circle,
      rgba(56, 182, 255, 0.45) 0%,
      rgba(0, 102, 255, 0.22) 50%,
      transparent 75%
    );
    filter: blur(85px);
    animation: pulsar-halo 10s ease-in-out infinite alternate-reverse;
  }

  .compromiso-inner {
    position: relative;
    z-index: 1;
  }

  /* Encabezado */
  .encabezado {
    max-width: 900px;
    margin-bottom: 42px;
  }

  .titulo-compromiso {
    font-family: var(--display);
    font-size: clamp(2.2rem, 3.8vw, 3.35rem);
    font-weight: 800;
    color: #004aad;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin: 0;
  }

  .subtitulo-compromiso {
    margin: 12px 0 0;
    font-family: var(--font);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    font-weight: 500;
    color: #334155;
    line-height: 1.35;
  }

  /* Rejilla de las 4 tarjetas */
  .rejilla-tarjetas {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 42px;
  }

  /* Tarjeta individual */
  .tarjeta-compromiso {
    position: relative;
    border-radius: 26px;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tarjeta-compromiso:hover {
    transform: translateY(-8px);
  }

  /* Aura suave detrás de la tarjeta */
  .tarjeta-aura {
    position: absolute;
    inset: -2px;
    border-radius: 28px;
    background: radial-gradient(
      circle at 50% 80%,
      rgba(56, 182, 255, 0.4) 0%,
      rgba(0, 74, 173, 0.2) 50%,
      transparent 75%
    );
    opacity: 0;
    filter: blur(14px);
    z-index: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .tarjeta-compromiso:hover .tarjeta-aura {
    opacity: 1;
  }

  .tarjeta-borde {
    position: absolute;
    inset: 0;
    border-radius: 26px;
    border: 1px solid rgba(210, 225, 245, 0.85);
    pointer-events: none;
    z-index: 3;
    transition: border-color 0.3s ease;
  }

  .tarjeta-compromiso:hover .tarjeta-borde {
    border-color: rgba(56, 182, 255, 0.7);
  }

  /* Cuerpo principal con proporción casi cuadrada */
  .tarjeta-cuerpo {
    position: relative;
    z-index: 1;
    aspect-ratio: 1 / 1.06;
    min-height: 290px;
    border-radius: 26px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 12px;
    box-shadow:
      0 14px 34px rgba(0, 52, 130, 0.08),
      0 2px 6px rgba(0, 0, 0, 0.04);
    background: #f1f5f9;
  }

  /* Imagen de fondo con zoom sutil */
  .tarjeta-img-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .tarjeta-img-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tarjeta-compromiso:hover .tarjeta-img-wrap img {
    transform: scale(1.08);
  }

  /* Filtro sutil para realzar contraste */
  .tarjeta-filtro-img {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.02) 0%,
      rgba(6, 19, 44, 0.22) 55%,
      rgba(4, 14, 34, 0.55) 100%
    );
  }

  /* Cartela inferior con Glassmorphism */
  .panel-glass {
    position: relative;
    z-index: 2;
    padding: 16px 18px 18px;
    border-radius: 20px;
    background: linear-gradient(
      165deg,
      rgba(10, 26, 54, 0.82) 0%,
      rgba(4, 15, 36, 0.94) 100%
    );
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(120, 205, 255, 0.32);
    box-shadow:
      0 10px 24px rgba(0, 0, 0, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .tarjeta-compromiso:hover .panel-glass {
    border-color: rgba(56, 182, 255, 0.7);
    transform: translateY(-2px);
  }

  .panel-titulo {
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin: 0 0 5px;
    line-height: 1.18;
  }

  .panel-desc {
    font-family: var(--font);
    font-size: 0.85rem;
    font-weight: 400;
    color: rgba(220, 238, 255, 0.85);
    line-height: 1.38;
    margin: 0;
  }

  /* Botón inferior izquierdo "Quiero una respuesta clara" */
  .pie-seccion {
    margin-top: 8px;
    display: flex;
    justify-content: flex-start;
  }

  .btn-respuesta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 36px;
    border-radius: 999px;
    background: linear-gradient(180deg, #004aad 0%, #003180 100%);
    color: #ffffff;
    font-family: var(--font);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    border: 1px solid rgba(56, 182, 255, 0.65);
    box-shadow:
      0 0 28px rgba(0, 74, 173, 0.48),
      0 6px 18px rgba(0, 20, 60, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
  }

  .btn-respuesta:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 38px rgba(56, 182, 255, 0.75),
      0 8px 24px rgba(0, 20, 60, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    filter: brightness(1.06);
  }

  @keyframes pulsar-halo {
    0% {
      transform: scale(0.96);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.08);
      opacity: 1;
    }
  }

  /* Responsive */
  @media (max-width: 1040px) {
    .rejilla-tarjetas {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .tarjeta-cuerpo {
      min-height: 270px;
    }
  }

  @media (max-width: 600px) {
    .compromiso-seccion {
      padding: 72px 0 84px;
    }

    .rejilla-tarjetas {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .tarjeta-cuerpo {
      aspect-ratio: auto;
      min-height: 250px;
    }

    .btn-respuesta {
      width: 100%;
    }
  }
</style>
