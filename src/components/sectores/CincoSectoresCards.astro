---
// Componente: "CINCO SECTORES, LEÍDOS POR cómo consumen"
// Rejilla de 8 tarjetas según el boceto oficial de Figma
import imgRestaurante from "../../imagenes/sectores/sectores indice/sectores-indice.png";
import imgHotel from "../../imagenes/sectores/sectores indice/sectores-indice-hoteles.png";
import imgSupermercado from "../../imagenes/sectores/sectores indice/sectores-indice-restaurante (1).png";
import imgLogistica from "../../imagenes/sectores/sectores indice/sectores-indice-logistica.png";
import imgIndustria from "../../imagenes/sectores/sectores indice/sectores-indice-industria (1).png";
import imgMultisede from "../../imagenes/sectores/sectores indice/sectores-indice-varios.png";
import imgComunidad from "../../imagenes/sectores/sectores indice/sectores-indice-comunidad.png";
import imgCasa from "../../imagenes/sectores/sectores indice/sectores-indice-t¿hogar.png";

interface SectorCardItem {
  id: string;
  titulo: string;
  desc: string;
  imagen: ImageMetadata;
  imgPos: string;
  href: string;
  esExternoModal?: boolean;
}

const sectoresCards: SectorCardItem[] = [
  {
    id: "restaurantes",
    titulo: "Restaurante u hostelería",
    desc: "Los dos servicios caen en las horas caras, y el frío no para ni el día de cierre.",
    imagen: imgRestaurante,
    imgPos: "65% 60%",
    href: "/sectores/restaurantes"
  },
  {
    id: "hotel",
    titulo: "Hotel",
    desc: "En febrero sigues pagando la potencia de agosto.",
    imagen: imgHotel,
    imgPos: "60% 24%",
    href: "/sectores/hoteles"
  },
  {
    id: "supermercado",
    titulo: "Supermercado o alimentación",
    desc: "Tu tienda nunca se apaga: el frío pesa más que los picos.",
    imagen: imgSupermercado,
    imgPos: "center 22%",
    href: "/sectores/supermercados"
  },
  {
    id: "logistica",
    titulo: "Logística y frío",
    desc: "Trabajar de noche no es lo mismo que consumir en P6.",
    imagen: imgLogistica,
    imgPos: "45% 28%",
    href: "/sectores/logistica-frio"
  },
  {
    id: "industria",
    titulo: "Industria",
    desc: "Un turno más cambia la factura.",
    imagen: imgIndustria,
    imgPos: "35% 22%",
    href: "/sectores/industria"
  },
  {
    id: "multisede",
    titulo: "Varios locales o sedes",
    desc: "Leemos cada suministro y todos juntos, con una persona que responde por todos.",
    imagen: imgMultisede,
    imgPos: "45% 28%",
    href: "/sectores/varios-suministros"
  },
  {
    id: "comunidad",
    titulo: "¿Es para una comunidad de propietarios?",
    desc: "Escalera, ascensor y garaje, con sus propios importes.",
    imagen: imgComunidad,
    imgPos: "40% 25%",
    href: "/tarifas/comunidades-de-propietarios"
  },
  {
    id: "casa",
    titulo: "¿Es para tu casa?",
    desc: "La factura de tu casa, leída antes de cambiar nada.",
    imagen: imgCasa,
    imgPos: "center 24%",
    href: "/particulares"
  }
];
---

<section class="sectores-grid-seccion" id="cinco-sectores">
  <div class="sectores-grid-contenedor">
    <!-- Encabezado centrado oficial -->
    <header class="sectores-grid-header">
      <h2 class="sectores-grid-titulo">
        CINCO SECTORES, LEÍDOS POR <span class="titulo-cursiva-azul">cómo consumen</span>
      </h2>
    </header>

    <!-- Rejilla de 8 tarjetas (2 filas de 4) -->
    <div class="sectores-cards-grid">
      {
        sectoresCards.map((card) => (
          <article class="sector-card-item">
            <a
              href={card.href}
              class="sector-card-link"
              data-abrir-funnel={card.esExternoModal ? true : undefined}
              data-tramo-msg={card.esExternoModal ? `Consulta para: ${card.titulo}` : undefined}
              aria-label={`Ver análisis para ${card.titulo}`}
            >
              <!-- Imagen superior fotográfica con curva orgánica de transición -->
              <div class="sector-card-media">
                <img
                  src={card.imagen.src}
                  alt={card.titulo}
                  class="sector-card-img"
                  style={`object-position: ${card.imgPos};`}
                  loading="lazy"
                  decoding="async"
                />
                <!-- Curva blanca orgánica idéntica al boceto -->
                <svg
                  class="sector-card-curva"
                  viewBox="0 0 300 46"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <path
                    d="M 0,42 C 95,32 200,14 268,4 C 284,2 295,4 300,10 L 300,46 L 0,46 Z"
                    fill="#ffffff"
                  />
                </svg>
              </div>

              <!-- Contenido inferior con título, botón de chevron y descripción -->
              <div class="sector-card-body">
                <div class="sector-card-head">
                  <h3 class="sector-card-tit">{card.titulo}</h3>
                  <div class="sector-btn-flecha" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 3.5 10.5 8 6 12.5"></path>
                    </svg>
                  </div>
                </div>
                <p class="sector-card-desc">{card.desc}</p>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: CINCO SECTORES, LEÍDOS POR CÓMO CONSUMEN
     ========================================================================== */
  .sectores-grid-seccion {
    padding: clamp(64px, 8vw, 108px) 0;
    background: #f4f6fa;
    width: 100%;
    position: relative;
    border-top: 1px solid #eef2f6;
  }

  .sectores-grid-contenedor {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 52px);
  }

  /* Encabezado */
  .sectores-grid-header {
    text-align: center;
    margin-bottom: clamp(38px, 5vw, 54px);
  }

  .sectores-grid-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.9rem, 1.7rem + 1.4vw, 2.9rem);
    font-weight: 800;
    color: #0c192c;
    line-height: 1.18;
    margin: 0;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .titulo-cursiva-azul {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: #4f8df9;
    letter-spacing: 0;
    display: inline;
  }

  /* Rejilla de 8 Tarjetas: 4 por fila en Desktop */
  .sectores-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(18px, 2.2vw, 28px);
    width: 100%;
  }

  @media (max-width: 1200px) {
    .sectores-cards-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }
  }

  @media (max-width: 640px) {
    .sectores-cards-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* Tarjeta individual */
  .sector-card-item {
    background: #ffffff;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 4px 18px rgba(12, 25, 44, 0.05);
    border: 1px solid #e9edf4;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.28s ease;
    display: flex;
    flex-direction: column;
    isolation: isolate;
    transform: translateZ(0);
    -webkit-mask-image: -webkit-radial-gradient(white, black);
  }

  .sector-card-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 36px rgba(0, 74, 173, 0.12);
    border-color: #c7ddfc;
  }

  .sector-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
    outline: none;
    border: none;
  }

  /* Media superior con curva */
  .sector-card-media {
    position: relative;
    width: 100%;
    height: 185px;
    overflow: hidden;
    background: #ffffff;
    transform: translateZ(0);
  }

  .sector-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: filter 0.3s ease, transform 0.35s ease;
  }

  .sector-card-item:hover .sector-card-img {
    filter: brightness(1.04);
    transform: scale(1.03);
  }

  /* Curva blanca orgánica solapada para evitar costuras subpíxel */
  .sector-card-curva {
    position: absolute;
    bottom: -2px;
    left: -1px;
    right: -1px;
    width: calc(100% + 2px);
    height: 42px;
    pointer-events: none;
    z-index: 2;
    display: block;
    shape-rendering: geometricPrecision;
  }

  /* Cuerpo blanco inferior */
  .sector-card-body {
    position: relative;
    z-index: 3;
    margin-top: -2px;
    padding: 6px 22px 24px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 8px;
  }

  .sector-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .sector-card-tit {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.06rem;
    font-weight: 700;
    color: #162a52;
    line-height: 1.3;
    margin: 0;
    transition: color 0.2s ease;
  }

  .sector-card-item:hover .sector-card-tit {
    color: #004aad;
  }

  /* Botón circular con flecha chevron */
  .sector-btn-flecha {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #e6f2ff;
    color: #0052cc;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .sector-card-item:hover .sector-btn-flecha {
    background: #004aad;
    color: #ffffff;
    transform: scale(1.08);
  }

  .sector-card-desc {
    font-size: 0.84rem;
    line-height: 1.5;
    color: #3b4e6b;
    margin: 0;
  }
</style>
