---
// Componente: HeroLogistica.astro
// Hero oficial para la página: /sectores/logistica-frio ("Luz para logística y almacenes frigoríficos")
// Fondo fotográfico de nave logística con cámaras de frío + degradado azul corporativo + tarjeta glassmorphic interactiva.

import logisticaImg from "../../../imagenes/sector_logistica.jpg";

const tramosLuz = [
  {
    id: "300",
    label: "MENOS DE 300€",
    valor: "<300",
    rango: "menos de 300 € al mes",
    msg: "Estudio energético para pequeño almacén, punto logístico o nave de distribución local.",
  },
  {
    id: "1000",
    label: "300 – 1.000€",
    valor: "300-1000",
    rango: "entre 300 y 1.000 € al mes",
    msg: "Optimización de turnos, cámaras frigoríficas y potencia para nave logística intermedia.",
  },
  {
    id: "3000",
    label: "1.000 – 3.000€",
    valor: "1000-3000",
    rango: "entre 1.000 y 3.000 € al mes",
    msg: "Auditoría de almacén frigorífico, peaje 3.0TD / 6.1TD, curva de carga nocturna y reactiva.",
  },
  {
    id: "mas3000",
    label: "Más de 3.000€",
    valor: ">3000",
    rango: "más de 3.000 € al mes",
    msg: "Consultoría integral y multipunto para centros logísticos, plataformas frigoríficas y gran distribución.",
  },
];
---

<section class="logistica-hero-root">
  <!-- Fondo con fotografía de almacén logístico frigorífico y degradado fluido -->
  <div class="logistica-hero-bg">
    <img
      src={logisticaImg.src}
      alt="Almacén logístico frigorífico de gran altura con operario y transpaleta"
      class="hero-bg-img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-bg-gradient"></div>
  </div>

  <div class="logistica-hero-contenedor">
    <div class="logistica-hero-grid">
      <!-- Columna Izquierda: Titulares y propuesta técnica -->
      <div class="logistica-hero-textos">
        <div class="logistica-kicker">
          <span>LUZ PARA LOGÍSTICA Y ALMACENES FRIGORÍFICOS</span>
          <span class="logistica-kicker-bar" aria-hidden="true">|</span>
        </div>

        <h1 class="logistica-h1">
          <span class="h1-cursiva-cyan">Trabajar de noche</span>
          <span class="h1-bloque-mayus">NO ES LO MISMO QUE CONSUMIR EN P6.</span>
        </h1>

        <p class="logistica-subtitulo">
          Las horas baratas tienen su calendario, y tus turnos tienen otro. Leemos qué parte de tu consumo cae de verdad en ellas, con tus datos.
        </p>
      </div>

      <!-- Columna Derecha: Tarjeta Glassmorphic con selector de tramos conectado al formulario modal -->
      <div class="logistica-hero-card-col">
        <div class="hero-card-glass">
          <h2 class="card-pregunta-tit">¿Cuánto paga tu empresa de luz al mes?</h2>
          <p class="card-pregunta-sub">
            En total, sumando todos tus suministros. Con una cifra aproximada nos basta.
          </p>

          <!-- Rejilla 2x2 de botones de tramo -->
          <div class="card-tramos-grid" role="group" aria-label="Selección de tramo mensual de luz">
            {
              tramosLuz.map((t) => (
                <button
                  type="button"
                  class="btn-tramo-azul"
                  data-abrir-funnel
                  data-tramo-id={t.valor}
                  data-tramo-label={t.label}
                  data-tramo-rango={t.rango}
                  data-tramo-msg={t.msg}
                  aria-label={`Seleccionar tramo ${t.label} para abrir estudio energético`}
                >
                  <span class="tramo-txt">{t.label}</span>
                  <span class="tramo-flecha" aria-hidden="true">
                    <svg
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#003580"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="9 18 15 12 9 6" />
                    </svg>
                  </span>
                </button>
              ))
            }
          </div>

          <!-- Pie de tarjeta -->
          <p class="card-nota-pie">
            Tú eliges cómo empezamos: con tu factura, con tu CUPS o con dos datos de tu negocio. El análisis no tiene coste.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     HERO SECTOR: LOGÍSTICA Y FRÍO
     ========================================================================== */
  .logistica-hero-root {
    position: relative;
    z-index: 20;
    margin-top: -78px;
    width: 100%;
    min-height: calc(88vh + 78px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #004aad;
    overflow: hidden;
    padding-top: calc(78px + clamp(36px, 5vh, 52px));
    padding-bottom: clamp(48px, 6vh, 72px);
    box-sizing: border-box;
  }

  /* Fondo fotográfico y degradados */
  .logistica-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    display: block;
    opacity: 0.92;
  }

  .hero-bg-gradient {
    position: absolute;
    inset: 0;
    /* Degradado fluido desde azul corporativo profundo a la izquierda que revela la imagen hacia la derecha */
    background: linear-gradient(
      90deg,
      #003882 0%,
      #004aad 32%,
      rgba(0, 74, 173, 0.92) 52%,
      rgba(0, 85, 204, 0.72) 72%,
      rgba(0, 102, 238, 0.35) 90%,
      rgba(0, 102, 238, 0.12) 100%
    );
  }

  /* Contenedor principal */
  .logistica-hero-contenedor {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    padding-block: clamp(20px, 3vh, 32px);
    box-sizing: border-box;
  }

  .logistica-hero-grid {
    display: grid;
    grid-template-columns: 1.12fr 0.98fr;
    gap: clamp(36px, 4.5vw, 64px);
    align-items: center;
  }

  /* Textos Izquierda */
  .logistica-hero-textos {
    display: flex;
    flex-direction: column;
    max-width: 620px;
  }

  .logistica-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #cbd5e1;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .logistica-kicker-bar {
    color: #00c2ff;
    font-weight: 800;
  }

  .logistica-h1 {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0 0 18px 0;
    line-height: 1.14;
  }

  .h1-cursiva-cyan {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.35rem, 2.1rem + 1.3vw, 3.45rem);
    color: #00c2ff;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 16px rgba(0, 194, 255, 0.35);
  }

  .h1-bloque-mayus {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.05rem, 1.85rem + 1.2vw, 3.05rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .logistica-subtitulo {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: clamp(0.96rem, 0.92rem + 0.22vw, 1.08rem);
    line-height: 1.62;
    color: #f1f5f9;
    margin: 0;
    max-width: 540px;
    text-wrap: pretty;
  }

  /* Tarjeta Glassmorphic Derecha */
  .logistica-hero-card-col {
    display: flex;
    justify-content: flex-end;
  }

  .hero-card-glass {
    width: 100%;
    max-width: 510px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 26px;
    padding: clamp(26px, 3.2vw, 34px);
    box-shadow:
      0 20px 48px rgba(0, 15, 45, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.45);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .card-pregunta-tit {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.22rem, 1.15rem + 0.35vw, 1.48rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 6px 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .card-pregunta-sub {
    font-size: 0.88rem;
    line-height: 1.45;
    color: #e2e8f0;
    margin: 0 0 22px 0;
  }

  /* Rejilla de Botones 2x2 */
  .card-tramos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 22px;
  }

  .btn-tramo-azul {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #004aad;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    padding: 12px 14px;
    cursor: pointer;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-weight: 700;
    font-size: 0.86rem;
    letter-spacing: 0.02em;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
    text-align: left;
    box-sizing: border-box;
  }

  .btn-tramo-azul:hover {
    background: #0059d6;
    border-color: rgba(255, 255, 255, 0.55);
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(0, 74, 173, 0.45);
  }

  .btn-tramo-azul:focus-visible {
    outline: 2px solid #00c2ff;
    outline-offset: 2px;
  }

  .tramo-txt {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tramo-flecha {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #00c2ff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 8px;
    transition: transform 0.2s ease;
  }

  .btn-tramo-azul:hover .tramo-flecha {
    transform: translateX(2px);
  }

  .card-nota-pie {
    font-size: 0.8rem;
    line-height: 1.48;
    color: #cbd5e1;
    margin: 0;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 992px) {
    .logistica-hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .logistica-hero-card-col {
      justify-content: flex-start;
    }

    .hero-card-glass {
      max-width: 100%;
    }

    .hero-bg-img {
      width: 100%;
      opacity: 0.35;
    }

    .hero-bg-gradient {
      background: linear-gradient(
        180deg,
        rgba(0, 56, 130, 0.95) 0%,
        rgba(0, 74, 173, 0.96) 65%,
        #003882 100%
      );
    }
  }

  @media (max-width: 600px) {
    .card-tramos-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .logistica-h1 {
      line-height: 1.15;
    }

    .h1-cursiva-cyan {
      font-size: 2.1rem;
    }

    .h1-bloque-mayus {
      font-size: 1.85rem;
    }

    .hero-card-glass {
      padding: 22px 18px;
    }
  }
</style>
