---
// Componente: QueParteCaeP6.astro
// Sección de Logística y Frío: "QUÉ PARTE DE TU TURNO cae en P6"
// Matriz de 3 columnas: Turno vs Lo que cae en P6 vs Lo que no
// Banner de reactiva en P6 + Cita "Ya tengo tarifa nocturna" + 2 píldoras de guías técnicas

interface TurnoItem {
  id: string;
  turno: string;
  caeP6: string;
  loQueNo: string;
}

const turnos: TurnoItem[] = [
  {
    id: "noche",
    turno: "De 22:00 a 6:00",
    caeP6: "De 0:00 a 6:00",
    loQueNo: "De 22:00 a 24:00: son horas de llano",
  },
  {
    id: "manana",
    turno: "De 6:00 a 14:00",
    caeP6: "De 6:00 a 8:00",
    loQueNo: "De 8:00 a 14:00: llano y, desde las 9:00, punta",
  },
  {
    id: "tarde",
    turno: "De 14:00 a 22:00",
    caeP6: "Nada",
    loQueNo: "Todo: llano hasta las 18:00 y punta hasta las 22:00",
  },
  {
    id: "finde",
    turno: "Sábado, domingo y festivo nacional",
    caeP6: "Todo el día",
    loQueNo: "—",
  },
];
---

<section
  class="parte-p6-seccion"
  id="que-parte-cae-en-p6"
  aria-labelledby="parte-p6-tit"
>
  <div class="parte-p6-contenedor">
    <!-- Encabezado de la Sección -->
    <div class="parte-p6-header">
      <h2 class="parte-p6-titulo" id="parte-p6-tit">
        QUÉ PARTE DE TU TURNO <span class="tit-cursiva">cae en P6</span>
      </h2>
      <p class="parte-p6-bajada-principal">
        Tus equipos no paran de noche. Eso no convierte toda la noche en P6.
      </p>
      <p class="parte-p6-explicacion">
        P6 es el periodo con los peajes y cargos más bajos. Pero no es "la noche": entre semana, va de las 0:00 a las 8:00. Así quedan tres turnos habituales en un día laborable, en la Península.
      </p>
    </div>

    <!-- Rejilla Comparativa de 3 Columnas (Solapamiento elegante) -->
    <div class="matriz-turnos-grid">
      <!-- Columna 1: Turno -->
      <div class="col-matriz col-turno">
        <div class="col-pill-wrap">
          <span class="pill-col pill-turno">Turno</span>
        </div>
        <div class="col-filas-stack">
          {
            turnos.map((t) => (
              <div class="fila-matriz fila-turno">
                <div class="circulo-icono-turno" aria-hidden="true">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#0052cc"
                    stroke-width="2.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                </div>
                <span class="txt-turno-nombre">{t.turno}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Columna 2: Lo que cae en P6 (Tarjeta Elevada Blanca) -->
      <div class="col-matriz col-cae-p6">
        <div class="col-pill-wrap">
          <span class="pill-col pill-cae-p6">Lo que cae en P6</span>
        </div>
        <div class="col-filas-stack">
          {
            turnos.map((t) => (
              <div class="fila-matriz fila-cae-p6">
                <span class="txt-cae-p6">{t.caeP6}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Columna 3: Lo que no (Tarjeta Azul Marino) -->
      <div class="col-matriz col-lo-que-no">
        <div class="col-pill-wrap">
          <span class="pill-col pill-lo-que-no">Lo que no</span>
        </div>
        <div class="col-filas-stack">
          {
            turnos.map((t) => (
              <div class="fila-matriz fila-lo-que-no">
                <span class="txt-lo-que-no">{t.loQueNo}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Banner Inferior en Forma de Píldora: Ventaja de reactiva en P6 -->
    <div class="banner-pildora-reactiva" role="note">
      <div class="circulo-blanco-destacado" aria-hidden="true">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#0052cc"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
        </svg>
      </div>
      <p class="texto-pildora-reactiva">
        <strong>Y una ventaja que se ve poco:</strong> la reactiva de las cámaras que trabajan en P6 no se paga en esas horas. La de las horas de día, sí, si pasa del umbral.
      </p>
    </div>

    <!-- Bloque de Cita: "Ya tengo tarifa nocturna." -->
    <div class="tarifa-nocturna-cita">
      <div class="cita-cuadro-celeste" aria-hidden="true">
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#0052cc"
          stroke-width="2.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2H4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2 0 4 1.75 6 5 8" />
          <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2h-4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2 0 4 1.75 6 5 8" />
        </svg>
      </div>

      <div class="cita-textos-bloque">
        <h3 class="cita-tit-azul">"Ya tengo tarifa nocturna."</h3>
        <p class="cita-desc-gris">
          Una tarifa de día y noche define su propio tramo de noche, que no tiene por qué coincidir con P6. Y los peajes siguen siempre los periodos regulados. Qué parte de tu consumo cae en cada uno se ve con tus datos.
        </p>
      </div>
    </div>

    <!-- Píldoras de Enlace a Guías Técnicas -->
    <div class="pildoras-guias-bottom" role="navigation" aria-label="Guías técnicas de apoyo">
      <a
        href="/guias/peaje-3-0td"
        class="pildora-cyan-guia"
        aria-label="Ir a la guía sobre el peaje 3.0TD y sus periodos"
      >
        <span>El peaje 3.0TD y sus periodos</span>
        <span class="circulo-flecha-azul" aria-hidden="true">
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#00c2ff"
            stroke-width="3.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </span>
      </a>

      <a
        href="/guias/precio-fijo-o-indexado"
        class="pildora-cyan-guia"
        aria-label="Ir a la guía de cómo se reparte el precio a lo largo del día"
      >
        <span>Cómo se reparte el precio a lo largo del día</span>
        <span class="circulo-flecha-azul" aria-hidden="true">
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#00c2ff"
            stroke-width="3.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: QUÉ PARTE DE TU TURNO CAE EN P6 (LOGÍSTICA Y FRÍO)
     ========================================================================== */
  .parte-p6-seccion {
    position: relative;
    width: 100%;
    background: #ffffff;
    color: #081d3e;
    padding: clamp(65px, 7vw, 105px) 0 clamp(75px, 8vw, 115px);
    overflow: hidden;
    box-sizing: border-box;
  }

  .parte-p6-contenedor {
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  /* Encabezado */
  .parte-p6-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(36px, 4.2vw, 50px);
    max-width: 900px;
  }

  .parte-p6-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.9rem + 1.2vw, 2.95rem);
    font-weight: 800;
    color: #081d3e;
    line-height: 1.15;
    margin: 0 0 12px 0;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .tit-cursiva {
    display: inline;
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #0052cc;
  }

  .parte-p6-bajada-principal {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.25rem);
    font-weight: 700;
    color: #081d3e;
    margin: 0 0 10px 0;
    line-height: 1.35;
  }

  .parte-p6-explicacion {
    font-size: clamp(0.94rem, 0.9rem + 0.2vw, 1.02rem);
    line-height: 1.62;
    color: #475569;
    margin: 0;
    max-width: 820px;
  }

  /* ==========================================================================
     REJILLA DE 3 COLUMNAS
     ========================================================================== */
  .matriz-turnos-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr 1.25fr;
    align-items: stretch;
    margin-bottom: clamp(34px, 4vw, 48px);
    position: relative;
  }

  .col-matriz {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .col-pill-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 18px;
    height: 42px;
    align-items: center;
  }

  .pill-col {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    padding: 8px 24px;
    border-radius: 9999px;
    letter-spacing: 0.015em;
    white-space: nowrap;
    text-align: center;
  }

  /* Col 1: Turno */
  .col-turno {
    background: #f8fafc;
    border-radius: 24px 0 0 24px;
    padding: 22px 24px;
    border: 1px solid #e2e8f0;
    border-right: none;
    z-index: 1;
  }

  .pill-turno {
    background: #0052cc;
    color: #ffffff;
  }

  .col-filas-stack {
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-around;
  }

  .fila-matriz {
    display: flex;
    align-items: center;
    min-height: 68px;
    padding: 12px 0;
    box-sizing: border-box;
  }

  .fila-turno {
    gap: 12px;
    border-bottom: 1px solid #e2e8f0;
  }

  .fila-turno:last-child {
    border-bottom: none;
  }

  .circulo-icono-turno {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #dbeafe;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .txt-turno-nombre {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    color: #0052cc;
    line-height: 1.35;
  }

  /* Col 2: Lo que cae en P6 (Tarjeta Elevada Blanca) */
  .col-cae-p6 {
    background: #ffffff;
    border-radius: 24px;
    padding: 22px 26px;
    box-shadow: 0 16px 38px rgba(8, 29, 62, 0.14);
    border: 1px solid #cbd5e1;
    z-index: 3;
    margin-inline: -8px;
  }

  .pill-cae-p6 {
    background: #002255;
    color: #ffffff;
  }

  .fila-cae-p6 {
    border-bottom: 1px solid #f1f5f9;
  }

  .fila-cae-p6:last-child {
    border-bottom: none;
  }

  .txt-cae-p6 {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: 0.94rem;
    font-weight: 600;
    color: #0f172a;
    line-height: 1.4;
  }

  /* Col 3: Lo que no (Tarjeta Azul Marino) */
  .col-lo-que-no {
    background: #081d3e;
    color: #ffffff;
    border-radius: 0 24px 24px 0;
    padding: 22px 28px;
    border: 1px solid rgba(8, 29, 62, 0.2);
    border-left: none;
    z-index: 1;
  }

  .pill-lo-que-no {
    background: #e0edff;
    color: #081d3e;
  }

  .fila-lo-que-no {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .fila-lo-que-no:last-child {
    border-bottom: none;
  }

  .txt-lo-que-no {
    font-size: 0.9rem;
    line-height: 1.5;
    color: #e2e8f0;
  }

  /* ==========================================================================
     BANNER INFERIOR EN FORMA DE PÍLDORA (REACTIVA EN P6)
     ========================================================================== */
  .banner-pildora-reactiva {
    display: flex;
    align-items: center;
    gap: 18px;
    background: #0052cc;
    border-radius: 9999px;
    padding: 16px 28px;
    box-shadow: 0 10px 28px rgba(0, 82, 204, 0.25);
    width: 100%;
    box-sizing: border-box;
    margin-bottom: clamp(28px, 3.5vw, 40px);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .banner-pildora-reactiva:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(0, 82, 204, 0.35);
  }

  .circulo-blanco-destacado {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
  }

  .texto-pildora-reactiva {
    margin: 0;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(0.92rem, 0.88rem + 0.2vw, 1.02rem);
    color: #ffffff;
    line-height: 1.5;
    font-weight: 500;
  }

  .texto-pildora-reactiva strong {
    font-weight: 700;
  }

  /* ==========================================================================
     BLOQUE DE CITA: YA TENGO TARIFA NOCTURNA
     ========================================================================== */
  .tarifa-nocturna-cita {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: clamp(28px, 3.5vw, 38px);
    max-width: 900px;
  }

  .cita-cuadro-celeste {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #dbeafe;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cita-textos-bloque {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cita-tit-azul {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
    font-weight: 700;
    color: #0052cc;
    margin: 0;
    line-height: 1.35;
  }

  .cita-desc-gris {
    font-size: 0.92rem;
    line-height: 1.58;
    color: #475569;
    margin: 0;
  }

  /* ==========================================================================
     PÍLDORAS DE GUÍAS TÉCNICAS INFERIORES
     ========================================================================== */
  .pildoras-guias-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .pildora-cyan-guia {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #00c2ff;
    color: #081d3e;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 10px 16px 10px 22px;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 194, 255, 0.28);
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .pildora-cyan-guia:hover {
    background: #33d1ff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 194, 255, 0.45);
  }

  .circulo-flecha-azul {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #003882;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .pildora-cyan-guia:hover .circulo-flecha-azul {
    transform: translateX(2px);
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 960px) {
    .matriz-turnos-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .col-turno {
      border-radius: 20px;
      border-right: 1px solid #e2e8f0;
    }

    .col-cae-p6 {
      margin-inline: 0;
      border-radius: 20px;
    }

    .col-lo-que-no {
      border-radius: 20px;
      border-left: 1px solid rgba(8, 29, 62, 0.2);
    }

    .banner-pildora-reactiva {
      border-radius: 20px;
      padding: 18px 20px;
    }

    .pildora-cyan-guia {
      white-space: normal;
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (max-width: 640px) {
    .parte-p6-seccion {
      padding: 55px 0 65px;
    }

    .parte-p6-titulo {
      font-size: 1.85rem;
    }

    .col-turno,
    .col-cae-p6,
    .col-lo-que-no {
      padding: 20px 18px;
    }
  }
</style>
