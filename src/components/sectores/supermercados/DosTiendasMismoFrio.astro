---
// Componente: DosTiendasMismoFrio.astro
// Sección de Supermercados: "DOS TIENDAS CON FRÍO QUE NO SE PARECEN | BAJAS LA PERSIANA. Las cámaras siguen."
// Comparativa entre "Tienda A" vs "Supermercado B"

import imgTiendaA from "../../../imagenes/supermercado_tienda_a.jpg";
import imgTiendaB from "../../../imagenes/supermercado_tienda_b.jpg";

interface FilaSupermercado {
  titulo: string;
  icono: "trabaja" | "consume" | "potencia" | "reactiva" | "estructura";
  textoA: string;
  textoB: string;
}

const caracteristicas: FilaSupermercado[] = [
  {
    titulo: "Cómo trabaja",
    icono: "trabaja",
    textoA: "Mucho frío: cámaras y congelados. Horario comercial y cierre de domingo.",
    textoB: "Sala amplia, climatización e iluminación intensa, y obrador de día.",
  },
  {
    titulo: "Cuándo consume",
    icono: "consume",
    textoA: "La base de frío pesa más que todo lo demás, y buena parte cae en P6: noches y domingos.",
    textoB: "Lo que más pesa son las horas de sala, de día y entre semana.",
  },
  {
    titulo: "Su potencia",
    icono: "potencia",
    textoA: "Un pico moderado y estable, sin grandes cambios entre invierno y verano.",
    textoB: "Su pico es de día y en verano, cuando coinciden climatización y obrador: cae en un periodo caro y arrastra a los demás.",
  },
  {
    titulo: "Su reactiva",
    icono: "reactiva",
    textoA: "Buena parte la generan las cámaras de noche y en domingo, y esa no se paga. La que se paga es la de las horas de apertura.",
    textoB: "La mayor parte cae en horas de apertura: se paga. Se mira si compensa corregirla.",
  },
  {
    titulo: "Su estructura",
    icono: "estructura",
    textoA: "Seis periodos le permiten pagar su base nocturna con la parte regulada que le toca.",
    textoB: "La estructura le importa menos que acertar la potencia de verano.",
  },
];
---

<section
  class="dos-tiendas-seccion"
  id="dos-tiendas-comparativa"
  aria-labelledby="dos-tiendas-tit"
>
  <div class="dos-tiendas-contenedor">
    <!-- Encabezado de la Sección -->
    <div class="dos-tiendas-header">
      <div class="etiqueta-kicker">
        <span>DOS TIENDAS CON FRÍO QUE NO SE PARECEN</span>
        <span class="separador-barra" aria-hidden="true">|</span>
      </div>

      <h2 class="dos-tiendas-titulo" id="dos-tiendas-tit">
        BAJAS LA PERSIANA.
        <span class="subtitulo-destacado">Las cámaras siguen.</span>
      </h2>

      <p class="dos-tiendas-bajada">
        Las dos venden alimentación, y las dos tienen frío. En la factura, no tienen casi nada en común.
      </p>
    </div>

    <!-- Rejilla Comparativa de las 2 Tiendas -->
    <div class="comparativa-tiendas-grid">
      <!-- 1. TIENDA A -->
      <article class="tarjeta-tienda" aria-label="Análisis de Tienda A">
        <div class="tarjeta-media">
          <img
            src={imgTiendaA.src}
            alt="Murales e islas de refrigeración y congelados en una tienda de alimentación"
            class="tarjeta-foto"
            loading="lazy"
            decoding="async"
          />
          <div class="badge-tienda badge-tienda-a">Tienda A</div>
        </div>

        <div class="tarjeta-cuerpo">
          <ul class="filas-stack" role="list">
            {
              caracteristicas.map((c) => (
                <li class="fila-detalle">
                  <div class="circulo-icono-azul" aria-hidden="true">
                    {c.icono === "trabaja" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                      </svg>
                    )}
                    {c.icono === "consume" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                      </svg>
                    )}
                    {c.icono === "potencia" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                      </svg>
                    )}
                    {c.icono === "reactiva" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M2 12c2.5-6 5.5-6 8 0s5.5 6 8 0 3-4 4-4" />
                      </svg>
                    )}
                    {c.icono === "estructura" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                      </svg>
                    )}
                  </div>
                  <div class="fila-textos">
                    <h3 class="fila-titulo">{c.titulo}</h3>
                    <p class="fila-desc">{c.textoA}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <!-- 2. SUPERMERCADO B -->
      <article class="tarjeta-tienda" aria-label="Análisis de Supermercado B">
        <div class="tarjeta-media">
          <img
            src={imgTiendaB.src}
            alt="Interior amplio de supermercado con zona de frescos, panadería y pasillos iluminados"
            class="tarjeta-foto"
            loading="lazy"
            decoding="async"
          />
          <div class="badge-tienda badge-tienda-b">Supermercado B</div>
        </div>

        <div class="tarjeta-cuerpo">
          <ul class="filas-stack" role="list">
            {
              caracteristicas.map((c) => (
                <li class="fila-detalle">
                  <div class="circulo-icono-azul" aria-hidden="true">
                    {c.icono === "trabaja" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                      </svg>
                    )}
                    {c.icono === "consume" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                      </svg>
                    )}
                    {c.icono === "potencia" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                      </svg>
                    )}
                    {c.icono === "reactiva" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M2 12c2.5-6 5.5-6 8 0s5.5 6 8 0 3-4 4-4" />
                      </svg>
                    )}
                    {c.icono === "estructura" && (
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="2.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                      </svg>
                    )}
                  </div>
                  <div class="fila-textos">
                    <h3 class="fila-titulo">{c.titulo}</h3>
                    <p class="fila-desc">{c.textoB}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>

    <!-- Banner Inferior en Forma de Píldora -->
    <div class="banner-pildora-conclusion" role="note">
      <div class="circulo-blanco-destacado" aria-hidden="true">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#0052cc"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
        </svg>
      </div>
      <p class="texto-pildora-conclusion">
        Una tarifa <strong class="destacado-texto">"para alimentación"</strong> daría por hecho cómo es la tienda media. Estas dos tienen frío, pero no se parecen.
      </p>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: DOS TIENDAS CON FRÍO QUE NO SE PARECEN
     ========================================================================== */
  .dos-tiendas-seccion {
    position: relative;
    width: 100%;
    background: #ffffff;
    color: #081d3e;
    padding: clamp(65px, 7vw, 105px) 0 clamp(75px, 8vw, 115px);
    overflow: hidden;
    box-sizing: border-box;
  }

  .dos-tiendas-contenedor {
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  /* Encabezado */
  .dos-tiendas-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(38px, 4.5vw, 54px);
    max-width: 920px;
  }

  .etiqueta-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #64748b;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .separador-barra {
    color: #0052cc;
    font-weight: 800;
  }

  .dos-tiendas-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.9rem + 1.2vw, 2.95rem);
    font-weight: 800;
    color: #081d3e;
    line-height: 1.15;
    margin: 0 0 12px 0;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .subtitulo-destacado {
    color: #0052cc;
    font-weight: 800;
    text-transform: none;
    letter-spacing: -0.01em;
  }

  .dos-tiendas-bajada {
    font-size: clamp(0.96rem, 0.92rem + 0.2vw, 1.05rem);
    line-height: 1.62;
    color: #475569;
    margin: 0;
    max-width: 780px;
  }

  /* Rejilla de las 2 Tiendas */
  .comparativa-tiendas-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3.2vw, 38px);
    align-items: stretch;
    margin-bottom: clamp(34px, 4vw, 48px);
  }

  /* Tarjeta Individual */
  .tarjeta-tienda {
    display: flex;
    flex-direction: column;
    background: #f1f5f9;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(8, 29, 62, 0.08);
    border: 1px solid rgba(8, 29, 62, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .tarjeta-tienda:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 42px rgba(8, 29, 62, 0.14);
  }

  /* Media superior */
  .tarjeta-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9.5;
    overflow: hidden;
    background: #001f4d;
  }

  .tarjeta-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1.02);
    transition: transform 0.4s ease;
  }

  .tarjeta-tienda:hover .tarjeta-foto {
    transform: scale(1.05);
  }

  .badge-tienda {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    background: #0052cc;
    color: #ffffff;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    padding: 8px 28px;
    border-radius: 9999px;
    box-shadow: 0 6px 18px rgba(0, 82, 204, 0.45);
    letter-spacing: 0.02em;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.25);
    z-index: 2;
  }

  .badge-tienda-b {
    background: #0060e6;
  }

  /* Cuerpo con Filas */
  .tarjeta-cuerpo {
    padding: 26px 28px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #f1f5f9;
  }

  .filas-stack {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .fila-detalle {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 15px 0;
    border-bottom: 1px solid #e2e8f0;
    box-sizing: border-box;
  }

  .fila-detalle:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .circulo-icono-azul {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #004aad;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
    box-shadow: 0 3px 8px rgba(0, 74, 173, 0.25);
  }

  .fila-textos {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
  }

  .fila-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.96rem;
    font-weight: 700;
    color: #004aad;
    margin: 0;
    line-height: 1.3;
  }

  .fila-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #334155;
    margin: 0;
  }

  /* ==========================================================================
     BANNER INFERIOR EN FORMA DE PÍLDORA
     ========================================================================== */
  .banner-pildora-conclusion {
    display: flex;
    align-items: center;
    gap: 18px;
    background: #0052cc;
    border-radius: 9999px;
    padding: 16px 26px;
    box-shadow: 0 10px 28px rgba(0, 82, 204, 0.28);
    width: 100%;
    max-width: 820px;
    box-sizing: border-box;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .banner-pildora-conclusion:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(0, 82, 204, 0.35);
  }

  .circulo-blanco-destacado {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
  }

  .texto-pildora-conclusion {
    margin: 0;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(0.92rem, 0.88rem + 0.2vw, 1.02rem);
    color: #ffffff;
    line-height: 1.45;
    font-weight: 500;
  }

  .destacado-texto {
    font-weight: 700;
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 960px) {
    .comparativa-tiendas-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .banner-pildora-conclusion {
      border-radius: 20px;
      padding: 16px 20px;
    }
  }

  @media (max-width: 640px) {
    .dos-tiendas-seccion {
      padding: 55px 0 65px;
    }

    .dos-tiendas-titulo {
      font-size: 1.85rem;
    }

    .tarjeta-cuerpo {
      padding: 20px 18px;
    }

    .banner-pildora-conclusion {
      flex-direction: row;
      gap: 14px;
      border-radius: 16px;
    }
  }
</style>
