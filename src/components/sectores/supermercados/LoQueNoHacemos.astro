---
// Componente: LoQueNoHacemos.astro
// Sección de Supermercados: "LO QUE NO HACEMOS"
// Clarificación sobre venta de equipos vs. optimización de contratación energética

import bannerSupermercadosImg from "../../../imagenes/sectores/sectores_supermercados/banner (2).png";

interface ItemNoHacemos {
  id: string;
  etiqueta: string;
  icono: "equipos" | "eficiencia";
  descripcion: string;
}

const items: ItemNoHacemos[] = [
  {
    id: "equipos",
    etiqueta: "Equipos",
    icono: "equipos",
    descripcion:
      "No vendemos ni instalamos equipos de frío, iluminación ni baterías de condensadores.",
  },
  {
    id: "eficiencia",
    etiqueta: "Eficiencia",
    icono: "eficiencia",
    descripcion:
      "Si ya cambiaste a LED o renovaste cámaras, eso reduce lo que consumes. Nosotros miramos otra cosa: cómo lo pagas. Potencia, estructura, modalidad y contrato.",
  },
];
---

<section
  class="lo-que-no-hacemos-seccion"
  id="lo-que-no-hacemos"
  aria-labelledby="no-hacemos-tit"
>
  <!-- Fondo fotográfico encuadrado a la derecha + degradado azul corporativo -->
  <div class="lo-que-no-hacemos-bg" aria-hidden="true">
    <div class="lo-que-no-hacemos-foto-wrap">
      <img
        src={bannerSupermercadosImg.src}
        alt=""
        class="lo-que-no-hacemos-img"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="lo-que-no-hacemos-gradient"></div>
  </div>

  <div class="lo-que-no-hacemos-contenedor">
    <div class="lo-que-no-hacemos-bloque">
      <!-- Título centrado sobre el bloque de tarjetas -->
      <h2 class="no-hacemos-titulo" id="no-hacemos-tit">
        LO QUE NO HACEMOS
      </h2>

      <!-- Bloque de Tarjetas con Solapamiento / Estructura Fila a Fila -->
      <div class="tarjetas-solapadas-wrap">
        <!-- Columna Izquierda: Etiquetas (Fondo Blanco) -->
        <div class="etiquetas-columna-blanca">
          {
            items.map((item) => (
              <div class="etiqueta-fila-item">
                <div class="circulo-icono-celeste" aria-hidden="true">
                  {item.icono === "equipos" && (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#004aad"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                    </svg>
                  )}
                  {item.icono === "eficiencia" && (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#004aad"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                  )}
                </div>
                <span class="etiqueta-nombre">{item.etiqueta}</span>
              </div>
            ))
          }
        </div>

        <!-- Columna Derecha: Tarjeta Azul con Descripciones -->
        <div class="descripciones-tarjeta-azul">
          {
            items.map((item) => (
              <div class="descripcion-fila-item">
                <p class="descripcion-texto">{item.descripcion}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: LO QUE NO HACEMOS (SUPERMERCADOS)
     ========================================================================== */
  .lo-que-no-hacemos-seccion {
    position: relative;
    width: 100%;
    min-height: clamp(460px, 44vw, 560px);
    display: flex;
    align-items: center;
    background: #004aad;
    color: #ffffff;
    padding: clamp(65px, 7vw, 105px) 0;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Fondo fotográfico posicionado en el bloque derecho como en el boceto */
  .lo-que-no-hacemos-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    background: #004aad;
  }

  .lo-que-no-hacemos-foto-wrap {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 76%;
    overflow: hidden;
  }

  .lo-que-no-hacemos-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    display: block;
  }

  /* Degradado oficial: Azul intenso a la izquierda fundiéndose hacia la derecha */
  .lo-que-no-hacemos-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #003d99 0%,
      #004aad 26%,
      #005ce6 44%,
      rgba(0, 92, 230, 0.88) 52%,
      rgba(0, 92, 230, 0.52) 64%,
      rgba(0, 92, 230, 0.16) 76%,
      transparent 86%
    );
  }

  .lo-que-no-hacemos-contenedor {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
  }

  .lo-que-no-hacemos-bloque {
    width: 100%;
    max-width: 760px;
    margin-right: clamp(0px, 7vw, 90px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Título */
  .no-hacemos-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.8rem, 1.6rem + 1vw, 2.35rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 clamp(28px, 3.5vw, 40px) 0;
  }

  /* Contenedor Solapado de las Tarjetas */
  .tarjetas-solapadas-wrap {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
  }

  /* Columna Izquierda: Fondo Blanco */
  .etiquetas-columna-blanca {
    background: #ffffff;
    border-radius: 24px 0 0 24px;
    padding: 20px 38px 20px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    min-width: 205px;
    box-shadow: 0 14px 32px rgba(8, 29, 62, 0.14);
    z-index: 1;
    box-sizing: border-box;
  }

  .etiqueta-fila-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
  }

  .etiqueta-fila-item:first-child {
    border-bottom: 1px solid #e2e8f0;
  }

  .circulo-icono-celeste {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #c3d9ff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .etiqueta-nombre {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.02rem;
    font-weight: 700;
    color: #004aad;
    letter-spacing: -0.01em;
  }

  /* Columna Derecha: Tarjeta Azul que solapa ligeramente */
  .descripciones-tarjeta-azul {
    background: rgba(0, 70, 165, 0.94);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 24px;
    padding: 26px 34px;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    flex: 1;
    margin-left: -20px;
    z-index: 2;
    box-shadow: 0 18px 40px rgba(0, 38, 99, 0.38);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-sizing: border-box;
  }

  .descripcion-fila-item {
    display: flex;
    align-items: center;
    padding: 16px 0;
  }

  .descripcion-fila-item:first-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
  }

  .descripcion-texto {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: clamp(0.88rem, 0.84rem + 0.16vw, 0.95rem);
    line-height: 1.55;
    color: #ffffff;
    margin: 0;
    font-weight: 400;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 900px) {
    .lo-que-no-hacemos-foto-wrap {
      width: 100%;
      right: 0;
    }

    .lo-que-no-hacemos-gradient {
      background: linear-gradient(
        180deg,
        rgba(0, 61, 153, 0.9) 0%,
        rgba(0, 74, 173, 0.86) 55%,
        rgba(0, 61, 153, 0.94) 100%
      );
    }

    .lo-que-no-hacemos-bloque {
      margin-right: 0;
    }
  }

  @media (max-width: 768px) {
    .tarjetas-solapadas-wrap {
      flex-direction: column;
      max-width: 100%;
    }

    .etiquetas-columna-blanca {
      border-radius: 20px 20px 0 0;
      padding: 18px 22px;
      min-width: 100%;
      flex-direction: row;
      justify-content: space-between;
    }

    .etiqueta-fila-item {
      padding: 6px 0;
    }

    .etiqueta-fila-item:first-child {
      border-bottom: none;
    }

    .descripciones-tarjeta-azul {
      margin-left: 0;
      margin-top: -10px;
      border-radius: 20px;
      padding: 22px 20px;
    }

    .descripcion-fila-item {
      padding: 14px 0;
    }
  }

  @media (max-width: 480px) {
    .etiquetas-columna-blanca {
      flex-direction: column;
      gap: 10px;
    }

    .etiqueta-fila-item:first-child {
      border-bottom: 1px solid #f1f5f9;
      padding-bottom: 12px;
    }
  }
</style>
