---
// Componente: LoQueNoHacemos.astro
// Sección de Supermercados: "LO QUE NO HACEMOS"
// Clarificación sobre venta de equipos vs. optimización de contratación energética

interface ItemNoHacemos {
  id: string;
  etiqueta: string;
  icono: "equipos" | "eficiencia";
  descripcion: string;
}

const items: ItemNoHacemos[] = [
  {
    id: "equipos",
    etiqueta: "Equipos",
    icono: "equipos",
    descripcion:
      "No vendemos ni instalamos equipos de frío, iluminación ni baterías de condensadores.",
  },
  {
    id: "eficiencia",
    etiqueta: "Eficiencia",
    icono: "eficiencia",
    descripcion:
      "Si ya cambiaste a LED o renovaste cámaras, eso reduce lo que consumes. Nosotros miramos otra cosa: cómo lo pagas. Potencia, estructura, modalidad y contrato.",
  },
];
---

<section
  class="lo-que-no-hacemos-seccion"
  id="lo-que-no-hacemos"
  aria-labelledby="no-hacemos-tit"
>
  <div class="lo-que-no-hacemos-contenedor">
    <!-- Título centrado -->
    <h2 class="no-hacemos-titulo" id="no-hacemos-tit">
      LO QUE NO HACEMOS
    </h2>

    <!-- Bloque de Tarjetas con Solapamiento / Estructura Fila a Fila -->
    <div class="tarjetas-solapadas-wrap">
      <!-- Columna Izquierda: Etiquetas (Fondo Blanco) -->
      <div class="etiquetas-columna-blanca">
        {
          items.map((item) => (
            <div class="etiqueta-fila-item">
              <div class="circulo-icono-celeste" aria-hidden="true">
                {item.icono === "equipos" && (
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#0052cc"
                    stroke-width="2.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                  </svg>
                )}
                {item.icono === "eficiencia" && (
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#0052cc"
                    stroke-width="2.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="5" />
                    <line x1="12" y1="1" x2="12" y2="3" />
                    <line x1="12" y1="21" x2="12" y2="23" />
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                    <line x1="1" y1="12" x2="3" y2="12" />
                    <line x1="21" y1="12" x2="23" y2="12" />
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
                  </svg>
                )}
              </div>
              <span class="etiqueta-nombre">{item.etiqueta}</span>
            </div>
          ))
        }
      </div>

      <!-- Columna Derecha: Tarjeta Azul con Descripciones -->
      <div class="descripciones-tarjeta-azul">
        {
          items.map((item) => (
            <div class="descripcion-fila-item">
              <p class="descripcion-texto">{item.descripcion}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: LO QUE NO HACEMOS (SUPERMERCADOS)
     ========================================================================== */
  .lo-que-no-hacemos-seccion {
    position: relative;
    width: 100%;
    /* Degradado oficial fluido de azul eléctrico corporativo que se ilumina hacia el blanco a la derecha */
    background: linear-gradient(
      90deg,
      #004aad 0%,
      #0059d6 25%,
      #006ef0 48%,
      #5ca2fc 70%,
      #bcd9ff 86%,
      #f0f6ff 96%,
      #ffffff 100%
    );
    color: #ffffff;
    padding: clamp(65px, 7vw, 105px) 0;
    overflow: hidden;
    box-sizing: border-box;
  }

  .lo-que-no-hacemos-contenedor {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Título */
  .no-hacemos-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.8rem, 1.6rem + 1vw, 2.4rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 clamp(32px, 4vw, 46px) 0;
  }

  /* Contenedor Solapado de las Tarjetas */
  .tarjetas-solapadas-wrap {
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 820px;
    position: relative;
  }

  /* Columna Izquierda: Fondo Blanco */
  .etiquetas-columna-blanca {
    background: #ffffff;
    border-radius: 24px 0 0 24px;
    padding: 24px 34px 24px 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    min-width: 200px;
    box-shadow: 0 14px 32px rgba(8, 29, 62, 0.12);
    z-index: 1;
    box-sizing: border-box;
  }

  .etiqueta-fila-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
  }

  .etiqueta-fila-item:first-child {
    border-bottom: 1px solid #f1f5f9;
  }

  .circulo-icono-celeste {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #e0edff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .etiqueta-nombre {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.02rem;
    font-weight: 700;
    color: #0052cc;
    letter-spacing: -0.01em;
  }

  /* Columna Derecha: Tarjeta Azul que solapa ligeramente */
  .descripciones-tarjeta-azul {
    background: #0052cc;
    border-radius: 24px;
    padding: 24px 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    flex: 1;
    margin-left: -18px;
    z-index: 2;
    box-shadow: 0 16px 38px rgba(0, 56, 130, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-sizing: border-box;
  }

  .descripcion-fila-item {
    display: flex;
    align-items: center;
    padding: 16px 0;
  }

  .descripcion-fila-item:first-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
  }

  .descripcion-texto {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: clamp(0.9rem, 0.86rem + 0.18vw, 0.98rem);
    line-height: 1.58;
    color: #ffffff;
    margin: 0;
    font-weight: 400;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 768px) {
    .tarjetas-solapadas-wrap {
      flex-direction: column;
      max-width: 100%;
    }

    .etiquetas-columna-blanca {
      border-radius: 20px 20px 0 0;
      padding: 18px 22px;
      min-width: 100%;
      flex-direction: row;
      justify-content: space-between;
    }

    .etiqueta-fila-item {
      padding: 6px 0;
    }

    .etiqueta-fila-item:first-child {
      border-bottom: none;
    }

    .descripciones-tarjeta-azul {
      margin-left: 0;
      margin-top: -10px;
      border-radius: 20px;
      padding: 22px 20px;
    }

    .descripcion-fila-item {
      padding: 14px 0;
    }
  }

  @media (max-width: 480px) {
    .etiquetas-columna-blanca {
      flex-direction: column;
      gap: 10px;
    }

    .etiqueta-fila-item:first-child {
      border-bottom: 1px solid #f1f5f9;
      padding-bottom: 12px;
    }
  }
</style>
