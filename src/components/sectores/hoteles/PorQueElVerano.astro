---
// Componente: PorQueElVerano.astro
// Sección de Hoteles: "POR QUÉ EL VERANO, se paga todo el año"
// 4 tarjetas explicativas sobre el desfase estacional de potencia en hoteles:
// 01. Se paga cada día
// 02. El pico arrastra
// 03. Julio no es agosto
// 04. Lo que pagas sin usar

interface TarjetaVerano {
  numero: string;
  titulo: string;
  icono: "calendario" | "arrastre" | "verano" | "sinusar";
  texto: string;
}

const tarjetas: TarjetaVerano[] = [
  {
    numero: "01",
    titulo: "Se paga cada día",
    icono: "calendario",
    texto:
      "La potencia se contrata para el momento de más demanda del año, normalmente la climatización de una tarde de verano, y se paga los 365 días. Con el hotel lleno o a medio gas.",
  },
  {
    numero: "02",
    titulo: "El pico arrastra",
    icono: "arrastre",
    texto:
      "En 3.0TD, cada periodo tiene que tener igual o más potencia que el anterior. Si tu pico cae en un periodo caro, esa potencia se extiende a todos los que van detrás.",
  },
  {
    numero: "03",
    titulo: "Julio no es agosto",
    icono: "verano",
    texto:
      "En la Península, julio es temporada eléctrica alta y agosto, temporada media. Una tarde de julio cae en P2; una de agosto, en P4. El kW de P2 cuesta casi tres veces el de P4 en peajes y cargos, y además obliga a P3, P4, P5 y P6 a tener como mínimo esa potencia. El mismo pico de climatización no cuesta lo mismo en un mes que en otro.",
  },
  {
    numero: "04",
    titulo: "Lo que pagas sin usar",
    icono: "sinusar",
    texto:
      "Es la diferencia entre la potencia que tienes contratada y la que tu hotel usa de verdad cada mes, periodo a periodo. En temporada baja, es la que más pesa.",
  },
];
---

<section class="verano-seccion" id="por-que-el-verano" aria-labelledby="verano-tit">
  <div class="verano-contenedor">
    <!-- Encabezado -->
    <div class="verano-header">
      <h2 class="verano-titulo" id="verano-tit">
        POR QUÉ EL VERANO, <span class="verano-cursiva">se paga todo el año</span>
      </h2>
      <p class="verano-bajada">
        La ocupación baja. La potencia contratada, no.
      </p>
    </div>

    <!-- Rejilla de las 4 tarjetas -->
    <div class="verano-grid">
      {
        tarjetas.map((t) => (
          <article class="verano-card">
            <!-- Insignia circular decorativa superior con icono alusivo y número en relieve -->
            <div class="verano-badge-wrap" aria-hidden="true">
              <div class="badge-circulo-azul">
                {t.icono === "calendario" && (
                  <svg
                    class="badge-svg-icono"
                    width="26"
                    height="26"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                )}

                {t.icono === "arrastre" && (
                  <svg
                    class="badge-svg-icono"
                    width="26"
                    height="26"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                    <polyline points="17 6 23 6 23 12" />
                  </svg>
                )}

                {t.icono === "verano" && (
                  <svg
                    class="badge-svg-icono"
                    width="26"
                    height="26"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="5" />
                    <line x1="12" y1="1" x2="12" y2="3" />
                    <line x1="12" y1="21" x2="12" y2="23" />
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                    <line x1="1" y1="12" x2="3" y2="12" />
                    <line x1="21" y1="12" x2="23" y2="12" />
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
                  </svg>
                )}

                {t.icono === "sinusar" && (
                  <svg
                    class="badge-svg-icono"
                    width="26"
                    height="26"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 14 14" />
                    <path d="M16 12h2" />
                    <path d="M12 16v2" />
                  </svg>
                )}
              </div>

              <!-- Círculo cian inferior con el número en relieve -->
              <div class="badge-circulo-cyan">
                <span class="badge-num">{t.numero}</span>
              </div>
            </div>

            <!-- Contenido de la tarjeta -->
            <h3 class="verano-card-tit">{t.titulo}</h3>
            <p class="verano-card-desc">{t.texto}</p>
          </article>
        ))
      }
    </div>

    <!-- Botón inferior a la guía de potencia -->
    <div class="verano-acciones-bottom">
      <a href="/guias/potencia-contratada" class="pildora-guia-verano" aria-label="Ir a la guía de potencia contratada: cuánta necesitas">
        <span>Potencia contratada: cuánta necesitas</span>
        <span class="pildora-circulo-flecha" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#00c2ff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: POR QUÉ EL VERANO, SE PAGA TODO EL AÑO (HOTELES)
     ========================================================================== */
  .verano-seccion {
    position: relative;
    width: 100%;
    background: #081d3e;
    color: #ffffff;
    padding: clamp(65px, 7vw, 105px) 0 clamp(75px, 8vw, 115px);
    overflow: hidden;
    box-sizing: border-box;
  }

  .verano-contenedor {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
  }

  /* Encabezado */
  .verano-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(48px, 6vw, 68px);
    max-width: 860px;
  }

  .verano-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.9rem + 1.2vw, 2.95rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 14px 0;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .verano-cursiva {
    display: inline;
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #00c2ff;
  }

  .verano-bajada {
    font-size: clamp(0.98rem, 0.94rem + 0.25vw, 1.1rem);
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
  }

  /* Rejilla de 4 tarjetas */
  .verano-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(18px, 2.2vw, 28px);
    align-items: stretch;
    margin-top: 24px;
    margin-bottom: 42px;
  }

  /* Tarjeta individual */
  .verano-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(11, 30, 64, 0.76);
    border: 1.5px solid rgba(56, 182, 255, 0.26);
    border-radius: 24px;
    padding: 56px 24px 34px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.32);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    box-sizing: border-box;
  }

  .verano-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 194, 255, 0.55);
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.44), 0 0 24px rgba(0, 194, 255, 0.12);
  }

  /* Insignia circular decorativa superior */
  .verano-badge-wrap {
    position: absolute;
    top: -38px;
    left: 50%;
    transform: translateX(-50%);
    width: 82px;
    height: 76px;
    pointer-events: none;
  }

  .badge-circulo-azul {
    position: absolute;
    top: 0;
    left: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #0052cc;
    box-shadow: 0 8px 20px rgba(0, 82, 204, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .verano-card:hover .badge-circulo-azul {
    transform: scale(1.04);
    background: #0060ed;
  }

  .badge-svg-icono {
    margin-top: -3px;
    margin-left: -3px;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }

  .badge-circulo-cyan {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #00c2ff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(0, 194, 255, 0.45);
    border: 2px solid #081d3e;
    transition: transform 0.25s ease;
  }

  .verano-card:hover .badge-circulo-cyan {
    transform: scale(1.08);
  }

  .badge-num {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.88rem;
    font-weight: 800;
    color: #081d3e;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* Título de la tarjeta */
  .verano-card-tit {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
    margin: 0 0 14px 0;
    line-height: 1.25;
  }

  /* Párrafo explicativo */
  .verano-card-desc {
    font-size: 0.89rem;
    line-height: 1.62;
    color: #cbd5e1;
    text-align: center;
    margin: 0;
    width: 100%;
  }

  /* Botón inferior */
  .verano-acciones-bottom {
    display: flex;
    margin-top: 10px;
  }

  .pildora-guia-verano {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #00c2ff;
    color: #081d3e;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    padding: 10px 18px 10px 22px;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0, 194, 255, 0.32);
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pildora-guia-verano:hover {
    background: #33d1ff;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 194, 255, 0.45);
  }

  .pildora-circulo-flecha {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #003882;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .pildora-guia-verano:hover .pildora-circulo-flecha {
    transform: translateX(2px);
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 1100px) {
    .verano-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px 24px;
    }
  }

  @media (max-width: 640px) {
    .verano-seccion {
      padding: 55px 0 65px;
    }

    .verano-grid {
      grid-template-columns: 1fr;
      gap: 52px;
    }

    .pildora-guia-verano {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
