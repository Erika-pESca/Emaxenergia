---
// Componente: ReglasSegunPotencia.astro
// Sección: "LAS REGLAS CAMBIAN según tu potencia"
// Comparativa técnica entre 2.0TD vs. 3.0TD para restaurantes y hostelería.
// 3 tarjetas con fondo y alineación perfecta fila por fila mediante CSS Subgrid y sincronización dinámica.

interface ConceptoFila {
  id: string;
  titulo: string;
  icono: "horas" | "potencia" | "finde" | "exceso" | "reactiva" | "importa";
  c20: string;
  c30: string;
}

const conceptos: ConceptoFila[] = [
  {
    id: "horas",
    titulo: "Las horas",
    icono: "horas",
    c20: "Punta, llano y valle. Punta, de 10:00 a 14:00 y de 18:00 a 22:00 entre semana.",
    c30: "Seis periodos, de P1 a P6, según la hora, el día y el mes del año.",
  },
  {
    id: "potencia",
    titulo: "La potencia",
    icono: "potencia",
    c20: "Dos potencias, una para punta y llano y otra para valle, sin pasar de 15 kW. Si tu contador no tiene telegestión, las dos tienen que ser iguales.",
    c30: "Seis potencias, y cada una tiene que ser igual o mayor que la anterior.",
  },
  {
    id: "finde",
    titulo: "El fin de semana",
    icono: "finde",
    c20: "Es valle todo el día, también para la potencia. Si tu cocina trabaja a tope el domingo a mediodía, tu potencia de valle tiene que cubrirlo: no puedes bajarla pensando que el valle es solo la madrugada.",
    c30: "Es P6 todo el día. Su potencia es la más barata y tiene que ser igual o mayor que la de los demás periodos, así que el pico del domingo cabe ahí sin subir los otros cinco.",
  },
  {
    id: "exceso",
    titulo: "Si te pasas de potencia",
    icono: "exceso",
    c20: "El contador corta, aunque estés en pleno servicio. No se cobran excesos.",
    c30: "No corta: se cobran excesos, y salen caros a propósito.",
  },
  {
    id: "reactiva",
    titulo: "La reactiva",
    icono: "reactiva",
    c20: "No se paga.",
    c30: "Se paga en P1 a P5 la que pasa del 33 % de la energía activa. Cámaras y extracción la generan.",
  },
  {
    id: "importa",
    titulo: "Lo que suele importar más",
    icono: "importa",
    c20: "Acertar las dos potencias con tu servicio real, también el del fin de semana.",
    c30: "La potencia de P1 y P2, que el servicio arrastra a los demás periodos, y la reactiva de cámaras y extracción.",
  },
];
---

<section class="reglas-seccion" id="tu-peaje" aria-labelledby="reglas-titulo">
  <div class="reglas-contenedor">
    <!-- Cabecera -->
    <div class="reglas-header">
      <h2 class="reglas-h2" id="reglas-titulo">
        LAS REGLAS CAMBIAN <span class="reglas-cursiva">según tu potencia</span>
      </h2>
      <p class="reglas-subtitulo">
        En hostelería conviven locales con 15 kW o menos (peaje 2.0TD) y locales con más (3.0TD). No se juega con las mismas reglas. Tu potencia contratada aparece en la factura.
      </p>
    </div>

    <!-- Comparativa Matrix 3 Columnas con Tarjeta en cada Columna -->
    <div class="comparativa-scroll-wrap">
      <div class="comparativa-matrix" id="matriz-comparativa-potencia">
        <!-- Columna 1: Tarjeta con fondo claro para los conceptos -->
        <div class="col-card card-conceptos-claro">
          <div class="col-card-header col-card-header-vacia" aria-hidden="true">
            <span class="pill-badge pill-suave">Conceptos clave</span>
          </div>
          {
            conceptos.map((item) => (
              <div class="card-celda-fila celda-concepto-item" data-fila-celda={item.id}>
                <div class="concepto-circulo" aria-hidden="true">
                  {item.icono === "horas" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#004aad" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>
                  )}
                  {item.icono === "potencia" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#004aad" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                    </svg>
                  )}
                  {item.icono === "finde" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#004aad" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                      <line x1="16" y1="2" x2="16" y2="6" />
                      <line x1="8" y1="2" x2="8" y2="6" />
                      <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                  )}
                  {item.icono === "exceso" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#004aad" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2" />
                      <line x1="12" y1="8" x2="12" y2="12" />
                      <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                  )}
                  {item.icono === "reactiva" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#004aad" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12c2.5 0 2.5-6 5-6s2.5 12 5 12 2.5-12 5-12 2.5 6 5 6" />
                    </svg>
                  )}
                  {item.icono === "importa" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#004aad" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                    </svg>
                  )}
                </div>
                <span class="concepto-nombre">{item.titulo}</span>
              </div>
            ))
          }
        </div>

        <!-- Columna 2: Tarjeta Blanca Flotante (Con 15 kW o menos · 2.0TD) -->
        <div class="col-card card-pequeno-blanco">
          <div class="col-card-header">
            <span class="pill-badge pill-navy">Con 15 kW o menos · 2.0TD</span>
          </div>
          {
            conceptos.map((item) => (
              <div class="card-celda-fila celda-20" data-fila-celda={item.id}>
                <span class="celda-label-movil">{item.titulo}:</span>
                <p class="celda-texto">{item.c20}</p>
              </div>
            ))
          }
        </div>

        <!-- Columna 3: Tarjeta Azul Marina (Con más de 15 kW · 3.0TD) -->
        <div class="col-card card-grande-noche">
          <div class="col-card-header">
            <span class="pill-badge pill-blanca">Con más de 15 kW · 3.0TD</span>
          </div>
          {
            conceptos.map((item) => (
              <div class="card-celda-fila celda-30" data-fila-celda={item.id}>
                <span class="celda-label-movil">{item.titulo}:</span>
                <p class="celda-texto">{item.c30}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Bloque Inferior de Botones de Acción y Guías -->
    <div class="reglas-acciones-bottom">
      <!-- Fila 1: Botón principal de análisis que abre el formulario oficial de EMAX -->
      <div class="fila-cta-analisis">
        <button
          type="button"
          class="btn-analizar-local"
          data-abrir-funnel
          data-tramo-msg="Análisis de potencia y peajes (2.0TD / 3.0TD) para local de restaurante y hostelería."
          aria-label="Abrir formulario para analizar mi local"
        >
          <span>Analizar mi local</span>
          <span class="btn-circulo-flecha" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#081d3e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </span>
        </button>
      </div>

      <!-- Fila 2: Píldoras cian que enlazan con las guías técnicas correspondientes -->
      <div class="fila-pildoras-guias" role="navigation" aria-label="Guías técnicas relacionadas">
        <a href="/guias/potencia-contratada" class="pildora-guia">
          <span>Potencia contratada</span>
          <span class="pildora-arrow" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#003580" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </span>
        </a>

        <a href="/guias/exceso-de-potencia" class="pildora-guia">
          <span>Exceso de potencia</span>
          <span class="pildora-arrow" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#003580" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </span>
        </a>

        <a href="/guias/energia-reactiva" class="pildora-guia">
          <span>Energía reactiva</span>
          <span class="pildora-arrow" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#003580" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: LAS REGLAS CAMBIAN SEGÚN TU POTENCIA (HOSTELERÍA)
     ========================================================================== */
  .reglas-seccion {
    position: relative;
    width: 100%;
    background: #ffffff;
    color: #0f172a;
    padding: clamp(65px, 7vw, 105px) 0 clamp(75px, 8vw, 115px);
    overflow: hidden;
    box-sizing: border-box;
  }

  .reglas-contenedor {
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
  }

  /* Encabezado */
  .reglas-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(40px, 5vw, 56px);
    max-width: 860px;
  }

  .reglas-h2 {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.9rem + 1.2vw, 2.95rem);
    font-weight: 800;
    color: #081d3e;
    line-height: 1.15;
    margin: 0 0 14px 0;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .reglas-cursiva {
    display: inline;
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #2563eb;
  }

  .reglas-subtitulo {
    font-size: clamp(0.98rem, 0.94rem + 0.2vw, 1.08rem);
    line-height: 1.62;
    color: #475569;
    margin: 0;
  }

  /* ==========================================================================
     COMPARATIVA MATRIX 3 COLUMNAS: ALINEACIÓN PERFECTA CON SUBGRID
     ========================================================================== */
  .comparativa-scroll-wrap {
    width: 100%;
    margin-bottom: 40px;
  }

  .comparativa-matrix {
    display: grid;
    grid-template-columns: minmax(210px, 245px) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: 64px repeat(6, auto);
    gap: clamp(16px, 2vw, 26px);
    align-items: stretch;
  }

  /* Cada una de las 3 tarjetas ocupa las 7 filas y usa subgrid */
  .col-card {
    grid-row: span 7;
    display: grid;
    grid-template-rows: subgrid;
    border-radius: 26px;
    padding: 24px 28px 28px;
    box-sizing: border-box;
  }

  .col-card-header {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-bottom: 12px;
    box-sizing: border-box;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 22px;
    border-radius: 9999px;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-align: center;
  }

  .pill-navy {
    background: #081d3e;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(8, 29, 62, 0.25);
  }

  .pill-blanca {
    background: #ffffff;
    color: #004aad;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }

  .pill-suave {
    background: #ffffff;
    color: #004aad;
    border: 1.5px solid #d0e2fa;
    box-shadow: 0 2px 8px rgba(0, 74, 173, 0.06);
    font-size: 0.85rem;
  }

  /* Celdas individuales alineadas fila a fila */
  .card-celda-fila {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 18px 0;
    box-sizing: border-box;
  }

  .celda-label-movil {
    display: none;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 4px;
  }

  .celda-texto {
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }

  /* --------------------------------------------------------------------------
     COLUMNA 1: Tarjeta con fondo claro para conceptos
     -------------------------------------------------------------------------- */
  .card-conceptos-claro {
    background: #f1f6fd;
    border: 1.5px solid #dce8f8;
    box-shadow: 0 6px 24px rgba(0, 74, 173, 0.06);
    padding: 24px 22px 28px;
  }

  .celda-concepto-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14px;
  }

  .concepto-circulo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffffff;
    border: 1.5px solid #cce3fd;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 3px 10px rgba(0, 74, 173, 0.1);
  }

  .concepto-nombre {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.98rem;
    font-weight: 700;
    color: #004aad;
    line-height: 1.25;
  }

  .card-conceptos-claro .card-celda-fila:not(:last-child) {
    border-bottom: 1px solid #dce8f8;
  }

  /* --------------------------------------------------------------------------
     COLUMNA 2: Tarjeta Blanca Flotante (2.0TD)
     -------------------------------------------------------------------------- */
  .card-pequeno-blanco {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    box-shadow: 0 20px 48px rgba(0, 42, 108, 0.12), 0 4px 12px rgba(0, 0, 0, 0.04);
    color: #1e293b;
    position: relative;
    z-index: 2;
  }

  .card-pequeno-blanco .card-celda-fila:not(:last-child) {
    border-bottom: 1px solid #edf2f7;
  }

  /* --------------------------------------------------------------------------
     COLUMNA 3: Tarjeta Noche Azul Marino (3.0TD)
     -------------------------------------------------------------------------- */
  .card-grande-noche {
    background: #081d3e;
    color: #e2e8f0;
    box-shadow: 0 16px 40px rgba(8, 29, 62, 0.35);
    position: relative;
    z-index: 1;
  }

  .card-grande-noche .card-celda-fila:not(:last-child) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .card-grande-noche .celda-texto {
    color: #d1d9e6;
  }

  /* ==========================================================================
     BOTONES INFERIORES DE ACCIÓN
     ========================================================================== */
  .reglas-acciones-bottom {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 10px;
  }

  /* Fila 1: Botón Analizar mi local */
  .btn-analizar-local {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #004aad;
    color: #ffffff;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 74, 173, 0.35);
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-analizar-local:hover {
    background: #0056cc;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 74, 173, 0.45);
  }

  .btn-circulo-flecha {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #00c2ff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .btn-analizar-local:hover .btn-circulo-flecha {
    transform: translateX(2px);
  }

  /* Fila 2: Píldoras cian */
  .fila-pildoras-guias {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .pildora-guia {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #00c2ff;
    color: #081d3e;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.88rem;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 3px 12px rgba(0, 194, 255, 0.28);
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pildora-guia:hover {
    background: #33d1ff;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 194, 255, 0.4);
  }

  .pildora-arrow {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(8, 29, 62, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .pildora-guia:hover .pildora-arrow {
    transform: translateX(2px);
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 960px) {
    .comparativa-matrix {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 32px;
    }

    .col-card {
      grid-row: auto;
      display: flex;
      flex-direction: column;
    }

    .card-conceptos-claro {
      display: none;
    }

    .card-celda-fila {
      min-height: auto !important;
    }

    .celda-label-movil {
      display: block;
      color: #004aad;
    }

    .card-grande-noche .celda-label-movil {
      color: #38b6ff;
    }

    .col-card-header {
      height: auto;
      margin-bottom: 16px;
    }
  }

  @media (max-width: 600px) {
    .fila-pildoras-guias {
      flex-direction: column;
      align-items: flex-start;
    }

    .pildora-guia,
    .btn-analizar-local {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

<script>
  // Sincronización dinámica de alturas para asegurar alineación milimétrica en cualquier navegador y ancho
  function sincronizarAlturasComparativa() {
    if (window.innerWidth <= 960) return;

    const matriz = document.getElementById('matriz-comparativa-potencia');
    if (!matriz) return;

    const filas = ['horas', 'potencia', 'finde', 'exceso', 'reactiva', 'importa'];

    // 1. Limpiar alturas forzadas previas
    const celdas = matriz.querySelectorAll<HTMLElement>('[data-fila-celda]');
    celdas.forEach((c) => {
      c.style.minHeight = '';
    });

    // 2. Medir la altura máxima por fila y aplicarla a las 3 celdas de esa fila
    filas.forEach((id) => {
      const celdasFila = matriz.querySelectorAll<HTMLElement>(`[data-fila-celda="${id}"]`);
      let maxH = 0;
      celdasFila.forEach((c) => {
        const h = c.offsetHeight;
        if (h > maxH) maxH = h;
      });
      if (maxH > 0) {
        celdasFila.forEach((c) => {
          c.style.minHeight = `${maxH}px`;
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', sincronizarAlturasComparativa);
  } else {
    sincronizarAlturasComparativa();
  }

  window.addEventListener('resize', sincronizarAlturasComparativa);
  document.addEventListener('astro:page-load', sincronizarAlturasComparativa);
</script>
