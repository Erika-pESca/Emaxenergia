---
// Componente: CocinaDeGas.astro
// Sección banner de Restaurantes y Hostelería: "Si tu cocina ES DE GAS"
// Fondo fotográfico de cocina de gas a la derecha con degradado azul corporativo a la izquierda según boceto oficial.

import bannerGasImg from "../../../imagenes/sectores/sectores_restaurante/Banner.png";
---

<section class="cocina-gas-seccion" id="cocina-de-gas" aria-labelledby="cocina-gas-tit">
  <!-- Fondo fotográfico encuadrado a la derecha + degradado azul corporativo -->
  <div class="cocina-gas-bg" aria-hidden="true">
    <div class="cocina-gas-foto-wrap">
      <img
        src={bannerGasImg.src}
        alt=""
        class="cocina-gas-img"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="cocina-gas-gradient"></div>
  </div>

  <div class="cocina-gas-contenedor">
    <div class="cocina-gas-content">
      <h2 class="cocina-gas-titulo" id="cocina-gas-tit">
        <span class="cocina-gas-cursiva">Si tu cocina</span> ES DE GAS
      </h2>
      <p class="cocina-gas-texto">
        Con cocina de gas, tu luz es el frío, la extracción, el lavavajillas, la climatización y la sala. Sigue habiendo una potencia que acertar y, si pasas de 15 kW, una reactiva que mirar.
      </p>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN BANNER: SI TU COCINA ES DE GAS (RESTAURANTES)
     ========================================================================== */
  .cocina-gas-seccion {
    position: relative;
    width: 100%;
    min-height: clamp(320px, 34vw, 420px);
    display: flex;
    align-items: center;
    background: #004aad;
    color: #ffffff;
    padding: clamp(64px, 7vw, 100px) 0;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Fondo fotográfico posicionado en el bloque derecho como en el boceto */
  .cocina-gas-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    background: #004aad;
  }

  .cocina-gas-foto-wrap {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 72%;
    overflow: hidden;
  }

  .cocina-gas-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 52%;
    display: block;
  }

  /* Degradado oficial: Azul intenso a la izquierda fundiéndose suavemente sobre la encimera y los fuegos */
  .cocina-gas-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #003d99 0%,
      #004aad 22%,
      #005ce6 38%,
      rgba(0, 92, 230, 0.92) 44%,
      rgba(0, 92, 230, 0.55) 52%,
      rgba(0, 92, 230, 0.18) 60%,
      transparent 68%
    );
  }

  .cocina-gas-contenedor {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
    display: flex;
    align-items: center;
  }

  .cocina-gas-content {
    display: flex;
    flex-direction: column;
    max-width: 490px;
    width: 100%;
  }

  .cocina-gas-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.9rem + 1.2vw, 2.95rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 18px 0;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .cocina-gas-cursiva {
    display: inline;
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #00c2ff;
    margin-right: 6px;
  }

  .cocina-gas-texto {
    font-size: clamp(0.98rem, 0.94rem + 0.2vw, 1.08rem);
    line-height: 1.65;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 768px) {
    .cocina-gas-foto-wrap {
      width: 100%;
    }

    .cocina-gas-gradient {
      background: linear-gradient(
        180deg,
        rgba(0, 61, 153, 0.92) 0%,
        rgba(0, 74, 173, 0.85) 60%,
        rgba(0, 74, 173, 0.72) 100%
      );
    }

    .cocina-gas-seccion {
      padding: 54px 0;
      min-height: auto;
    }

    .cocina-gas-content {
      max-width: 100%;
    }

    .cocina-gas-titulo {
      font-size: 2rem;
    }
  }
</style>
