---
// Componente: HeroRestaurantes.astro
// Hero oficial para la página: /sectores/restaurantes ("Luz para restaurantes y hostelería")
// Fiel al boceto oficial Sectores_restaurantes con el chef emplatando a la derecha, degradado azul corporativo y tarjeta translúcida.

import restauranteImg from "../../../imagenes/sectores/sectores_restaurante/Hero (5).png";

const tramosLuz = [
  {
    id: "300",
    label: "MENOS DE 300€",
    valor: "<300",
    rango: "menos de 300 € al mes",
    msg: "Revisaremos tu factura de restaurante u hostelería para detectar si tu potencia de cocina o climatización está sobredimensionada.",
  },
  {
    id: "1000",
    label: "300 - 1.000€",
    valor: "300-1000",
    rango: "entre 300 y 1.000 € al mes",
    msg: "Auditamos tu potencia en P1-P6 durante el servicio de comidas y cenas, evitando penalizaciones de maxímetro y recargos innecesarios.",
  },
  {
    id: "3000",
    label: "1.000 - 3.000€",
    valor: "1000-3000",
    rango: "entre 1.000 y 3.000 € al mes",
    msg: "Estudiamos la curva de cuartohorarias del servicio de mediodía (planchas, freidoras, extracción) y optimizamos tu peaje 3.0TD.",
  },
  {
    id: "mas3000",
    label: "Más de 3.000€",
    valor: ">3000",
    rango: "más de 3.000 € al mes",
    msg: "Consultoría especializada para grupos de restauración, hoteles y grandes comedores: coberturas OMIP y negociación a medida.",
  },
];
---

<section class="restaurantes-hero-root" aria-labelledby="h1-restaurantes">
  <!-- Fondo fotográfico a ancho completo con el chef a la derecha y fusión azul corporativa -->
  <div class="restaurantes-hero-bg" aria-hidden="true">
    <img
      src={restauranteImg.src}
      alt=""
      class="hero-bg-img"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="hero-bg-gradient"></div>
  </div>

  <div class="restaurantes-hero-contenedor">
    <div class="restaurantes-hero-grid">
      <!-- Columna Izquierda: Titulares y propuesta técnica -->
      <div class="restaurantes-hero-textos">
        <div class="restaurantes-kicker">
          <span>LUZ PARA RESTAURANTES Y HOSTELERÍA</span>
          <span class="restaurantes-kicker-bar" aria-hidden="true">|</span>
        </div>

        <h1 class="restaurantes-h1" id="h1-restaurantes">
          <span class="h1-cursiva-cyan">Lo que pasa</span> EN TU FACTURA A LAS DOS DE LA TARDE
        </h1>

        <p class="restaurantes-subtitulo">
          En pleno servicio, planchas, freidoras y extracción marcan tu potencia. Leemos tu factura con las reglas de tu peaje.
        </p>
      </div>

      <!-- Columna Derecha: Tarjeta translúcida con selector de tramos -->
      <div class="restaurantes-hero-card-col">
        <div class="hero-card-glass">
          <h2 class="card-pregunta-tit">¿Cuánto paga tu empresa de luz al mes?</h2>
          <p class="card-pregunta-sub">
            En total, sumando todos tus suministros. Con una cifra aproximada nos basta.
          </p>

          <!-- Rejilla 2x2 de botones de tramo -->
          <div class="card-tramos-grid" role="group" aria-label="Selección de tramo mensual de luz">
            {
              tramosLuz.map((t) => (
                <button
                  type="button"
                  class="btn-tramo-azul"
                  data-abrir-funnel
                  data-tramo-id={t.valor}
                  data-tramo-label={t.label}
                  data-tramo-rango={t.rango}
                  data-tramo-msg={t.msg}
                  aria-label={`Seleccionar tramo ${t.label} para abrir estudio energético`}
                >
                  <span class="tramo-txt">{t.label}</span>
                  <span class="tramo-flecha" aria-hidden="true">
                    <svg
                      width="13"
                      height="13"
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M6 3.5 10.5 8 6 12.5"></path>
                    </svg>
                  </span>
                </button>
              ))
            }
          </div>

          <!-- Pie de tarjeta -->
          <p class="card-nota-pie">
            Tú eliges cómo empezamos: con tu factura, con tu CUPS o con dos datos de tu negocio. El análisis no tiene coste.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     HERO RESTAURANTES Y HOSTELERÍA: DISEÑO OFICIAL BOCETO (ANCHO COMPLETO ORIGINAL)
     ========================================================================== */
  .restaurantes-hero-root {
    position: relative;
    z-index: 20;
    margin-top: -78px;
    width: 100%;
    min-height: calc(88vh + 78px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #004aad;
    overflow: hidden;
    padding-top: calc(78px + clamp(36px, 5vh, 52px));
    padding-bottom: clamp(48px, 6vh, 72px);
    box-sizing: border-box;
  }

  /* Fondo con fotografía a ancho completo */
  .restaurantes-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    background: #004aad;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    display: block;
  }

  /* Gradiente oficial: Azul corporativo sólido a la izquierda fusionándose hacia la derecha */
  .hero-bg-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #004aad 0%,
      #004aad 40%,
      rgba(0, 74, 173, 0.94) 48%,
      rgba(10, 82, 184, 0.62) 58%,
      rgba(20, 92, 194, 0.28) 68%,
      rgba(20, 92, 194, 0.08) 76%,
      transparent 84%
    );
  }

  /* Contenedor principal con su ancho y padding originales */
  .restaurantes-hero-contenedor {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 52px);
    box-sizing: border-box;
  }

  /* Grid 2 Columnas con proporciones de ancho originales */
  .restaurantes-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 68px);
    align-items: center;
  }

  /* Textos izquierda con su ancho original */
  .restaurantes-hero-textos {
    display: flex;
    flex-direction: column;
    max-width: 620px;
  }

  .restaurantes-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Sora", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 14px;
  }

  .restaurantes-kicker-bar {
    color: #00c2ff;
    font-weight: 700;
    font-size: 1.15em;
  }

  .restaurantes-h1 {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.3rem, 2rem + 1.8vw, 3.4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.12;
    margin: 0 0 20px;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .h1-cursiva-cyan {
    display: inline;
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    color: #00c2ff;
    text-transform: none;
    letter-spacing: 0;
  }

  .restaurantes-subtitulo {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.12rem);
    line-height: 1.62;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    max-width: 540px;
  }

  /* Tarjeta Glassmorphic derecha */
  .restaurantes-hero-card-col {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .hero-card-glass {
    width: 100%;
    max-width: 630px;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.28) 0%,
      rgba(220, 234, 252, 0.2) 100%
    );
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 22px;
    padding: clamp(26px, 3.2vw, 38px) clamp(26px, 3.4vw, 42px);
    box-shadow: 0 20px 48px rgba(0, 20, 60, 0.2);
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-sizing: border-box;
  }

  .card-pregunta-tit {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.3rem, 1.15rem + 0.45vw, 1.58rem);
    font-weight: 700;
    color: #004aad;
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .card-pregunta-sub {
    font-size: 0.92rem;
    line-height: 1.5;
    color: #111827;
    font-weight: 500;
    margin: -4px 0 8px;
    max-width: 480px;
  }

  /* Rejilla 2x2 de botones */
  .card-tramos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 20px;
  }

  @media (max-width: 540px) {
    .card-tramos-grid {
      grid-template-columns: 1fr;
    }
  }

  .btn-tramo-azul {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 15px 18px 15px 22px;
    background: #004aad;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    cursor: pointer;
    font-family: "Sora", sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    box-shadow: 0 4px 14px rgba(0, 40, 110, 0.25);
    transition: background-color 0.2s ease, transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    text-align: left;
    outline: none;
  }

  .btn-tramo-azul:hover {
    background: #0059cf;
    border-color: #00c2ff;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 50, 130, 0.4);
  }

  .btn-tramo-azul:active {
    transform: translateY(0);
  }

  .tramo-txt {
    flex: 1;
    white-space: nowrap;
  }

  /* Círculo cian con icono chevron */
  .tramo-flecha {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #00c2ff;
    color: #004aad;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .btn-tramo-azul:hover .tramo-flecha {
    transform: translateX(2px);
    background: #ffffff;
  }

  .card-nota-pie {
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.48;
    color: #111827;
    margin: 10px 0 0;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 1024px) {
    .restaurantes-hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .restaurantes-hero-textos {
      max-width: 100%;
    }

    .restaurantes-hero-card-col {
      justify-content: flex-start;
      padding-top: 0;
    }

    .hero-card-glass {
      max-width: 100%;
    }

    .hero-bg-gradient {
      background: linear-gradient(
        180deg,
        rgba(0, 74, 173, 0.92) 0%,
        rgba(0, 74, 173, 0.84) 55%,
        rgba(4, 40, 100, 0.88) 100%
      );
    }
  }

  @media (max-width: 640px) {
    .restaurantes-hero-root {
      min-height: auto;
      padding-top: calc(78px + 28px);
      padding-bottom: 48px;
    }

    .restaurantes-h1 {
      font-size: 2.1rem;
    }

    .hero-card-glass {
      padding: 22px 18px;
      border-radius: 20px;
    }
  }
</style>
