---
// Componente: UnServicioLeidoEnFactura.astro
// Sección de Restaurantes y Hostelería: "UN SERVICIO, leído en la factura"
// 3 tarjetas explicativas sobre el comportamiento del consumo: Las horas, El pico y El frío.
// Círculos superiores con iconos alusivos al contenido + número de etapa en relieve.

interface TarjetaServicio {
  numero: string;
  titulo: string;
  texto: string;
  icono: "horas" | "pico" | "frio";
}

const tarjetas: TarjetaServicio[] = [
  {
    numero: "01",
    titulo: "Las horas",
    icono: "horas",
    texto:
      "Tus dos servicios caen en las horas caras. La comida empieza en punta y acaba en llano; la cena, igual. Lo que gastas en un servicio paga los peajes y cargos de las horas caras, no los de la madrugada.",
  },
  {
    numero: "02",
    titulo: "El pico",
    icono: "pico",
    texto:
      "Cuando coinciden planchas, hornos, freidoras, lavavajillas y extracción, tu local pide de golpe la potencia más alta de la semana. Ese pico es el que decide cuánta potencia tienes que contratar.",
  },
  {
    numero: "03",
    titulo: "El frío",
    icono: "frio",
    texto:
      "Por debajo de todo, las cámaras y los botelleros no paran: ni de noche, ni el día que cierras. Es la base de tu factura, aunque no se note en el servicio.",
  },
];
---

<section class="un-servicio-seccion" id="un-servicio-factura" aria-labelledby="un-servicio-tit">
  <div class="un-servicio-contenedor">
    <!-- Cabecera de la sección: titular en dos tiempos con cursiva de marca -->
    <div class="un-servicio-header">
      <h2 class="un-servicio-titulo" id="un-servicio-tit">
        UN SERVICIO, <span class="un-servicio-cursiva">leído en la factura</span>
      </h2>
      <p class="un-servicio-bajada">
        El frío trabaja todo el día. La cocina concentra el consumo en dos servicios.
      </p>
    </div>

    <!-- Rejilla de las 3 tarjetas de servicio -->
    <div class="un-servicio-grid">
      {
        tarjetas.map((t) => (
          <article class="servicio-card">
            <!-- Insignia circular decorativa superior con icono alusivo y número en relieve -->
            <div class="servicio-badge-wrap" aria-hidden="true">
              <div class="badge-circulo-azul">
                {t.icono === "horas" && (
                  <svg
                    class="badge-svg-icono"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                )}

                {t.icono === "pico" && (
                  <svg
                    class="badge-svg-icono"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                  </svg>
                )}

                {t.icono === "frio" && (
                  <svg
                    class="badge-svg-icono"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" y1="2" x2="12" y2="22" />
                    <line x1="2" y1="12" x2="22" y2="12" />
                    <line x1="5" y1="5" x2="19" y2="19" />
                    <line x1="5" y1="19" x2="19" y2="5" />
                    <polyline points="10 4 12 2 14 4" />
                    <polyline points="10 20 12 22 14 20" />
                    <polyline points="4 10 2 12 4 14" />
                    <polyline points="20 10 22 12 20 14" />
                  </svg>
                )}
              </div>

              <!-- Círculo cian inferior con el número en relieve -->
              <div class="badge-circulo-cyan">
                <span class="badge-num">{t.numero}</span>
              </div>
            </div>

            <!-- Contenido de la tarjeta -->
            <h3 class="servicio-card-tit">{t.titulo}</h3>
            <p class="servicio-card-desc">{t.texto}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: UN SERVICIO, LEÍDO EN LA FACTURA (RESTAURANTES)
     ========================================================================== */
  .un-servicio-seccion {
    position: relative;
    width: 100%;
    background: #081d3e;
    color: #ffffff;
    padding: clamp(65px, 7vw, 105px) 0 clamp(75px, 8vw, 115px);
    overflow: hidden;
    box-sizing: border-box;
  }

  .un-servicio-contenedor {
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
  }

  /* Encabezado */
  .un-servicio-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(48px, 6vw, 68px);
    max-width: 820px;
  }

  .un-servicio-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.9rem + 1.2vw, 2.95rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 14px 0;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .un-servicio-cursiva {
    display: inline;
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #00c2ff;
  }

  .un-servicio-bajada {
    font-size: clamp(0.98rem, 0.94rem + 0.25vw, 1.1rem);
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
  }

  /* Rejilla de 3 tarjetas */
  .un-servicio-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 36px);
    align-items: stretch;
    margin-top: 24px;
  }

  /* Tarjeta individual */
  .servicio-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(11, 30, 64, 0.76);
    border: 1.5px solid rgba(56, 182, 255, 0.26);
    border-radius: 24px;
    padding: 56px 30px 36px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.32);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    box-sizing: border-box;
  }

  .servicio-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 194, 255, 0.55);
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.44), 0 0 24px rgba(0, 194, 255, 0.12);
  }

  /* Insignia circular decorativa superior con 2 círculos superpuestos */
  .servicio-badge-wrap {
    position: absolute;
    top: -38px;
    left: 50%;
    transform: translateX(-50%);
    width: 82px;
    height: 76px;
    pointer-events: none;
  }

  .badge-circulo-azul {
    position: absolute;
    top: 0;
    left: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #0052cc;
    box-shadow: 0 8px 20px rgba(0, 82, 204, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .servicio-card:hover .badge-circulo-azul {
    transform: scale(1.04);
    background: #0060ed;
  }

  .badge-svg-icono {
    margin-top: -3px;
    margin-left: -3px;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }

  .badge-circulo-cyan {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #00c2ff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(0, 194, 255, 0.45);
    border: 2px solid #081d3e;
    transition: transform 0.25s ease;
  }

  .servicio-card:hover .badge-circulo-cyan {
    transform: scale(1.08);
  }

  .badge-num {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.88rem;
    font-weight: 800;
    color: #081d3e;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* Título de la tarjeta */
  .servicio-card-tit {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.38rem;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
    margin: 0 0 16px 0;
    line-height: 1.25;
  }

  /* Párrafo explicativo */
  .servicio-card-desc {
    font-size: 0.94rem;
    line-height: 1.64;
    color: #cbd5e1;
    text-align: left;
    margin: 0;
    width: 100%;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 960px) {
    .un-servicio-grid {
      grid-template-columns: 1fr;
      gap: 52px;
      max-width: 580px;
      margin-inline: auto;
      margin-top: 32px;
    }

    .servicio-card {
      padding: 52px 26px 32px;
    }
  }

  @media (max-width: 640px) {
    .un-servicio-seccion {
      padding: 55px 0 65px;
    }

    .un-servicio-titulo {
      font-size: 1.9rem;
    }

    .un-servicio-grid {
      gap: 48px;
    }
  }
</style>
