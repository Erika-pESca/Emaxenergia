---
// Componente: DosRestaurantesMismoTamano.astro
// Sección: "DOS RESTAURANTES DEL MISMO TAMAÑO | Puedes llenar TODAS LAS MESAS. Y seguir dejándote margen en la factura."
// Comparativa entre Restaurante A (cocina eléctrica, cenas y fin de semana) vs Restaurante B (cocina de gas, menú del día).

import imgRestauranteA from "../../../imagenes/restaurante_a_abierto.jpg";
import imgRestauranteB from "../../../imagenes/restaurante_b_cerrado.jpg";

interface FilaCaracteristica {
  titulo: string;
  icono: "trabaja" | "peaje" | "potencia" | "reactiva" | "luz";
  textoA: string;
  textoB: string;
}

const caracteristicas: FilaCaracteristica[] = [
  {
    titulo: "Cómo trabaja",
    icono: "trabaja",
    textoA: "Cocina eléctrica. Cenas todos los días y el fin de semana lleno.",
    textoB: "Cocina de gas. Menú del día entre semana; cierra sábado y domingo.",
  },
  {
    titulo: "Su peaje",
    icono: "peaje",
    textoA: "Pasa de 15 kW: 3.0TD.",
    textoB: "No llega: 2.0TD.",
  },
  {
    titulo: "Su potencia",
    icono: "potencia",
    textoA:
      "La del fin de semana es la que manda: va en P6, que siempre es igual o mayor que las demás. P1 y P2 se ajustan al pico de los servicios entre semana.",
    textoB:
      "Dos potencias distintas: la de punta, para el servicio de mediodía; la de valle, mucho más baja, porque el fin de semana solo trabaja el frío. Si su contador tiene telegestión.",
  },
  {
    titulo: "La reactiva",
    icono: "reactiva",
    textoA: "Se revisa: extracción y cámaras la generan, y en 3.0TD se paga.",
    textoB: "No se paga.",
  },
  {
    titulo: "Su luz",
    icono: "luz",
    textoA: "Cocina, extracción, frío, lavavajillas y sala.",
    textoB: "Frío, extracción, lavavajillas y sala. La cocina va a gas.",
  },
];
---

<section class="dos-restaurantes-seccion" id="dos-restaurantes-comparativa" aria-labelledby="dos-restaurantes-tit">
  <div class="dos-restaurantes-contenedor">
    <!-- Encabezado -->
    <div class="dos-restaurantes-header">
      <div class="etiqueta-kicker">
        <span>DOS RESTAURANTES DEL MISMO TAMAÑO</span>
        <span class="separador-barra" aria-hidden="true">|</span>
      </div>

      <h2 class="dos-restaurantes-titulo" id="dos-restaurantes-tit">
        <span class="tit-cursiva">Puedes llenar</span> TODAS LAS MESAS.<br />
        <span class="tit-segunda-linea">Y seguir dejándote margen en la factura.</span>
      </h2>

      <p class="dos-restaurantes-subtitulo">
        Mismo barrio, mismas mesas. Desde la calle se parecen. En la factura, no tienen nada que ver.
      </p>
    </div>

    <!-- Rejilla de las 2 Grandes Tarjetas -->
    <div class="comparativa-tarjetas-grid">
      <!-- RESTAURANTE A -->
      <article class="tarjeta-restaurante" aria-label="Análisis de Restaurante A">
        <div class="tarjeta-media">
          <img
            src={imgRestauranteA.src}
            alt="Cocina abierta y comedor lleno de comensales en el Restaurante A"
            class="tarjeta-foto"
            loading="lazy"
            decoding="async"
          />
          <div class="badge-restaurante">Restaurante A</div>
        </div>

        <div class="tarjeta-cuerpo">
          <ul class="filas-stack" role="list">
            {
              caracteristicas.map((c) => (
                <li class="fila-detalle">
                  <div class="circulo-icono-azul" aria-hidden="true">
                    {c.icono === "trabaja" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                      </svg>
                    )}
                    {c.icono === "peaje" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <line x1="2" y1="10" x2="22" y2="10" />
                      </svg>
                    )}
                    {c.icono === "potencia" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                      </svg>
                    )}
                    {c.icono === "reactiva" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 12c2.5 0 2.5-6 5-6s2.5 12 5 12 2.5-12 5-12 2.5 6 5 6" />
                      </svg>
                    )}
                    {c.icono === "luz" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="3" />
                        <path d="M12 17a5 5 0 0 0 5-5c0-2.76-2.24-5-5-5s-5 2.24-5 5a5 5 0 0 0 5 5z" />
                        <line x1="12" y1="21" x2="12" y2="23" />
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                        <line x1="1" y1="12" x2="3" y2="12" />
                        <line x1="21" y1="12" x2="23" y2="12" />
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
                      </svg>
                    )}
                  </div>
                  <div class="fila-textos">
                    <h3 class="fila-titulo">{c.titulo}</h3>
                    <p class="fila-desc">{c.textoA}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <!-- RESTAURANTE B -->
      <article class="tarjeta-restaurante" aria-label="Análisis de Restaurante B">
        <div class="tarjeta-media">
          <img
            src={imgRestauranteB.src}
            alt="Cocina de gas cerrada de noche en el Restaurante B con sillas recogidas"
            class="tarjeta-foto"
            loading="lazy"
            decoding="async"
          />
          <div class="badge-restaurante">Restaurante B</div>
        </div>

        <div class="tarjeta-cuerpo">
          <ul class="filas-stack" role="list">
            {
              caracteristicas.map((c) => (
                <li class="fila-detalle">
                  <div class="circulo-icono-azul" aria-hidden="true">
                    {c.icono === "trabaja" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                      </svg>
                    )}
                    {c.icono === "peaje" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <line x1="2" y1="10" x2="22" y2="10" />
                      </svg>
                    )}
                    {c.icono === "potencia" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                      </svg>
                    )}
                    {c.icono === "reactiva" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 12c2.5 0 2.5-6 5-6s2.5 12 5 12 2.5-12 5-12 2.5 6 5 6" />
                      </svg>
                    )}
                    {c.icono === "luz" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="3" />
                        <path d="M12 17a5 5 0 0 0 5-5c0-2.76-2.24-5-5-5s-5 2.24-5 5a5 5 0 0 0 5 5z" />
                        <line x1="12" y1="21" x2="12" y2="23" />
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                        <line x1="1" y1="12" x2="3" y2="12" />
                        <line x1="21" y1="12" x2="23" y2="12" />
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
                      </svg>
                    )}
                  </div>
                  <div class="fila-textos">
                    <h3 class="fila-titulo">{c.titulo}</h3>
                    <p class="fila-desc">{c.textoB}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>

    <!-- Banner Inferior de Síntesis -->
    <div class="banner-sintesis-wrap">
      <div class="banner-sintesis-pill">
        <span class="banner-circulo-blanco" aria-hidden="true"></span>
        <span class="banner-sintesis-txt">La misma potencia máxima, dos facturas que no se parecen.</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: DOS RESTAURANTES DEL MISMO TAMAÑO
     ========================================================================== */
  .dos-restaurantes-seccion {
    position: relative;
    width: 100%;
    background: #081d3e;
    color: #ffffff;
    padding: clamp(70px, 7vw, 110px) 0 clamp(75px, 8vw, 115px);
    overflow: hidden;
    box-sizing: border-box;
  }

  .dos-restaurantes-contenedor {
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
  }

  /* Encabezado */
  .dos-restaurantes-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(38px, 4.5vw, 54px);
    max-width: 860px;
  }

  .etiqueta-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #38b6ff;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .separador-barra {
    color: rgba(255, 255, 255, 0.4);
  }

  .dos-restaurantes-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.9rem + 1.2vw, 2.95rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.18;
    margin: 0 0 14px 0;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .tit-cursiva {
    display: inline;
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #00c2ff;
  }

  .tit-segunda-linea {
    display: block;
    font-weight: 700;
    color: #ffffff;
    font-size: 0.88em;
    margin-top: 4px;
    text-transform: none;
    letter-spacing: -0.01em;
  }

  .dos-restaurantes-subtitulo {
    font-size: clamp(0.98rem, 0.94rem + 0.25vw, 1.1rem);
    line-height: 1.62;
    color: #cbd5e1;
    margin: 0;
    max-width: 740px;
  }

  /* Rejilla de 2 Tarjetas */
  .comparativa-tarjetas-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3.2vw, 38px);
    align-items: stretch;
  }

  /* Tarjeta Individual */
  .tarjeta-restaurante {
    display: flex;
    flex-direction: column;
    background: #f1f5f9;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .tarjeta-restaurante:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 54px rgba(0, 0, 0, 0.45);
  }

  /* Parte superior: Foto + Badge */
  .tarjeta-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #001f4d;
  }

  .tarjeta-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1.02);
    transition: transform 0.4s ease;
  }

  .tarjeta-restaurante:hover .tarjeta-foto {
    transform: scale(1.06);
  }

  .badge-restaurante {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    background: #0052cc;
    color: #ffffff;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    padding: 8px 24px;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    letter-spacing: 0.02em;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* Cuerpo inferior blanco con filas */
  .tarjeta-cuerpo {
    padding: 26px 28px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #f1f5f9;
  }

  .filas-stack {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .fila-detalle {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid #e2e8f0;
    box-sizing: border-box;
  }

  .fila-detalle:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .circulo-icono-azul {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #004aad;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
    box-shadow: 0 3px 8px rgba(0, 74, 173, 0.25);
  }

  .fila-textos {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .fila-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: #004aad;
    margin: 0;
    line-height: 1.3;
  }

  .fila-desc {
    font-size: 0.88rem;
    line-height: 1.54;
    color: #334155;
    margin: 0;
  }

  /* ==========================================================================
     BANNER INFERIOR DE SÍNTESIS
     ========================================================================== */
  .banner-sintesis-wrap {
    display: flex;
    margin-top: 36px;
  }

  .banner-sintesis-pill {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    background: #0052cc;
    color: #ffffff;
    padding: 12px 28px 12px 14px;
    border-radius: 9999px;
    box-shadow: 0 6px 20px rgba(0, 82, 204, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .banner-circulo-blanco {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .banner-sintesis-txt {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 960px) {
    .comparativa-tarjetas-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .banner-sintesis-pill {
      border-radius: 20px;
      padding: 14px 20px;
    }
  }

  @media (max-width: 640px) {
    .dos-restaurantes-seccion {
      padding: 55px 0 65px;
    }

    .dos-restaurantes-titulo {
      font-size: 1.85rem;
    }

    .tarjeta-cuerpo {
      padding: 20px 18px;
    }

    .banner-sintesis-txt {
      font-size: 0.95rem;
    }
  }
</style>
