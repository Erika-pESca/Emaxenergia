---
// Componente: LoQueNoHacemosVarios.astro
// Sección para /sectores/varios-suministros: "LO QUE NO HACEMOS"
// Tarjetas solapadas (Comparativas / Panel) sobre fondo claro + botón "Analizar mis locales" según boceto oficial.

const items = [
  {
    id: "comparativas",
    etiqueta: "Comparativas",
    descripcion:
      "No hacemos comparativas de compañías ni te buscamos la mejor oferta del mercado. Construimos tus tarifas de EMAX y respondemos por ellas.",
  },
  {
    id: "panel",
    etiqueta: "Panel",
    descripcion:
      "No tenemos un panel para seguir el consumo de tus sedes en tiempo real. Lo que recibes es un informe y una persona.",
  },
];
---

<section
  class="no-hacemos-varios-seccion"
  id="lo-que-no-hacemos"
  aria-labelledby="no-hacemos-varios-tit"
>
  <div class="no-hacemos-varios-contenedor">
    <h2 class="no-hacemos-varios-titulo" id="no-hacemos-varios-tit">
      LO QUE NO HACEMOS
    </h2>

    <div class="no-hacemos-varios-bloque">
      <div class="tarjetas-solapadas-varios">
        <!-- Columna Izquierda: Etiquetas sobre fondo celeste -->
        <div class="etiquetas-columna-celeste">
          {
            items.map((item) => (
              <div class="etiqueta-fila-item">
                <div class="circulo-icono-celeste" aria-hidden="true">
                  {item.id === "comparativas" && (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#004aad"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="18" y1="20" x2="18" y2="10" />
                      <line x1="12" y1="20" x2="12" y2="4" />
                      <line x1="6" y1="20" x2="6" y2="14" />
                    </svg>
                  )}
                  {item.id === "panel" && (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#004aad"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                      <line x1="8" y1="21" x2="16" y2="21" />
                      <line x1="12" y1="17" x2="12" y2="21" />
                    </svg>
                  )}
                </div>
                <span class="etiqueta-nombre">{item.etiqueta}</span>
              </div>
            ))
          }
        </div>

        <!-- Columna Derecha: Tarjeta Azul con Descripciones -->
        <div class="descripciones-tarjeta-azul">
          {
            items.map((item) => (
              <div class="descripcion-fila-item">
                <p class="descripcion-texto">{item.descripcion}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Botón inferior alineado a la izquierda del bloque -->
      <div class="accion-varios-wrap">
        <button
          type="button"
          class="btn-analizar-locales"
          data-abrir-funnel
          data-tramo-msg="Tengo varios locales o suministros y quiero analizarlos."
        >
          <span>Analizar mis locales</span>
          <span class="btn-circulo-cyan" aria-hidden="true">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#004aad"
              stroke-width="3.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: LO QUE NO HACEMOS (VARIOS SUMINISTROS)
     ========================================================================== */
  .no-hacemos-varios-seccion {
    position: relative;
    width: 100%;
    background: #f8fafc;
    padding: clamp(68px, 7.5vw, 108px) 0;
    overflow: hidden;
    box-sizing: border-box;
  }

  .no-hacemos-varios-contenedor {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .no-hacemos-varios-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.85rem, 1.65rem + 1vw, 2.4rem);
    font-weight: 800;
    color: #004aad;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 clamp(32px, 4vw, 44px) 0;
  }

  .no-hacemos-varios-bloque {
    width: 100%;
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .tarjetas-solapadas-varios {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
  }

  /* Columna Izquierda: Fondo Celeste */
  .etiquetas-columna-celeste {
    background: #e1effe;
    border-radius: 24px 0 0 24px;
    padding: 20px 44px 20px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    min-width: 245px;
    z-index: 1;
    box-sizing: border-box;
  }

  .etiqueta-fila-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
  }

  .etiqueta-fila-item:first-child {
    border-bottom: 1px solid #cbd5e1;
  }

  .circulo-icono-celeste {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #bfd7ff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .etiqueta-nombre {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.02rem;
    font-weight: 700;
    color: #004aad;
    letter-spacing: 0.01em;
  }

  /* Columna Derecha: Tarjeta Azul que solapa */
  .descripciones-tarjeta-azul {
    background: #004aad;
    border-radius: 26px;
    padding: 26px 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    flex: 1;
    margin-left: -24px;
    z-index: 2;
    box-shadow: 0 16px 36px rgba(0, 48, 120, 0.25);
    box-sizing: border-box;
  }

  .descripcion-fila-item {
    display: flex;
    align-items: center;
    padding: 16px 0;
  }

  .descripcion-fila-item:first-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
  }

  .descripcion-texto {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: clamp(0.88rem, 0.84rem + 0.16vw, 0.95rem);
    line-height: 1.56;
    color: #ffffff;
    margin: 0;
    font-weight: 400;
  }

  /* Botón inferior "Analizar mis locales" */
  .accion-varios-wrap {
    display: flex;
    justify-content: flex-start;
  }

  .btn-analizar-locales {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px 10px 22px;
    background: #004aad;
    color: #00c2ff;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(0, 74, 173, 0.25);
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-analizar-locales:hover {
    background: #0059d6;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 74, 173, 0.38);
  }

  .btn-circulo-cyan {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #00c2ff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .btn-analizar-locales:hover .btn-circulo-cyan {
    transform: translateX(2px);
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 768px) {
    .tarjetas-solapadas-varios {
      flex-direction: column;
      align-items: stretch;
    }

    .etiquetas-columna-celeste {
      border-radius: 20px 20px 0 0;
      padding: 18px 22px;
      min-width: 100%;
      flex-direction: row;
      justify-content: space-between;
    }

    .etiqueta-fila-item {
      padding: 6px 0;
    }

    .etiqueta-fila-item:first-child {
      border-bottom: none;
    }

    .descripciones-tarjeta-azul {
      margin-left: 0;
      margin-top: -10px;
      border-radius: 20px;
      padding: 22px 20px;
    }
  }

  @media (max-width: 480px) {
    .etiquetas-columna-celeste {
      flex-direction: column;
      gap: 10px;
    }

    .etiqueta-fila-item:first-child {
      border-bottom: 1px solid #cbd5e1;
      padding-bottom: 12px;
    }
  }
</style>

