---
// Componente: DoceContratosNoSonUnContrato.astro
// Sección de Varios Suministros: "DOCE CONTRATOS NO SON UN contrato multiplicado por doce."
// 5 tarjetas de problemas recurrentes con varias sedes (Vencimientos, Potencia, Condiciones, Previsión, Presupuesto)
// Con badges circulares distintivos (círculo azul + píldora cian con número)

const puntos = [
  {
    num: "01",
    titulo: "Vencimientos",
    desc: "Cada contrato termina en una fecha distinta, y alguno se renueva sin que nadie lo decida.",
    icono: "calendario",
  },
  {
    num: "02",
    titulo: "Potencia",
    desc: "Cada sede tiene una potencia que nadie ha revisado desde que abrió.",
    icono: "potencia",
  },
  {
    num: "03",
    titulo: "Condiciones",
    desc: "Sedes que consumen parecido pagan con condiciones distintas.",
    icono: "condiciones",
  },
  {
    num: "04",
    titulo: "Previsión",
    desc: "Las facturas llegan sede a sede, y el total del año se conoce cuando ya ha pasado.",
    icono: "prevision",
  },
  {
    num: "05",
    titulo: "Presupuesto",
    desc: "Las facturas llegan sede a sede, y el total del año se conoce cuando ya ha pasado.",
    icono: "presupuesto",
  },
];
---

<section
  class="doce-contratos-seccion"
  id="doce-contratos"
  aria-labelledby="doce-contratos-tit"
>
  <div class="doce-contratos-contenedor">
    <!-- Encabezado de la Sección -->
    <div class="doce-contratos-header">
      <h2 class="doce-contratos-titulo" id="doce-contratos-tit">
        <span class="tit-mayus">DOCE CONTRATOS NO SON UN </span>
        <span class="tit-cursiva">contrato</span>
        <span class="tit-cursiva tit-bloque">multiplicado por doce.</span>
      </h2>
      <p class="doce-contratos-subtitulo">
        Con varias sedes, el problema no suele ser un precio. Es todo lo que nadie mira junto.
      </p>
    </div>

    <!-- Rejilla de 5 Tarjetas (3 arriba, 2 abajo centradas) -->
    <div class="tarjetas-problemas-wrap">
      <!-- Fila Superior: 3 tarjetas -->
      <div class="fila-tarjetas fila-tres">
        {
          puntos.slice(0, 3).map((item) => (
            <article class="tarjeta-problema" aria-label={`Punto ${item.num}: ${item.titulo}`}>
              <div class="badge-doble-circulo" aria-hidden="true">
                <span class="circulo-azul-base">
                  {item.icono === "calendario" && (
                    <svg class="badge-svg-icono" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                      <line x1="16" y1="2" x2="16" y2="6" />
                      <line x1="8" y1="2" x2="8" y2="6" />
                      <line x1="3" y1="10" x2="21" y2="10" />
                      <circle cx="12" cy="15" r="2" />
                    </svg>
                  )}
                  {item.icono === "potencia" && (
                    <svg class="badge-svg-icono" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                    </svg>
                  )}
                  {item.icono === "condiciones" && (
                    <svg class="badge-svg-icono" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 2 14 8 20 8" />
                      <path d="M9 15l2 2 4-4" />
                    </svg>
                  )}
                </span>
                <span class="circulo-cyan-num">{item.num}</span>
              </div>
              <h3 class="tarjeta-problema-tit">{item.titulo}</h3>
              <p class="tarjeta-problema-desc">{item.desc}</p>
            </article>
          ))
        }
      </div>

      <!-- Fila Inferior: 2 tarjetas centradas -->
      <div class="fila-tarjetas fila-dos">
        {
          puntos.slice(3, 5).map((item) => (
            <article class="tarjeta-problema" aria-label={`Punto ${item.num}: ${item.titulo}`}>
              <div class="badge-doble-circulo" aria-hidden="true">
                <span class="circulo-azul-base">
                  {item.icono === "prevision" && (
                    <svg class="badge-svg-icono" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="18" y1="20" x2="18" y2="10" />
                      <line x1="12" y1="20" x2="12" y2="4" />
                      <line x1="6" y1="20" x2="6" y2="14" />
                      <polyline points="2 6 9 3 15 7 22 2" />
                    </svg>
                  )}
                  {item.icono === "presupuesto" && (
                    <svg class="badge-svg-icono" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="4" width="20" height="16" rx="2" />
                      <line x1="2" y1="10" x2="22" y2="10" />
                      <circle cx="16" cy="15" r="1.5" />
                    </svg>
                  )}
                </span>
                <span class="circulo-cyan-num">{item.num}</span>
              </div>
              <h3 class="tarjeta-problema-tit">{item.titulo}</h3>
              <p class="tarjeta-problema-desc">{item.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN: DOCE CONTRATOS NO SON UN CONTRATO MULTIPLICADO POR DOCE
     ========================================================================== */
  .doce-contratos-seccion {
    position: relative;
    width: 100%;
    background: #081d3e;
    color: #ffffff;
    padding: clamp(65px, 7.5vw, 110px) 0 clamp(75px, 8.5vw, 120px);
    overflow: hidden;
    box-sizing: border-box;
  }

  .doce-contratos-contenedor {
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  /* Encabezado */
  .doce-contratos-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(52px, 6vw, 72px);
    max-width: 980px;
  }

  .doce-contratos-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.05rem, 1.85rem + 1.2vw, 2.95rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.18;
    margin: 0 0 14px 0;
    letter-spacing: -0.015em;
  }

  .tit-mayus {
    text-transform: uppercase;
    display: inline;
  }

  .tit-cursiva {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    color: #00c2ff;
    letter-spacing: -0.005em;
    text-transform: none;
  }

  .tit-bloque {
    display: block;
  }

  .doce-contratos-subtitulo {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: clamp(0.96rem, 0.92rem + 0.2vw, 1.05rem);
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
    max-width: 820px;
  }

  /* ==========================================================================
     REJILLA DE TARJETAS (3 arriba, 2 abajo centradas)
     ========================================================================== */
  .tarjetas-problemas-wrap {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 5.5vw, 68px);
    width: 100%;
  }

  .fila-tarjetas {
    display: grid;
    gap: clamp(20px, 2.8vw, 32px);
    width: 100%;
  }

  .fila-tres {
    grid-template-columns: repeat(3, 1fr);
  }

  .fila-dos {
    grid-template-columns: repeat(2, 1fr);
    max-width: 840px;
    margin-inline: auto;
  }

  /* Tarjeta Individual con Badge en la parte superior */
  .tarjeta-problema {
    position: relative;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 20px;
    padding: clamp(38px, 4.2vw, 48px) clamp(20px, 2.5vw, 32px) clamp(26px, 3vw, 34px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.22);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    box-sizing: border-box;
  }

  .tarjeta-problema:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 194, 255, 0.4);
    box-shadow: 0 22px 46px rgba(0, 0, 0, 0.32);
  }

  /* Badge de doble círculo característico (Azul con icono + Cyan con número grande) */
  .badge-doble-circulo {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 86px;
    height: 68px;
    display: flex;
    align-items: center;
  }

  .circulo-azul-base {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: #004bb5;
    box-shadow: 0 4px 14px rgba(0, 56, 130, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .badge-svg-icono {
    width: 22px;
    height: 22px;
    transform: translate(-7px, -5px);
    flex-shrink: 0;
  }

  .circulo-cyan-num {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #00c2ff;
    color: #081d3e;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.98rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.28);
  }

  /* Textos de la tarjeta */
  .tarjeta-problema-tit {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.1rem, 1.04rem + 0.2vw, 1.25rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 10px 0;
    letter-spacing: -0.01em;
  }

  .tarjeta-problema-desc {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: clamp(0.86rem, 0.83rem + 0.12vw, 0.92rem);
    line-height: 1.58;
    color: #cbd5e1;
    margin: 0;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 992px) {
    .fila-tres {
      grid-template-columns: repeat(2, 1fr);
    }

    .fila-dos {
      max-width: 100%;
    }
  }

  @media (max-width: 680px) {
    .fila-tres,
    .fila-dos {
      grid-template-columns: 1fr;
    }

    .tarjetas-problemas-wrap {
      gap: 42px;
    }

    .tarjeta-problema {
      padding-top: 42px;
    }
  }
</style>
