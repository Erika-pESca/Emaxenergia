---
// Componente: ParaEmpezarBastaFactura.astro
// Sección Banner para /sectores/varios-suministros: "Para empezar TE BASTA UNA FACTURA"
// Fondo fotográfico a la derecha (`hero (8).png`) + degradado azul corporativo a la izquierda según boceto oficial.

import bannerVariosImg from "../../../imagenes/sectores/varios_sumistros/hero (8).png";
---

<section
  class="basta-factura-seccion"
  id="para-empezar"
  aria-labelledby="basta-factura-tit"
>
  <!-- Fondo fotográfico encuadrado a la derecha + degradado azul corporativo -->
  <div class="basta-factura-bg" aria-hidden="true">
    <div class="basta-factura-foto-wrap">
      <img
        src={bannerVariosImg.src}
        alt=""
        class="basta-factura-img"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="basta-factura-gradient"></div>
  </div>

  <div class="basta-factura-contenedor">
    <div class="basta-factura-content">
      <h2 class="basta-factura-titulo" id="basta-factura-tit">
        <span class="tit-cursiva">Para empezar</span> TE<br />
        BASTA UNA FACTURA
      </h2>

      <p class="basta-factura-texto">
        Con la factura de una sede abrimos el análisis. Después te pedimos el listado de CUPS o una factura de cada sede.
      </p>

      <p class="basta-factura-nota">
        Si tus sedes son de sociedades distintas, cada una autoriza la consulta de sus suministros.
      </p>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN BANNER: PARA EMPEZAR TE BASTA UNA FACTURA (VARIOS SUMINISTROS)
     ========================================================================== */
  .basta-factura-seccion {
    position: relative;
    width: 100%;
    min-height: clamp(440px, 42vw, 540px);
    display: flex;
    align-items: center;
    background: #004aad;
    color: #ffffff;
    padding: clamp(65px, 7.5vw, 105px) 0;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Fondo fotográfico posicionado en el bloque derecho */
  .basta-factura-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    background: #004aad;
  }

  .basta-factura-foto-wrap {
    position: absolute;
    top: 0;
    bottom: 0;
    right: -2%;
    width: 78%;
    overflow: hidden;
  }

  .basta-factura-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }

  /* Degradado oficial: Azul intenso a la izquierda fundiéndose hacia la derecha */
  .basta-factura-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #003d99 0%,
      #004aad 26%,
      #005ce6 42%,
      rgba(0, 92, 230, 0.92) 48%,
      rgba(0, 92, 230, 0.58) 57%,
      rgba(0, 92, 230, 0.22) 66%,
      transparent 75%
    );
  }

  .basta-factura-contenedor {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1260px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    box-sizing: border-box;
    display: flex;
    align-items: center;
  }

  .basta-factura-content {
    display: flex;
    flex-direction: column;
    max-width: 560px;
    width: 100%;
  }

  .basta-factura-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2rem, 1.8rem + 1.1vw, 2.85rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.015em;
    margin: 0 0 18px 0;
    line-height: 1.18;
    text-transform: uppercase;
  }

  .tit-cursiva {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.05em;
    color: #00c2ff;
    letter-spacing: -0.01em;
    text-transform: none;
  }

  .basta-factura-texto {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: clamp(0.95rem, 0.9rem + 0.22vw, 1.04rem);
    line-height: 1.62;
    color: #ffffff;
    margin: 0 0 18px 0;
    font-weight: 400;
  }

  .basta-factura-nota {
    font-family: var(--font-cuerpo, "Sora", sans-serif);
    font-size: clamp(0.84rem, 0.8rem + 0.15vw, 0.9rem);
    line-height: 1.58;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
    font-weight: 400;
    max-width: 500px;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 768px) {
    .basta-factura-foto-wrap {
      width: 100%;
      right: 0;
    }

    .basta-factura-gradient {
      background: linear-gradient(
        180deg,
        rgba(0, 61, 153, 0.9) 0%,
        rgba(0, 74, 173, 0.85) 55%,
        rgba(0, 61, 153, 0.94) 100%
      );
    }

    .basta-factura-seccion {
      padding: 55px 0 65px;
    }

    .basta-factura-content {
      max-width: 100%;
    }
  }
</style>

