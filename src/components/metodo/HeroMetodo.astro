---
// Hero Principal de El Método EMAX
// Diseño editorial sobrio, humano y corporativo:
// 1. Izquierda: Kicker badge + Titular serif + Subtítulo + 5 Píldoras de decisión interactivas con salto suave
// 2. Derecha: Ficha de auditoría ejecutiva tangible con datos reales + Selector de gasto integrado que abre el modal
// 3. Modal Funnel completo para iniciar el estudio sin coste
import { site } from "../../data/site";

interface DecisionPill {
  id: string;
  num: string;
  nombre: string;
}

const decisionesPills: DecisionPill[] = [
  { id: "potencia", num: "1", nombre: "Potencia" },
  { id: "penalizaciones", num: "2", nombre: "Penalizaciones" },
  { id: "cuando-consumes", num: "3", nombre: "Horarios" },
  { id: "riesgo", num: "4", nombre: "Riesgo" },
  { id: "condiciones", num: "5", nombre: "Condiciones" },
];

interface TramoGasto {
  id: string;
  etiqueta: string;
  rango: string;
  msg: string;
}

const tramos: TramoGasto[] = [
  {
    id: "menos-300",
    etiqueta: "Menos de 300 €",
    rango: "menos de 3.600 € al año en luz",
    msg: "Con este gasto hacemos un estudio sencillo. Lo más cómodo suele ser empezar con los datos básicos de tu factura.",
  },
  {
    id: "300-1000",
    etiqueta: "300 – 1.000 €",
    rango: "entre 3.600 y 12.000 € al año en luz",
    msg: "Con este gasto merece la pena mirar tu factura con detalle: la potencia, los periodos y las condiciones.",
  },
  {
    id: "1000-3000",
    etiqueta: "1.000 – 3.000 €",
    rango: "entre 12.000 y 36.000 € al año en luz",
    msg: "Con este gasto te atiende un gestor especialista que revisa tu suministro completo y tus maxímetros.",
  },
  {
    id: "mas-3000",
    etiqueta: "Más de 3.000 €",
    rango: "más de 36.000 € al año en luz",
    msg: "Con este gasto realizamos una auditoría técnica completa de potencia, reactiva y periodos de alta tensión.",
  },
];
---

<section
  class="hero-metodo-seccion"
  id="hero-metodo"
  aria-labelledby="hero-metodo-h1"
>
  <div class="contenedor hero-grid">
    <!-- COLUMNA IZQUIERDA: Titular, subtítulo y 5 píldoras interactivas -->
    <div class="hero-propuesta">
      <div class="kicker-wrap">
        <span class="kicker-punto" aria-hidden="true"></span>
        <span class="kicker-texto">El método EMAX</span>
      </div>

      <h1 id="hero-metodo-h1" class="hero-h1">
        Antes de elegir tarifa, hay cinco decisiones.
      </h1>

      <p class="hero-subtitulo">
        Potencia, penalizaciones, horarios, riesgo y condiciones: se deciden en
        ese orden y con tus datos reales. La tarifa sale al final.
      </p>

      <!-- 5 Píldoras interactivas de decisión que incitan a hacer clic -->
      <div class="pildoras-bloque">
        <span class="pildoras-label">Explorar las 5 decisiones:</span>
        <div
          class="pildoras-lista"
          role="navigation"
          aria-label="Acceso directo a decisiones"
        >
          {
            decisionesPills.map((d) => (
              <a
                href={`#${d.id}`}
                class="pildora-btn"
                data-salto-decision={d.id}
              >
                <span class="pildora-num">{d.num}</span>
                <span class="pildora-txt">{d.nombre}</span>
                <span class="pildora-flecha" aria-hidden="true">
                  ↓
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Garantías sutiles en franja horizontal -->
      <div class="hero-garantias-franja">
        <span class="garantia-item">
          <svg
            aria-hidden="true"
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
          </svg>
          Análisis sin coste
        </span>
        <span class="garantia-sep">·</span>
        <span class="garantia-item">
          <svg
            aria-hidden="true"
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
          </svg>
          Te llama un especialista humano
        </span>
        <span class="garantia-sep">·</span>
        <span class="garantia-item">
          <svg
            aria-hidden="true"
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
          </svg>
          Sin cambios sin tu firma
        </span>
      </div>
    </div>

    <!-- COLUMNA DERECHA: Ficha de auditoría ejecutiva real con selector integrado -->
    <div class="hero-card-col">
      <div class="ficha-auditoria">
        <!-- Cabecera de la ficha -->
        <header class="ficha-header">
          <h2 class="ficha-titulo">¿Cuánto paga tu empresa de luz al mes?</h2>
          <p class="ficha-sub">
            En total, sumando todos tus suministros. Con una cifra aproximada
            nos basta.
          </p>
        </header>

        <!-- Selector de tramos de gasto -->
        <div class="ficha-selector-seccion">
          <div class="ficha-tramos-grid">
            {
              tramos.map((item) => (
                <button
                  type="button"
                  class="ficha-tramo-btn"
                  data-abrir-funnel
                  data-tramo-id={item.id}
                  data-tramo-label={item.etiqueta}
                  data-tramo-rango={item.rango}
                  data-tramo-msg={item.msg}
                >
                  <span class="tramo-txt">{item.etiqueta}</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     MODAL FUNNEL - VENTANA EMERGENTE
     ========================================================================= -->
<div
  class="modal-backdrop"
  id="modal-funnel"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-funnel-titulo"
  hidden
>
  <div class="modal-dialog">
    <header class="modal-cabecera">
      <div class="modal-marca-wrap">
        <span class="modal-marca"
          >e<span class="rayo">⚡</span>max <span class="marca-sub"
            >energía</span
          ></span
        >
        <span class="modal-tel">{site.phone}</span>
      </div>

      <nav class="fn-etapas" aria-label="Progreso del estudio">
        <span class="fn-etapa activa" data-etapa-indicador="1">Tu gasto</span>
        <span class="fn-etapa-sep">/</span>
        <span class="fn-etapa" data-etapa-indicador="2">Cómo empezamos</span>
        <span class="fn-etapa-sep">/</span>
        <span class="fn-etapa" data-etapa-indicador="3">Tus datos</span>
        <span class="fn-etapa-sep">/</span>
        <span class="fn-etapa" data-etapa-indicador="4">Listo</span>
      </nav>

      <button
        type="button"
        class="modal-btn-cerrar"
        id="btn-cerrar-funnel"
        aria-label="Cerrar ventana y volver a la web"
      >
        <span>Volver a la web</span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <div class="modal-cuerpo-grid">
      <!-- Columna Izquierda: Pasos interactivos -->
      <div class="fn-col-izq">
        <!-- PASO 1 -->
        <div class="fn-paso-vista" id="fn-paso-1">
          <div class="fn-resultado">
            <p class="fn-resultado-cifra" id="fn-resultado-texto">
              Con lo que nos dices, tu empresa paga entre 3.600 y 12.000 € al
              año en luz.
            </p>
            <p class="fn-resultado-comun">
              No es lo que vas a ahorrar: es lo que está en juego.
            </p>
            <p class="fn-resultado-msg" id="fn-resultado-msg">
              Con este gasto merece la pena auditar tu factura con detalle: la
              potencia, los periodos y las 5 decisiones.
            </p>
          </div>

          <h2 id="modal-funnel-titulo" class="fn-titulo">
            ¿Cuántos suministros tiene tu empresa?
          </h2>

          <div class="fn-dos-botones">
            <button
              type="button"
              class="fn-opcion-btn"
              data-elegir-suministro="uno"
            >
              Uno
            </button>
            <button
              type="button"
              class="fn-opcion-btn"
              data-elegir-suministro="varios"
            >
              Varios
            </button>
          </div>

          <p class="fn-ayuda">
            Cada local, nave o sede con su propio contador es un suministro
            independiente.
          </p>

          <div class="fn-porque">
            <p class="fn-porque-t">Por qué te lo preguntamos</p>
            <p class="fn-porque-c">
              Con varios suministros te atiende un gestor que analiza cada sede
              y la compra global.
            </p>
          </div>

          <button type="button" class="fn-atras-btn" id="btn-cambiar-tramo">
            ← Cambiar tramo de gasto
          </button>
        </div>

        <!-- PASO 2 -->
        <div class="fn-paso-vista" id="fn-paso-2" hidden>
          <h2 class="fn-titulo">¿Cómo prefieres empezar?</h2>
          <p class="fn-sub">
            Elige la opción que te resulte más cómoda para poner en marcha el
            estudio.
          </p>

          <div class="fn-canales-lista">
            <button
              type="button"
              class="fn-canal-tarjeta"
              data-elegir-canal="llamada"
            >
              <div class="fn-canal-info">
                <strong class="fn-canal-tit">Una llamada</strong>
                <span class="fn-canal-desc"
                  >Un consultor especialista te llama en la franja que elijas,
                  con tu informe delante.</span
                >
              </div>
              <span class="fn-canal-flecha">→</span>
            </button>

            <button
              type="button"
              class="fn-canal-tarjeta"
              data-elegir-canal="factura"
            >
              <div class="fn-canal-info">
                <strong class="fn-canal-tit">Subir mi factura</strong>
                <span class="fn-canal-desc"
                  >Foto o PDF de tu factura más reciente para que Maxi y el
                  equipo la lean antes.</span
                >
              </div>
              <span class="fn-canal-flecha">→</span>
            </button>
          </div>

          <div class="fn-porque">
            <p class="fn-porque-t">Sin compromiso comercial</p>
            <p class="fn-porque-c">
              Te explicamos los números con total claridad. Si tu contrato
              actual ya es óptimo, te lo decimos por escrito.
            </p>
          </div>

          <button type="button" class="fn-atras-btn" data-ir-paso="1">
            ← Atrás
          </button>
        </div>

        <!-- PASO 3 -->
        <div class="fn-paso-vista" id="fn-paso-3" hidden>
          <h2 class="fn-titulo">¿Dónde te llamamos?</h2>
          <p class="fn-sub">
            Dinos a quién preguntar y en qué franja horaria te va mejor hablar.
          </p>

          <form class="fn-formulario" id="fn-form-datos">
            <div class="fn-campo">
              <label for="fn-input-nombre">Tu nombre o empresa</label>
              <input
                type="text"
                id="fn-input-nombre"
                name="nombre"
                required
                placeholder="Ej. Taller Mecánico Gómez"
              />
            </div>

            <div class="fn-campo">
              <label for="fn-input-telefono">Teléfono de contacto</label>
              <input
                type="tel"
                id="fn-input-telefono"
                name="telefono"
                required
                placeholder="Ej. 600 000 000"
              />
            </div>

            <fieldset class="fn-grupo-franja">
              <legend>¿Cuándo te va mejor que te llamemos?</legend>
              <label class="fn-radio-label">
                <input type="radio" name="franja" value="manana" checked />
                <span>Por la mañana, de 9:00 a 13:00</span>
              </label>
              <label class="fn-radio-label">
                <input type="radio" name="franja" value="tarde" />
                <span>Por la tarde, de 15:00 a 19:00</span>
              </label>
            </fieldset>

            <p class="fn-antes-boton">
              Al pulsar, registramos tu solicitud y un consultor te llamará en
              la franja elegida sin coste.
            </p>

            <button type="submit" class="boton-fn-enviar">
              Solicitar la llamada con mi informe
            </button>
          </form>

          <button type="button" class="fn-atras-btn" data-ir-paso="2">
            ← Atrás
          </button>
        </div>

        <!-- PASO 4 -->
        <div class="fn-paso-vista" id="fn-paso-4" hidden>
          <div class="fn-exito-tarjeta">
            <span class="fn-exito-check">✓</span>
            <h2 class="fn-titulo">Hecho. Hemos recibido tu solicitud.</h2>
            <p class="fn-sub">
              Un consultor especialista de EMAX revisará los datos de tu empresa
              y te llamará en la franja seleccionada.
            </p>
          </div>

          <div class="fn-resumen-confirmacion">
            <p><strong>Lo que va a pasar ahora:</strong></p>
            <ul>
              <li>Revisamos tu consumo por periodos y maxímetros reales.</li>
              <li>Te llamamos para explicártelo con tu informe delante.</li>
              <li>Te lo mandamos por escrito decidas lo que decidas.</li>
            </ul>
          </div>

          <button
            type="button"
            class="boton-fn-enviar"
            id="btn-finalizar-funnel"
          >
            Volver a la web
          </button>
        </div>
      </div>

      <!-- Columna Derecha: Panel de proceso -->
      <aside class="fn-panel" aria-label="Información del proceso de EMAX">
        <h3 class="fn-panel-t">Qué va a pasar</h3>

        <ol class="fn-panel-pasos">
          <li>
            <span class="cifra">1</span>
            <div>
              <strong>Nos dices cuánto pagas y cómo prefieres empezar.</strong>
            </div>
          </li>
          <li>
            <span class="cifra">2</span>
            <div>
              <strong
                >Maxi lee tu factura o los datos de tu suministro, y un
                especialista revisa lo que ha leído.</strong
              >
            </div>
          </li>
          <li>
            <span class="cifra">3</span>
            <div>
              <strong
                >Un consultor te llama, cuando tú digas, con tu informe delante.</strong
              >
            </div>
          </li>
          <li>
            <span class="cifra">4</span>
            <div>
              <strong>Te lo mandamos por escrito. Y decides tú.</strong>
            </div>
          </li>
        </ol>

        <div class="fn-panel-cierre">
          <p class="fn-panel-cierre-linea">
            Recibes tu informe decidas lo que decidas.
          </p>
          <p class="fn-panel-sin-coste">El análisis no tiene coste.</p>
          <p class="fn-panel-cierre-sub">
            Si tu contrato actual ya encaja con cómo consume tu empresa, el
            informe te lo dice en lugar de proponerte otra tarifa.
          </p>
        </div>
      </aside>
    </div>
  </div>
</div>

<script>
  // Control interactivo del modal funnel y saltos a decisiones
  const modalFunnel = document.getElementById("modal-funnel");
  const btnCerrarFunnel = document.getElementById("btn-cerrar-funnel");
  const btnFinalizarFunnel = document.getElementById("btn-finalizar-funnel");
  const btnCambiarTramo = document.getElementById("btn-cambiar-tramo");

  const fnResultadoTexto = document.getElementById("fn-resultado-texto");
  const fnResultadoMsg = document.getElementById("fn-resultado-msg");

  const pasoVistas: Record<number, HTMLElement | null> = {
    1: document.getElementById("fn-paso-1"),
    2: document.getElementById("fn-paso-2"),
    3: document.getElementById("fn-paso-3"),
    4: document.getElementById("fn-paso-4"),
  };

  const etapaIndicadores = document.querySelectorAll("[data-etapa-indicador]");

  function irAlPaso(numPaso: number) {
    Object.keys(pasoVistas).forEach((key) => {
      const vista = pasoVistas[Number(key)];
      if (vista) {
        if (Number(key) === numPaso) {
          vista.removeAttribute("hidden");
        } else {
          vista.setAttribute("hidden", "true");
        }
      }
    });

    etapaIndicadores.forEach((ind) => {
      const idx = Number(ind.getAttribute("data-etapa-indicador"));
      if (idx === numPaso) {
        ind.classList.add("activa");
      } else {
        ind.classList.remove("activa");
      }
    });
  }

  function abrirModalFunnel(btn: HTMLElement) {
    if (!modalFunnel) return;

    const rango =
      btn.getAttribute("data-tramo-rango") ||
      "entre 3.600 y 12.000 € al año en luz";
    const msg =
      btn.getAttribute("data-tramo-msg") ||
      "Con este gasto merece la pena mirar tu factura con detalle.";

    if (fnResultadoTexto) {
      fnResultadoTexto.textContent = `Con lo que nos dices, tu empresa paga ${rango}.`;
    }
    if (fnResultadoMsg) {
      fnResultadoMsg.textContent = msg;
    }

    irAlPaso(1);
    modalFunnel.removeAttribute("hidden");
    document.body.style.overflow = "hidden";
  }

  function cerrarModalFunnel() {
    if (!modalFunnel) return;
    modalFunnel.setAttribute("hidden", "true");
    document.body.style.overflow = "";
  }

  // Delegación global para botones con data-abrir-funnel
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest<HTMLElement>("[data-abrir-funnel]");
    if (btn) {
      abrirModalFunnel(btn);
    }
  });

  // Salto suave y apertura automática de acordeones al hacer clic en las 5 píldoras
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const pill = target?.closest<HTMLAnchorElement>("[data-salto-decision]");
    if (pill) {
      const decisionId = pill.getAttribute("data-salto-decision");
      if (decisionId) {
        const targetElement = document.getElementById(decisionId);
        if (targetElement) {
          if (targetElement.tagName.toLowerCase() === "details") {
            (targetElement as HTMLDetailsElement).open = true;
          }
        }
      }
    }
  });

  btnCerrarFunnel?.addEventListener("click", cerrarModalFunnel);
  btnFinalizarFunnel?.addEventListener("click", cerrarModalFunnel);
  btnCambiarTramo?.addEventListener("click", cerrarModalFunnel);

  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      modalFunnel &&
      !modalFunnel.hasAttribute("hidden")
    ) {
      cerrarModalFunnel();
    }
  });

  modalFunnel?.addEventListener("click", (e) => {
    if (e.target === modalFunnel) {
      cerrarModalFunnel();
    }
  });

  const btnsSuministro = document.querySelectorAll("[data-elegir-suministro]");
  btnsSuministro.forEach((b) => {
    b.addEventListener("click", () => irAlPaso(2));
  });

  const btnsCanal = document.querySelectorAll("[data-elegir-canal]");
  btnsCanal.forEach((b) => {
    b.addEventListener("click", () => irAlPaso(3));
  });

  const btnsIrAtras = document.querySelectorAll("[data-ir-paso]");
  btnsIrAtras.forEach((b) => {
    b.addEventListener("click", () => {
      const target = Number(b.getAttribute("data-ir-paso")) || 1;
      irAlPaso(target);
    });
  });

  const formDatos = document.getElementById("fn-form-datos");
  formDatos?.addEventListener("submit", (e) => {
    e.preventDefault();
    irAlPaso(4);
  });
</script>

<style>
  /* ==========================================================================
     HERO METODO - DISEÑO EDITORIAL SOBRIO Y CORPORATIVO
     ========================================================================== */
  .hero-metodo-seccion {
    margin-top: -66px;
    padding: calc(66px + 34px) 0 48px;
    background-color: var(--fondo, #f4f7fb);
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  @media (width >= 1024px) {
    .hero-metodo-seccion {
      margin-top: -66px;
      padding: calc(66px + 32px) 0 56px;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  .kicker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--azul-resalte, #ddf1ff);
    padding: 5px 12px;
    border-radius: var(--radio-pill, 999px);
    margin-bottom: 14px;
  }

  .kicker-punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--azul-600, #1a6ff7);
    display: inline-block;
  }

  .kicker-texto {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--azul-900, #004aad);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-h1 {
    font-family: var(--font-titulos, serif);
    font-size: clamp(2.1rem, 1.7rem + 2vw, 3.1rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--tinta, #0f2346);
    margin: 0 0 16px;
    letter-spacing: -0.015em;
  }

  .hero-subtitulo {
    font-size: 1.1rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
    margin: 0 0 28px;
    max-width: 36em;
  }

  /* 5 Píldoras interactivas */
  .pildoras-bloque {
    margin-bottom: 28px;
  }

  .pildoras-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--tinta-3, #63738e);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 10px;
  }

  .pildoras-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pildora-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    background: #ffffff;
    border: 1.5px solid #d0ddec;
    border-radius: var(--radio-pill, 999px);
    color: var(--tinta, #0f2346);
    font-size: 0.88rem;
