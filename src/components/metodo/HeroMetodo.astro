---
// Hero Principal de El Método EMAX
// Diseño editorial sobrio, humano y corporativo:
// 1. Izquierda: Kicker badge + Titular serif + Subtítulo + 5 Píldoras de decisión interactivas con salto suave
// 2. Derecha: Ficha de auditoría ejecutiva tangible con datos reales + Selector de gasto integrado que abre el modal
// 3. Modal Funnel completo para iniciar el estudio sin coste
import { site } from "../../data/site";

interface DecisionPill {
  id: string;
  num: string;
  nombre: string;
}

const decisionesPills: DecisionPill[] = [
  { id: "potencia", num: "1", nombre: "Potencia" },
  { id: "penalizaciones", num: "2", nombre: "Penalizaciones" },
  { id: "cuando-consumes", num: "3", nombre: "Horarios" },
  { id: "riesgo", num: "4", nombre: "Riesgo" },
  { id: "condiciones", num: "5", nombre: "Condiciones" },
];

interface TramoGasto {
  id: string;
  etiqueta: string;
  rango: string;
  msg: string;
}

const tramos: TramoGasto[] = [
  {
    id: "menos-300",
    etiqueta: "Menos de 300 €",
    rango: "menos de 3.600 € al año en luz",
    msg: "Con este gasto hacemos un estudio sencillo. Lo más cómodo suele ser empezar con los datos básicos de tu factura.",
  },
  {
    id: "300-1000",
    etiqueta: "300 – 1.000 €",
    rango: "entre 3.600 y 12.000 € al año en luz",
    msg: "Con este gasto merece la pena mirar tu factura con detalle: la potencia, los periodos y las condiciones.",
  },
  {
    id: "1000-3000",
    etiqueta: "1.000 – 3.000 €",
    rango: "entre 12.000 y 36.000 € al año en luz",
    msg: "Con este gasto te atiende un gestor especialista que revisa tu suministro completo y tus maxímetros.",
  },
  {
    id: "mas-3000",
    etiqueta: "Más de 3.000 €",
    rango: "más de 36.000 € al año en luz",
    msg: "Con este gasto realizamos una auditoría técnica completa de potencia, reactiva y periodos de alta tensión.",
  },
];
---

<section
  class="hero-metodo-seccion"
  id="hero-metodo"
  aria-labelledby="hero-metodo-h1"
>
  <div class="contenedor hero-grid">
    <!-- COLUMNA IZQUIERDA: Titular, subtítulo y 5 píldoras interactivas -->
    <div class="hero-propuesta">
      <div class="kicker-wrap">
        <span class="kicker-punto" aria-hidden="true"></span>
        <span class="kicker-texto">El método EMAX</span>
      </div>

      <h1 id="hero-metodo-h1" class="hero-h1">
        Antes de elegir tarifa, hay cinco decisiones.
      </h1>

      <p class="hero-subtitulo">
        Potencia, penalizaciones, horarios, riesgo y condiciones: se deciden en
        ese orden y con tus datos reales. La tarifa sale al final.
      </p>

      <!-- 5 Píldoras interactivas de decisión que incitan a hacer clic -->
      <div class="pildoras-bloque">
        <span class="pildoras-label">Explorar las 5 decisiones:</span>
        <div
          class="pildoras-lista"
          role="navigation"
          aria-label="Acceso directo a decisiones"
        >
          {
            decisionesPills.map((d) => (
              <a
                href={`#${d.id}`}
                class="pildora-btn"
                data-salto-decision={d.id}
              >
                <span class="pildora-num">{d.num}</span>
                <span class="pildora-txt">{d.nombre}</span>
                <span class="pildora-flecha" aria-hidden="true">
                  ↓
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Garantías sutiles en franja horizontal -->
      <div class="hero-garantias-franja">
        <span class="garantia-item">
          <svg
            aria-hidden="true"
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
          </svg>
          Análisis sin coste
        </span>
        <span class="garantia-sep">·</span>
        <span class="garantia-item">
          <svg
            aria-hidden="true"
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
          </svg>
          Te llama un especialista humano
        </span>
        <span class="garantia-sep">·</span>
        <span class="garantia-item">
          <svg
            aria-hidden="true"
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
          </svg>
          Sin cambios sin tu firma
        </span>
      </div>
    </div>

    <!-- COLUMNA DERECHA: Ficha de auditoría ejecutiva real con selector integrado -->
    <div class="hero-card-col">
      <div class="ficha-auditoria">
        <!-- Cabecera de la ficha -->
        <header class="ficha-header">
          <h2 class="ficha-titulo">¿Cuánto paga tu empresa de luz al mes?</h2>
          <p class="ficha-sub">
            En total, sumando todos tus suministros. Con una cifra aproximada
            nos basta.
          </p>
        </header>

        <!-- Selector de tramos de gasto -->
        <div class="ficha-selector-seccion">
          <div class="ficha-tramos-grid">
            {
              tramos.map((item) => (
                <button
                  type="button"
                  class="ficha-tramo-btn"
                  data-abrir-funnel
                  data-tramo-id={item.id}
                  data-tramo-label={item.etiqueta}
                  data-tramo-rango={item.rango}
                  data-tramo-msg={item.msg}
                >
                  <span class="tramo-txt">{item.etiqueta}</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>



<script>
  // Salto suave y apertura automática de acordeones al hacer clic en las 5 píldoras
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const pill = target?.closest<HTMLAnchorElement>("[data-salto-decision]");
    if (pill) {
      const decisionId = pill.getAttribute("data-salto-decision");
      if (decisionId) {
        const targetElement = document.getElementById(decisionId);
        if (targetElement) {
          if (targetElement.tagName.toLowerCase() === "details") {
            (targetElement as HTMLDetailsElement).open = true;
          }
        }
      }
    }
  });
</script>

<style>
  /* ==========================================================================
     HERO METODO - DISEÑO EDITORIAL SOBRIO Y CORPORATIVO
     ========================================================================== */
  .hero-metodo-seccion {
    margin-top: -66px;
    padding: calc(66px + 34px) 0 48px;
    background-color: var(--fondo, #f4f7fb);
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  @media (width >= 1024px) {
    .hero-metodo-seccion {
      margin-top: -66px;
      padding: calc(66px + 32px) 0 56px;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  .kicker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--azul-resalte, #ddf1ff);
    padding: 5px 12px;
    border-radius: var(--radio-pill, 999px);
    margin-bottom: 14px;
  }

  .kicker-punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--azul-600, #1a6ff7);
    display: inline-block;
  }

  .kicker-texto {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--azul-900, #004aad);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-h1 {
    font-family: var(--font-titulos, serif);
    font-size: clamp(2.1rem, 1.7rem + 2vw, 3.1rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--tinta, #0f2346);
    margin: 0 0 16px;
    letter-spacing: -0.015em;
  }

  .hero-subtitulo {
    font-size: 1.1rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
    margin: 0 0 28px;
    max-width: 36em;
  }

  /* 5 Píldoras interactivas */
  .pildoras-bloque {
    margin-bottom: 28px;
  }

  .pildoras-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--tinta-3, #63738e);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 10px;
  }

  .pildoras-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pildora-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    background: #ffffff;
    border: 1.5px solid #d0ddec;
    border-radius: var(--radio-pill, 999px);
    color: var(--tinta, #0f2346);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 2px 4px rgba(15, 35, 70, 0.04);
    transition: all 0.15s ease;
  }

  .pildora-btn:hover {
    border-color: var(--azul-900, #004aad);
    color: var(--azul-900, #004aad);
    background: var(--azul-suave, #edf4fe);
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 74, 173, 0.12);
  }

  .pildora-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--azul-suave, #edf4fe);
    color: var(--azul-900, #004aad);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .pildora-btn:hover .pildora-num {
    background: var(--azul-900, #004aad);
    color: #fff;
  }

  .pildora-flecha {
    color: var(--tinta-3, #63738e);
    font-size: 0.85rem;
    transition: transform 0.15s;
  }

  .pildora-btn:hover .pildora-flecha {
    transform: translateY(2px);
    color: var(--azul-900, #004aad);
  }

  /* Franja horizontal de garantías */
  .hero-garantias-franja {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--linea-fina, #e6edf7);
    font-size: 0.88rem;
    color: var(--tinta-2, #3a4b68);
  }

  .garantia-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
  }

  .garantia-item svg {
    color: var(--verde-ok, #067647);
  }

  .garantia-sep {
    color: #cbd5e1;
    font-weight: 700;
  }

  /* ==========================================================================
     COLUMNA DERECHA: FICHA DE AUDITORÍA EJECUTIVA TANGIBLE
     ========================================================================== */
  .ficha-auditoria {
    background: #ffffff;
    border: 1px solid var(--linea-fina, #e6edf7);
    border-radius: 16px;
    padding: 32px 28px;
    box-shadow: 0 4px 20px rgba(15, 35, 70, 0.05);
    position: relative;
    animation: pulsoSombraAzul 3.6s ease-in-out infinite;
  }

  @keyframes pulsoSombraAzul {
    0%, 100% {
      box-shadow: 0 4px 20px rgba(15, 35, 70, 0.05);
    }
    50% {
      box-shadow:
        0 0 0 1px rgba(26, 111, 247, 0.25),
        0 0 35px rgba(26, 111, 247, 0.42),
        0 14px 40px rgba(0, 74, 173, 0.18);
    }
  }

  .ficha-header {
    margin-bottom: 24px;
  }

  .ficha-titulo {
    font-family: inherit;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--tinta, #0f2346);
    line-height: 1.25;
    margin: 0 0 10px;
  }

  .ficha-sub {
    font-size: 0.95rem;
    color: var(--tinta-2, #3a4b68);
    margin: 0;
    line-height: 1.5;
  }

  .ficha-selector-seccion {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ficha-tramos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  @media (max-width: 500px) {
    .ficha-tramos-grid {
      grid-template-columns: 1fr;
    }
  }

  .ficha-tramo-btn {
    width: 100%;
    padding: 14px 16px;
    border: 1.5px solid var(--azul-900, #004aad);
    border-radius: 12px;
    background: #ffffff;
    color: var(--azul-900, #004aad);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    text-align: center;
    font-family: inherit;
    transition: all 0.15s ease;
  }

  .ficha-tramo-btn:hover {
    background: var(--azul-suave, #edf4fe);
    border-color: var(--azul-900, #004aad);
    color: var(--azul-900, #004aad);
    transform: translateY(-1px);
  }

  .ficha-micro-link {
    text-align: left;
    margin-top: 4px;
  }

  .link-ver-decisiones {
    font-size: 0.9rem;
    color: var(--azul-900, #004aad);
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 500;
    transition: opacity 0.15s;
  }

  .link-ver-decisiones:hover {
    opacity: 0.8;
  }

  </style>
