---
// Hero Principal de El Método EMAX
// Con fondo_metodo.jpg oficial de marca:
// 1. Imagen de fondo fondo_metodo.jpg que va de azul royal a la izquierda a luz clara a la derecha
// 2. Columna izquierda: Kicker badge, H1, subtítulo, secuencia 5 decisiones y garantías sobre fondo azul
// 3. Columna derecha: Tarjeta glassmórfica sobre la zona de luz con título azul #0056d6, subtítulo oscuro y botones azul #004aad con flecha cian
// 4. Conexión nativa con el modal unificado Formulario.astro
import { site } from "../../data/site";
import heroMetodoImg from "../../imagenes/metodo/Hero.png";

interface TramoGasto {
  id: string;
  etiqueta: string;
  rango: string;
  msg: string;
}

const tramos: TramoGasto[] = [
  {
    id: "menos-300",
    etiqueta: "MENOS DE 300€",
    rango: "menos de 3.600 € al año en luz",
    msg: "Con este gasto hacemos un estudio sencillo. Lo más cómodo suele ser empezar con los datos básicos de tu factura.",
  },
  {
    id: "300-1000",
    etiqueta: "300 - 1.000€",
    rango: "entre 3.600 y 12.000 € al año en luz",
    msg: "Con este gasto merece la pena mirar tu factura con detalle: la potencia, los periodos y las condiciones.",
  },
  {
    id: "1000-3000",
    etiqueta: "1.000 - 3.000€",
    rango: "entre 12.000 y 36.000 € al año en luz",
    msg: "Con este gasto te atiende un gestor especialista que revisa tu suministro completo y tus maxímetros.",
  },
  {
    id: "mas-3000",
    etiqueta: "Más de 3.000€",
    rango: "más de 36.000 € al año en luz",
    msg: "Con este gasto realizamos una auditoría técnica completa de potencia, reactiva y periodos de alta tensión.",
  },
];
---

<section
  class="hero-metodo-seccion"
  id="hero-metodo"
  aria-labelledby="hero-metodo-h1"
>
  <!-- Fondo fotográfico con degradado corporativo oficial -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src={heroMetodoImg.src}
      alt=""
      class="hero-bg-img"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="hero-bg-overlay"></div>
  </div>

  <div class="hero-metodo-contenedor">
    <!-- COLUMNA IZQUIERDA: Titular, propuesta, secuencia técnica y garantías -->
    <div class="hero-propuesta">
      <div class="kicker-wrap">
        <span class="kicker-punto" aria-hidden="true"></span>
        <span class="kicker-texto">El Método EMAX</span>
        <span class="kicker-sep" aria-hidden="true">|</span>
        <span class="kicker-sub">Auditoría previa</span>
      </div>

      <h1 id="hero-metodo-h1" class="hero-h1">
        ANTES DE ELEGIR<br />
        TARIFA, HAY <span class="hero-cursiva">cinco decisiones.</span>
      </h1>

      <p class="hero-subtitulo">
        Potencia, penalizaciones, horarios, riesgo y condiciones: se deciden en
        ese orden y con tus datos reales. La tarifa sale al final.
      </p>

      <!-- Secuencia visible de las 5 decisiones del método -->
      <div class="hero-secuencia-decisiones" aria-label="Las 5 decisiones en orden">
        <span class="secuencia-label">El orden del análisis:</span>
        <div class="secuencia-tags">
          <span class="dec-tag"><span class="dec-num">1</span> Potencia</span>
          <span class="dec-flecha" aria-hidden="true">→</span>
          <span class="dec-tag"><span class="dec-num">2</span> Penalizaciones</span>
          <span class="dec-flecha" aria-hidden="true">→</span>
          <span class="dec-tag"><span class="dec-num">3</span> Horarios</span>
          <span class="dec-flecha" aria-hidden="true">→</span>
          <span class="dec-tag"><span class="dec-num">4</span> Riesgo</span>
          <span class="dec-flecha" aria-hidden="true">→</span>
          <span class="dec-tag"><span class="dec-num">5</span> Condiciones</span>
        </div>
      </div>

      <!-- Franja de garantías técnicas -->
      <div class="hero-garantias-franja">
        <span class="garantia-item">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
          </svg>
          Estudio técnico sin coste
        </span>
        <span class="garantia-sep">·</span>
        <span class="garantia-item">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
          </svg>
          Sin permanencia ni cambios forzados
        </span>
        <span class="garantia-sep">·</span>
        <span class="garantia-item">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
          </svg>
          Informe por escrito
        </span>
      </div>
    </div>

    <!-- COLUMNA DERECHA: Ficha Glassmórfica equilibrada y compacta -->
    <div class="hero-card-col">
      <div class="ficha-auditoria">
        <!-- Cabecera de la ficha -->
        <header class="ficha-header">
          <h2 class="ficha-titulo">¿Cuánto paga tu empresa de luz al mes?</h2>
          <p class="ficha-sub">
            En total, sumando todos tus suministros. Con una cifra aproximada nos basta.
          </p>
        </header>

        <!-- Selector de tramos de gasto que abren el Formulario / Funnel unificado -->
        <div class="ficha-tramos-grid">
          {
            tramos.map((item) => (
              <button
                type="button"
                class="ficha-tramo-btn"
                data-abrir-funnel
                data-tramo-id={item.id}
                data-tramo-label={`Estudio para empresa: ${item.etiqueta}`}
                data-tramo-rango={item.rango}
                data-tramo-msg={item.msg}
              >
                <span class="tramo-txt">{item.etiqueta}</span>
                <span class="tramo-icono" aria-hidden="true">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     HERO METODO - FONDO fondo_metodo.jpg Y DISEÑO CORPORATIVO
     ========================================================================== */
  .hero-metodo-seccion {
    position: relative;
    z-index: 20;
    margin-top: -78px;
    min-height: calc(84vh + 78px);
    display: flex;
    align-items: center;
    padding: calc(78px + 48px) 0 72px;
    background-color: #004aad;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 85% center;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #004aad 0%,
      #004aad 28%,
      rgba(0, 74, 173, 0.82) 40%,
      rgba(0, 74, 173, 0.35) 54%,
      rgba(0, 74, 173, 0.05) 68%,
      transparent 85%
    );
    pointer-events: none;
  }

  @media (max-width: 1024px) {
    .hero-bg-overlay {
      background: linear-gradient(
        180deg,
        rgba(0, 74, 173, 0.96) 0%,
        rgba(0, 74, 173, 0.88) 55%,
        rgba(0, 74, 173, 0.75) 100%
      );
    }
  }

  .hero-metodo-contenedor {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 52px);
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 60px);
    align-items: center;
  }

  @media (max-width: 1024px) {
    .hero-metodo-contenedor {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* Columna Izquierda: Mensaje y Titular de Gran Impacto */
  .hero-propuesta {
    display: flex;
    flex-direction: column;
  }

  .kicker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    margin-bottom: 20px;
    width: fit-content;
    backdrop-filter: blur(10px);
  }

  .kicker-punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00d4ff;
    box-shadow: 0 0 10px #00d4ff;
  }

  .kicker-texto {
    font-family: "Sora", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .kicker-sep {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.85rem;
  }

  .kicker-sub {
    font-family: "Sora", sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: #38bdf8;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-h1 {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.3rem, 1.9rem + 2vw, 3.4rem);
    font-weight: 800;
    line-height: 1.12;
    color: #ffffff;
    letter-spacing: -0.025em;
    margin: 0 0 18px;
    text-transform: uppercase;
  }

  .hero-cursiva {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: #38bdf8;
    letter-spacing: -0.01em;
    display: inline-block;
  }

  .hero-subtitulo {
    font-size: clamp(1.02rem, 1.15vw, 1.15rem);
    line-height: 1.6;
    color: rgba(240, 248, 255, 0.95);
    margin: 0 0 24px;
    max-width: 580px;
    font-weight: 400;
  }

  /* Secuencia de las 5 decisiones */
  .hero-secuencia-decisiones {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }

  .secuencia-label {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #38bdf8;
  }

  .secuencia-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .dec-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 5px 11px;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #ffffff;
    backdrop-filter: blur(8px);
  }

  .dec-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: #00d4ff;
    color: #004aad;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .dec-flecha {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.85rem;
  }

  /* Garantías */
  .hero-garantias-franja {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 0.84rem;
    color: rgba(240, 248, 255, 0.9);
  }

  .garantia-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
  }

  .garantia-item svg {
    color: #38bdf8;
  }

  .garantia-sep {
    color: rgba(255, 255, 255, 0.35);
  }

  /* Columna Derecha: Tarjeta Glassmórfica sobre la zona luminosa */
  .hero-card-col {
    position: relative;
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 1024px) {
    .hero-card-col {
      justify-content: flex-start;
    }
  }

  .ficha-auditoria {
    width: 100%;
    max-width: 530px;
    /* Vidrio esmerilado: deja intuir la foto detrás pero garantiza la lectura */
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.62) 0%,
      rgba(235, 244, 255, 0.5) 100%
    );
    border: 1.5px solid rgba(255, 255, 255, 0.75);
    border-radius: 28px;
    padding: clamp(28px, 3.4vw, 38px);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 24px 60px rgba(0, 16, 48, 0.28), inset 0 1px 1px rgba(255, 255, 255, 0.9);
  }

  .ficha-header {
    margin-bottom: 22px;
  }

  .ficha-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.24rem, 1.1rem + 0.4vw, 1.48rem);
    font-weight: 700;
    color: #004aad;
    line-height: 1.25;
    margin: 0 0 8px;
    letter-spacing: -0.015em;
  }

  .ficha-sub {
    font-size: 0.94rem;
    color: #0f172a;
    margin: 0;
    line-height: 1.5;
    font-weight: 500;
  }

  .ficha-tramos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 13px;
  }

  @media (max-width: 540px) {
    .ficha-tramos-grid {
      grid-template-columns: 1fr;
    }
  }

  .ficha-tramo-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 15px 17px;
    background: #004aad;
    border: 1.5px solid rgba(0, 74, 173, 0.25);
    border-radius: 12px;
    color: #ffffff;
    font-family: "Sora", sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    text-align: left;
    box-shadow: 0 6px 16px rgba(0, 25, 75, 0.25);
    transition: transform 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
  }

  .ficha-tramo-btn:hover {
    background: #005ce6;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(0, 74, 173, 0.4);
  }

  .tramo-txt {
    font-family: "Sora", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .tramo-icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #00d4ff;
    color: #004aad;
    flex-shrink: 0;
    transition: transform 0.18s ease, background-color 0.18s ease, color 0.18s ease;
  }

  .ficha-tramo-btn:hover .tramo-icono {
    transform: translateX(3px);
    background: #ffffff;
    color: #004aad;
  }
</style>
