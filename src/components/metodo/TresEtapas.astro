---
// Componente TresEtapas de la sección El Método
// Estructura y diseño idénticos a los componentes de src/components/home:
// Explica el orden analítico: 1. Diagnóstico, 2. Estrategia (las 5 decisiones), 3. Tarifa
interface Etapa {
  num: string;
  nombre: string;
  quien: string;
  desc: string;
}

const etapas: Etapa[] = [
  {
    num: "1",
    nombre: "Diagnóstico",
    quien: "Maxi + especialista",
    desc: "Qué miramos: consumo histórico por periodos, potencia contratada frente a maxímetros reales, penalizaciones por reactiva y contrato actual.",
  },
  {
    num: "2",
    nombre: "Estrategia",
    quien: "Especialista colegiado",
    desc: "Las cinco decisiones clave: qué se corrige (potencias, excesos, reactiva) y qué se mantiene porque ya funciona en tu empresa.",
  },
  {
    num: "3",
    nombre: "Tarifa",
    quien: "EMAX Energía",
    desc: "Construida fila a fila: estructura horaria adaptada a tus turnos, modalidad de riesgo adecuada y condiciones transparentes sin sorpresas.",
  },
];
---

<section class="proceso-seccion" id="orden-metodo" aria-labelledby="h2-orden">
  <div class="contenedor">
    <div class="seccion-cabecera">
      <p class="seccion-kicker">
        ¿CÓMO CAMBIARTE? <span class="kicker-sep" aria-hidden="true">|</span>
      </p>
      <h2 class="seccion-titulo" id="h2-orden">
        PRIMERO ENTENDEMOS CÓMO CONSUME TU EMPRESA. DESPUÉS <span class="titulo-cursiva">decidimos qué hacer.</span>
      </h2>
      <p class="seccion-subtitulo">
        Tres etapas. Las cinco decisiones son la segunda.
      </p>
    </div>

    <!-- Contenedor del Timeline horizontal con Beam iluminado -->
    <!-- Contenedor del Timeline Vertical con haz de luz continuo -->
    <div class="timeline-vertical-wrap" id="procesoTimeline">
      <!-- Pista vertical central -->
      <div class="timeline-v-track" aria-hidden="true">
        <div class="timeline-v-beam" id="procesoBeam"></div>
      </div>

      <!-- Lista vertical de las 3 etapas -->
      <div class="timeline-v-items">
        {
          etapas.map((etapa) => (
            <div
              class:list={[
                "timeline-v-fila",
                `fila-${etapa.num}`,
                etapa.num === "2" ? "lado-izq" : "lado-der",
                "tb-item",
              ]}
              data-etapa-num={etapa.num}
            >
              {/* Para etapa 2 (lado-izq): Tarjeta en columna 1, Nodo en columna 2 */}
              {etapa.num === "2" ? (
                <>
                  <article class:list={["timeline-v-card", `card-color-${etapa.num}`]}>
                    <div class="timeline-v-card-fill" aria-hidden="true"></div>
                    <div class="timeline-v-card-body">
                      <header class="timeline-v-card-top">
                        <span class="paso-fase-etiqueta">Etapa {etapa.num}</span>
                        <span class="paso-quien-badge">
                          <span class="quien-dot" aria-hidden="true"></span>
                          {etapa.quien}
                        </span>
                      </header>
                      <h3 class="paso-titulo">{etapa.nombre}</h3>
                      <p class="paso-desc">{etapa.desc}</p>
                    </div>
                  </article>

                  <div class="timeline-v-nodo">
                    <span class="timeline-v-dot tb-dot">{etapa.num}</span>
                  </div>
                  <div class="timeline-v-vacio" aria-hidden="true"></div>
                </>
              ) : (
                /* Para etapa 1 y 3 (lado-der): Vacío en col 1, Nodo en col 2, Tarjeta en col 3 */
                <>
                  <div class="timeline-v-vacio" aria-hidden="true"></div>
                  <div class="timeline-v-nodo">
                    <span class="timeline-v-dot tb-dot">{etapa.num}</span>
                  </div>

                  <article class:list={["timeline-v-card", `card-color-${etapa.num}`]}>
                    <div class="timeline-v-card-fill" aria-hidden="true"></div>
                    <div class="timeline-v-card-body">
                      <header class="timeline-v-card-top">
                        <span class="paso-fase-etiqueta">Etapa {etapa.num}</span>
                        <span class="paso-quien-badge">
                          <span class="quien-dot" aria-hidden="true"></span>
                          {etapa.quien}
                        </span>
                      </header>
                      <h3 class="paso-titulo">{etapa.nombre}</h3>
                      <p class="paso-desc">{etapa.desc}</p>
                    </div>
                  </article>
                </>
              )}
            </div>
          ))
        }
      </div>

      <!-- Enlace contextual inferior centrado -->
      <div class="proceso-footer" id="procesoFooter">
        <a href="/diagnostico" class="enlace-diagnostico-btn" id="btnDiagnosticoDestino">
          <span class="btn-luz-punto" aria-hidden="true"></span>
          <span>Qué recibes en tu informe de diagnóstico</span>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3.5 10.5 8 6 12.5"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     PROCESO SECCIÓN (TRES ETAPAS) - IDÉNTICO A src/components/home/ComoEmpezar.astro
     ========================================================================== */
  .proceso-seccion {
    padding: var(--e-8, 64px) 0;
    background-color: var(--fondo-calido, #f7f9fc);
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  @media (width >= 1024px) {
    .proceso-seccion {
      padding: var(--e-9, 80px) 0;
    }
  }

  .seccion-cabecera {
    max-width: 54rem;
    margin-inline: auto;
    text-align: center;
    margin-bottom: 52px;
  }

  .seccion-kicker {
    font-family: "Sora", sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    color: #8da4be;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .seccion-kicker .kicker-sep {
    color: #1a6ff7;
    font-weight: 700;
  }

  .seccion-titulo {
    font-family: "Sora", sans-serif;
    font-size: clamp(1.85rem, 1.5rem + 1.8vw, 2.75rem);
    font-weight: 800;
    color: #0f2346;
    line-height: 1.18;
    margin: 0 0 16px;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .titulo-cursiva {
    font-family: "Merriweather", Georgia, serif;
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: #1a6ff7;
    letter-spacing: -0.01em;
    display: inline-block;
  }

  .seccion-subtitulo {
    font-size: 1.05rem;
    color: #63738e;
    line-height: 1.5;
    margin: 0;
  }

  /* ==========================================================================
     TIMELINE VERTICAL ALTERNADO CON HAZ DE LUZ CONTINUO
     - Etapa 1: Derecha
     - Etapa 2: Izquierda
     - Etapa 3: Derecha
     - Botón: Centro
     ========================================================================== */
  .timeline-vertical-wrap {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
    padding: 20px 0 0;
  }

  /* Pista vertical central */
  .timeline-v-track {
    position: absolute;
    top: 40px;
    bottom: 90px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    background: #e2eaf5;
    border-radius: 999px;
    z-index: 1;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .timeline-v-track {
      left: 28px;
      transform: none;
    }
  }

  /* Haz de luz de gradiente azul claro a medio que baja con el scroll */
  .timeline-v-beam {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 0%;
    background: linear-gradient(180deg, #1a6ff7 0%, #38b6ff 70%, #60a5fa 100%);
    box-shadow: 0 0 16px 2px rgba(56, 182, 255, 0.7);
    border-radius: 999px;
    transition: height 0.12s ease-out;
    will-change: height;
  }

  /* Lista de filas de etapas */
  .timeline-v-items {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-bottom: 48px;
  }

  /* Fila base de etapa */
  .timeline-v-fila {
    display: grid;
    grid-template-columns: 1fr 64px 1fr;
    align-items: center;
    position: relative;
    min-height: 140px;
  }

  @media (max-width: 768px) {
    .timeline-v-fila {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 20px;
      padding-left: 8px;
    }
  }

  /* Nodo central del número sobre el riel */
  .timeline-v-nodo {
    grid-column: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    align-self: center;
    height: 100%;
    z-index: 3;
  }

  @media (max-width: 768px) {
    .timeline-v-nodo {
      flex-shrink: 0;
      align-self: center;
      margin-top: 0;
    }
  }

  .timeline-v-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--tinta-2, #3a4b68);
    border: 2px solid #cbdbee;
    font-weight: 800;
    font-size: 1.15rem;
    font-family: var(--font-display, sans-serif);
    transition: all 0.35s ease;
    box-shadow: 0 2px 8px rgba(15, 35, 70, 0.06);
  }

  /* Punto iluminado al pasar el scroll */
  .timeline-v-fila.lit .timeline-v-dot {
    background: #1a6ff7;
    color: #ffffff;
    border-color: #38b6ff;
    box-shadow: 0 0 16px rgba(26, 111, 247, 0.6);
    transform: scale(1.08);
  }

  /* Ubicación alternada de tarjetas en Desktop */
  /* Etapa 1 y 3 a la derecha */
  .timeline-v-fila.lado-der .timeline-v-card {
    margin-left: 20px;
  }

  /* Etapa 2 a la izquierda */
  .timeline-v-fila.lado-izq .timeline-v-card {
    margin-right: 20px;
  }

  .timeline-v-vacio {
    display: block;
  }

  @media (max-width: 768px) {
    .timeline-v-vacio {
      display: none;
    }

    .timeline-v-fila.lado-der .timeline-v-card,
    .timeline-v-fila.lado-izq .timeline-v-card {
      margin: 0;
      width: 100%;
    }
  }

  /* ==========================================================================
     TARJETAS CON PINTURA PROGRESIVA AL SCROLL
     - Inician en blanco corporativo con bordes y tipografía nítida
     - Se van pintando suavemente a medida que el haz baja hacia el número
     - Al pasar el centro del número se pintan al 100% (azul celeste 1/3, azul profundo 2)
     ========================================================================== */
  .timeline-v-card {
    position: relative;
    overflow: hidden;
    background: #ffffff;
    border: 1.5px solid #d8e5f2;
    border-radius: 20px;
    box-shadow: 0 4px 18px rgba(15, 35, 70, 0.05);
    margin-top: auto;
    margin-bottom: auto;
    transform: scale(0.985);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .timeline-v-fila.lit .timeline-v-card {
    transform: scale(1);
  }

  /* Capa de relleno de color que se intensifica suavemente con --p-pintura */
  .timeline-v-card-fill {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    opacity: var(--p-pintura, 0);
    transition: opacity 0.08s linear;
    will-change: opacity;
  }

  /* Etapa 1 y 3: Azul celeste eléctrico (#1ea1f2 / #28a9f5) */
  .timeline-v-card.card-color-1 .timeline-v-card-fill,
  .timeline-v-card.card-color-3 .timeline-v-card-fill {
    background: linear-gradient(135deg, #28a9f5 0%, #1793e5 100%);
  }

  .timeline-v-fila.lit .timeline-v-card.card-color-1,
  .timeline-v-fila.lit .timeline-v-card.card-color-3 {
    border-color: rgba(255, 255, 255, 0.45);
    box-shadow: 0 16px 36px rgba(23, 147, 229, 0.42), 0 0 0 2px rgba(255, 255, 255, 0.45);
  }

  /* Etapa 2: Azul profundo corporativo (#004aad) */
  .timeline-v-card.card-color-2 .timeline-v-card-fill {
    background: linear-gradient(135deg, #0054c2 0%, #003c94 100%);
  }

  .timeline-v-fila.lit .timeline-v-card.card-color-2 {
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow: 0 16px 36px rgba(0, 74, 173, 0.45), 0 0 0 2px rgba(255, 255, 255, 0.45);
  }

  /* Contenido interno sobre la capa de pintura */
  .timeline-v-card-body {
    position: relative;
    z-index: 2;
    padding: 28px 26px;
  }

  .timeline-v-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  /* Etiqueta de fase (Etapa 1, 2, 3) */
  .paso-fase-etiqueta {
    font-family: "Sora", sans-serif;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 6px;
    background: #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
  }

  .timeline-v-card.card-color-1 .paso-fase-etiqueta,
  .timeline-v-card.card-color-3 .paso-fase-etiqueta {
    color: #1793e5;
    border: 1.5px solid color-mix(in srgb, transparent calc(var(--p-pintura, 0) * 100%), rgba(23, 147, 229, 0.3));
  }

  .timeline-v-card.card-color-2 .paso-fase-etiqueta {
    color: #004aad;
    border: 1.5px solid color-mix(in srgb, transparent calc(var(--p-pintura, 0) * 100%), rgba(0, 74, 173, 0.3));
  }

  /* Badge de quién interviene */
  .paso-quien-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: "Sora", sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, rgba(255, 255, 255, 0.22) calc(var(--p-pintura, 0) * 100%), #f1f5f9);
    color: color-mix(in srgb, #ffffff calc(var(--p-pintura, 0) * 100%), #3a4b68);
    border: 1px solid color-mix(in srgb, rgba(255, 255, 255, 0.32) calc(var(--p-pintura, 0) * 100%), #dbe4ef);
    backdrop-filter: blur(8px);
    transition: all 0.12s linear;
  }

  .quien-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    transition: background-color 0.12s linear;
  }

  .timeline-v-card.card-color-1 .quien-dot,
  .timeline-v-card.card-color-3 .quien-dot {
    background: color-mix(in srgb, #ffffff calc(var(--p-pintura, 0) * 100%), #1793e5);
  }

  .timeline-v-card.card-color-2 .quien-dot {
    background: color-mix(in srgb, #00d4ff calc(var(--p-pintura, 0) * 100%), #004aad);
  }

  /* Título y descripción con transición de color fluida mediante color-mix */
  .paso-titulo {
    font-family: "Sora", sans-serif;
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1.25;
    margin: 0 0 8px;
    letter-spacing: -0.015em;
    color: color-mix(in srgb, #ffffff calc(var(--p-pintura, 0) * 100%), #0f2346);
    transition: color 0.12s linear;
  }

  .paso-desc {
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
    color: color-mix(in srgb, rgba(255, 255, 255, 0.95) calc(var(--p-pintura, 0) * 100%), #475569);
    transition: color 0.12s linear;
  }

  /* Botón centrado en el footer */
  .proceso-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 16px;
    position: relative;
    z-index: 3;
  }

  .enlace-diagnostico-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    background: #ffffff;
    border: 1.5px solid var(--azul-900, #004aad);
    border-radius: 999px;
    color: var(--azul-900, #004aad);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(15, 35, 70, 0.06);
    transition: all 0.3s ease;
  }

  .btn-luz-punto {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cbdbee;
    transition: all 0.3s ease;
  }

  /* Resaltado del botón al terminar el recorrido */
  .enlace-diagnostico-btn.lit {
    border-color: #38b6ff;
    box-shadow: 0 0 24px rgba(56, 182, 255, 0.4), 0 8px 24px rgba(0, 74, 173, 0.12);
    transform: translateY(-2px);
  }

  .enlace-diagnostico-btn.lit .btn-luz-punto {
    background: #00e599;
    box-shadow: 0 0 10px #00e599, 0 0 4px #00e599;
  }

  .enlace-diagnostico-btn:hover {
    background: #eef5ff;
    transform: translateY(-2px);
  }

  .enlace-diagnostico-btn svg {
    transition: transform 0.15s;
  }

  .enlace-diagnostico-btn:hover svg {
    transform: translateX(4px);
  }
</style>

<script>
  // =========================================================================
  // ANIMACIÓN DE HAZ DE LUZ VERTICAL (BEAM) CON PINTURA SUAVE Y CONTINUA
  // =========================================================================
  function initProcesoBeamVertical() {
    const timeline = document.getElementById("procesoTimeline");
    const beam = document.getElementById("procesoBeam");
    const btnDestino = document.getElementById("btnDiagnosticoDestino");
    if (!timeline || !beam) return;

    const items = Array.from(timeline.querySelectorAll<HTMLElement>(".tb-item"));
    let ticking = false;

    function actualizarBeam() {
      const rect = timeline.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      // La línea de lectura media en la pantalla (58% de la altura visible)
      const lineaLectura = windowHeight * 0.58;
      
      // Avance vertical dentro del riel del timeline
      const filled = Math.max(0, Math.min(rect.height - 70, lineaLectura - rect.top));
      beam.style.height = `${filled}px`;

      // Pintura progresiva suave de cada tarjeta y nodo al compás del scroll
      items.forEach((item) => {
        const dot = item.querySelector<HTMLElement>(".tb-dot");
        const card = item.querySelector<HTMLElement>(".timeline-v-card");
        if (!dot || !card) return;

        const dr = dot.getBoundingClientRect();
        const centroDot = dr.top + dr.height / 2;

        // Se empieza a pintar suavemente con 260px de anticipación antes de llegar al centro del número
        const distanciaVentana = 260;
        const startY = centroDot - distanciaVentana;

        let progreso = 0;
        if (lineaLectura >= centroDot) {
          progreso = 1;
        } else if (lineaLectura <= startY) {
          progreso = 0;
        } else {
          progreso = (lineaLectura - startY) / distanciaVentana;
        }

        const pasado = centroDot <= lineaLectura;
        item.classList.toggle("lit", pasado);
        card.style.setProperty("--p-pintura", (pasado ? 1 : progreso).toFixed(3));
      });

      // Iluminar el botón centrado al llegar al final del timeline
      if (btnDestino) {
        const btnRect = btnDestino.getBoundingClientRect();
        const botonAlcanzado = btnRect.top <= lineaLectura + 40;
        btnDestino.classList.toggle("lit", botonAlcanzado);
      }

      ticking = false;
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(actualizarBeam);
        }
      },
      { passive: true }
    );

    window.addEventListener("resize", actualizarBeam);
    actualizarBeam();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProcesoBeamVertical);
  } else {
    initProcesoBeamVertical();
  }

  document.addEventListener("astro:page-load", initProcesoBeamVertical);
</script>
