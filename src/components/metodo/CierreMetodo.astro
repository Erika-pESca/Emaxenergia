---
// Componente CierreMetodo de la sección El Método
// Estructura y diseño idénticos a src/components/home/ProximaFactura.astro:
// 1. Camino A: Selector interactivo de tramos de gasto que conecta con el modal del funnel
// 2. Camino B: Llamada telefónica directa a un especialista humano con horario y radar en vivo
import { site } from "../../data/site";

interface TramoGasto {
  id: string;
  etiqueta: string;
  rango: string;
  msg: string;
}

const tramosCierre: TramoGasto[] = [
  {
    id: "menos-300",
    etiqueta: "Menos de 300 €",
    rango: "menos de 3.600 € al año en luz",
    msg: "Con este gasto hacemos un estudio sencillo a partir de los datos básicos de tu factura.",
  },
  {
    id: "300-1000",
    etiqueta: "300 – 1.000 €",
    rango: "entre 3.600 y 12.000 € al año en luz",
    msg: "Con este gasto merece la pena auditar tu potencia, los periodos y las 5 decisiones.",
  },
  {
    id: "1000-3000",
    etiqueta: "1.000 – 3.000 €",
    rango: "entre 12.000 y 36.000 € al año en luz",
    msg: "Con este gasto te atiende un gestor especialista que revisa tu suministro completo.",
  },
  {
    id: "mas-3000",
    etiqueta: "Más de 3.000 €",
    rango: "más de 36.000 € al año en luz",
    msg: "Con este gasto realizamos una auditoría técnica completa de potencia, reactiva y peajes.",
  },
];
---

<section class="cierre-seccion" id="cierre-metodo" aria-labelledby="h2-cierre-metodo">
  <div class="contenedor">
    <div class="cierre-caja tarjeta-blanca">
      <!-- Encabezado de Cierre -->
      <div class="cierre-header">
        <div class="kicker-wrap">
          <span class="kicker-punto" aria-hidden="true"></span>
          <span class="kicker-texto">El método en tu empresa</span>
        </div>
        <h2 class="cierre-titulo" id="h2-cierre-metodo">Tu consumo define cómo compras energía.</h2>
        <p class="cierre-subtitulo">
          Empieza por lo que paga tu empresa. Las cinco decisiones las ponemos nosotros.
        </p>
      </div>

      <!-- Dos Caminos de Conversión: Opción A y Opción B -->
      <div class="cierre-caminos-grid">
        <!-- Camino A: Quiero los números -->
        <div class="camino-card">
          <div class="camino-top">
            <span class="camino-badge-step">Opción A</span>
            <h3 class="camino-tit">Quiero los números</h3>
            <p class="camino-desc">¿Cuánto paga tu empresa de luz al mes aproximadamente?</p>
          </div>

          <div class="tramos-cierre-lista">
            {
              tramosCierre.map((t) => (
                <button
                  type="button"
                  class="tramo-cierre-btn"
                  data-abrir-funnel
                  data-tramo-id={t.id}
                  data-tramo-label={t.etiqueta}
                  data-tramo-rango={t.rango}
                  data-tramo-msg={t.msg}
                >
                  <span>{t.etiqueta}</span>
                  <span aria-hidden="true" class="flecha">→</span>
                </button>
              ))
            }
          </div>

          <p class="cierre-nota-sub">
            Después eliges cómo seguimos, y un consultor te llama con tu informe en la franja que tú elijas.
          </p>
        </div>

        <!-- Camino B: Quiero hablar directo -->
        <div class="camino-card camino-telefono">
          <div class="camino-top">
            <span class="camino-badge-step destacada">Opción B</span>
            <h3 class="camino-tit">Prefiero hablar con un especialista</h3>
            <p class="camino-desc">Llámanos ahora mismo o solicita llamada directa en tu horario preferido.</p>
          </div>

          <div class="telefono-destacado-box">
            <span class="tel-label">Línea directa para empresas</span>
            <a href={site.phoneHref} class="tel-enlace-grande">
              <span class="tel-sonar-dot" aria-hidden="true"></span>
              {site.phone}
            </a>
            <span class="tel-horario">{site.horario}</span>
          </div>

          <a href="/contacto" class="boton-solicitar-llamada">
            Solicitar que me llamen gratis
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     CIERRE SECCIÓN - IDÉNTICO A src/components/home/ProximaFactura.astro
     ========================================================================== */
  .cierre-seccion {
    padding: 76px 0 84px;
    background: #ffffff;
    border-top: 1px solid var(--linea-fina, #e6edf7);
  }

  .cierre-caja {
    padding: 56px 44px;
    border-radius: var(--radio-grande, 28px);
    border: 1.5px solid #d4e2f5;
    background: #f8fbff;
    box-shadow: var(--sombra-tarjeta, 0 8px 24px rgba(15, 35, 70, 0.07));
  }

  @media (max-width: 768px) {
    .cierre-caja {
      padding: 36px 20px;
      border-radius: var(--radio-tarjeta, 20px);
    }
  }

  .cierre-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .kicker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radio-pill, 999px);
    background: #ffffff;
    border: 1px solid #d8e5f5;
  }

  .kicker-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--azul-900, #004aad);
  }

  .kicker-texto {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--azul-900, #004aad);
  }

  .cierre-titulo {
    font-family: var(--font-titulos, serif);
    font-size: clamp(2rem, 1.6rem + 1.8vw, 2.9rem);
    color: var(--tinta, #0f2346);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }

  .cierre-subtitulo {
    font-size: 1.15rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.55;
    margin: 0;
  }

  .cierre-caminos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  @media (max-width: 900px) {
    .cierre-caminos-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .camino-card {
    background: #ffffff;
    border: 1.5px solid #d6e2f0;
    border-radius: var(--radio-tarjeta, 20px);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .camino-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--sombra-tarjeta, 0 8px 24px rgba(15, 35, 70, 0.07));
  }

  .camino-top {
    margin-bottom: 24px;
  }

  .camino-badge-step {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: var(--radio-pill, 999px);
    background: #eef4fc;
    color: var(--azul-900, #004aad);
    margin-bottom: 12px;
  }

  .camino-badge-step.destacada {
    background: var(--verde-fondo, #ecfdf3);
    color: var(--verde-ok, #067647);
  }

  .camino-tit {
    font-family: var(--font-titulos, serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--tinta, #0f2346);
    margin: 0 0 6px;
  }

  .camino-desc {
    font-size: 0.95rem;
    color: var(--tinta-2, #3a4b68);
    margin: 0;
    line-height: 1.45;
  }

  /* Lista de tramos Camino A */
  .tramos-cierre-lista {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 16px;
  }

  @media (max-width: 500px) {
    .tramos-cierre-lista {
      grid-template-columns: 1fr;
    }
  }

  .tramo-cierre-btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1.5px solid #c8d8ec;
    background: #ffffff;
    color: var(--tinta, #0f2346);
    font-weight: 600;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s;
  }

  .tramo-cierre-btn:hover {
    border-color: var(--azul-900, #004aad);
    background: var(--azul-suave, #edf4fe);
    color: var(--azul-900, #004aad);
    transform: translateY(-1px);
  }

  .tramo-cierre-btn .flecha {
    color: var(--azul-900, #004aad);
    font-weight: 700;
  }

  .cierre-nota-sub {
    font-size: 0.82rem;
    color: var(--tinta-3, #63738e);
    margin: 0;
    line-height: 1.4;
  }

  /* Caja teléfono Camino B */
  .telefono-destacado-box {
    background: #f1f6fd;
    border: 1.5px dashed #b8cee8;
    border-radius: 14px;
    padding: 20px;
    text-align: center;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .tel-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tinta-3, #63738e);
  }

  .tel-enlace-grande {
    font-family: var(--font-display, sans-serif);
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--azul-900, #004aad);
    text-decoration: none;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.15s;
  }

  .tel-enlace-grande:hover {
    color: var(--azul-700, #0f5bd8);
  }

  .tel-sonar-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--verde-ok, #067647);
    box-shadow: 0 0 0 0 rgba(6, 118, 71, 0.7);
    animation: sonarPulse 1.8s infinite;
  }

  @keyframes sonarPulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(6, 118, 71, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 8px rgba(6, 118, 71, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(6, 118, 71, 0);
    }
  }

  .tel-horario {
    font-size: 0.8rem;
    color: var(--tinta-2, #3a4b68);
  }

  .boton-solicitar-llamada {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    background: var(--azul-900, #004aad);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: var(--radio-pill, 999px);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 74, 173, 0.25);
    transition: all 0.15s;
  }

  .boton-solicitar-llamada:hover {
    background: var(--azul-900-hover, #003c8c);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 74, 173, 0.35);
  }
</style>
