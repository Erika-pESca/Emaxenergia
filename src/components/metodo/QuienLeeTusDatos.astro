---
// Componente QuienLeeTusDatos de la sección El Método
// Estructura y diseño idénticos a src/components/home/TecnologiaPersonas.astro:
// Combina la potencia del motor algorítmico Maxi con la cercanía y el criterio de un consultor colegiado
import fotoConsultor from "../../imagenes/consultor-emax.jpg";

const funcionesMaxi = [
  { texto: "Relaciona la información de consumo de tu suministro.", detalle: "Qué pasa en cada periodo, con qué potencia y en qué meses del año." },
  { texto: "Cruza tu potencia contratada con tus maxímetros reales.", detalle: "Detecta kW ociosos por los que pagas cuota fija innecesaria." },
  { texto: "Identifica excesos y penalizaciones por energía reactiva.", detalle: "Calcula el acumulado anual evitable en tu factura." },
];

const funcionesEspecialista = [
  { texto: "Interpreta y audita lo que ha procesado Maxi.", detalle: "Criterio técnico colegiado adaptado a la operativa real de tu empresa." },
  { texto: "Decide qué conviene cambiar y qué se mantiene.", detalle: "Si tu contrato actual ya es el más adecuado, te lo dice con honestidad." },
  { texto: "Firma tu informe y te lo explica por teléfono.", detalle: "Atención directa con una persona que conoce tu caso de principio a fin." },
];
---

<section class="maxi-humano-seccion" id="maxi" aria-labelledby="h2-maxi">
  <div class="contenedor">
    <div class="seccion-cabecera">
      <div class="kicker-wrap">
        <span class="kicker-punto" aria-hidden="true"></span>
        <span class="kicker-texto">Tecnología de datos + Criterio humano</span>
      </div>
      <h2 class="seccion-titulo" id="h2-maxi">Quién lee tus datos</h2>
      <p class="seccion-subtitulo">
        Maxi no decide por ti. Te da mejores datos para decidir con criterio propio y un especialista asignado a tu lado.
      </p>
    </div>

    <!-- Rejilla de dupla idéntica a home/TecnologiaPersonas -->
    <div class="dupla-grid">
      <!-- Tarjeta 1: Maxi (El motor de datos) -->
      <article class="tarjeta-dupla tarjeta-maxi">
        <header class="dupla-header">
          <div class="icono-entidad icono-maxi" aria-hidden="true">
            <span class="letra-m">M</span>
          </div>
          <div>
            <span class="entidad-tipo">Motor de análisis EMAX</span>
            <h3 class="entidad-nombre">Maxi</h3>
          </div>
        </header>

        <p class="entidad-descripcion">
          Tecnología de análisis de datos que procesa lecturas cuartohorarias, cruza curvas de carga y detecta desviaciones en segundos.
        </p>

        <ul class="funciones-lista" role="list">
          {
            funcionesMaxi.map((f) => (
              <li class="funcion-item">
                <span class="funcion-bullet" aria-hidden="true">✓</span>
                <div>
                  <strong class="funcion-texto">{f.texto}</strong>
                  <span class="funcion-detalle">{f.detalle}</span>
                </div>
              </li>
            ))
          }
        </ul>

        <!-- Lo que Maxi no hace (advertencia honesta del método) -->
        <div class="dupla-alerta-honestidad">
          <span class="alerta-etiqueta">Lo que Maxi no hace:</span>
          <p class="alerta-texto">
            Maxi no decide solo, no garantiza resultados milagro, no sustituye a tu consultor y nunca toca tu contador.
          </p>
        </div>
      </article>

      <!-- Tarjeta 2: Tu Especialista Humano EMAX (Con fotografía real de oficina) -->
      <article class="tarjeta-dupla tarjeta-especialista tarjeta-blanca">
        <header class="dupla-header con-foto">
          <img
            src={fotoConsultor.src}
            alt="Consultor energético especialista de EMAX Energía"
            class="avatar-foto"
            width={64}
            height={64}
            loading="lazy"
          />
          <div>
            <span class="entidad-tipo destacado-verde">Tu consultor asignado</span>
            <h3 class="entidad-nombre">La persona</h3>
          </div>
        </header>

        <p class="entidad-descripcion">
          Un especialista en energía para empresas con nombre y apellidos que conoce tu sector, da la cara y te acompaña en cada decisión.
        </p>

        <ul class="funciones-lista" role="list">
          {
            funcionesEspecialista.map((f) => (
              <li class="funcion-item">
                <span class="funcion-bullet verde" aria-hidden="true">✓</span>
                <div>
                  <strong class="funcion-texto">{f.texto}</strong>
                  <span class="funcion-detalle">{f.detalle}</span>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="dupla-footer-nota">
          <span>Un consultor asignado que te atiende por teléfono con tu informe delante</span>
        </div>
      </article>
    </div>

    <!-- Lema destacado institucional -->
    <div class="maxi-lema-caja">
      <p class="maxi-lema-frase">
        «Maxi no decide por ti. Te da mejores datos para decidir.»
      </p>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     QUIÉN LEE TUS DATOS - IDÉNTICO A src/components/home/TecnologiaPersonas.astro
     ========================================================================== */
  .maxi-humano-seccion {
    padding: var(--e-8, 64px) 0;
    background-color: var(--fondo-calido, #f7f9fc);
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  @media (width >= 1024px) {
    .maxi-humano-seccion {
      padding: var(--e-9, 80px) 0;
    }
  }

  .seccion-cabecera {
    max-width: 48rem;
    margin-bottom: 40px;
  }

  .kicker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--azul-resalte, #ddf1ff);
    padding: 6px 14px;
    border-radius: var(--radio-pill, 999px);
    margin-bottom: 14px;
  }

  .kicker-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--azul-600, #1a6ff7);
    display: inline-block;
  }

  .kicker-texto {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--azul-900, #004aad);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .seccion-titulo {
    font-family: var(--font-titulos, serif);
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: 700;
    color: var(--tinta, #0f2346);
    line-height: 1.22;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }

  .seccion-subtitulo {
    font-size: 1.125rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.5;
    margin: 0;
  }

  /* Rejilla de las 2 tarjetas */
  .dupla-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-bottom: 32px;
  }

  @media (max-width: 860px) {
    .dupla-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .tarjeta-dupla {
    background: var(--papel, #ffffff);
    border: 1px solid var(--linea, #d6e0ee);
    border-radius: var(--radio-tarjeta, 20px);
    padding: 32px 28px 24px;
    box-shadow: var(--sombra-tarjeta, 0 8px 24px rgba(15, 35, 70, 0.07));
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .tarjeta-dupla:hover {
    transform: translateY(-3px);
    box-shadow: var(--sombra-flotante, 0 14px 40px rgba(0, 74, 173, 0.16));
  }

  .dupla-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .icono-entidad {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.75rem;
    font-family: var(--font-display, sans-serif);
    flex-shrink: 0;
  }

  .icono-maxi {
    background: linear-gradient(135deg, #004aad 0%, #1a6ff7 100%);
    color: #fff;
    box-shadow: 0 6px 16px rgba(0, 74, 173, 0.25);
  }

  .avatar-foto {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    object-fit: cover;
    box-shadow: 0 4px 14px rgba(15, 35, 70, 0.15);
    border: 2px solid #fff;
    flex-shrink: 0;
  }

  .entidad-tipo {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--tinta-3, #63738e);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 2px;
  }

  .entidad-tipo.destacado-verde {
    color: var(--verde-ok, #067647);
  }

  .entidad-nombre {
    font-family: var(--font-titulos, serif);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--tinta, #0f2346);
    margin: 0;
  }

  .entidad-descripcion {
    font-size: 0.95rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.5;
    margin: 0 0 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  .funciones-lista {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .funcion-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .funcion-bullet {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--azul-resalte, #ddf1ff);
    color: var(--azul-900, #004aad);
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .funcion-bullet.verde {
    background: var(--verde-fondo, #ecfdf3);
    color: var(--verde-ok, #067647);
  }

  .funcion-texto {
    display: block;
    font-size: 0.93rem;
    font-weight: 600;
    color: var(--tinta, #0f2346);
    line-height: 1.35;
  }

  .funcion-detalle {
    display: block;
    font-size: 0.84rem;
    color: var(--tinta-2, #3a4b68);
    line-height: 1.4;
    margin-top: 2px;
  }

  .dupla-alerta-honestidad {
    background: #fff8f5;
    border: 1px solid #ffd8cc;
    border-radius: 12px;
    padding: 12px 14px;
    margin-top: auto;
  }

  .alerta-etiqueta {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    color: #c2410c;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }

  .alerta-texto {
    font-size: 0.85rem;
    color: #7c2d12;
    margin: 0;
    line-height: 1.4;
  }

  .dupla-footer-nota {
    background: var(--fondo, #f4f7fb);
    border: 1px solid var(--linea-fina, #e6edf7);
    border-radius: 12px;
    padding: 12px 14px;
    margin-top: auto;
    font-size: 0.85rem;
    color: var(--tinta-2, #3a4b68);
    font-weight: 500;
    line-height: 1.4;
  }

  /* Lema final */
  .maxi-lema-caja {
    background: var(--papel, #ffffff);
    border: 1.5px solid var(--linea, #d6e0ee);
    border-radius: var(--radio-tarjeta, 20px);
    padding: 24px 32px;
    text-align: center;
    box-shadow: var(--sombra-subtil, 0 2px 6px rgba(15, 35, 70, 0.04));
  }

  .maxi-lema-frase {
    font-family: var(--font-titulos, serif);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    font-weight: 700;
    color: var(--azul-900, #004aad);
    margin: 0;
    font-style: italic;
  }
</style>
