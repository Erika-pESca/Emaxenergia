---
// Componente QuienLeeTusDatos de la sección El Método
// 3 tarjetas interactivas con imágenes reales y animación expansiva al hover
import fotoPersonal from "../../imagenes/personal.jpg";
import fotoMaxi from "../../imagenes/maxi.jpg";
import fotoConsultor from "../../imagenes/consultor-emax.jpg";

interface TarjetaData {
  titulo: string;
  desc: string;
  foto: ImageMetadata;
  alt: string;
}

const tarjetas: TarjetaData[] = [
  {
    titulo: "La persona",
    desc: "Un especialista interpreta lo que ha leído Maxi, decide qué se recomienda y lo firma.",
    foto: fotoPersonal,
    alt: "Especialista energética de EMAX analizando informe de consumo",
  },
  {
    titulo: "Maxi",
    desc: "Maxi es la tecnología de análisis de EMAX. Relaciona la información de consumo de tu suministro y ayuda al equipo a estudiarlo: qué pasa en cada periodo, con qué potencia, en qué meses.",
    foto: fotoMaxi,
    alt: "Maxi, tecnología de análisis de datos de EMAX Energía",
  },
  {
    titulo: "Lo que Maxi no hace",
    desc: "Maxi no decide solo, no garantiza resultados, no sustituye a tu consultor y no toca tu contador.",
    foto: fotoConsultor,
    alt: "Consultor energético colegiado de EMAX supervisando datos",
  },
];
---

<section class="quien-lee-seccion" id="quien-lee-datos" aria-labelledby="h2-quien-lee">
  <div class="contenedor">
    <div class="seccion-cabecera">
      <p class="seccion-kicker">
        ASI FUNCIONA <span class="kicker-sep" aria-hidden="true">|</span>
      </p>
      <h2 class="seccion-titulo" id="h2-quien-lee">
        QUIÉN LEE TUS DATOS
      </h2>
    </div>

    <!-- Rejilla de las 3 tarjetas interactivas con fotos y efecto expansivo al hover -->
    <div class="tarjetas-grid">
      {
        tarjetas.map((t, idx) => (
          <article class:list={["tarjeta-quien", `tarjeta-${idx + 1}`]}>
            <div class="tarjeta-img-wrap">
              <img
                src={t.foto.src}
                alt={t.alt}
                class="tarjeta-foto"
                loading="lazy"
              />
              <div class="tarjeta-sombra-gradiente" aria-hidden="true"></div>
            </div>

            <div class="tarjeta-info-caja">
              <h3 class="tarjeta-titulo">{t.titulo}</h3>
              <p class="tarjeta-desc">{t.desc}</p>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Lema inferior centrado -->
    <div class="quien-lema-wrap">
      <p class="quien-lema-texto">
        Maxi no decide por ti. Te da mejores datos para decidir.
      </p>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     SECCIÓN QUIÉN LEE TUS DATOS
     ========================================================================== */
  .quien-lee-seccion {
    padding: var(--e-8, 64px) 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--linea-fina, #e6edf7);
  }

  @media (width >= 1024px) {
    .quien-lee-seccion {
      padding: 80px 0 96px;
    }
  }

  .seccion-cabecera {
    max-width: 54rem;
    margin-bottom: 44px;
  }

  .seccion-kicker {
    font-family: "Sora", sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    color: #8da4be;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .kicker-sep {
    color: #1a6ff7;
    font-weight: 700;
  }

  .seccion-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2rem, 1.6rem + 1.8vw, 2.85rem);
    font-weight: 800;
    color: #0f2346;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  /* ==========================================================================
     REJILLA DE TARJETAS Y ANIMACIÓN EXPANSIVA AL HOVER ("MÁS GRANDE Y GORDITO")
     ========================================================================== */
  .tarjetas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    align-items: stretch;
  }

  @media (max-width: 960px) {
    .tarjetas-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      max-width: 520px;
      margin-inline: auto;
    }
  }

  /* Tarjeta base con el mismo borde sutil de las tarjetas del sitio */
  .tarjeta-quien {
    position: relative;
    height: 540px;
    border-radius: 26px;
    overflow: hidden;
    background: #0d1e38;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-shadow: 0 8px 24px rgba(15, 35, 70, 0.08);
    border: 1.5px solid var(--linea, #d6e0ee);
    cursor: pointer;
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s ease,
      opacity 0.35s ease;
    will-change: transform, box-shadow;
  }

  /* Efecto de foco: atenuar sutilmente las hermanas para que la activa resalte */
  .tarjetas-grid:hover .tarjeta-quien:not(:hover) {
    opacity: 0.9;
    transform: scale(0.985);
  }

  /* Hover de la tarjeta activa: se eleva y aparece una línea azul brillante a los alrededores */
  .tarjeta-quien:hover {
    transform: scale(1.05) translateY(-8px);
    border-color: #38b6ff;
    box-shadow:
      0 22px 48px rgba(15, 35, 70, 0.16),
      0 0 0 2px #38b6ff,
      0 0 22px rgba(56, 182, 255, 0.55);
    z-index: 5;
    opacity: 1 !important;
  }

  /* Contenedor de la fotografía con zoom al hover */
  .tarjeta-img-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    border-radius: inherit;
  }

  .tarjeta-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Al pasar el cursor: SE AGRANDA LA IMAGEN */
  .tarjeta-quien:hover .tarjeta-foto {
    transform: scale(1.12);
  }

  /* Gradiente para asegurar legibilidad */
  .tarjeta-sombra-gradiente {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 23, 46, 0.05) 0%,
      rgba(8, 23, 46, 0.25) 45%,
      rgba(8, 23, 46, 0.86) 82%,
      rgba(8, 23, 46, 0.98) 100%
    );
    pointer-events: none;
  }

  /* Caja inferior de información:
     - En reposo es compacta para lucir la imagen
     - Al pasar el cursor SE HACE MÁS GRANDE hacia arriba revelando la tipografía ampliada */
  .tarjeta-info-caja {
    position: relative;
    z-index: 2;
    background: rgba(14, 34, 64, 0.84);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 22px 22px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom: none;
    padding: 16px 20px 20px;
    margin: 0;
    transition:
      padding 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.35s ease,
      border-color 0.35s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Al pasar el cursor: SE HACE MÁS GRANDE LA PARTE DE LA INFORMACIÓN */
  .tarjeta-quien:hover .tarjeta-info-caja {
    background: rgba(10, 26, 52, 0.96);
    border-color: rgba(255, 255, 255, 0.24);
    padding: 22px 22px 26px;
    transform: translateY(-4px);
  }

  /* Título de la tarjeta: crece y brilla en cian al hover */
  .tarjeta-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.25rem;
    font-weight: 800;
    color: #00c2ff;
    line-height: 1.2;
    margin: 0 0 6px;
    letter-spacing: -0.015em;
    transition:
      font-size 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.3s ease,
      margin-bottom 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      text-shadow 0.35s ease;
  }

  .tarjeta-quien:hover .tarjeta-titulo {
    font-size: 1.4rem;
    color: #00d4ff;
    margin-bottom: 8px;
    text-shadow: 0 0 16px rgba(0, 212, 255, 0.6);
  }

  /* Descripción: en hover se amplía y resalta en blanco de alto contraste como en la captura */
  .tarjeta-desc {
    font-family: "Inter", sans-serif;
    font-size: 0.86rem;
    color: rgba(226, 234, 245, 0.88);
    line-height: 1.46;
    margin: 0;
    transition:
      font-size 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.35s ease,
      line-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tarjeta-quien:hover .tarjeta-desc {
    font-size: 0.94rem;
    line-height: 1.5;
    color: #ffffff;
    font-weight: 500;
  }

  /* ==========================================================================
     LEMA FINAL CENTRADO
     ========================================================================== */
  .quien-lema-wrap {
    text-align: center;
    margin-top: 52px;
  }

  .quien-lema-texto {
    font-family: "Sora", sans-serif;
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
    font-weight: 700;
    color: #0f2346;
    line-height: 1.4;
    margin: 0;
    letter-spacing: -0.01em;
  }
</style>
