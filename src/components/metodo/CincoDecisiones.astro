---
// Componente CincoDecisiones de la sección El Método
// Estructura y diseño idénticos a los componentes de src/components/home:
// 5 decisiones estratégicas con acordeones interactivos, datos contrastados y enlaces a guías
interface EnlaceGuia {
  texto: string;
  href: string;
}

interface FilaDecision {
  etiqueta: string;
  contenido: string;
  esDato?: boolean;
  esFuente?: boolean;
}

interface Decision {
  id: string;
  numero: number;
  titulo: string;
  resumen: string;
  filas: FilaDecision[];
  enlaces: EnlaceGuia[];
  detalleTracking: string;
}

const decisiones: Decision[] = [
  {
    id: "potencia",
    numero: 1,
    titulo: "¿Pagas la potencia que usas?",
    resumen: "Bajar la potencia de algún periodo, subirla si estás pagando excesos, o dejarla como está.",
    detalleTracking: "metodo · decisión 1",
    filas: [
      {
        etiqueta: "Entrada",
        contenido: "La potencia contratada se paga cada día y en cada periodo, la uses o no. Es la parte de la factura que más se parece a una cuota fija obligatoria.",
      },
      {
        etiqueta: "El dato",
        contenido: "La potencia contratada en cada periodo frente a la que tu empresa ha llegado a usar: los maxímetros de los últimos doce meses o, si nos autorizas, tu curva de consumo hora a hora.",
        esDato: true,
      },
      {
        etiqueta: "Límites",
        contenido: "En peajes 3.0TD y 6.1TD cada periodo debe tener igual o mayor potencia que el anterior (de P1 a P6 en escala creciente). Por eso, a veces un periodo lleva más potencia de la que usa. El cambio lo ejecuta la distribuidora, que puede limitarlo a un cambio voluntario cada doce meses. Contratar menos de lo que usas tampoco compensa: el precio del exceso está diseñado para penalizar. Por eso, sin maxímetros ni curva, nunca recomendamos tocar la potencia.",
      },
      {
        etiqueta: "Fuentes",
        contenido: "Circular 3/2020 de la CNMC, artículos 6.2 y 8.9",
        esFuente: true,
      },
    ],
    enlaces: [
      { texto: "Guía de potencia contratada →", href: "/guias/potencia-contratada" },
      { texto: "Evitar exceso de potencia →", href: "/guias/exceso-de-potencia" },
    ],
  },
  {
    id: "penalizaciones",
    numero: 2,
    titulo: "¿Pagas penalizaciones que se corrigen fuera del contrato?",
    resumen: "Ajustar la potencia, si hay excesos. Corregir la instalación, si la reactiva lo justifica. O dejarlo, si lo que pagas es poco.",
    detalleTracking: "metodo · decisión 2",
    filas: [
      {
        etiqueta: "Entrada",
        contenido: "Hay dos recargos que no dependen del precio que pactes con la compañía, sino de cómo usa la energía tu propia instalación: los excesos de potencia y la energía reactiva inductiva.",
      },
      {
        etiqueta: "El dato",
        contenido: "Los excesos y la reactiva que aparecen en tu factura, periodo a periodo, y cuánto suman en el acumulado anual de tu cuenta de resultados.",
        esDato: true,
      },
      {
        etiqueta: "Límites",
        contenido: "La reactiva no se soluciona cambiando de comercializadora: se corrige en tu cuadro eléctrico, normalmente instalando una batería de condensadores dimensionada. Es una inversión, y solo tiene sentido si se amortiza en un plazo razonable: te lo calculamos con tus costes anuales delante. La reactiva no se factura en P6, ni en suministros 2.0TD de 15 kW o menos.",
      },
      {
        etiqueta: "Fuentes",
        contenido: "Circular 3/2020 de la CNMC, art. 9.5 · Resolución de peajes de la CNMC para 2026, anexo III",
        esFuente: true,
      },
    ],
    enlaces: [
      { texto: "Guía de energía reactiva →", href: "/guias/energia-reactiva" },
      { texto: "Gestión de excesos →", href: "/guias/exceso-de-potencia" },
    ],
  },
  {
    id: "cuando-consumes",
    numero: 3,
    titulo: "¿Cuándo consume tu empresa?",
    resumen: "Una estructura de precio a medida: seis periodos (Genio), día y noche (Ingenio) o un precio único las 24 horas (Deseo).",
    detalleTracking: "metodo · decisión 3",
    filas: [
      {
        etiqueta: "Entrada",
        contenido: "No todas las horas cuestan lo mismo. La parte regulada del kWh (peajes y cargos) cambia según la hora, el día y la temporada del año. En 3.0TD, el kWh en el periodo punta más caro llega a multiplicar por 22 veces el precio del periodo valle.",
      },
      {
        etiqueta: "El dato",
        contenido: "Cómo se reparte tu consumo entre periodos (de P1 a P6 en 3.0TD y 6.1TD; punta, llano y valle en 2.0TD), traducido a los turnos reales de tu negocio: cocinas, cámaras 24h, maquinaria y fines de semana.",
        esDato: true,
      },
      {
        etiqueta: "Límites",
        contenido: "Los peajes y cargos oficiales de la distribuidora se liquidan siempre por los periodos regulados por ley, elijas la estructura que elijas. Lo que cambia es cómo empaquetamos el precio de la energía. La modalidad Genio solo existe en peajes con seis periodos (3.0TD y 6.1TD). Ingenio y Deseo se adaptan a cualquier suministro.",
      },
      {
        etiqueta: "Fuentes",
        contenido: "Circular 3/2020 de la CNMC, art. 7 · Resolución de peajes 2026 y Orden TED/1524/2025",
        esFuente: true,
      },
    ],
    enlaces: [
      { texto: "El peaje 3.0TD y sus periodos →", href: "/guias/peaje-3-0td" },
      { texto: "Estructuras de tarifa por dentro →", href: "/tarifas#estructura" },
    ],
  },
  {
    id: "riesgo",
    numero: 4,
    titulo: "¿Qué riesgo puede asumir tu empresa?",
    resumen: "Precio fijo, indexado o Cuota Fija.",
    detalleTracking: "metodo · decisión 4",
    filas: [
      {
        etiqueta: "Entrada",
        contenido: "Fijo o indexado es la pregunta que más te habrán hecho los comerciales y la que menos se responde con datos. No depende de adivinar qué hará el mercado mayorista, sino de la tolerancia de tu tesorería.",
      },
      {
        etiqueta: "El dato",
        contenido: "Cuatro preguntas clave: ¿un mes caro de mercado descuadra tu margen? ¿Tu consumo tiene picos estacionales muy marcados? ¿Consumes en horas de solar barata o puedes desplazar procesos? ¿Tienes tiempo para seguir el mercado?",
        esDato: true,
      },
      {
        etiqueta: "Qué asumes en cada una",
        contenido: "<strong>Precio fijo:</strong> certeza total en el precio del kWh, asumiendo pagar algo más si el mercado baja.<br /><strong>Indexado:</strong> pagas la energía a precio de coste mayorista OMIE, asumiendo la volatilidad tanto al alza como a la baja.<br /><strong>Cuota Fija:</strong> previsibilidad presupuestaria mensual con regularización anual según consumo real.",
      },
      {
        etiqueta: "Límites",
        contenido: "No decidimos por corazonadas sobre el precio futuro. E incluso en tarifa indexada, los componentes regulados (peajes y cargos) siguen su propio calendario oficial inamovible.",
      },
    ],
    enlaces: [
      { texto: "Guía: Precio fijo o indexado →", href: "/guias/precio-fijo-o-indexado" },
      { texto: "Comparativa de modalidades →", href: "/tarifas#modalidad" },
    ],
  },
  {
    id: "condiciones",
    numero: 5,
    titulo: "¿Cuándo y en qué condiciones?",
    resumen: "Duración, fecha de entrada y condiciones. A veces, esperar.",
    detalleTracking: "metodo · decisión 5",
    filas: [
      {
        etiqueta: "Entrada",
        contenido: "Una buena tarifa que se activa en un mal momento puede acarrearte una penalización por rescisión anticipada en tu compañía actual. Por eso el calendario también se audita y se planifica.",
      },
      {
        etiqueta: "El dato",
        contenido: "La fecha exacta de vencimiento de tu contrato vigente, las cláusulas de permanencia que apliquen y los hitos futuros de tu negocio: aperturas, nuevos turnos o reformas de potencia.",
        esDato: true,
      },
      {
        etiqueta: "Límites",
        contenido: "Las condiciones se pactan contigo con total transparencia. Si una propuesta incluye compromiso de permanencia, te especificamos qué contraprestación económica recibes a cambio. Y cualquier modificación debe notificarse por escrito con al menos 30 días de antelación.",
      },
      {
        etiqueta: "Fuentes",
        contenido: "Real Decreto 88/2026, artículo 6.1.m",
        esFuente: true,
      },
    ],
    enlaces: [
      { texto: "Cartas de revisión de precio de la comercializadora →", href: "/guias/revision-precio-luz-empresa" },
    ],
  },
];
---

<section class="decisiones-seccion" id="decisiones" aria-labelledby="h2-decisiones">
  <div class="contenedor decisiones-layout">
    <!-- Columna Izquierda: Kicker, Título, Explicación, Tarjeta Blanca y Botones -->
    <div class="decisiones-col-izq">
      <p class="decisiones-kicker">
        TU PLAN EN 5 PASOS <span class="kicker-sep" aria-hidden="true">|</span>
      </p>

      <h2 class="decisiones-titulo" id="h2-decisiones">
        LAS <span class="titulo-cursiva">cinco</span><br />DECISIONES
      </h2>

      <p class="decisiones-intro">
        Es la etapa de Estrategia. Cada una se responde con un dato de tu empresa y puede acabar en un cambio o en dejarlo como está. Ábrelas para ver el detalle.
      </p>

      <!-- Tarjeta Blanca Flotante con Icono de Documento -->
      <div class="decisiones-callout-card">
        <div class="callout-icono" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <p class="callout-texto">
          Estas cinco decisiones quedan por escrito en tu informe, para que las revises con quien quieras: tu gestoría, tu socio o tu responsable de mantenimiento.
        </p>
      </div>

      <!-- Botones de Acción -->
      <div class="decisiones-acciones">
        <button
          type="button"
          class="btn-decision-primario"
          data-abrir-funnel
          data-tramo-id="300-1000"
          data-tramo-label="Estudio completo"
          data-tramo-rango="las 5 decisiones de tu empresa"
          data-tramo-msg="Preparamos tu informe con las 5 decisiones calculadas fila a fila."
        >
          <span>Analizar mi consumo</span>
          <span class="btn-circulo-icono" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3.5 10.5 8 6 12.5"></path>
            </svg>
          </span>
        </button>

        <a href="/diagnostico#factura-obrador" class="btn-decision-secundario">
          <span>Ver la factura de un ejemplo, leída</span>
          <span class="btn-circulo-icono" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3.5 10.5 8 6 12.5"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>

    <!-- Columna Derecha: Lista vertical de las 5 decisiones con números en cian -->
    <div class="decisiones-col-der" id="acordeon-decisiones">
      {
        decisiones.map((item) => (
          <div class="decision-fila-item">
            <div class="decision-num-circulo" aria-hidden="true">
              {item.numero}
            </div>

            <details class="det-tarjeta" id={item.id} data-detalle={item.detalleTracking}>
              <summary class="det-summary">
                <div class="det-titulares">
                  <h3 class="det-titulo">{item.titulo}</h3>
                  <p class="det-resumen">{item.resumen}</p>
                </div>
                <span class="det-toggle-btn" aria-hidden="true">
                  <svg class="icono-flecha" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m4 6 4 4 4-4"></path>
                  </svg>
                </span>
              </summary>

              <div class="det-panel-wrapper">
                <div class="det-panel-cuerpo">
                  <dl class="det-filas-dl">
                    {
                      item.filas.map((fila) => (
                        <div class:list={["det-fila", { "det-fila-dato": fila.esDato, "det-fila-fuente": fila.esFuente }]}>
                          <dt class="det-dt">{fila.etiqueta}</dt>
                          <dd class="det-dd" set:html={fila.contenido} />
                        </div>
                      ))
                    }

                    {
                      item.enlaces.length > 0 && (
                        <div class="det-fila det-fila-enlaces">
                          <dt class="det-dt">Para saber más</dt>
                          <dd class="det-dd det-tags-enlaces">
                            {
                              item.enlaces.map((enlace) => (
                                <a href={enlace.href} class="enlace-pildora">
                                  {enlace.texto}
                                </a>
                              ))
                            }
                          </dd>
                        </div>
                      )
                    }
                  </dl>
                </div>
              </div>
            </details>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Control interactivo con transiciones suaves para acordeón exclusivo (solo uno abierto a la vez)
  function initAcordeonDecisiones() {
    const acordeon = document.getElementById("acordeon-decisiones");
    if (!acordeon) return;

    const detailsList = acordeon.querySelectorAll<HTMLDetailsElement>("details.det-tarjeta");

    detailsList.forEach((detail) => {
      const summary = detail.querySelector("summary");
      if (!summary) return;

      // Cerrar suavemente con animación de colapso
      const cerrarAcordeon = (d: HTMLDetailsElement) => {
        if (!d.classList.contains("det-abierto")) return;
        d.classList.remove("det-abierto");
        setTimeout(() => {
          if (!d.classList.contains("det-abierto")) {
            d.open = false;
          }
        }, 360);
      };

      // Abrir suavemente con animación de despliegue
      const abrirAcordeon = (d: HTMLDetailsElement) => {
        d.open = true;
        // Doble frame para asegurar que el navegador registre el estado inicial 0fr
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            d.classList.add("det-abierto");
          });
        });
      };

      summary.addEventListener("click", (e) => {
        e.preventDefault();
        const isOpen = detail.classList.contains("det-abierto");

        if (isOpen) {
          cerrarAcordeon(detail);
        } else {
          // Cerrar suavemente cualquier otro acordeón que esté abierto
          detailsList.forEach((otro) => {
            if (otro !== detail && otro.classList.contains("det-abierto")) {
              cerrarAcordeon(otro);
            }
          });
          abrirAcordeon(detail);
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAcordeonDecisiones);
  } else {
    initAcordeonDecisiones();
  }
  document.addEventListener("astro:page-load", initAcordeonDecisiones);
</script>

<style>
  /* ==========================================================================
     SECCIÓN CINCO DECISIONES - DISEÑO OSCURO OFICIAL CON GRID DE 2 COLUMNAS
     ========================================================================== */
  .decisiones-seccion {
    background-color: #08172e;
    background-image: radial-gradient(circle at 10% 20%, rgba(26, 111, 247, 0.12) 0%, transparent 45%),
                      radial-gradient(circle at 90% 80%, rgba(56, 182, 255, 0.08) 0%, transparent 40%);
    padding: 80px 0 96px;
    color: #ffffff;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
  }

  .decisiones-layout {
    display: grid;
    grid-template-columns: 1fr 1.38fr;
    gap: 56px;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .decisiones-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  /* ==========================================================================
     COLUMNA IZQUIERDA: KICKER, TÍTULO, INTRO, TARJETA BLANCA Y BOTONES
     ========================================================================== */
  .decisiones-col-izq {
    position: sticky;
    top: 96px;
  }

  @media (max-width: 1024px) {
    .decisiones-col-izq {
      position: static;
    }
  }

  .decisiones-kicker {
    font-family: "Sora", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    color: #8da4be;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .kicker-sep {
    color: #38b6ff;
    font-weight: 800;
  }

  .decisiones-titulo {
    font-family: "Sora", sans-serif;
    font-size: clamp(2.3rem, 1.8rem + 2vw, 3.4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.08;
    margin: 0 0 20px;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .titulo-cursiva {
    font-family: "Merriweather", Georgia, serif;
    font-style: italic;
    font-weight: 400;
    text-transform: lowercase;
    color: #28a9f5;
    letter-spacing: -0.01em;
    display: inline-block;
  }

  .decisiones-intro {
    font-family: "Inter", sans-serif;
    font-size: 1.02rem;
    color: #a5b8d0;
    line-height: 1.6;
    margin: 0 0 26px;
    max-width: 32rem;
  }

  /* Tarjeta blanca flotante */
  .decisiones-callout-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 18px 22px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 28px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
    max-width: 33rem;
  }

  .callout-icono {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #e8f3fe;
    color: #1a6ff7;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .callout-texto {
    font-family: "Inter", sans-serif;
    font-size: 0.88rem;
    line-height: 1.48;
    color: #0f2346;
    font-weight: 500;
    margin: 0;
  }

  /* Botones de acción inferiores */
  .decisiones-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .btn-decision-primario {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px 8px 22px;
    background: #0070e0;
    color: #ffffff;
    font-family: "Sora", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(0, 112, 224, 0.35);
    transition: all 0.25s ease;
  }

  .btn-decision-primario:hover {
    background: #0080ff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 112, 224, 0.5);
  }

  .btn-decision-secundario {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px 8px 22px;
    background: rgba(0, 112, 224, 0.22);
    color: #ffffff;
    border: 1px solid rgba(56, 182, 255, 0.35);
    font-family: "Sora", sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-decision-secundario:hover {
    background: rgba(0, 112, 224, 0.35);
    border-color: rgba(56, 182, 255, 0.6);
    transform: translateY(-2px);
  }

  .btn-circulo-icono {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #0056b3;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .btn-decision-secundario .btn-circulo-icono {
    background: #0070e0;
  }

  .btn-decision-primario:hover .btn-circulo-icono,
  .btn-decision-secundario:hover .btn-circulo-icono {
    transform: translateX(2px);
  }

  /* ==========================================================================
     COLUMNA DERECHA: FILAS CON CÍRCULOS NUMÉRICOS Y ACORDEONES OSCUROS
     ========================================================================== */
  .decisiones-col-der {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .decision-fila-item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  /* Círculo numérico cian con texto oscuro */
  .decision-num-circulo {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #00c2ff;
    color: #08172e;
    font-family: "Sora", sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 6px;
    box-shadow: 0 4px 16px rgba(0, 194, 255, 0.4);
  }

  @media (max-width: 640px) {
    .decision-fila-item {
      gap: 12px;
    }
    .decision-num-circulo {
      width: 40px;
      height: 40px;
      font-size: 1.15rem;
    }
  }

  /* Tarjeta de acordeón */
  .det-tarjeta {
    flex: 1;
    min-width: 0;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 20px;
    overflow: hidden;
    transition: background 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(10px);
  }

  .det-tarjeta:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(56, 182, 255, 0.4);
  }

  .det-tarjeta.det-abierto {
    background: rgba(14, 38, 70, 0.85);
    border-color: rgba(56, 182, 255, 0.55);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  /* Summary */
  .det-summary {
