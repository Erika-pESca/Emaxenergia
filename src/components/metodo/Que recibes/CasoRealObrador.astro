      content: "";
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: #cadbed;
      transition: width 0.2s, background-color 0.2s;
    }

    .dot-btn[aria-current="true"]::before {
      width: 26px;
      background: #004aad;
    }
  }
</style>

<script>
  // Control interactivo de Scrollytelling fiel a Así leemos una factura
  (function initScrollytellingObrador() {
    const pasos = Array.from(document.querySelectorAll<HTMLElement>("#pasos-carril-obrador .paso-tarjeta"));
    const zonas = Array.from(document.querySelectorAll<HTMLElement>("#factura-sheet-obrador .factura-zona"));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".dot-btn"));
    const sheet = document.getElementById("factura-sheet-obrador");
    const carril = document.getElementById("pasos-carril-obrador");
    const mqMobile = window.matchMedia("(max-width: 899px)");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    sheet?.classList.add("focus");

    let pasoActual = -1;

    function activarPaso(index: number) {
      if (index === pasoActual || index < 0 || index >= pasos.length) return;
      pasoActual = index;

      pasos.forEach((p, idx) => {
        p.classList.toggle("on", idx === index);
      });

      zonas.forEach((z, idx) => {
        z.classList.toggle("on", idx === index);
      });

      dots.forEach((d, idx) => {
        d.setAttribute("aria-current", idx === index ? "true" : "false");
      });
    }

    // Clic directo en las zonas de la factura para saltar a ese paso
    zonas.forEach((zona, idx) => {
      zona.style.cursor = "pointer";
      zona.addEventListener("click", () => {
        const behavior = prefersReducedMotion ? "auto" : "smooth";
        if (mqMobile.matches && carril) {
          carril.scrollTo({ left: pasos[idx].offsetLeft, behavior });
        } else {
          pasos[idx].scrollIntoView({ behavior, block: "center" });
        }
        activarPaso(idx);
      });
    });

    // Clic en las tarjetas
    pasos.forEach((paso, idx) => {
      paso.addEventListener("click", () => {
        activarPaso(idx);
      });
    });

    // Detección precisa de scroll en desktop
    function calcularPasoActivoPorScroll() {
      if (mqMobile.matches) return;
      const viewportCenter = window.innerHeight * 0.45;
      let pasoMasCercano = 0;
      let menorDistancia = Infinity;

      pasos.forEach((p, idx) => {
        const rect = p.getBoundingClientRect();
        const pasoCentro = rect.top + rect.height * 0.4;
        const distancia = Math.abs(pasoCentro - viewportCenter);

        if (distancia < menorDistancia) {
          menorDistancia = distancia;
          pasoMasCercano = idx;
        }
      });

      activarPaso(pasoMasCercano);
    }

    // Escuchador de scroll de ventana
    window.addEventListener("scroll", calcularPasoActivoPorScroll, { passive: true });
    calcularPasoActivoPorScroll();

    // Scroll táctil en móvil
    carril?.addEventListener(
      "scroll",
      () => {
        if (!mqMobile.matches) return;
        const scrollLeft = carril.scrollLeft;
        let mejorPaso = 0;
        let menorDistancia = Infinity;

        if (scrollLeft + carril.clientWidth >= carril.scrollWidth - 6) {
          mejorPaso = pasos.length - 1;
        } else {
          pasos.forEach((p, idx) => {
            const dist = Math.abs(p.offsetLeft - scrollLeft);
            if (dist < menorDistancia) {
              menorDistancia = dist;
              mejorPaso = idx;
            }
          });
        }
        activarPaso(mejorPaso);
      },
      { passive: true }
    );

    // Clic en los dots de móvil
    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        const behavior = prefersReducedMotion ? "auto" : "smooth";
        if (mqMobile.matches && carril) {
          carril.scrollTo({ left: pasos[idx].offsetLeft, behavior });
        } else {
          pasos[idx].scrollIntoView({ behavior, block: "center" });
        }
      });
    });
  })();
</script>
