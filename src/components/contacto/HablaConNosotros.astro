---
// Componente: Sección "HABLA CON nosotros." y formulario "¿Es otra cosa? Escríbenos" (/contacto)
// Basado fielmente en el boceto oficial de Contacto
---

<section class="habla-root" aria-labelledby="tit-habla-nosotros">
  <div class="habla-contenedor">
    <div class="habla-grid">
      <!-- Columna Izquierda: Información de contacto directo -->
      <div class="habla-info-col">
        <h2 class="habla-titulo" id="tit-habla-nosotros">
          HABLA CON<br />
          <span class="habla-cursiva">nosotros.</span>
        </h2>

        <p class="habla-subtitulo">
          Estamos aquí para ayudarte.<br />
          Elige la forma de contacto que prefieras.
        </p>

        <ul class="habla-datos-lista">
          <li class="habla-dato-item">
            <span class="habla-icono-box" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </span>
            <div class="habla-dato-texto">
              <strong class="habla-dato-label">TELÉFONO</strong>
              <a href="tel:+34933949343" class="habla-dato-valor">933 949 343</a>
            </div>
          </li>

          <li class="habla-dato-item">
            <span class="habla-icono-box" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </span>
            <div class="habla-dato-texto">
              <strong class="habla-dato-label">EMAIL</strong>
              <a href="mailto:hola@emaxenergia.com" class="habla-dato-valor">hola@emaxenergia.com</a>
            </div>
          </li>

          <li class="habla-dato-item">
            <span class="habla-icono-box" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </span>
            <div class="habla-dato-texto">
              <strong class="habla-dato-label">HORARIO</strong>
              <span class="habla-dato-valor habla-dato-valor--horario">
                De lunes a viernes, de 9:00 a 13:00 y de 15:00 a 19:00
              </span>
            </div>
          </li>
        </ul>
      </div>

      <!-- Columna Derecha: Tarjeta azul oscuro "¿Es otra cosa? Escríbenos" -->
      <div class="habla-form-col">
        <div class="escribenos-card">
          <h3 class="escribenos-titulo">
            ¿Es otra cosa?<br />
            <span class="escribenos-serif">Escríbenos</span>
          </h3>

          <form class="escribenos-form" data-form-contacto novalidate>
            <div class="campo-grupo">
              <label for="contacto-nombre" class="campo-label">Tu nombre</label>
              <input
                type="text"
                id="contacto-nombre"
                name="nombre"
                class="campo-input"
                autocomplete="name"
                required
              />
            </div>

            <div class="campo-grupo">
              <label for="contacto-email" class="campo-label">Tu email</label>
              <input
                type="email"
                id="contacto-email"
                name="email"
                class="campo-input"
                autocomplete="email"
                required
              />
            </div>

            <div class="campo-grupo">
              <label for="contacto-asunto" class="campo-label">¿Sobre qué es?</label>
              <input
                type="text"
                id="contacto-asunto"
                name="asunto"
                class="campo-input"
              />
            </div>

            <div class="campo-grupo">
              <label for="contacto-mensaje" class="campo-label">Cuéntanos</label>
              <textarea
                id="contacto-mensaje"
                name="mensaje"
                class="campo-textarea"
                rows="4"
                required
              ></textarea>
            </div>

            <div class="campo-grupo">
              <label for="contacto-telefono" class="campo-label">
                Tu teléfono, si prefieres que te llamemos
                <small class="campo-opcional">(opcional)</small>
              </label>
              <input
                type="tel"
                id="contacto-telefono"
                name="telefono"
                class="campo-input"
                autocomplete="tel"
              />
            </div>

            <p class="escribenos-privacidad">
              Usaremos tus datos solo para responderte. <a href="/privacidad">Política de privacidad</a>
            </p>

            <div class="escribenos-acciones">
              <button type="submit" class="btn-enviar-contacto">
                <span>Enviar</span>
                <span class="btn-enviar-icono" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3.5 10.5 8 6 12.5"></path>
                  </svg>
                </span>
              </button>
            </div>

            <p class="escribenos-feedback" data-contacto-feedback hidden></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const formContacto = document.querySelector<HTMLFormElement>("[data-form-contacto]");
  const feedbackEl = formContacto?.querySelector<HTMLParagraphElement>("[data-contacto-feedback]");

  formContacto?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!feedbackEl) return;

    const nombre = (formContacto.querySelector<HTMLInputElement>("#contacto-nombre")?.value || "").trim();
    const email = (formContacto.querySelector<HTMLInputElement>("#contacto-email")?.value || "").trim();
    const mensaje = (formContacto.querySelector<HTMLTextAreaElement>("#contacto-mensaje")?.value || "").trim();

    if (!nombre || !email || !mensaje) {
      feedbackEl.hidden = false;
      feedbackEl.textContent = "Por favor, completa tu nombre, tu email y tu mensaje.";
      feedbackEl.dataset.estado = "error";
      return;
    }

    feedbackEl.hidden = false;
    feedbackEl.textContent = "Gracias por escribirnos. Hemos recibido tu mensaje y te responderemos muy pronto.";
    feedbackEl.dataset.estado = "ok";
    formContacto.reset();
  });
</script>

<style>
  .habla-root {
    width: 100%;
    background: #f9fafc;
    padding: 76px 0 96px;
  }

  .habla-contenedor {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .habla-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 56px;
    align-items: center;
  }

  /* Columna Izquierda */
  .habla-info-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .habla-titulo {
    font-family: "Poppins", sans-serif;
    font-size: clamp(2.1rem, 3.6vw, 2.85rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0.01em;
    color: #091d42;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  .habla-cursiva {
    display: inline-block;
    font-family: "Instrument Serif", Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.5rem, 4.2vw, 3.35rem);
    line-height: 1;
    color: #1cb5f5;
    text-transform: lowercase;
    letter-spacing: 0;
  }

  .habla-subtitulo {
    font-family: "Poppins", sans-serif;
    font-size: 0.92rem;
    line-height: 1.55;
    color: #1e293b;
    margin: 0 0 36px;
  }

  .habla-datos-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .habla-dato-item {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .habla-icono-box {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    background: #bfd6f8;
    color: #004aad;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .habla-dato-texto {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .habla-dato-label {
    font-family: "Poppins", sans-serif;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #091d42;
    text-transform: uppercase;
  }

  .habla-dato-valor {
    font-family: "Poppins", sans-serif;
    font-size: 0.98rem;
    font-weight: 400;
    color: #1e293b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  a.habla-dato-valor:hover {
    color: #004aad;
  }

  .habla-dato-valor--horario {
    font-size: 0.82rem;
    color: #334155;
  }

  /* Columna Derecha: Formulario "¿Es otra cosa? Escríbenos" */
  .escribenos-card {
    background: #061b42;
    border-radius: 32px;
    padding: 42px 40px 38px;
    color: #ffffff;
    box-shadow: 0 20px 48px rgba(6, 27, 66, 0.18);
  }

  .escribenos-titulo {
    font-family: "Poppins", sans-serif;
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.18;
    color: #ffffff;
    margin: 0 0 22px;
  }

  .escribenos-serif {
    display: block;
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: 2.15rem;
    line-height: 1.1;
    color: #1cb5f5;
    margin-top: 2px;
  }

  .escribenos-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .campo-grupo {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .campo-label {
    font-family: "Poppins", sans-serif;
    font-size: 0.86rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.3;
  }

  .campo-opcional {
    display: block;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.68);
    margin-top: 1px;
  }

  .campo-input,
  .campo-textarea {
    width: 100%;
    background: #2c4068;
    border: 1.5px solid #1d63b8;
    border-radius: 12px;
    color: #ffffff;
    font-family: "Poppins", sans-serif;
    font-size: 0.95rem;
    padding: 0 16px;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
  }

  .campo-input {
    height: 48px;
  }

  .campo-textarea {
    min-height: 118px;
    padding: 12px 16px;
    resize: vertical;
  }

  .campo-input:focus,
  .campo-textarea:focus {
    border-color: #25b5f8;
    background: #324975;
    box-shadow: 0 0 0 3px rgba(37, 181, 248, 0.18);
  }

  .escribenos-privacidad {
    font-family: "Poppins", sans-serif;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.78);
    margin: 2px 0 4px;
    line-height: 1.45;
  }

  .escribenos-privacidad a {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .escribenos-privacidad a:hover {
    color: #25b5f8;
  }

  .escribenos-acciones {
    display: flex;
    align-items: center;
  }

  .btn-enviar-contacto {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #1cb5f5;
    color: #061b42;
    border: 0;
    border-radius: 999px;
    padding: 7px 9px 7px 18px;
    font-family: "Poppins", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.18s ease, transform 0.15s ease;
  }

  .btn-enviar-contacto:hover {
    background: #38bdf8;
    transform: translateY(-1px);
  }

  .btn-enviar-icono {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid #061b42;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #061b42;
  }

  .escribenos-feedback {
    margin: 4px 0 0;
    font-family: "Poppins", sans-serif;
    font-size: 0.84rem;
    line-height: 1.45;
    padding: 10px 14px;
    border-radius: 10px;
  }

  .escribenos-feedback[data-estado="ok"] {
    background: rgba(34, 197, 94, 0.16);
    border: 1px solid rgba(74, 222, 128, 0.45);
    color: #bbf7d0;
  }

  .escribenos-feedback[data-estado="error"] {
    background: rgba(239, 68, 68, 0.16);
    border: 1px solid rgba(248, 113, 113, 0.45);
    color: #fecaca;
  }

  @media (max-width: 860px) {
    .habla-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .escribenos-card {
      padding: 32px 24px;
      border-radius: 24px;
    }
  }

  @media (max-width: 560px) {
    .habla-root {
      padding: 52px 0 68px;
    }

    .escribenos-card {
      padding: 24px 18px;
      border-radius: 20px;
    }

    .escribenos-titulo {
      font-size: 1.4rem;
    }

    .escribenos-serif {
      font-size: 1.85rem;
    }

    .habla-icono-box {
      width: 40px;
      height: 40px;
    }
  }
</style>

