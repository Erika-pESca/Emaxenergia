---
// Componente: Hero de la página de Contacto (/contacto)
// Basado fielmente en el boceto oficial de Contacto
import imgRevisionFacturas from "../../imagenes/contacto/Revisión de facturas en la oficina.png";
import imgAgenteCliente from "../../imagenes/contacto/Agente sonriente en oficina moderna.png";
---

<section class="contacto-hero-root" aria-labelledby="h1-contacto">
  <div class="contacto-hero-contenedor">
    <header class="contacto-hero-header">
      <h1 class="contacto-h1" id="h1-contacto">CONTACTO</h1>
      <p class="contacto-subtitulo">
        Para que te respondamos mejor, dinos qué buscas.
      </p>
    </header>

    <div class="contacto-cards-grid">
      <!-- Tarjeta 1: Revisar factura -->
      <a
        href="#estudio"
        class="contacto-opcion-card"
        data-abrir-funnel
        data-tramo-msg="Consulta desde página de Contacto: Quiero que reviséis la factura de mi empresa"
      >
        <div class="card-media-top">
          <img
            src={imgRevisionFacturas.src}
            alt="Revisión de facturas de empresa en la oficina"
            class="card-foto"
            loading="eager"
            decoding="async"
          />
          <div class="card-foto-overlay"></div>
          <h2 class="card-top-titulo card-top-titulo--centrado">
            Quiero que reviséis la<br />factura de mi empresa
          </h2>
        </div>
        <div class="card-bottom-bar">
          <p class="card-bottom-txt">
            Es el camino más rápido: empiezas con lo que pagas al mes.
          </p>
        </div>
      </a>

      <!-- Tarjeta 2: Ya soy cliente -->
      <a href="/atencion-al-cliente" class="contacto-opcion-card">
        <div class="card-media-top">
          <img
            src={imgAgenteCliente.src}
            alt="Atención al cliente EMAX Energía"
            class="card-foto"
            loading="eager"
            decoding="async"
          />
          <div class="card-foto-overlay"></div>
          <h2 class="card-top-titulo card-top-titulo--centrado">
            Ya soy cliente
          </h2>
        </div>
        <div class="card-bottom-bar card-bottom-bar--centrado">
          <p class="card-bottom-txt">
            Dudas, averías, reclamaciones
          </p>
        </div>
      </a>

      <!-- Tarjeta 3: Soy un profesional y quiero colaborar -->
      <a href="/canal-directo" class="contacto-opcion-card contacto-opcion-card--profesional">
        <div class="card-media-top card-media-top--claro">
          <h2 class="card-top-titulo card-top-titulo--izq">
            Soy un profesional y quiero<br />colaborar
          </h2>
        </div>
        <div class="card-bottom-bar card-bottom-bar--oscuro">
          <p class="card-bottom-txt">
            Gestorías, asesorías, administradores de fincas, instaladores.
          </p>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .contacto-hero-root {
    position: relative;
    z-index: 20;
    margin-top: -78px;
    width: 100%;
    background: linear-gradient(
      90deg,
      #06183b 0%,
      #05255d 26%,
      #004aad 47%,
      #0051be 50%,
      #004aad 53%,
      #05255d 74%,
      #06183b 100%
    );
    border-radius: 0 0 28px 28px;
    padding: calc(78px + 96px) 0 84px;
    overflow: hidden;
    color: #ffffff;
  }

  .contacto-hero-contenedor {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contacto-hero-header {
    text-align: center;
    margin-bottom: 48px;
    max-width: 760px;
  }

  .contacto-h1 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1.08;
    color: #25b5f8;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  .contacto-subtitulo {
    font-family: "Poppins", sans-serif;
    font-size: clamp(1rem, 1.35vw, 1.22rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.45;
    color: #ffffff;
    margin: 0;
  }

  /* Grid de 3 tarjetas */
  .contacto-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    width: 100%;
    max-width: 1020px;
  }

  .contacto-opcion-card {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.25);
    text-decoration: none;
    background: rgba(10, 35, 82, 0.45);
    box-shadow: 0 14px 32px rgba(4, 15, 38, 0.28);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .contacto-opcion-card:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.65);
    box-shadow: 0 18px 40px rgba(4, 15, 38, 0.4);
  }

  .card-media-top {
    position: relative;
    height: 175px;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    padding: 20px 20px;
    box-sizing: border-box;
  }

  .card-media-top--claro {
    background: #dcdfe4;
    padding: 22px 22px;
  }

  .card-foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    z-index: 1;
    transition: transform 0.35s ease;
  }

  .contacto-opcion-card:hover .card-foto {
    transform: scale(1.04);
  }

  .card-foto-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(6, 24, 59, 0.62) 0%,
      rgba(6, 24, 59, 0.18) 55%,
      rgba(6, 24, 59, 0.35) 100%
    );
    z-index: 2;
  }

  .card-top-titulo {
    position: relative;
    z-index: 3;
    font-family: "Poppins", sans-serif;
    font-size: 0.96rem;
    font-weight: 700;
    line-height: 1.28;
    color: #25b5f8;
    margin: 0;
    width: 100%;
  }

  .card-top-titulo--centrado {
    text-align: center;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }

  .card-top-titulo--izq {
    text-align: left;
    color: #1cb5f5;
  }

  .card-bottom-bar {
    padding: 14px 18px;
    min-height: 58px;
    display: flex;
    align-items: center;
    background: rgba(52, 108, 196, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    flex-grow: 1;
  }

  .card-bottom-bar--centrado {
    justify-content: center;
    text-align: center;
  }

  .card-bottom-bar--oscuro {
    background: rgba(56, 84, 128, 0.65);
  }

  .card-bottom-txt {
    font-family: "Poppins", sans-serif;
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
  }

  @media (max-width: 960px) {
    .contacto-cards-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 680px;
      gap: 20px;
    }

    .contacto-opcion-card--profesional {
      grid-column: 1 / -1;
    }

    .contacto-hero-root {
      padding: calc(78px + 68px) 0 64px;
    }
  }

  @media (max-width: 640px) {
    .contacto-cards-grid {
      grid-template-columns: 1fr;
      max-width: 440px;
      gap: 18px;
    }

    .contacto-opcion-card--profesional {
      grid-column: auto;
    }

    .contacto-hero-root {
      padding: calc(78px + 52px) 0 52px;
    }
  }
</style>

