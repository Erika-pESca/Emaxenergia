---
// Componente Unificado: Pantalla de confirmación oficial de envío
// Utilizado tanto para Contacto (/contacto/recibido) como para Canal Directo (/canal-directo/enviado)
// Diseño fiel al boceto oficial con fondo azul degradado, círculo con checkmark y tipografías cuidadas
import { site } from "../../data/site";

interface Props {
  tipo?: "contacto" | "canal";
}

const { tipo = "contacto" } = Astro.props;
const esCanal = tipo === "canal";
---

<section class="contacto-recibido-hero" aria-labelledby="tit-recibido">
  <div class="recibido-contenedor">
    <!-- Círculo central con checkmark del boceto oficial -->
    <div class="recibido-circulo-wrap" aria-hidden="true">
      <div class="recibido-circulo">
        <svg
          class="recibido-check-icon"
          width="46"
          height="46"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#004aad"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
    </div>

    <!-- Título y subtítulos -->
    <h1 class="recibido-titulo" id="tit-recibido">
      Recibido<span data-nombre></span>.
    </h1>

    {esCanal ? (
      <p class="recibido-subtitulo">
        Te contactamos en <b data-email>tu email</b><span data-telefono></span> para conocer tu despacho y contarte cómo trabajamos.
      </p>
    ) : (
      <p class="recibido-subtitulo">
        Te respondemos a <span data-email>tu email</span>.
      </p>
    )}

    <p class="recibido-urgente">
      Si es urgente, llámanos al <a href={site.phoneHref} class="recibido-tel-link">{site.phone}</a>.
    </p>

    <!-- Fila de acciones -->
    <div class="recibido-acciones">
      {esCanal ? (
        <a href="/metodo/" class="recibido-link-factura">
          Mientras tanto, cómo trabajamos →
        </a>
      ) : (
        <a
          href="/contacto/"
          class="recibido-link-factura"
          data-abrir-funnel
          data-tramo-msg="Consulta desde página de Contacto Recibido: Quiero que reviséis la factura de mi empresa"
        >
          ¿Quieres que revisemos tu factura?
        </a>
      )}

      <a href="/" class="btn-volver-inicio">
        <span>Volver al inicio</span>
        <span class="btn-arrow-circulo" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    try {
      var raw = sessionStorage.getItem("emax:formulario");
      if (raw) {
        var data = JSON.parse(raw);
        if (data.nombre) {
          var elNom = document.querySelector("[data-nombre]");
          if (elNom) elNom.textContent = ", " + data.nombre;
        }
        if (data.email) {
          var elEm = document.querySelector("[data-email]");
          if (elEm) elEm.textContent = data.email;
        }
        if (data.telefono) {
          var elTel = document.querySelector("[data-telefono]");
          if (elTel) elTel.textContent = " o en el " + data.telefono;
        }
      }
    } catch (e) {}
  })();
</script>

<style>
  .contacto-recibido-hero {
    position: relative;
    z-index: 20;
    margin-top: -78px;
    width: 100%;
    min-height: calc(85vh + 78px);
    background: linear-gradient(
      90deg,
      #06183b 0%,
      #05255d 26%,
      #004aad 47%,
      #0051be 50%,
      #004aad 53%,
      #05255d 74%,
      #06183b 100%
    );
    border-radius: 0 0 28px 28px;
    padding: calc(78px + 72px) 24px 84px;
    overflow: hidden;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .recibido-contenedor {
    max-width: 820px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Círculo central exacto al boceto */
  .recibido-circulo-wrap {
    margin-bottom: 24px;
  }

  .recibido-circulo {
    width: clamp(120px, 16vw, 150px);
    height: clamp(120px, 16vw, 150px);
    border-radius: 50%;
    background: #dbe2ea;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 16px 36px rgba(4, 15, 38, 0.35);
    border: 3px solid rgba(255, 255, 255, 0.35);
    transition: transform 0.3s ease;
  }

  .recibido-circulo:hover {
    transform: scale(1.04);
  }

  .recibido-check-icon {
    width: clamp(38px, 5vw, 48px);
    height: clamp(38px, 5vw, 48px);
    color: #004aad;
  }

  /* Tipografía */
  .recibido-titulo {
    font-family: var(--font-acento, var(--font-literata), Georgia, serif);
    font-style: italic;
    font-size: clamp(2.4rem, 4.8vw, 3.8rem);
    font-weight: 400;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }

  .recibido-subtitulo {
    font-family: var(--font-titulos, var(--font-poppins), sans-serif);
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    font-weight: 500;
    color: #ffffff;
    line-height: 1.45;
    margin: 0 0 16px;
    letter-spacing: 0.01em;
    max-width: 720px;
  }

  .recibido-subtitulo b {
    color: #38b6ff;
    font-weight: 600;
  }

  .recibido-urgente {
    font-family: var(--font-cuerpo, var(--font-poppins), sans-serif);
    font-size: clamp(0.92rem, 1.2vw, 1rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.45;
    margin: 0 0 38px;
  }

  .recibido-tel-link {
    color: #ffffff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .recibido-tel-link:hover {
    color: #38b6ff;
  }

  /* Fila de acciones */
  .recibido-acciones {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 32px);
    flex-wrap: wrap;
    width: 100%;
  }

  .recibido-link-factura {
    font-family: var(--font-cuerpo, var(--font-poppins), sans-serif);
    font-size: clamp(0.88rem, 1.1vw, 0.96rem);
    font-weight: 500;
    color: #25b5f8;
    text-decoration: none;
    transition: color 0.2s ease, text-decoration 0.2s ease;
    cursor: pointer;
    padding: 6px 4px;
  }

  .recibido-link-factura:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .btn-volver-inicio {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25b5f8;
    color: #071f49;
    font-family: var(--font-display, var(--font-sora), sans-serif);
    font-size: clamp(0.88rem, 1.1vw, 0.95rem);
    font-weight: 700;
    text-decoration: none;
    padding: 10px 18px 10px 22px;
    border-radius: 9999px;
    box-shadow: 0 6px 20px rgba(37, 181, 248, 0.35);
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-volver-inicio:hover {
    background: #46c3fc;
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(37, 181, 248, 0.5);
  }

  .btn-arrow-circulo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #071f49;
    color: #ffffff;
    transition: transform 0.2s ease;
  }

  .btn-volver-inicio:hover .btn-arrow-circulo {
    transform: translateX(2px);
  }

  @media (max-width: 680px) {
    .contacto-recibido-hero {
      padding: calc(78px + 44px) 20px 60px;
      min-height: auto;
    }

    .recibido-acciones {
      flex-direction: column;
      gap: 18px;
    }

    .btn-volver-inicio {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }
  }
</style>
