---
// Pie de página institucional de EMAX Energía
// Columnas, datos de contacto y enlaces legales obtenidos de src/data/site.ts.
import Logo from "./Logo.astro";
import { footerNav, legalNav, site } from "../data/site";
---

<footer class="pie-pagina" id="pie-pagina">
  <!-- Banda superior azul con tagline -->
  <div class="pie-banda-top">
    <div class="contenedor pie-banda-top-inner">
      <p class="pie-tagline-top">{site.subTagline}</p>
      <a href="tel:+34933949343" class="pie-tel-top">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        {site.phone}
      </a>
    </div>
  </div>

  <!-- Cuerpo principal del footer -->
  <div class="contenedor pie-principal">
    <!-- Columna de marca -->
    <div class="pie-marca">
      <Logo variant="light" />
      <p class="pie-descripcion">{site.tagline}</p>

      <div class="pie-contacto-directo">
        <a href={site.phoneHref} class="contacto-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>{site.phone}</span>
        </a>
        <a href={`mailto:${site.email}`} class="contacto-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span>{site.email}</span>
        </a>
        <span class="contacto-item no-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>{site.direccion}</span>
        </span>
      </div>
    </div>

    <!-- Columnas de navegación -->
    {
      footerNav.map((columna) => (
        <div class="pie-columna">
          <h2 class="columna-titulo">{columna.title}</h2>
          <ul class="columna-lista" role="list">
            {columna.links.map((link) => (
              <li>
                <a href={link.href} class="columna-enlace">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <!-- Barra legal inferior -->
  <div class="contenedor pie-legal">
    <div class="pie-legal-linea"></div>
    <div class="pie-legal-contenido">
      <small class="copia-legal">
        © {new Date().getFullYear()} {site.name} · {site.legalName} ({site.cif}). Todos los derechos reservados.
      </small>
      <nav class="nav-legal" aria-label="Enlaces legales">
        {legalNav.map((link) => <a href={link.href} class="enlace-legal">{link.label}</a>)}
      </nav>
    </div>
  </div>
</footer>

<style>
  /* Eliminamos cualquier margen externo que genere espacio blanco */
  .pie-pagina {
    background: #091730;
    color: #e2eaf5;
    margin-top: 0;
    padding-bottom: calc(var(--dock-alto, 64px) + 36px);
    display: flex;
    flex-direction: column;
  }

  /* Banda superior de acento azul */
  .pie-banda-top {
    background: linear-gradient(90deg, #003a88 0%, #004aad 50%, #0056cc 100%);
    padding: 18px 0;
  }

  .pie-banda-top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .pie-tagline-top {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-size: clamp(0.9rem, 1.2vw, 1.08rem);
    color: #daeeff;
    margin: 0;
    line-height: 1.4;
    max-width: 70ch;
  }

  .pie-tel-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .pie-tel-top:hover {
    color: #38b6ff;
  }

  /* Grid principal */
  .pie-principal {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 52px;
  }

  /* Columna de marca */
  .pie-marca {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pie-descripcion {
    font-size: 0.92rem;
    color: #8da2c0;
    max-width: 30ch;
    line-height: 1.6;
    margin: 0;
  }

  .pie-contacto-directo {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 6px;
  }

  .contacto-item {
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.88rem;
    font-weight: 500;
    color: #b0c4de;
    transition: color 0.15s ease;
    line-height: 1.45;
  }

  .contacto-item svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  a.contacto-item:hover {
    color: #ffffff;
  }

  .no-link {
    cursor: default;
    font-size: 0.82rem;
    color: #6b7fa3;
  }

  /* Columnas de navegación */
  .pie-columna {
    display: flex;
    flex-direction: column;
  }

  .columna-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #38b6ff;
    margin-bottom: 20px;
    line-height: 1;
  }

  .columna-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .columna-enlace {
    font-size: 0.88rem;
    color: #8da2c0;
    transition: color 0.15s ease, padding-left 0.15s ease;
    display: block;
  }

  .columna-enlace:hover {
    color: #ffffff;
    padding-left: 4px;
  }

  /* Barra legal */
  .pie-legal {
    padding-bottom: 0;
  }

  .pie-legal-linea {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin-bottom: 24px;
  }

  .pie-legal-contenido {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    font-size: 0.8rem;
    color: #4d6080;
    flex-wrap: wrap;
  }

  .copia-legal {
    color: inherit;
  }

  .nav-legal {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .enlace-legal {
    color: #6b7fa3;
    transition: color 0.15s ease;
  }

  .enlace-legal:hover {
    color: #b0c4de;
    text-decoration: underline;
  }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 1100px) {
    .pie-principal {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 36px;
    }

    .pie-marca {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 40px;
    }

    .pie-contacto-directo {
      margin-top: 0;
    }
  }

  @media (max-width: 700px) {
    .pie-banda-top-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .pie-principal {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      padding-top: 40px;
      padding-bottom: 40px;
    }

    .pie-marca {
      grid-column: 1 / -1;
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .pie-principal {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .pie-legal-contenido {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .nav-legal {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
