---
// Pie de página institucional de EMAX Energía
// Diseño y distribución fiel al boceto oficial de 6 columnas (Método, Tarifas, Sectores, Guías, EMAX, Legal)
import Logo from "./Logo.astro";
import { site } from "../data/site";

interface FooterLink {
  href: string;
  label: string;
  spacedTop?: boolean;
}

interface FooterCol {
  title: string;
  maxW?: string;
  links: FooterLink[];
}

const columnasFooter: FooterCol[] = [
  {
    title: "Método",
    maxW: "150px",
    links: [
      { href: "/metodo", label: "Cómo trabajamos" },
      { href: "/diagnostico", label: "El diagnóstico" },
    ],
  },
  {
    title: "Tarifas",
    maxW: "145px",
    links: [
      { href: "/tarifas", label: "Luz para empresas" },
      { href: "/tarifas/gas-natural", label: "Gas para empresas" },
      { href: "/tarifas/comunidades-de-propietarios", label: "Comunidades de propietarios" },
      { href: "/particulares", label: "Hogares", spacedTop: true },
    ],
  },
  {
    title: "Sectores",
    maxW: "155px",
    links: [
      { href: "/sectores/restaurantes", label: "Restaurantes y hostelería" },
      { href: "/sectores/hoteles", label: "Hoteles" },
      { href: "/sectores/supermercados", label: "Supermercados y alimentación" },
      { href: "/sectores/logistica-frio", label: "Logística y frío" },
      { href: "/sectores/industria", label: "Industria" },
      { href: "/sectores/varios-suministros", label: "Varios suministros" },
      { href: "/sectores", label: "Todos los sectores", spacedTop: true },
    ],
  },
  {
    title: "Guías",
    maxW: "180px",
    links: [
      { href: "/guias/bajar-factura-luz-empresa", label: "Cómo bajar la factura de luz" },
      { href: "/guias/factura-luz-empresa", label: "La factura de luz de tu empresa" },
      { href: "/guias/potencia-contratada", label: "Potencia contratada" },
      { href: "/guias/precio-fijo-o-indexado", label: "Precio fijo o indexado" },
      { href: "/guias/cups-y-tus-datos", label: "Qué se ve con tu CUPS" },
      { href: "/guias", label: "Todas las guías" },
    ],
  },
  {
    title: "EMAX",
    maxW: "160px",
    links: [
      { href: "/contacto", label: "Contacto" },
      { href: "/atencion-al-cliente", label: "Atención al cliente" },
      { href: "/canal-directo", label: "Canal directo" },
    ],
  },
  {
    title: "Legal",
    maxW: "160px",
    links: [
      { href: "/aviso-legal", label: "Aviso legal" },
      { href: "/privacidad", label: "Privacidad" },
      { href: "/cookies", label: "Cookies" },
      { href: "#configurar-cookies", label: "Configurar cookies", spacedTop: true },
    ],
  },
];
---

<footer class="pie-pagina" id="pie-pagina">
  <!-- Banda superior azul con teléfono, email y horario bien distribuidos -->
  <div class="pie-banda-top">
    <div class="pie-wrap pie-banda-top-inner">
      <div class="pie-banda-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <a href={site.phoneHref} class="pie-banda-enlace">{site.phone}</a>
      </div>

      <span class="pie-sep" aria-hidden="true">·</span>

      <div class="pie-banda-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <a href={`mailto:${site.email}`} class="pie-banda-enlace">{site.email}</a>
      </div>

      <span class="pie-sep" aria-hidden="true">·</span>

      <div class="pie-banda-item pie-banda-horario">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>De lunes a viernes, de 9:00 a 13:00 y de 15:00 a 19:00</span>
      </div>
    </div>
  </div>

  <!-- Cuerpo principal del footer (diseño oficial de 6 columnas) -->
  <div class="pie-wrap pie-interior">
    <!-- Cabecera con logo -->
    <div class="pie-cabecera-marca">
      <div class="pie-logo-escala">
        <Logo variant="light" />
      </div>
    </div>

    <div class="pie-divisor" aria-hidden="true"></div>

    <!-- Rejilla de 6 columnas bien distribuidas como en el boceto -->
    <div class="pie-columnas-grid">
      {
        columnasFooter.map((columna) => (
          <div class="pie-columna">
            <h2 class="columna-titulo">{columna.title}</h2>
            <ul
              class="columna-lista"
              role="list"
              style={columna.maxW ? `max-width: ${columna.maxW};` : undefined}
            >
              {columna.links.map((link) => (
                <li class={link.spacedTop ? "item-espaciado" : undefined}>
                  <a href={link.href} class="columna-enlace">{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="pie-divisor" aria-hidden="true"></div>

    <!-- Línea legal inferior -->
    <div class="pie-legal-contenido">
      <p class="copia-legal">
        © 2026 {site.legalName} · NIF {site.cif} · Carrer Esteve Gilabert Bruniquer, 52, 08402 Granollers (Barcelona) · EMAX Energía es una marca de Grupo EMAX. [LEGAL]
      </p>
    </div>
  </div>
</footer>

<style>
  .pie-pagina {
    background: #021842;
    color: #e2eaf5;
    margin-top: 0;
    padding-bottom: calc(var(--dock-alto, 64px) + 32px);
    display: flex;
    flex-direction: column;
  }

  /* Contenedor ancho alineado al boceto */
  .pie-wrap {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: clamp(28px, 5vw, 72px);
    box-sizing: border-box;
  }

  /* Banda superior de acento azul */
  .pie-banda-top {
    background: linear-gradient(90deg, #003a88 0%, #004aad 50%, #0056cc 100%);
    padding: 15px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .pie-banda-top-inner {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--font-cuerpo, "Inter", sans-serif);
    font-size: 0.92rem;
    color: #e8f3ff;
    letter-spacing: 0.02em;
  }

  .pie-banda-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .pie-banda-item svg {
    color: #38b6ff;
    flex-shrink: 0;
  }

  .pie-banda-enlace {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .pie-banda-enlace:hover {
    color: #38b6ff;
  }

  .pie-sep {
    color: rgba(255, 255, 255, 0.55);
    font-weight: 700;
  }

  /* Contenedor interior del pie */
  .pie-interior {
    padding-top: 48px;
    padding-bottom: 16px;
    display: flex;
    flex-direction: column;
  }

  /* Cabecera de marca con logo */
  .pie-cabecera-marca {
    display: flex;
    align-items: center;
    margin-bottom: 28px;
  }

  .pie-logo-escala :global(.logo img) {
    height: 54px;
    width: auto;
  }

  /* Líneas divisorias horizontales de lado a lado */
  .pie-divisor {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.28);
  }

  /* Rejilla de 6 columnas bien espaciadas como en el boceto */
  .pie-columnas-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr 1.15fr 1.25fr 1fr 0.85fr;
    gap: 32px clamp(24px, 3.5vw, 52px);
    padding: 40px 0 52px;
    align-items: start;
  }

  .pie-columna {
    display: flex;
    flex-direction: column;
  }

  .columna-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #ffffff;
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .columna-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .item-espaciado {
    margin-top: 12px;
  }

  .columna-enlace {
    font-size: 0.84rem;
    color: #dbe6f6;
    text-decoration: none;
    line-height: 1.48;
    letter-spacing: 0.03em;
    display: block;
    transition: color 0.15s ease;
  }

  .columna-enlace:hover {
    color: #38b6ff;
  }

  /* Pie legal inferior */
  .pie-legal-contenido {
    padding-top: 24px;
  }

  .copia-legal {
    font-size: 0.72rem;
    color: #c0d0e6;
    margin: 0;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 1100px) {
    .pie-columnas-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 36px 28px;
    }

    .columna-lista {
      max-width: none !important;
    }
  }

  @media (max-width: 700px) {
    .pie-banda-top-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .pie-sep {
      display: none;
    }

    .pie-columnas-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }
  }

  @media (max-width: 460px) {
    .pie-columnas-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
