---
// Pie. Columnas y enlaces legales salen de src/data/site.ts.
// variant="light" muestra el logo en blanco sobre el azul.
import Logo from "./Logo.astro";
import { footerNav, legalNav, site } from "../data/site";
---

<footer class="footer">
  <div class="wrap footer-main">
    <div class="brand">
      <Logo variant="light" />
      <p>{site.tagline}</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.phoneHref}>{site.phone}</a>
      <span>España</span>
    </div>
    {
      footerNav.map((group) => (
        <div class="col">
          <h2>{group.title}</h2>
          {group.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      ))
    }
  </div>
  <div class="wrap footer-legal">
    <small>2026 EMAX energía. Todos los derechos reservados.</small>
    <nav aria-label="Legal">
      {legalNav.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer);
    color: var(--white);
    padding: 64px 0 28px;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1.45fr 1fr 1fr 0.8fr;
    gap: 32px 40px;
    padding-bottom: 56px;
  }

  .brand p {
    max-width: 34ch;
    margin-top: 18px;
    font-size: 0.92rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.92);
  }

  .brand a,
  .brand span {
    display: block;
    margin-top: 12px;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.92);
  }

  .brand a:first-of-type {
    margin-top: 28px;
  }

  .col h2 {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 16px;
  }

  .col a {
    display: block;
    margin-top: 10px;
    font-size: 0.95rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.92);
  }

  .brand a:hover,
  .col a:hover,
  .footer-legal a:hover {
    color: var(--white);
  }

  .footer-legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.35);
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .footer-legal nav {
    display: flex;
    gap: 36px;
  }

  @media (max-width: 860px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
    }

    .brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-main {
      grid-template-columns: 1fr;
    }

    .footer-legal {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
