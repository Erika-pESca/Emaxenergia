---
// Componente: FormularioGas.astro
// Formulario / Funnel específico para la página de Gas Natural (/tarifas/gas-natural/)
// Mantiene la estructura y estética de Formulario.astro adaptando el Paso 1 al boceto de Gas
// (selector "¿Para quién es?" con Empresa o negocio / Comunidad de vecinos / Hogar y 4 tramos de gasto).

import { site } from "../data/site";
import Logo from "./Logo.astro";
---

<!-- =========================================================================
     MODAL GAS: FORMULARIO DE ESTUDIO TÉCNICO Y CONTACTO (GAS NATURAL)
     ========================================================================= -->
<div
  class="modal-backdrop"
  id="modal-funnel-gas"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-funnel-gas-titulo"
  hidden
>
  <div class="modal-dialog">
    <!-- Cabecera: logo original, teléfono y cierre -->
    <header class="modal-cabecera">
      <div class="modal-marca-wrap">
        <Logo />
        <span class="modal-marca-sep" aria-hidden="true">|</span>
        <a href={site.phoneHref} class="modal-tel" title={`Llamar al ${site.phone}`}>{site.phone}</a>
      </div>

      <button
        type="button"
        class="modal-btn-cerrar"
        id="btn-cerrar-funnel-gas"
        aria-label="Cerrar ventana y volver a la web"
      >
        <span>Volver a la web</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <!-- Barra de progreso paso a paso: cada etapa con su color -->
    <nav class="fn-stepper" aria-label="Progreso del estudio de gas">
      <div class="fn-step activa" data-gas-etapa-indicador="1" style="--c: #004aad; --c-suave: #e0edfe;">
        <span class="fn-step-circulo">
          <span class="fn-step-num">1</span>
          <svg class="fn-step-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span class="fn-step-textos">
          <span class="fn-step-label">Tu gasto</span>
          <span class="fn-step-desc">Importe mensual</span>
        </span>
      </div>

      <div class="fn-step-linea" data-gas-step-linea="1" style="--c: #004aad;" aria-hidden="true"></div>

      <div class="fn-step" data-gas-etapa-indicador="2" style="--c: #19a9f0; --c-suave: #e1f4fd;">
        <span class="fn-step-circulo">
          <span class="fn-step-num">2</span>
          <svg class="fn-step-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span class="fn-step-textos">
          <span class="fn-step-label">Cómo empezamos</span>
          <span class="fn-step-desc">Llamada o factura</span>
        </span>
      </div>

      <div class="fn-step-linea" data-gas-step-linea="2" style="--c: #19a9f0;" aria-hidden="true"></div>

      <div class="fn-step" data-gas-etapa-indicador="3" style="--c: #f26a1b; --c-suave: #fdeadd;">
        <span class="fn-step-circulo">
          <span class="fn-step-num">3</span>
          <svg class="fn-step-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span class="fn-step-textos">
          <span class="fn-step-label">Tus datos</span>
          <span class="fn-step-desc">Contacto y franja</span>
        </span>
      </div>

      <div class="fn-step-linea" data-gas-step-linea="3" style="--c: #f26a1b;" aria-hidden="true"></div>

      <div class="fn-step" data-gas-etapa-indicador="4" style="--c: #12b76a; --c-suave: #e3f7ee;">
        <span class="fn-step-circulo">
          <span class="fn-step-num">4</span>
          <svg class="fn-step-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span class="fn-step-textos">
          <span class="fn-step-label">Listo</span>
          <span class="fn-step-desc">Solicitud enviada</span>
        </span>
      </div>
    </nav>

    <div class="modal-cuerpo-grid">
      <!-- COLUMNA IZQUIERDA: Formulario -->
      <div class="fn-col-izq">
        <!-- PASO 1: Tu gasto de gas (según boceto) -->
        <div class="fn-paso-vista" id="fn-gas-paso-1" style="--c: #004aad;">
          <p class="fn-eyebrow">Paso 1 de 4 · Tu gasto</p>

          <!-- Selector de segmento: ¿Para quién es? -->
          <div class="fn-para-quien-bloque">
            <p class="fn-para-quien-label" id="fn-gas-para-quien-lbl">¿Para quién es?</p>
            <div class="fn-segmento-pills" role="group" aria-labelledby="fn-gas-para-quien-lbl">
              <button
                type="button"
                class="fn-seg-pill activo"
                data-gas-segmento="empresa"
                aria-pressed="true"
              >
                Empresa o negocio
              </button>
              <button
                type="button"
                class="fn-seg-pill"
                data-gas-segmento="comunidad"
                aria-pressed="false"
              >
                Comunidad de vecinos
              </button>
              <button
                type="button"
                class="fn-seg-pill"
                data-gas-segmento="hogar"
                aria-pressed="false"
              >
                Hogar
              </button>
            </div>
          </div>

          <h2 id="modal-funnel-gas-titulo" class="fn-titulo">
            ¿Cuánto paga tu empresa de gas al mes?
          </h2>

          <p class="fn-sub" id="fn-gas-subtitulo">
            En total, sumando todos tus suministros. Con una cifra aproximada nos basta.
          </p>

          <!-- 4 Botones de tramo de gasto -->
          <div class="fn-cuatro-botones" id="fn-gas-tramos-grid">
            <button type="button" class="fn-opcion-btn" data-elegir-gasto-gas="menos-300">
              Menos de 300 €
            </button>
            <button type="button" class="fn-opcion-btn" data-elegir-gasto-gas="300-1000">
              300 – 1.000 €
            </button>
            <button type="button" class="fn-opcion-btn" data-elegir-gasto-gas="1000-3000">
              1.000 – 3.000 €
            </button>
            <button type="button" class="fn-opcion-btn" data-elegir-gasto-gas="mas-3000">
              Más de 3.000 €
            </button>
          </div>

          <p class="fn-ayuda" id="fn-gas-ayuda">
            Es el importe total de la factura. Si te llega cada dos meses, divide entre dos.
          </p>

          <div class="fn-no-lo-se-wrap">
            <button
              type="button"
              class="fn-no-lo-se-btn"
              id="fn-gas-no-lo-se-btn"
              aria-expanded="false"
              aria-controls="fn-gas-no-lo-se-texto"
            >
              No lo sé
            </button>
            <p id="fn-gas-no-lo-se-texto" class="fn-no-lo-se-desplegado" hidden>
              Busca en tu última factura el importe total a pagar. Si tienes varios suministros, suma las facturas de un mismo mes.
            </p>
          </div>

          <div class="fn-porque">
            <p class="fn-porque-t">Por qué te lo preguntamos</p>
            <p class="fn-porque-c" id="fn-gas-porque-texto">
              El tipo de análisis que tiene sentido, y quién te atiende, dependen de cuánto se juega tu empresa.
            </p>
          </div>
        </div>

        <!-- PASO 1B: Suministros (empresa / comunidad tras elegir gasto, igual que en v12.16) -->
        <div class="fn-paso-vista" id="fn-gas-paso-1b" style="--c: #004aad;" hidden>
          <p class="fn-eyebrow">Paso 1 de 4 · Tu gasto</p>

          <div class="fn-resultado" id="fn-gas-resultado-box">
            <p class="fn-resultado-cifra" id="fn-gas-resultado-cifra">
              Con lo que nos dices, tu empresa paga entre 3.600 y 12.000 € al año en gas.
            </p>
            <p class="fn-resultado-comun">No es lo que vas a ahorrar: es lo que está en juego.</p>
            <p class="fn-resultado-msg" id="fn-gas-resultado-msg">
              Con este gasto merece la pena mirar tu factura con detalle: el peaje, el consumo anual y las condiciones.
            </p>
          </div>

          <h2 class="fn-titulo" id="fn-gas-suministros-titulo">¿Cuántos suministros tiene tu empresa?</h2>

          <div class="fn-dos-botones">
            <button type="button" class="fn-opcion-btn fn-opcion-grande" data-gas-elegir-suministro="uno">
              Uno
            </button>
            <button type="button" class="fn-opcion-btn fn-opcion-grande" data-gas-elegir-suministro="varios">
              Varios
            </button>
          </div>

          <p class="fn-ayuda">Cada local, nave o sede con su propio contador es un suministro.</p>

          <div class="fn-porque">
            <p class="fn-porque-t">Por qué te lo preguntamos</p>
            <p class="fn-porque-c">
              Con varios suministros te atiende un gestor que mira cada uno y el conjunto.
            </p>
          </div>

          <button type="button" class="fn-atras-btn" id="fn-gas-volver-gasto">
            ← Atrás
          </button>
        </div>

        <!-- PASO 2: Cómo empezamos -->
        <div class="fn-paso-vista" id="fn-gas-paso-2" style="--c: #19a9f0;" hidden>
          <p class="fn-eyebrow">Paso 2 de 4 · Cómo empezamos</p>
          <h2 class="fn-titulo">¿Cómo prefieres empezar?</h2>
          <p class="fn-sub">Elige lo que te resulte más cómodo para poner en marcha el estudio.</p>

          <div class="fn-canales-lista">
            <button type="button" class="fn-canal-tarjeta" data-gas-elegir-canal="llamada">
              <div class="fn-canal-info">
                <strong class="fn-canal-tit">Una llamada</strong>
                <span class="fn-canal-desc">Un consultor te llama en la franja que elijas, con tu informe técnico delante.</span>
              </div>
              <span class="fn-canal-flecha" aria-hidden="true">→</span>
            </button>

            <button type="button" class="fn-canal-tarjeta" data-gas-elegir-canal="factura">
              <div class="fn-canal-info">
                <strong class="fn-canal-tit">Subir mi factura</strong>
                <span class="fn-canal-desc">Foto o PDF de tu factura más reciente para hacer la auditoría inmediata.</span>
              </div>
              <span class="fn-canal-flecha" aria-hidden="true">→</span>
            </button>
          </div>

          <div class="fn-porque">
            <p class="fn-porque-t">Sin compromiso comercial</p>
            <p class="fn-porque-c">Te explicamos los números antes de pedirte nada. Si no te compensa, te lo decimos con honestidad.</p>
          </div>

          <button type="button" class="fn-atras-btn" data-gas-ir-paso="1">
            ← Atrás
          </button>
        </div>

        <!-- PASO 3: Datos de contacto -->
        <div class="fn-paso-vista" id="fn-gas-paso-3" style="--c: #f26a1b;" hidden>
          <p class="fn-eyebrow">Paso 3 de 4 · Tus datos</p>
          <h2 class="fn-titulo">¿Dónde te llamamos?</h2>
          <p class="fn-sub">Dinos a quién preguntar y en qué franja horaria te va mejor hablar.</p>

          <form class="fn-formulario" id="fn-gas-form-datos">
            <!-- Campos ocultos para metadatos de lead y backend -->
            <input type="hidden" id="fn-gas-input-segmento" name="segmento" value="empresa" />
            <input type="hidden" id="fn-gas-input-gasto" name="gasto_mensual" value="" />
            <input type="hidden" id="fn-gas-input-suministros" name="suministros" value="uno" />
            <input type="hidden" id="fn-gas-input-canal" name="canal" value="llamada" />
            <input type="hidden" id="fn-gas-input-tramo" name="tramo_origen" value="gas-natural" />

            <div class="fn-campo">
              <label for="fn-gas-input-nombre" id="fn-gas-label-nombre">Tu nombre o empresa</label>
              <input type="text" id="fn-gas-input-nombre" name="nombre" required placeholder="Ej. Obrador La Espiga" autocomplete="organization" />
            </div>

            <div class="fn-campo">
              <label for="fn-gas-input-telefono">Teléfono de contacto</label>
              <input type="tel" id="fn-gas-input-telefono" name="telefono" required placeholder="Ej. 600 000 000" autocomplete="tel" />
            </div>

            <fieldset class="fn-grupo-franja">
              <legend>¿Cuándo te va mejor que te llamemos?</legend>
              <label class="fn-radio-label">
                <input type="radio" name="franja" value="manana" checked />
                <span>Por la mañana, de 9:00 a 13:00</span>
              </label>
              <label class="fn-radio-label">
                <input type="radio" name="franja" value="tarde" />
                <span>Por la tarde, de 15:00 a 19:00</span>
              </label>
            </fieldset>

            <p class="fn-antes-boton">
              Al pulsar, un consultor técnico te llamará con tu informe elaborado sin ningún coste ni permanencia.
            </p>

            <button type="submit" class="boton-fn-enviar" id="btn-submit-formulario-gas">
              <span>Solicitar la llamada con mi informe</span>
            </button>
          </form>

          <button type="button" class="fn-atras-btn" data-gas-ir-paso="2">
            ← Atrás
          </button>
        </div>

        <!-- PASO 4: Confirmación -->
        <div class="fn-paso-vista" id="fn-gas-paso-4" style="--c: #12b76a;" hidden>
          <p class="fn-eyebrow">Paso 4 de 4 · Listo</p>

          <div class="fn-exito-tarjeta">
            <span class="fn-exito-check" aria-hidden="true">✓</span>
            <h2 class="fn-titulo">Hecho. Hemos recibido tu solicitud.</h2>
            <p class="fn-sub">
              Un consultor especialista de EMAX revisará los datos de tu suministro de gas y te contactará en la franja elegida.
            </p>
          </div>

          <div class="fn-resumen-confirmacion">
            <p><strong>Lo que va a pasar ahora:</strong></p>
            <ul>
              <li>Revisamos tu peaje de gas, tu consumo anual y tu temporada.</li>
              <li>Te llamamos para explicártelo por teléfono con tu informe delante.</li>
              <li>Te lo mandamos por escrito decidas lo que decidas.</li>
            </ul>
          </div>

          <button type="button" class="boton-fn-enviar" id="btn-finalizar-funnel-gas">
            Volver a la web
          </button>
        </div>
      </div>

      <!-- COLUMNA DERECHA: Qué va a pasar -->
      <aside class="fn-panel" aria-label="Información del proceso de EMAX">
        <div>
          <h3 class="fn-panel-t">Qué va a pasar</h3>

          <ol class="fn-panel-pasos">
            <li data-gas-panel-paso="1" class="paso-actual" style="--c: #004aad; --c-suave: #e0edfe;">
              <span class="cifra">1</span>
              <div>
                <strong>Nos dices cuánto pagas y cómo prefieres empezar.</strong>
              </div>
            </li>
            <li data-gas-panel-paso="2" style="--c: #19a9f0; --c-suave: #e1f4fd;">
              <span class="cifra">2</span>
              <div>
                <strong>Maxi lee tu factura o los datos de tu suministro, y un especialista revisa lo que ha leído.</strong>
              </div>
            </li>
            <li data-gas-panel-paso="3" style="--c: #f26a1b; --c-suave: #fdeadd;">
              <span class="cifra">3</span>
              <div>
                <strong>Un consultor te llama, cuando tú digas, con tu informe delante.</strong>
              </div>
            </li>
            <li data-gas-panel-paso="4" style="--c: #12b76a; --c-suave: #e3f7ee;">
              <span class="cifra">4</span>
              <div>
                <strong>Te lo mandamos por escrito. Y decides tú.</strong>
              </div>
            </li>
          </ol>
        </div>

        <div class="fn-panel-cierre">
          <p class="fn-panel-cierre-linea">Recibes tu informe decidas lo que decidas.</p>
          <p class="fn-panel-sin-coste">El análisis no tiene coste.</p>
          <p class="fn-panel-cierre-sub" id="fn-gas-cierre-sub">
            Si tu contrato actual ya encaja con cómo consume tu empresa, el informe te lo dice en lugar de proponerte otra tarifa.
          </p>
        </div>
      </aside>
    </div>
  </div>
</div>

<script>
  // =========================================================================
  // CONTROL DEL FORMULARIO DE GAS NATURAL
  // =========================================================================
  interface TramoGas {
    id: string;
    label: string;
    resultado: string;
    msg?: string;
  }

  interface ConfigSegmentoGas {
    titulo: string;
    subtitulo: string;
    mostrarAyuda: boolean;
    porque: string;
    cierreSub: string;
    preguntaSuministros: string;
    labelNombre: string;
    placeholderNombre: string;
    tramos: TramoGas[];
  }

  const CONFIG_SEGMENTOS_GAS: Record<string, ConfigSegmentoGas> = {
    empresa: {
      titulo: "¿Cuánto paga tu empresa de gas al mes?",
      subtitulo: "En total, sumando todos tus suministros. Con una cifra aproximada nos basta.",
      mostrarAyuda: true,
      porque:
        "El tipo de análisis que tiene sentido, y quién te atiende, dependen de cuánto se juega tu empresa.",
      cierreSub:
        "Si tu contrato actual ya encaja con cómo consume tu empresa, el informe te lo dice en lugar de proponerte otra tarifa.",
      preguntaSuministros: "¿Cuántos suministros tiene tu empresa?",
      labelNombre: "Tu nombre o empresa",
      placeholderNombre: "Ej. Obrador La Espiga",
      tramos: [
        {
          id: "menos-300",
          label: "Menos de 300\u00a0€",
          resultado: "Con lo que nos dices, tu empresa paga menos de 3.600 € al año en gas.",
          msg: "Con este gasto hacemos un estudio sencillo.",
        },
        {
          id: "300-1000",
          label: "300 – 1.000\u00a0€",
          resultado: "Con lo que nos dices, tu empresa paga entre 3.600 y 12.000 € al año en gas.",
          msg: "Con este gasto merece la pena mirar tu factura con detalle: la potencia, los periodos y las condiciones.",
        },
        {
          id: "1000-3000",
          label: "1.000 – 3.000\u00a0€",
          resultado: "Con lo que nos dices, tu empresa paga entre 12.000 y 36.000 € al año en gas.",
          msg: "Con este gasto te atiende un gestor, que revisa tu suministro completo. Si después del análisis no podemos plantearte un ahorro con garantías suficientes, no queremos hacerte perder el tiempo.",
        },
        {
          id: "mas-3000",
          label: "Más de 3.000\u00a0€",
          resultado: "Con lo que nos dices, tu empresa paga más de 36.000 € al año en gas.",
          msg: "Con este gasto te atiende un gestor, que revisa tu suministro completo. Si después del análisis no podemos plantearte un ahorro con garantías suficientes, no queremos hacerte perder el tiempo.",
        },
      ],
    },
    comunidad: {
      titulo: "¿Cuánto paga la comunidad de gas al mes?",
      subtitulo: "Suma todas las facturas de la comunidad: portal, ascensor, garaje, piscina.",
      mostrarAyuda: false,
      porque:
        "El tipo de análisis que tiene sentido, y quién te atiende, dependen de cuánto se juega tu empresa.",
      cierreSub:
        "Si tu contrato actual ya encaja con cómo consume tu empresa, el informe te lo dice en lugar de proponerte otra tarifa.",
      preguntaSuministros: "¿Cuántos suministros tiene la comunidad?",
      labelNombre: "Tu nombre o comunidad",
      placeholderNombre: "Ej. Comunidad C/ Mayor 14",
      tramos: [
        {
          id: "com-menos-100",
          label: "Menos de 100\u00a0€",
          resultado: "Con lo que nos dices, la comunidad paga menos de 1.200 € al año en gas.",
        },
        {
          id: "com-100-200",
          label: "100 – 200\u00a0€",
          resultado: "Con lo que nos dices, la comunidad paga entre 1.200 y 2.400 € al año en gas.",
        },
        {
          id: "com-200-300",
          label: "200 – 300\u00a0€",
          resultado: "Con lo que nos dices, la comunidad paga entre 2.400 y 3.600 € al año en gas.",
        },
        {
          id: "com-mas-300",
          label: "Más de 300\u00a0€",
          resultado: "Con lo que nos dices, la comunidad paga más de 3.600 € al año en gas.",
        },
      ],
    },
    hogar: {
      titulo: "¿Cuánto pagas de gas al mes?",
      subtitulo: "Con una cifra aproximada nos basta.",
      mostrarAyuda: false,
      porque:
        "El tipo de análisis que tiene sentido, y quién te atiende, dependen de cuánto se juega tu empresa.",
      cierreSub:
        "Si tu contrato actual ya encaja con cómo consume tu empresa, el informe te lo dice en lugar de proponerte otra tarifa.",
      preguntaSuministros: "¿Cuántos suministros tiene tu casa?",
      labelNombre: "Tu nombre",
      placeholderNombre: "Ej. María García",
      tramos: [
        {
          id: "hog-menos-50",
          label: "Menos de 50\u00a0€",
          resultado: "Con lo que nos dices, en casa pagas menos de 600 € al año de gas.",
        },
        {
          id: "hog-50-100",
          label: "50 – 100\u00a0€",
          resultado: "Con lo que nos dices, en casa pagas entre 600 y 1.200 € al año de gas.",
        },
        {
          id: "hog-100-150",
          label: "100 – 150\u00a0€",
          resultado: "Con lo que nos dices, en casa pagas entre 1.200 y 1.800 € al año de gas.",
        },
        {
          id: "hog-mas-150",
          label: "Más de 150\u00a0€",
          resultado: "Con lo que nos dices, en casa pagas más de 1.800 € al año de gas.",
        },
      ],
    },
  };

  function inicializarFormularioGas() {
    const modalFunnel = document.getElementById("modal-funnel-gas");
    if (!modalFunnel || modalFunnel.dataset.iniciado === "true") return;
    modalFunnel.dataset.iniciado = "true";

    const btnCerrarFunnel = document.getElementById("btn-cerrar-funnel-gas");
    const btnFinalizarFunnel = document.getElementById("btn-finalizar-funnel-gas");

    const pasoVistas: Record<number, HTMLElement | null> = {
      1: document.getElementById("fn-gas-paso-1"),
      2: document.getElementById("fn-gas-paso-2"),
      3: document.getElementById("fn-gas-paso-3"),
      4: document.getElementById("fn-gas-paso-4"),
    };
    const paso1bVista = document.getElementById("fn-gas-paso-1b");

    const etapaIndicadores = modalFunnel.querySelectorAll("[data-gas-etapa-indicador]");

    // Campos ocultos
    const inputSegmento = document.getElementById("fn-gas-input-segmento") as HTMLInputElement | null;
    const inputGasto = document.getElementById("fn-gas-input-gasto") as HTMLInputElement | null;
    const inputSuministros = document.getElementById("fn-gas-input-suministros") as HTMLInputElement | null;
    const inputCanal = document.getElementById("fn-gas-input-canal") as HTMLInputElement | null;
    const inputTramo = document.getElementById("fn-gas-input-tramo") as HTMLInputElement | null;

    // Elementos dinámicos del paso 1 y 1b
    const tituloPaso1 = document.getElementById("modal-funnel-gas-titulo");
    const subtituloPaso1 = document.getElementById("fn-gas-subtitulo");
    const ayudaPaso1 = document.getElementById("fn-gas-ayuda");
    const porquePaso1 = document.getElementById("fn-gas-porque-texto");
    const cierreSub = document.getElementById("fn-gas-cierre-sub");
    const tramosGrid = document.getElementById("fn-gas-tramos-grid");
    const labelNombre = document.getElementById("fn-gas-label-nombre");
    const inputNombre = document.getElementById("fn-gas-input-nombre") as HTMLInputElement | null;
    const pillsSegmento = modalFunnel.querySelectorAll<HTMLButtonElement>("[data-gas-segmento]");
    const btnNoLoSe = document.getElementById("fn-gas-no-lo-se-btn");
    const txtNoLoSe = document.getElementById("fn-gas-no-lo-se-texto");
    const resultadoCifra = document.getElementById("fn-gas-resultado-cifra");
    const resultadoMsg = document.getElementById("fn-gas-resultado-msg");
    const suministrosTitulo = document.getElementById("fn-gas-suministros-titulo");
    const btnVolverGasto = document.getElementById("fn-gas-volver-gasto");

    function normalizarSegmento(raw?: string | null): string {
      if (!raw) return "empresa";
      const val = raw.toLowerCase();
      if (val.includes("comunidad")) return "comunidad";
      if (val.includes("hogar") || val.includes("casa") || val.includes("particular")) return "hogar";
      return "empresa";
    }

    function aplicarSegmentoGas(segKey: string) {
      const clave = CONFIG_SEGMENTOS_GAS[segKey] ? segKey : "empresa";
      const cfg = CONFIG_SEGMENTOS_GAS[clave];

      if (inputSegmento) inputSegmento.value = clave;

      pillsSegmento.forEach((pill) => {
        const esActivo = pill.getAttribute("data-gas-segmento") === clave;
        pill.classList.toggle("activo", esActivo);
        pill.setAttribute("aria-pressed", esActivo ? "true" : "false");
      });

      if (tituloPaso1) tituloPaso1.textContent = cfg.titulo;
      if (subtituloPaso1) subtituloPaso1.textContent = cfg.subtitulo;
      if (ayudaPaso1) {
        if (cfg.mostrarAyuda) {
          ayudaPaso1.removeAttribute("hidden");
        } else {
          ayudaPaso1.setAttribute("hidden", "true");
        }
      }
      if (porquePaso1) porquePaso1.textContent = cfg.porque;
      if (cierreSub) cierreSub.textContent = cfg.cierreSub;
      if (labelNombre) labelNombre.textContent = cfg.labelNombre;
      if (inputNombre) inputNombre.placeholder = cfg.placeholderNombre;

      if (tramosGrid) {
        const botones = tramosGrid.querySelectorAll<HTMLButtonElement>("[data-elegir-gasto-gas]");
        cfg.tramos.forEach((tramo, idx) => {
          const btn = botones[idx];
          if (btn) {
            btn.setAttribute("data-elegir-gasto-gas", tramo.id);
            btn.textContent = tramo.label;
          }
        });
      }
    }

    function irAlPaso(numPaso: number) {
      paso1bVista?.setAttribute("hidden", "true");
      Object.keys(pasoVistas).forEach((key) => {
        const k = Number(key);
        const vista = pasoVistas[k];
        if (vista) {
          if (k === numPaso) {
            vista.removeAttribute("hidden");
          } else {
            vista.setAttribute("hidden", "true");
          }
        }
      });

      etapaIndicadores.forEach((ind) => {
        const idx = Number(ind.getAttribute("data-gas-etapa-indicador"));
        ind.classList.remove("activa", "completada");
        ind.removeAttribute("aria-current");
        if (idx === numPaso) {
          ind.classList.add("activa");
          ind.setAttribute("aria-current", "step");
        } else if (idx < numPaso) {
          ind.classList.add("completada");
        }
      });

      // Líneas conectoras del stepper
      modalFunnel!.querySelectorAll("[data-gas-step-linea]").forEach((linea) => {
        const lineIdx = Number(linea.getAttribute("data-gas-step-linea"));
        linea.classList.toggle("completada", lineIdx < numPaso);
      });

      // Pasos informativos de la columna derecha
      modalFunnel!.querySelectorAll("[data-gas-panel-paso]").forEach((li) => {
        const pIdx = Number(li.getAttribute("data-gas-panel-paso"));
        li.classList.remove("paso-actual", "paso-hecho");
        if (pIdx === numPaso) li.classList.add("paso-actual");
        else if (pIdx < numPaso) li.classList.add("paso-hecho");
      });
    }

    function abrirModalFunnelGas(btn?: HTMLElement | null) {
      if (btn) {
        const segAttr =
          btn.getAttribute("data-segmento") ||
          btn.getAttribute("data-tipo-gas") ||
          btn.getAttribute("data-tramo-msg") ||
          "empresa";
        aplicarSegmentoGas(normalizarSegmento(segAttr));

        const tramoId = btn.getAttribute("data-tramo-id") || "gas-natural";
        if (inputTramo) inputTramo.value = tramoId;
      } else {
        aplicarSegmentoGas("empresa");
      }

      irAlPaso(1);
      modalFunnel!.removeAttribute("hidden");
      document.body.style.overflow = "hidden";
    }

    function cerrarModalFunnelGas() {
      modalFunnel!.setAttribute("hidden", "true");
      document.body.style.overflow = "";
    }

    // Delegación global: cualquier botón con data-abrir-funnel en la página de Gas abre este modal
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      const btn = target?.closest<HTMLElement>("[data-abrir-funnel]");
      if (btn) {
        e.preventDefault();
        abrirModalFunnelGas(btn);
      }
    });

    btnCerrarFunnel?.addEventListener("click", cerrarModalFunnelGas);
    btnFinalizarFunnel?.addEventListener("click", cerrarModalFunnelGas);

    // Cerrar con Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modalFunnel.hasAttribute("hidden")) {
        cerrarModalFunnelGas();
      }
    });

    // Cerrar al hacer clic fuera
    modalFunnel.addEventListener("click", (e) => {
      if (e.target === modalFunnel) {
        cerrarModalFunnelGas();
      }
    });

    // Cambio de segmento en Paso 1 (Empresa o negocio / Comunidad de vecinos / Hogar)
    pillsSegmento.forEach((pill) => {
      pill.addEventListener("click", () => {
        const seg = pill.getAttribute("data-gas-segmento") || "empresa";
        aplicarSegmentoGas(seg);
      });
    });

    // Botón desplegable "No lo sé" (v12.16)
    btnNoLoSe?.addEventListener("click", () => {
      if (!txtNoLoSe) return;
      const estaAbierto = !txtNoLoSe.hasAttribute("hidden");
      if (estaAbierto) {
        txtNoLoSe.setAttribute("hidden", "true");
        btnNoLoSe.setAttribute("aria-expanded", "false");
      } else {
        txtNoLoSe.removeAttribute("hidden");
        btnNoLoSe.setAttribute("aria-expanded", "true");
      }
    });

    // Paso 1: Selección de tramo de gasto
    modalFunnel.querySelectorAll<HTMLButtonElement>("[data-elegir-gasto-gas]").forEach((b) => {
      b.addEventListener("click", () => {
        const val = b.getAttribute("data-elegir-gasto-gas") || "menos-300";
        if (inputGasto) inputGasto.value = val;

        const segActual = inputSegmento?.value || "empresa";
        const cfg = CONFIG_SEGMENTOS_GAS[segActual] || CONFIG_SEGMENTOS_GAS.empresa;
        const tramoObj = cfg.tramos.find((t) => t.id === val) || cfg.tramos[0];

        if (segActual === "hogar") {
          if (inputSuministros) inputSuministros.value = "uno";
          irAlPaso(2);
          return;
        }

        if (resultadoCifra) resultadoCifra.textContent = tramoObj.resultado;
        if (resultadoMsg) {
          if (tramoObj.msg) {
            resultadoMsg.textContent = tramoObj.msg;
            resultadoMsg.removeAttribute("hidden");
          } else {
            resultadoMsg.setAttribute("hidden", "true");
          }
        }
        if (suministrosTitulo) suministrosTitulo.textContent = cfg.preguntaSuministros;

        pasoVistas[1]?.setAttribute("hidden", "true");
        paso1bVista?.removeAttribute("hidden");
      });
    });

    // Paso 1B: Selección de nº de suministros (Uno / Varios)
    modalFunnel.querySelectorAll<HTMLButtonElement>("[data-gas-elegir-suministro]").forEach((b) => {
      b.addEventListener("click", () => {
        const val = b.getAttribute("data-gas-elegir-suministro") || "uno";
        if (inputSuministros) inputSuministros.value = val;
        irAlPaso(2);
      });
    });

    btnVolverGasto?.addEventListener("click", () => {
      irAlPaso(1);
    });

    // Paso 2: Selección de canal de contacto
    modalFunnel.querySelectorAll<HTMLButtonElement>("[data-gas-elegir-canal]").forEach((b) => {
      b.addEventListener("click", () => {
        const canal = b.getAttribute("data-gas-elegir-canal") || "llamada";
        if (inputCanal) inputCanal.value = canal;
        irAlPaso(3);
      });
    });

    // Botones de vuelta atrás
    modalFunnel.querySelectorAll<HTMLButtonElement>("[data-gas-ir-paso]").forEach((b) => {
      b.addEventListener("click", () => {
        const target = Number(b.getAttribute("data-gas-ir-paso")) || 1;
        irAlPaso(target);
      });
    });

    async function enviarLeadGasAlBackend(datos: Record<string, string>) {
      console.log("Lead de Gas Natural capturado para el backend:", datos);
      return true;
    }

    // Paso 3: Envío del formulario
    const formDatos = document.getElementById("fn-gas-form-datos") as HTMLFormElement | null;
    formDatos?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(formDatos);
      const datosLead: Record<string, string> = {
        nombre: String(formData.get("nombre") || ""),
        telefono: String(formData.get("telefono") || ""),
        franja: String(formData.get("franja") || "manana"),
        segmento: inputSegmento?.value || "empresa",
        gasto_mensual: inputGasto?.value || "",
        suministros: inputSuministros?.value || "uno",
        canal: inputCanal?.value || "llamada",
        tramo_origen: inputTramo?.value || "gas-natural",
        fecha: new Date().toISOString(),
      };

      await enviarLeadGasAlBackend(datosLead);
      irAlPaso(4);
    });
  }

  inicializarFormularioGas();
  document.addEventListener("astro:page-load", inicializarFormularioGas);
</script>

