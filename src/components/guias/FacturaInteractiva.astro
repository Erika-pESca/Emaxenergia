  /* --------------------------------------------------------------------------
     Columna 2: Zona central con icono SVG animado interactivo
     -------------------------------------------------------------------------- */
  .icon-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 260px;
  }

  .icon-aura {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.18) 0%, rgba(0, 74, 173, 0.08) 50%, transparent 75%);
    pointer-events: none;
    animation: auraPulso 4s infinite ease-in-out;
  }

  @keyframes auraPulso {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.15); opacity: 1; }
  }

  .svg-icon-wrap {
    display: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 240px;
    aspect-ratio: 1;
    position: relative;
    z-index: 2;
  }

  .svg-icon-wrap.is-active {
    display: flex;
    animation: fadeInIcon 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInIcon {
    from { opacity: 0; transform: scale(0.92) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .svg-anim {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 14px 28px rgba(0, 10, 30, 0.5));
  }

  /* Animaciones específicas de cada icono para que se muevan con vida */
  /* 01. CUPS Laser */
  .laser-beam {
    animation: laserScan 2.4s infinite ease-in-out;
  }
  @keyframes laserScan {
    0%, 100% { transform: translateY(0); opacity: 0.3; }
    50% { transform: translateY(75px); opacity: 1; filter: drop-shadow(0 0 6px #00d4ff); }
  }

  /* 02. Potencia Aguja */
  .aguja-rotativa {
    transform-origin: 100px 105px;
    animation: oscilarAguja 2.8s infinite ease-in-out;
  }
  @keyframes oscilarAguja {
    0%, 100% { transform: rotate(-35deg); }
    50% { transform: rotate(40deg); }
  }
  .onda-pulso {
    transform-origin: 100px 105px;
    animation: pulsoCirculo 2s infinite ease-out;
  }
  @keyframes pulsoCirculo {
    0% { transform: scale(0.95); opacity: 0.8; }
    100% { transform: scale(1.12); opacity: 0.1; }
  }

  /* 03. Maxímetro Pico */
  .pico-flag {
    animation: picoRebote 1.8s infinite ease-in-out;
  }
  @keyframes picoRebote {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); filter: drop-shadow(0 0 8px #00d4ff); }
  }
  .bar-pico {
    animation: picoPulso 2.2s infinite ease-in-out;
  }
  @keyframes picoPulso {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 1; fill: #38bdf8; }
  }

  /* 04. Excesos Rayo */
  .rayo-flotante {
    animation: rayoSalto 2.2s infinite ease-in-out;
  }
  @keyframes rayoSalto {
    0%, 100% { transform: translateY(0) scale(1); filter: drop-shadow(0 0 10px rgba(0, 212, 255, 0.5)); }
    50% { transform: translateY(-6px) scale(1.04); filter: drop-shadow(0 0 20px rgba(0, 212, 255, 0.9)); }
  }
  .chispa-1, .chispa-2, .chispa-3 {
    animation: chispaFlash 1.5s infinite ease-in-out;
  }
  .chispa-2 { animation-delay: 0.4s; }
  .chispa-3 { animation-delay: 0.8s; }
  @keyframes chispaFlash {
    0%, 100% { opacity: 0.2; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  /* 05. Reactiva Ondas */
  .onda-flujo {
    animation: flujoOnda 2.2s infinite ease-in-out;
  }
  .onda-b { animation-delay: 0.35s; }
  .onda-c { animation-delay: 0.7s; }
  @keyframes flujoOnda {
    0%, 100% { transform: scaleY(1); opacity: 0.4; }
    50% { transform: scaleY(1.3); opacity: 1; }
  }

  /* 06. Peaje Manecilla */
  .manecilla-reloj {
    transform-origin: 100px 100px;
    animation: girarReloj 8s infinite linear;
  }
  @keyframes girarReloj {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* 07. Energía Balanza */
  .brazo-balanza {
    transform-origin: 100px 70px;
    animation: bascularBalanza 3.4s infinite ease-in-out;
  }
  @keyframes bascularBalanza {
    0%, 100% { transform: rotate(-6deg); }
    50% { transform: rotate(6deg); }
  }

  /* 08. Impuestos Lupa */
  .lupa-orbita {
    animation: orbitaLupa 3.6s infinite ease-in-out;
  }
  @keyframes orbitaLupa {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(8px, -8px); }
    66% { transform: translate(-6px, 6px); }
  }

  /* --------------------------------------------------------------------------
     Columna 3: Tarjeta de detalle explicativa con botón de acceso
     -------------------------------------------------------------------------- */
  .detail-card-wrap {
