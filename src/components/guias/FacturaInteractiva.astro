  @media (prefers-reduced-motion: reduce) {
    .laser-beam,
    .aguja-rotativa,
    .onda-pulso,
    .pico-flag,
    .bar-pico,
    .rayo-flotante,
    .chispa-1,
    .chispa-2,
    .chispa-3,
    .onda-flujo,
    .manecilla-reloj,
    .brazo-balanza,
    .lupa-orbita,
    .icon-aura {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  // Controlador interactivo de conceptos con animación sincronizada
  function initConceptosFactura() {
    const stage = document.getElementById("stageConceptos");
    if (!stage) return;

    const botones = Array.from(stage.querySelectorAll<HTMLButtonElement>("button.num-btn"));
    const iconWraps = Array.from(stage.querySelectorAll<HTMLElement>(".svg-icon-wrap"));

    const kicker = document.getElementById("detailKicker");
    const sub = document.getElementById("detailSub");
    const titulo = document.getElementById("detailTitulo");
    const desc = document.getElementById("detailDesc");
    const enlace = document.getElementById("detailEnlace");
    const guiaTexto = document.getElementById("detailGuiaTexto");

    const btnPrev = document.getElementById("btnPrevConcepto");
    const btnNext = document.getElementById("btnNextConcepto");

    let activeIndex = 0;

    function activarConcepto(idx: number) {
      if (idx < 0) idx = botones.length - 1;
      if (idx >= botones.length) idx = 0;

      const targetBtn = botones[idx];
      if (!targetBtn) return;
      if (idx === activeIndex && targetBtn.classList.contains("is-active")) return;
      activeIndex = idx;

      // Actualizar botones de la lista
      botones.forEach((b, i) => {
        const isAct = i === idx;
        b.classList.toggle("is-active", isAct);
        b.setAttribute("aria-selected", isAct ? "true" : "false");
      });

      // Extraer datos
      const num = targetBtn.dataset.num || "01";
      const nombre = targetBtn.dataset.nombre || "";
      const subTxt = targetBtn.dataset.sub || "";
      const descTxt = targetBtn.dataset.desc || "";
      const guiaTxt = targetBtn.dataset.guia || "";
      const href = targetBtn.dataset.href || "#";
      const icono = targetBtn.dataset.icono || "cups";

      // Actualizar tarjeta de detalle
      if (kicker) kicker.textContent = `CONCEPTO ${num} DE 08`;
      if (sub) sub.textContent = subTxt;
      if (titulo) titulo.textContent = nombre;
      if (desc) desc.textContent = descTxt;
      if (guiaTexto) guiaTexto.textContent = `Leer guía: ${guiaTxt}`;
      if (enlace) enlace.setAttribute("href", href);

      // Actualizar icono animado visible
      iconWraps.forEach((wrap) => {
        wrap.classList.toggle("is-active", wrap.dataset.icon === icono);
      });
    }

    let hoverTimer: ReturnType<typeof setTimeout> | null = null;

    // Eventos en botones de lista con debounce de 60ms para evitar parpadeos
    botones.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        if (hoverTimer) clearTimeout(hoverTimer);
        activarConcepto(idx);
      });
      btn.addEventListener("mouseenter", () => {
        if (hoverTimer) clearTimeout(hoverTimer);
        hoverTimer = setTimeout(() => {
          activarConcepto(idx);
        }, 60);
      });
      btn.addEventListener("focus", () => {
        if (hoverTimer) clearTimeout(hoverTimer);
        activarConcepto(idx);
      });
    });

    const listaContainer = stage.querySelector(".num-lista");
    listaContainer?.addEventListener("mouseleave", () => {
      if (hoverTimer) clearTimeout(hoverTimer);
    });

    // Flechas prev / next
    btnPrev?.addEventListener("click", () => {
      if (hoverTimer) clearTimeout(hoverTimer);
      activarConcepto(activeIndex - 1);
    });
    btnNext?.addEventListener("click", () => {
      if (hoverTimer) clearTimeout(hoverTimer);
      activarConcepto(activeIndex + 1);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initConceptosFactura);
  } else {
    initConceptosFactura();
  }

  document.addEventListener("astro:page-load", initConceptosFactura);
</script>
