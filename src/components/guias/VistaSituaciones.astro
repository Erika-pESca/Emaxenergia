<script>
  // Actualización reactiva de la tarjeta fija según la situación activa
  function inicializarVistaSituaciones() {
    const lista = document.getElementById("sitSituaciones");
    const tit = document.getElementById("vistaTitulo");
    const resp = document.getElementById("vistaRespuesta");
    const tiempo = document.getElementById("vistaTiempo");
    const fecha = document.getElementById("vistaFecha");
    const enlace = document.getElementById("vistaEnlace");

    if (!lista || !tit || !resp || !enlace) return;

    const cards = Array.from(lista.querySelectorAll<HTMLAnchorElement>("a.sit-card"));

    function activarSituacion(targetCard: HTMLAnchorElement) {
      cards.forEach((c) => c.classList.toggle("on", c === targetCard));

      const g = targetCard.dataset.guia || "";
      const r = targetCard.dataset.respuesta || "";
      const t = targetCard.dataset.tiempo || "5 min";
      const f = targetCard.dataset.fecha || "7 de octubre de 2026";
      const href = targetCard.getAttribute("href") || "#";

      tit!.textContent = g;
      resp!.textContent = r;
      if (tiempo) {
        tiempo.textContent = `Lectura de ${t}`;
      }
      if (fecha) {
        fecha.textContent = `Revisada el ${f}`;
      }
      enlace!.setAttribute("href", href);
    }


    lista.addEventListener("mouseover", (e) => {
      const card = (e.target as HTMLElement).closest<HTMLAnchorElement>("a.sit-card");
      if (card) activarSituacion(card);
    });

    lista.addEventListener("focusin", (e) => {
      const card = (e.target as HTMLElement).closest<HTMLAnchorElement>("a.sit-card");
      if (card) activarSituacion(card);
    });

    // Filtros por temática
    const filtroBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".sit-filtro-btn"));
    const items = Array.from(lista.querySelectorAll<HTMLLIElement>(".sit-item"));

    filtroBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filtroBtns.forEach((b) => {
          b.classList.remove("is-active");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("is-active");
        btn.setAttribute("aria-selected", "true");

        const targetFiltro = btn.dataset.filtro || "todos";

        let firstVisibleCard: HTMLAnchorElement | null = null;
        items.forEach((item) => {
          const itemGrupo = item.dataset.grupo;
          if (targetFiltro === "todos" || itemGrupo === targetFiltro) {
            item.classList.remove("is-hidden");
            if (!firstVisibleCard) {
              firstVisibleCard = item.querySelector<HTMLAnchorElement>("a.sit-card");
            }
          } else {
            item.classList.add("is-hidden");
          }
        });

        if (firstVisibleCard) {
          activarSituacion(firstVisibleCard);
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", inicializarVistaSituaciones);
  } else {
    inicializarVistaSituaciones();
  }
  document.addEventListener("astro:page-load", inicializarVistaSituaciones);
</script>
