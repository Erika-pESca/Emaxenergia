---
// Sección "Los conceptos de tu factura" - Píldoras de acceso directo
// Permite al usuario buscar rápidamente un concepto técnico que aparece en su recibo
import { conceptosFactura } from "../../data/guiasData";

const conceptosExtendidos = [
  ...conceptosFactura,
  { nombre: "Las tres partes", href: "/guias/factura-luz-empresa#tres-partes", desc: "Energía, potencia e impuestos" },
  { nombre: "Impuestos", href: "/guias/factura-luz-empresa#impuestos", desc: "IEE e IVA aplicables" },
  { nombre: "Lecturas", href: "/guias/factura-luz-empresa#lecturas", desc: "Lectura real vs estimada" },
];
---

<section class="seccion-conceptos" aria-labelledby="tit-conceptos">
  <div class="contenedor-conceptos">
    <div class="cabecera-conceptos">
      <div class="kicker-conceptos">Consulta por términos</div>
      <h2 id="tit-conceptos" class="tit-conceptos">
        LOS CONCEPTOS DE<br />
        <span class="tit-cursiva">tu factura, en claro.</span>
      </h2>
      <p class="desc-conceptos">
        ¿Ves una palabra rara en tu recibo? Haz clic para ir directo al apartado donde te
        explicamos cómo se calcula y si es obligatorio o evitable.
      </p>
    </div>

    <!-- Píldoras interactivas -->
    <div class="pildoras-wrap" role="list">
      {
        conceptosExtendidos.map((c) => (
          <a href={c.href} class="pildora-concepto" role="listitem">
            <span class="pildora-nombre">{c.nombre}</span>
            <span class="pildora-desc">{c.desc}</span>
            <span class="pildora-icono" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .seccion-conceptos {
    padding: 64px 0 72px;
    background: #f7f9fd;
    border-top: 1px solid var(--linea-fina);
    border-bottom: 1px solid var(--linea-fina);
  }

  .contenedor-conceptos {
    max-width: var(--ancho-max, 1200px);
    margin: 0 auto;
    padding: 0 24px;
  }

  .cabecera-conceptos {
    max-width: 600px;
    margin-bottom: 36px;
  }

  .kicker-conceptos {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--azul-900);
    margin-bottom: 10px;
  }

  .tit-conceptos {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.25rem);
    font-weight: 700;
    color: var(--tinta);
    line-height: 1.25;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }

  .tit-cursiva {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    color: var(--azul-900);
  }

  .desc-conceptos {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--tinta-2);
    margin: 0;
  }

  .pildoras-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pildora-concepto {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(15, 35, 70, 0.03);
  }

  .pildora-concepto:hover {
    background: var(--azul-suave);
    border-color: var(--azul-700);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 74, 173, 0.08);
  }

  .pildora-nombre {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--tinta);
  }

  .pildora-concepto:hover .pildora-nombre {
    color: var(--azul-900);
  }

  .pildora-desc {
    font-size: 0.75rem;
    color: var(--tinta-3);
    border-left: 1px solid var(--linea-fina);
    padding-left: 8px;
  }

  .pildora-icono {
    color: #9cb1cb;
    display: flex;
    align-items: center;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .pildora-concepto:hover .pildora-icono {
    color: var(--azul-900);
    transform: translateX(2px);
  }

  @media (max-width: 640px) {
    .pildora-desc {
      display: none;
    }

    .pildora-concepto {
      padding: 8px 14px;
    }
  }
</style>
