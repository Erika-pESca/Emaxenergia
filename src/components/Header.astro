---
// Cabecera. Los enlaces y el botón salen de src/data/site.ts.
// En pantallas estrechas el menú se abre con el botón de abajo.
import Logo from "./Logo.astro";
import { headerNav, primaryCta } from "../data/site";

const current = Astro.url.pathname;
---

<header class="header">
  <div class="wrap header-inner">
    <Logo />
    <nav class="nav" data-nav aria-label="Principal">
      {
        headerNav.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: current === item.href }]}
            aria-current={current === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="btn btn-primary nav-cta" href={primaryCta.href}>{primaryCta.label}</a>
    </nav>
    <a class="btn btn-primary header-cta" href={primaryCta.href}>{primaryCta.label}</a>
    <button class="menu-btn" type="button" data-menu aria-expanded="false" aria-label="Abrir menú">
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector("[data-menu]");
  const nav = document.querySelector("[data-nav]");
  btn?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    btn.setAttribute("aria-expanded", String(Boolean(open)));
    btn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--white);
  }

  .header-inner {
    height: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 40px;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: #091f44;
  }

  .nav-link:hover {
    color: var(--blue);
  }

  .header-cta {
    background: var(--blue);
    min-height: 40px;
    padding: 10px 18px;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .header-cta:hover {
    background: var(--blue-hover);
    transform: none;
  }

  .nav-cta {
    display: none;
  }

  .menu-btn {
    display: none;
    width: 42px;
    height: 42px;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 10px;
  }

  .menu-btn span {
    display: block;
    height: 2px;
    background: #091f44;
    margin: 6px 0;
  }

  @media (max-width: 980px) {
    .header-inner {
      grid-template-columns: 1fr auto;
    }

    .menu-btn {
      display: block;
    }

    .header-cta {
      display: none;
    }

    .nav-cta {
      display: inline-flex;
      margin-top: 8px;
      background: var(--blue);
    }

    .nav {
      display: none;
      position: absolute;
      inset: var(--header-h) 16px auto;
      background: var(--white);
      border-radius: 16px;
      box-shadow: var(--shadow);
      padding: 16px;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
    }

    .nav.open {
      display: flex;
    }

    .nav-link {
      padding: 12px;
      border-radius: 10px;
    }

    .nav-link:hover {
      background: var(--blue-soft);
    }
  }
</style>
