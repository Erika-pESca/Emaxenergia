---
// Cabecera Ultra Comercial enfocada en Conversión y Ventas
// Diseño corporativo edge-to-edge con:
// 1. Franja superior (Top utility bar) con segmentación Empresas / Comunidades / Hogares y mensaje de confianza.
// 2. Barra principal de alto impacto comercial con Logo, Navegación B2B, Teléfono directo visible,
//    botón "Te llamamos gratis" (con lead popover instantáneo) y botón principal "Analizar mi factura".
import Logo from "./Logo.astro";
import { site, primaryCta } from "../data/site";

const current = Astro.url.pathname;

const sectoresItems = [
  { href: "/sectores/restaurantes", label: "Restaurantes y hostelería", desc: "Turnos partidos en horas punta caras" },
  { href: "/sectores/hoteles", label: "Hoteles y alojamientos", desc: "Estacionalidad y potencia ociosa en invierno" },
  { href: "/sectores/supermercados", label: "Supermercados y tiendas", desc: "Consumo continuo de cámaras frigoríficas" },
  { href: "/sectores/logistica-frio", label: "Logística y frío industrial", desc: "Ajuste de peajes en ciclos 24/7" },
  { href: "/sectores/industria", label: "Industria y fabricación", desc: "Arranque de motores y energía reactiva" },
];

const tarifasItems = [
  { href: "/tarifas", label: "Luz para Empresas", desc: "Peajes 2.0TD, 3.0TD y 6.XTD optimizados" },
  { href: "/gas-natural", label: "Gas para Empresas", desc: "Suministro RL para negocios e industria" },
  { href: "/varios-suministros", label: "Múltiples Suministros", desc: "Unificación de facturación multisede" },
];
---

<header class="cabecera-comercial-root">
  <!-- 1. FRANJA SUPERIOR (Top Utility & Trust Bar) -->
  <div class="top-bar">
    <div class="contenedor-cabecera top-bar-contenido">
      <!-- Selector de segmento -->
      <div class="selector-segmentos" role="tablist" aria-label="Segmento de cliente">
        <a href="/" class="segmento-item activo" aria-selected="true">
          <span class="punto-segmento">●</span>
          <span>Empresas y Pymes</span>
        </a>
        <a href="/comunidades-de-propietarios" class="segmento-item" aria-selected="false">
          <span>Comunidades</span>
        </a>
        <a href="/particulares" class="segmento-item" aria-selected="false">
          <span>Particulares</span>
        </a>
      </div>

      <!-- Mensaje de confianza central (desktop) -->
      <div class="top-trust-msg">
        <span class="trust-check">✓</span>
        <span>Auditoría de factura sin coste · Sin permanencia ni cortes de suministro</span>
      </div>

      <!-- Enlaces de soporte y horario -->
      <div class="top-utilidades">
        <span class="top-horario">L-V 9:00 – 18:30</span>
        <span class="top-sep">|</span>
        <a href="/contacto" class="top-link">Contacto</a>
        <span class="top-sep">|</span>
        <a href="/atencion-al-cliente" class="top-link">Atención al cliente</a>
      </div>
    </div>
  </div>

  <!-- 2. BARRA PRINCIPAL (Main Edge-to-Edge Bar) -->
  <div class="barra-principal">
    <div class="contenedor-cabecera barra-principal-fila">
      <!-- Marca y especialidad -->
      <div class="marca-bloque">
        <Logo variant="dark" />
        <span class="marca-tag">Empresas</span>
      </div>

      <!-- Navegación central -->
      <nav class="nav-principal" data-nav-principal aria-label="Menú principal">
        <a href="/" class:list={["nav-enlace", { activo: current === "/" }]}>
          Inicio
        </a>

        <a href="/metodo" class:list={["nav-enlace", { activo: current === "/metodo" }]}>
          El Método
        </a>

        <!-- Menú desplegable Sectores -->
        <div class="nav-dropdown" data-dropdown>
          <button type="button" class="nav-enlace con-chevron" aria-haspopup="true" aria-expanded="false">
            <span>Sectores</span>
            <svg class="chevron-svg" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 4.5 3 3 3-3"></path>
            </svg>
          </button>

          <div class="dropdown-popover">
            <div class="dropdown-header-tag">Auditorías especializadas por sector</div>
            <div class="dropdown-cards-grid">
              {
                sectoresItems.map((s) => (
                  <a href={s.href} class="dropdown-card">
                    <strong class="card-nombre">{s.label}</strong>
                    <span class="card-desc">{s.desc}</span>
                  </a>
                ))
              }
            </div>
            <div class="dropdown-footer-link">
              <a href="/sectores">Ver todos los sectores empresariales →</a>
            </div>
          </div>
        </div>

        <!-- Menú desplegable Tarifas -->
        <div class="nav-dropdown" data-dropdown>
          <button type="button" class="nav-enlace con-chevron" aria-haspopup="true" aria-expanded="false">
            <span>Tarifas</span>
            <svg class="chevron-svg" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 4.5 3 3 3-3"></path>
            </svg>
          </button>

          <div class="dropdown-popover popover-tarifas">
            <div class="dropdown-header-tag">Modalidades y suministros</div>
            <div class="dropdown-cards-grid grid-vertical">
              {
                tarifasItems.map((t) => (
                  <a href={t.href} class="dropdown-card">
                    <strong class="card-nombre">{t.label}</strong>
                    <span class="card-desc">{t.desc}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <a href="/guias" class:list={["nav-enlace", { activo: current.startsWith("/guias") }]}>
          Guías
        </a>
      </nav>

      <!-- MOTOR DE CONVERSIÓN COMERCIAL (Derecha) -->
      <div class="motor-conversion">
        <!-- 1. Teléfono directo con estado de llamada -->
        <a href={site.phoneHref} class="caja-telefono" title={`Llamar gratis al ${site.phone}`}>
          <div class="tel-icono-circulo" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span class="tel-pulso-dot"></span>
          </div>
          <div class="tel-datos">
            <span class="tel-sub">Llama gratis a un asesor</span>
            <strong class="tel-cifra">{site.phone}</strong>
          </div>
        </a>

        <!-- 2. Botón "Te llamamos gratis" con Popover de captura rápida -->
        <div class="te-llamamos-wrapper" data-te-llamamos>
          <button type="button" class="btn-te-llamamos" data-btn-popover aria-expanded="false">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15.05 5A5 5 0 0 1 19 8.95M15.05 1A9 9 0 0 1 23 8.94m-1 7.98v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>Te llamamos gratis</span>
          </button>

          <!-- Popover interactivo rápido -->
          <div class="popover-llamada" data-popover-panel hidden>
            <div class="popover-cabeza">
              <strong>¿A qué número te llamamos?</strong>
              <p>Te llamará un consultor de EMAX con tu informe.</p>
            </div>
            <form class="popover-form" data-form-llamada>
              <div class="popover-input-fila">
                <input
                  type="tel"
                  name="telefono_llamame"
                  class="popover-input"
                  placeholder="Ej. 600 000 000"
                  required
                  aria-label="Tu número de teléfono"
                />
                <button type="submit" class="popover-submit">
                  Llamadme
                </button>
              </div>
              <span class="popover-privacidad">Sin coste ni compromiso. Respetamos tu privacidad.</span>
              <div class="popover-exito" data-popover-exito hidden>
                ✓ ¡Recibido! Te llamaremos en breve.
              </div>
            </form>
          </div>
        </div>

        <!-- 3. Botón Principal de Venta: Analizar mi factura -->
        <a href="/#estudio" class="btn-cta-comercial">
          <span>Analizar mi factura</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <!-- Botón menú hamburguesa (móvil) -->
        <button type="button" class="btn-hamburguesa-movil" data-toggle-movil aria-label="Abrir menú" aria-expanded="false">
          <span class="hamb-linea"></span>
          <span class="hamb-linea"></span>
          <span class="hamb-linea"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- 3. MENÚ MÓVIL DESPLEGABLE -->
  <div class="menu-movil-drawer" data-menu-movil hidden>
    <div class="movil-contenedor">
      <div class="movil-llamada-directa">
        <span class="movil-llamada-tit">Atención directa para empresas:</span>
        <a href={site.phoneHref} class="movil-tel-boton">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>Llamar al {site.phone}</span>
        </a>
      </div>

      <nav class="movil-links-lista" aria-label="Navegación móvil">
        <a href="/" class="movil-link">Inicio</a>
        <a href="/metodo" class="movil-link">El Método</a>

        <div class="movil-grupo-titulo">Sectores empresariales</div>
        {
          sectoresItems.map((s) => (
            <a href={s.href} class="movil-sublink">{s.label}</a>
          ))
        }

        <div class="movil-grupo-titulo">Tarifas</div>
        {
          tarifasItems.map((t) => (
            <a href={t.href} class="movil-sublink">{t.label}</a>
          ))
        }

        <div class="movil-grupo-titulo">Otros</div>
        <a href="/guias" class="movil-link">Guías energéticas</a>
        <a href="/contacto" class="movil-link">Contacto y oficinas</a>
      </nav>

      <div class="movil-cta-bottom">
        <a href="/#estudio" class="btn-cta-comercial ancho-total">
          Analizar mi factura ahora
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Control de Dropdowns en Desktop
  const dropdownWrappers = document.querySelectorAll("[data-dropdown]");
  dropdownWrappers.forEach((dd) => {
    const btn = dd.querySelector("button");
    btn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isActive = dd.classList.contains("abierto");
      dropdownWrappers.forEach((d) => d.classList.remove("abierto"));
      if (!isActive) dd.classList.add("abierto");
    });
  });

  // Control de Popover "Te llamamos gratis"
  const popoverWrapper = document.querySelector("[data-te-llamamos]");
  const popoverBtn = document.querySelector("[data-btn-popover]");
  const popoverPanel = document.querySelector("[data-popover-panel]");
  const popoverForm = document.querySelector("[data-form-llamada]");
  const popoverExito = document.querySelector("[data-popover-exito]");

  popoverBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isHidden = popoverPanel?.hasAttribute("hidden");
    if (isHidden) {
      popoverPanel?.removeAttribute("hidden");
      popoverBtn?.setAttribute("aria-expanded", "true");
    } else {
      popoverPanel?.setAttribute("hidden", "true");
      popoverBtn?.setAttribute("aria-expanded", "false");
    }
  });

  popoverForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (popoverExito) {
      popoverExito.removeAttribute("hidden");
      setTimeout(() => {
        popoverPanel?.setAttribute("hidden", "true");
        popoverBtn?.setAttribute("aria-expanded", "false");
      }, 3000);
    }
  });

  // Cerrar al hacer clic fuera
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest("[data-dropdown]")) {
      dropdownWrappers.forEach((d) => d.classList.remove("abierto"));
    }
    if (!target.closest("[data-te-llamamos]")) {
      popoverPanel?.setAttribute("hidden", "true");
      popoverBtn?.setAttribute("aria-expanded", "false");
    }
  });

  // Control de Menú Móvil
  const toggleMovilBtn = document.querySelector("[data-toggle-movil]");
  const drawerMovil = document.querySelector("[data-menu-movil]");

  toggleMovilBtn?.addEventListener("click", () => {
    const isHidden = drawerMovil?.hasAttribute("hidden");
    if (isHidden) {
      drawerMovil?.removeAttribute("hidden");
      toggleMovilBtn?.setAttribute("aria-expanded", "true");
      toggleMovilBtn?.classList.add("activo");
      document.body.style.overflow = "hidden";
    } else {
      drawerMovil?.setAttribute("hidden", "true");
      toggleMovilBtn?.setAttribute("aria-expanded", "false");
      toggleMovilBtn?.classList.remove("activo");
      document.body.style.overflow = "";
    }
  });

  // Cerrar cajón móvil si se hace clic en enlaces
  drawerMovil?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      drawerMovil?.setAttribute("hidden", "true");
      toggleMovilBtn?.setAttribute("aria-expanded", "false");
      toggleMovilBtn?.classList.remove("activo");
      document.body.style.overflow = "";
    });
  });
</script>

<style>
  /* ========================================================
     ESTRUCTURA GENERAL CABECERA
     ======================================================== */
  .cabecera-comercial-root {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 100;
    background: #ffffff;
    box-shadow: 0 4px 20px rgba(15, 35, 70, 0.06);
  }

  .contenedor-cabecera {
    width: min(1360px, calc(100% - 40px));
    margin-inline: auto;
  }

  /* ========================================================
     1. TOP UTILITY BAR (Franja Superior)
     ======================================================== */
  .top-bar {
    background: #0f2346;
    color: #e2eaf5;
    font-size: 0.8125rem;
    height: 38px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .top-bar-contenido {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .selector-segmentos {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 100%;
  }

  .segmento-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
    height: 28px;
    border-radius: var(--radio-pill, 999px);
    color: #a4b7d1;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .segmento-item:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .segmento-item.activo {
    background: #004aad;
    color: #ffffff;
    font-weight: 600;
  }

  .punto-segmento {
    font-size: 0.65rem;
    color: #38b6ff;
  }

  .top-trust-msg {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #cbdcf2;
    font-weight: 500;
  }

  .trust-check {
    color: #12b76a;
    font-weight: 800;
  }

  .top-utilidades {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #8da1bf;
  }

  .top-horario {
    color: #a4b7d1;
  }

  .top-sep {
    opacity: 0.3;
  }

  .top-link {
    color: #cbdcf2;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .top-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* ========================================================
     2. BARRA PRINCIPAL (Main Bar)
     ======================================================== */
  .barra-principal {
    height: 74px;
    background: #ffffff;
    border-bottom: 1.5px solid #e5edf7;
  }

  .barra-principal-fila {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .marca-bloque {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .marca-tag {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #edf4fe;
    color: #004aad;
    padding: 3px 8px;
    border-radius: var(--radio-pill, 999px);
    border: 1px solid #d4e4fa;
  }

  /* Navegación central */
  .nav-principal {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-enlace {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: var(--radio-sm, 8px);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--tinta, #0f2346);
    background: transparent;
    border: 0;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .nav-enlace:hover,
  .nav-dropdown:hover .nav-enlace,
  .nav-dropdown.abierto .nav-enlace {
    background: #f4f8fd;
    color: #004aad;
  }

  .nav-enlace.activo {
    color: #004aad;
    background: #edf4fe;
  }

  .chevron-svg {
    transition: transform 0.2s ease;
  }

  .nav-dropdown:hover .chevron-svg,
  .nav-dropdown.abierto .chevron-svg {
    transform: rotate(180deg);
  }

  /* Dropdown Megamenú */
  .nav-dropdown {
    position: relative;
  }

  .dropdown-popover {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: #ffffff;
    border: 1px solid #d8e4f5;
    border-radius: var(--radio-tarjeta, 20px);
    box-shadow: 0 18px 48px rgba(15, 35, 70, 0.13);
    min-width: 360px;
    padding: 16px;
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s ease;
  }

  .popover-tarifas {
    min-width: 330px;
  }

  .nav-dropdown:hover .dropdown-popover,
  .nav-dropdown.abierto .dropdown-popover {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-header-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #63738e;
    margin-bottom: 10px;
    padding-left: 6px;
  }

  .dropdown-cards-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dropdown-card {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border-radius: var(--radio-sm, 8px);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .dropdown-card:hover {
    background: #edf4fe;
  }

  .card-nombre {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--tinta, #0f2346);
  }

  .card-desc {
    font-size: 0.78rem;
    color: #556784;
  }

  .dropdown-footer-link {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid #e5edf7;
  }

  .dropdown-footer-link a {
    font-size: 0.82rem;
    font-weight: 700;
    color: #004aad;
    text-decoration: none;
    display: block;
    padding: 4px 6px;
  }

  .dropdown-footer-link a:hover {
    text-decoration: underline;
  }

  /* ========================================================
     MOTOR DE CONVERSIÓN COMERCIAL (Derecha)
     ======================================================== */
  .motor-conversion {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
  }

  /* Caja Teléfono Directo */
  .caja-telefono {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: var(--radio-pill, 999px);
    background: #f7faff;
    border: 1.5px solid #d9e6f8;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .caja-telefono:hover {
    border-color: #004aad;
    background: #edf4fe;
  }

  .tel-icono-circulo {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #004aad;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tel-pulso-dot {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #12b76a;
    border: 2px solid #ffffff;
    animation: pulsoVerde 2s infinite;
  }

  @keyframes pulsoVerde {
    0% { box-shadow: 0 0 0 0 rgba(18, 183, 106, 0.5); }
    70% { box-shadow: 0 0 0 6px rgba(18, 183, 106, 0); }
    100% { box-shadow: 0 0 0 0 rgba(18, 183, 106, 0); }
  }

  .tel-datos {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

