---
// Cabecera Dinámica en Cápsula Flotante (Globo Glassmorphism)
// Combina:
// 1. Estructura de cápsula / globo flotante suspendida (border-radius: 999px, blur de cristal).
// 2. Glider magnético dinámico en los enlaces (la píldora persigue el cursor en tiempo real).
// 3. Shimmer continuo de luz en el botón comercial "Analizar mi factura".
// 4. Radar sonar continuo y vibración en el teléfono de atención a empresas.
// 5. Barra de lectura y progreso de scroll integrada en la base de la cápsula.
// 6. Popover desplegable interactivo "Te llamamos gratis".
import Logo from "./Logo.astro";
import { site, primaryCta } from "../data/site";

const current = Astro.url.pathname;

const sectoresItems = [
  { href: "/sectores/restaurantes", label: "Restaurantes y hostelería", desc: "Turnos partidos en horas punta caras", icono: "🍽️" },
  { href: "/sectores/hoteles", label: "Hoteles y alojamientos", desc: "Estacionalidad y potencia ociosa en invierno", icono: "🏨" },
  { href: "/sectores/supermercados", label: "Supermercados y tiendas", desc: "Consumo continuo de cámaras frigoríficas", icono: "🛒" },
  { href: "/sectores/logistica-frio", label: "Logística y frío industrial", desc: "Ajuste de peajes en ciclos 24/7", icono: "❄️" },
  { href: "/sectores/industria", label: "Industria y fabricación", desc: "Arranque de motores y energía reactiva", icono: "⚡" },
];

const tarifasItems = [
  { href: "/tarifas", label: "Luz para Empresas", desc: "Peajes 2.0TD, 3.0TD y 6.XTD optimizados", badge: "Más contratada" },
  { href: "/gas-natural", label: "Gas para Empresas", desc: "Suministro RL para negocios e industria", badge: "Ahorro RL" },
  { href: "/varios-suministros", label: "Múltiples Suministros", desc: "Unificación de facturación multisede", badge: "Multisede" },
];
---

<header class="cabecera-flotante-root" id="cabecera-flotante">
  <div class="contenedor-capsula">
    <!-- CÁPSULA / GLOBO SUSPENDIDO -->
    <div class="capsula-globo" id="capsula-globo">
      <!-- Marca / Logo -->
      <div class="capsula-logo">
        <Logo variant="dark" />
      </div>

      <!-- Navegación central con Píldora Magnética Deslizante (Glider) -->
      <nav class="nav-capsula" id="nav-capsula-menu" aria-label="Menú principal">
        <!-- Indicador magnético flotante que persigue el cursor -->
        <span class="nav-glider" id="nav-glider" aria-hidden="true"></span>

        <a href="/" class:list={["nav-enlace", { activo: current === "/" }]} data-glider-target>
          <span>Inicio</span>
        </a>

        <a href="/metodo" class:list={["nav-enlace", { activo: current === "/metodo" }]} data-glider-target>
          <span>El Método</span>
        </a>

        <!-- Menú desplegable dinámico Sectores -->
        <div class="nav-dropdown" data-dropdown>
          <button type="button" class="nav-enlace con-chevron" data-glider-target aria-haspopup="true" aria-expanded="false">
            <span>Sectores</span>
            <svg class="chevron-svg" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 4.5 3 3 3-3"></path>
            </svg>
          </button>

          <div class="dropdown-popover popover-animado">
            <div class="dropdown-header-tag">Auditorías especializadas por sector</div>
            <div class="dropdown-cards-grid">
              {
                sectoresItems.map((s) => (
                  <a href={s.href} class="dropdown-card">
                    <span class="card-emoji" aria-hidden="true">{s.icono}</span>
                    <div class="card-textos">
                      <strong class="card-nombre">{s.label}</strong>
                      <span class="card-desc">{s.desc}</span>
                    </div>
                    <span class="card-flecha" aria-hidden="true">→</span>
                  </a>
                ))
              }
            </div>
            <div class="dropdown-footer-link">
              <a href="/sectores">Ver todos los sectores empresariales <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>

        <!-- Menú desplegable dinámico Tarifas -->
        <div class="nav-dropdown" data-dropdown>
          <button type="button" class="nav-enlace con-chevron" data-glider-target aria-haspopup="true" aria-expanded="false">
            <span>Tarifas</span>
            <svg class="chevron-svg" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 4.5 3 3 3-3"></path>
            </svg>
          </button>

          <div class="dropdown-popover popover-tarifas popover-animado">
            <div class="dropdown-header-tag">Modalidades y suministros</div>
            <div class="dropdown-cards-grid">
              {
                tarifasItems.map((t) => (
                  <a href={t.href} class="dropdown-card">
                    <div class="card-textos">
                      <div class="card-head-fila">
                        <strong class="card-nombre">{t.label}</strong>
                        <span class="card-badge-mini">{t.badge}</span>
                      </div>
                      <span class="card-desc">{t.desc}</span>
                    </div>
                    <span class="card-flecha" aria-hidden="true">→</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <a href="/guias" class:list={["nav-enlace", { activo: current.startsWith("/guias") }]} data-glider-target>
          <span>Guías</span>
        </a>
      </nav>

      <!-- MOTOR DE CONVERSIÓN CON ANIMACIONES VIVAS -->
      <div class="capsula-acciones">
        <!-- 1. Teléfono con Radar Sonar y vibración de llamada -->
        <a href={site.phoneHref} class="caja-telefono-sonar" title={`Llamar gratis al ${site.phone}`}>
          <div class="tel-sonar-wrap" aria-hidden="true">
            <span class="sonar-onda onda-1"></span>
            <span class="sonar-onda onda-2"></span>
            <div class="tel-icono-circulo">
              <svg class="icono-auricular" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
          </div>
          <div class="tel-textos">
            <span class="tel-sub">Llama gratis</span>
            <strong class="tel-cifra">{site.phone}</strong>
          </div>
        </a>

        <!-- 2. Botón "Te llamamos" con Popover elástico -->
        <div class="te-llamamos-wrapper" data-te-llamamos>
          <button type="button" class="btn-te-llamamos-capsula" data-btn-popover aria-expanded="false">
            <svg class="icono-llamada-entrante" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15.05 5A5 5 0 0 1 19 8.95M15.05 1A9 9 0 0 1 23 8.94m-1 7.98v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>Te llamamos</span>
          </button>

          <!-- Popover interactivo -->
          <div class="popover-llamada" data-popover-panel hidden>
            <div class="popover-cabeza">
              <strong>¿A qué número te llamamos?</strong>
              <p>Un consultor de EMAX te llamará con tu informe.</p>
            </div>
            <form class="popover-form" data-form-llamada>
              <div class="popover-input-fila">
                <input
                  type="tel"
                  name="telefono_llamame"
                  class="popover-input"
                  placeholder="Ej. 600 000 000"
                  required
                  aria-label="Tu número de teléfono"
                />
                <button type="submit" class="popover-submit">
                  Llamadme
                </button>
              </div>
              <span class="popover-privacidad">Sin compromiso. Respetamos tu privacidad.</span>
              <div class="popover-exito" data-popover-exito hidden>
                ✓ ¡Recibido! Te llamaremos en breve.
              </div>
            </form>
          </div>
        </div>

        <!-- 3. Botón Principal con Destello Dinámico (Shimmer Continuo) -->
        <a href="/#estudio" class="btn-cta-shimmer">
          <span class="shimmer-luz" aria-hidden="true"></span>
          <span class="btn-cta-txt">Analizar mi factura</span>
          <svg class="btn-cta-flecha" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <!-- Botón menú móvil -->
        <button type="button" class="btn-hamburguesa-capsula" data-toggle-movil aria-label="Abrir menú" aria-expanded="false">
          <span class="hamb-linea linea-1"></span>
          <span class="hamb-linea linea-2"></span>
          <span class="hamb-linea linea-3"></span>
        </button>
      </div>

      <!-- Barra de progreso viva en la base curvada de la cápsula -->
      <div class="capsula-scroll-progreso" id="scroll-progress-line" aria-hidden="true"></div>
    </div>
  </div>

  <!-- MENÚ MÓVIL DESPLEGABLE -->
  <div class="menu-movil-drawer" data-menu-movil hidden>
    <div class="movil-contenedor">
      <div class="movil-llamada-directa">
        <span class="movil-llamada-tit">Atención directa para empresas:</span>
        <a href={site.phoneHref} class="movil-tel-boton">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>Llamar al {site.phone}</span>
        </a>
      </div>

      <nav class="movil-links-lista" aria-label="Navegación móvil">
        <a href="/" class="movil-link">Inicio</a>
        <a href="/metodo" class="movil-link">El Método</a>

        <div class="movil-grupo-titulo">Sectores empresariales</div>
        {
          sectoresItems.map((s) => (
            <a href={s.href} class="movil-sublink">{s.label}</a>
          ))
        }

        <div class="movil-grupo-titulo">Tarifas</div>
        {
          tarifasItems.map((t) => (
            <a href={t.href} class="movil-sublink">{t.label}</a>
          ))
        }

        <div class="movil-grupo-titulo">Otros</div>
        <a href="/guias" class="movil-link">Guías energéticas</a>
        <a href="/contacto" class="movil-link">Contacto y oficinas</a>
      </nav>

      <div class="movil-cta-bottom">
        <a href="/#estudio" class="btn-cta-shimmer ancho-total">
          <span class="btn-cta-txt">Analizar mi factura ahora</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // 1. Barra de progreso dinámica al hacer Scroll y efecto de elevación
  const progressBar = document.getElementById("scroll-progress-line");
  const capsula = document.getElementById("capsula-globo");

  function actualizarScroll() {
    const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
    const scrollActual = window.scrollY;
    
    // Progreso porcentual
    if (progressBar && scrollTotal > 0) {
      const porcentaje = Math.min(100, Math.max(0, (scrollActual / scrollTotal) * 100));
      progressBar.style.width = `${porcentaje}%`;
    }

    // Efecto flotante dinámico
    if (scrollActual > 30) {
      capsula?.classList.add("es-elevada");
    } else {
      capsula?.classList.remove("es-elevada");
    }
  }

  window.addEventListener("scroll", actualizarScroll, { passive: true });
  actualizarScroll();

  // 2. Glider Magnético en los enlaces de navegación (Píldora deslizante)
  const navContainer = document.getElementById("nav-capsula-menu");
  const glider = document.getElementById("nav-glider");
  const navLinks = navContainer?.querySelectorAll("[data-glider-target]");
  const enlaceActivo = navContainer?.querySelector(".nav-enlace.activo");

  function moverGlider(elemento: HTMLElement) {
    if (!glider || !navContainer) return;
    const contenedorRect = navContainer.getBoundingClientRect();
    const elemRect = elemento.getBoundingClientRect();
    const leftOffset = elemRect.left - contenedorRect.left;
    
    glider.style.width = `${elemRect.width}px`;
    glider.style.transform = `translateX(${leftOffset}px)`;
    glider.style.opacity = "1";
  }

  function reiniciarGlider() {
    if (enlaceActivo) {
      moverGlider(enlaceActivo as HTMLElement);
    } else if (glider) {
      glider.style.opacity = "0";
    }
  }

  navLinks?.forEach((link) => {
    link.addEventListener("mouseenter", () => {
      moverGlider(link as HTMLElement);
    });
  });

  navContainer?.addEventListener("mouseleave", reiniciarGlider);
  setTimeout(reiniciarGlider, 150);

  // 3. Control de Dropdowns en Desktop (Hover con tolerancia + Click)
  const dropdownWrappers = document.querySelectorAll("[data-dropdown]");
  dropdownWrappers.forEach((dd) => {
    const btn = dd.querySelector("button");
    let timerCierre: any;

    dd.addEventListener("mouseenter", () => {
      clearTimeout(timerCierre);
      dropdownWrappers.forEach((d) => {
        if (d !== dd) d.classList.remove("abierto");
      });
      dd.classList.add("abierto");
    });

    dd.addEventListener("mouseleave", () => {
      timerCierre = setTimeout(() => {
        dd.classList.remove("abierto");
      }, 200); // 200ms de tolerancia para que nunca se cierre al mover el ratón a las opciones
    });

    btn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isActive = dd.classList.contains("abierto");
      dropdownWrappers.forEach((d) => d.classList.remove("abierto"));
      if (!isActive) dd.classList.add("abierto");
    });
  });

  // 4. Control de Popover "Te llamamos gratis"
  const popoverBtn = document.querySelector("[data-btn-popover]");
  const popoverPanel = document.querySelector("[data-popover-panel]");
  const popoverForm = document.querySelector("[data-form-llamada]");
  const popoverExito = document.querySelector("[data-popover-exito]");

  popoverBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isHidden = popoverPanel?.hasAttribute("hidden");
    if (isHidden) {
      popoverPanel?.removeAttribute("hidden");
      popoverBtn?.setAttribute("aria-expanded", "true");
    } else {
      popoverPanel?.setAttribute("hidden", "true");
      popoverBtn?.setAttribute("aria-expanded", "false");
    }
  });

  popoverForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (popoverExito) {
      popoverExito.removeAttribute("hidden");
      setTimeout(() => {
        popoverPanel?.setAttribute("hidden", "true");
        popoverBtn?.setAttribute("aria-expanded", "false");
      }, 3000);
    }
  });

  // Cerrar al hacer clic fuera
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest("[data-dropdown]")) {
      dropdownWrappers.forEach((d) => d.classList.remove("abierto"));
    }
    if (!target.closest("[data-te-llamamos]")) {
      popoverPanel?.setAttribute("hidden", "true");
      popoverBtn?.setAttribute("aria-expanded", "false");
    }
  });

  // 5. Control de Menú Móvil
  const toggleMovilBtn = document.querySelector("[data-toggle-movil]");
  const drawerMovil = document.querySelector("[data-menu-movil]");

  toggleMovilBtn?.addEventListener("click", () => {
    const isHidden = drawerMovil?.hasAttribute("hidden");
    if (isHidden) {
      drawerMovil?.removeAttribute("hidden");
      toggleMovilBtn?.setAttribute("aria-expanded", "true");
      toggleMovilBtn?.classList.add("activo");
      document.body.style.overflow = "hidden";
    } else {
      drawerMovil?.setAttribute("hidden", "true");
      toggleMovilBtn?.setAttribute("aria-expanded", "false");
      toggleMovilBtn?.classList.remove("activo");
      document.body.style.overflow = "";
    }
  });

  drawerMovil?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      drawerMovil?.setAttribute("hidden", "true");
      toggleMovilBtn?.setAttribute("aria-expanded", "false");
      toggleMovilBtn?.classList.remove("activo");
      document.body.style.overflow = "";
    });
  });
</script>

<style>
  /* ========================================================
     ESTRUCTURA DE CÁPSULA / GLOBO FLOTANTE
     ======================================================== */
  .cabecera-flotante-root {
    position: sticky;
    top: 14px;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 100;
    pointer-events: none;
    transition: transform 0.25s ease;
  }

  .contenedor-capsula {
    width: min(1280px, calc(100% - 28px));
    margin-inline: auto;
  }

  /* El Globo / Cápsula suspendida */
  .capsula-globo {
    position: relative;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 66px;
    padding: 0 10px 0 20px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1.5px solid rgba(225, 237, 250, 0.9);
    border-radius: var(--radio-pill, 999px);
    box-shadow: 0 12px 36px rgba(15, 35, 70, 0.08), 0 2px 6px rgba(15, 35, 70, 0.03);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Estado Elevado al hacer scroll */
  .capsula-globo.es-elevada {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(0, 74, 173, 0.18);
    box-shadow: 0 18px 48px rgba(0, 74, 173, 0.13), 0 4px 12px rgba(15, 35, 70, 0.06);
    transform: translateY(-2px);
  }

  /* Marca / Logo */
  .capsula-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .capsula-logo:hover {
    transform: scale(1.02);
  }


  /* ========================================================
     NAVEGACIÓN CENTRAL CON GLIDER MAGNÉTICO
     ======================================================== */
  .nav-capsula {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    background: #f4f8fd;
    border-radius: var(--radio-pill, 999px);
    border: 1px solid #e1ecfa;
  }

  /* Glider magnético */
  .nav-glider {
    position: absolute;
    top: 3px;
    left: 0;
    height: calc(100% - 6px);
    background: #ffffff;
    border-radius: var(--radio-pill, 999px);
    box-shadow: 0 3px 10px rgba(15, 35, 70, 0.09), 0 1px 3px rgba(15, 35, 70, 0.04);
    pointer-events: none;
    transition: transform 0.24s cubic-bezier(0.2, 0.8, 0.2, 1), width 0.24s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s ease;
    opacity: 0;
    z-index: 1;
  }

  .nav-enlace {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 15px;
    border-radius: var(--radio-pill, 999px);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--tinta, #0f2346);
    background: transparent;
    border: 0;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.18s ease;
    white-space: nowrap;
  }

  .nav-enlace:hover {
    color: #004aad;
  }

  .nav-enlace.activo {
    color: #004aad;
  }

  .chevron-svg {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-dropdown:hover .chevron-svg,
  .nav-dropdown.abierto .chevron-svg {
    transform: rotate(180deg);
  }

  /* Dropdown Megamenú */
  .nav-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  /* Puente invisible hacia abajo para mantener el hover */
  .nav-dropdown::after {
    content: "";
    position: absolute;
    top: 100%;
    left: -20px;
    right: -20px;
    height: 25px;
    background: transparent;
    pointer-events: auto;
  }

  .popover-animado {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(6px) scale(0.98);
    background: #ffffff;
    border: 1.5px solid #d4e2f5;
    border-radius: var(--radio-tarjeta, 20px);
    box-shadow: 0 20px 50px rgba(15, 35, 70, 0.18), 0 4px 12px rgba(15, 35, 70, 0.05);
    min-width: 360px;
    padding: 16px;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    z-index: 9999;
    transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
  }

  /* Puente superior en el propio popover para unirlo con la cápsula */
  .popover-animado::before {
    content: "";
    position: absolute;
    top: -20px;
    left: 0;
    right: 0;
    height: 20px;
    background: transparent;
  }

  .popover-tarifas {
    min-width: 330px;
  }

  .nav-dropdown:hover .popover-animado,
  .nav-dropdown:focus-within .popover-animado,
  .nav-dropdown.abierto .popover-animado {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .dropdown-header-tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #63738e;
    margin-bottom: 10px;
    padding-left: 6px;
  }

  .dropdown-cards-grid {
    display: flex;
    flex-direction: column;
