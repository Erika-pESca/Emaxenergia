---
// Logo de src/imagenes/logo-principal.png.
// "dark" en la cabecera. "light" en el pie: el filtro lo deja blanco.
import { Picture } from "astro:assets";
import logo from "../imagenes/logo-principal.png";

interface Props {
  variant?: "dark" | "light";
}

const { variant = "dark" } = Astro.props;
const height = 48;
const width = Math.round((height * logo.width) / logo.height);
---

<a class:list={["logo", variant]} href="/" aria-label="EMAX Energía, ir al inicio">
  <Picture
    src={logo}
    alt=""
    width={width}
    height={height}
    densities={[1, 2]}
    formats={['avif', 'webp']}
    fallbackFormat="png"
    loading="eager"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* Aquí <picture> sí genera caja (inline): con display: contents el baseline del enlace cambia y el pie crece 7 px menos */
  .logo :global(picture) {
    display: inline;
  }

  .logo img {
    height: 48px;
    width: auto;
  }

  .logo.light img {
    filter: brightness(0) invert(1);
  }
</style>
