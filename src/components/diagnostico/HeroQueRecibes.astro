---
// Componente HeroQueRecibes de la sección "Qué recibes" (Diagnóstico)
// Diseño exacto del boceto con la imagen de fondo oficial Hero (1).png
// Degradado corporativo oficial #004aad y tarjeta de cristal esmerilado idéntica al método
import heroDiagnosticoImg from "../../imagenes/diagnostico/Hero (1).png";

interface TramoGasto {
  id: string;
  etiqueta: string;
  rango: string;
  msg: string;
}

const tramosGasto: TramoGasto[] = [
  {
    id: "menos-300",
    etiqueta: "MENOS DE 300€",
    rango: "menos de 300 € al mes",
    msg: "Construimos una propuesta técnica con el término de potencia ajustado al milímetro para que no pagues de más.",
  },
  {
    id: "300-1000",
    etiqueta: "300 - 1.000€",
    rango: "entre 3.600 y 12.000 € al año en luz",
    msg: "Analizamos tu curva horaria y optimizamos tus potencias para maximizar tu ahorro mensual.",
  },
  {
    id: "1000-3000",
    etiqueta: "1.000 - 3.000€",
    rango: "entre 12.000 y 36.000 € al año",
    msg: "Auditoría exhaustiva de cuartohorarias, penalizaciones de reactiva y oportunidad en mercado indexado vs fijo.",
  },
  {
    id: "mas-3000",
    etiqueta: "Más de 3.000€",
    rango: "más de 36.000 € al año en energía",
    msg: "Un consultor senior de EMAX revisa tus peajes, maxímetros y coberturas OMIE de forma personalizada.",
  },
];
---

<section class="hero-qr-seccion" aria-labelledby="h1-que-recibes">
  <!-- Fondo fotográfico con degradado corporativo oficial -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src={heroDiagnosticoImg.src}
      alt=""
      class="hero-bg-img"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="hero-bg-overlay"></div>
  </div>

  <div class="hero-qr-contenedor">
    <!-- Columna Izquierda: Mensaje principal y propuesta de valor -->
    <div class="hero-qr-col-izq">
      <p class="hero-qr-kicker">
        TARIFAS DE LUZ PARA EMPRESAS <span class="kicker-sep" aria-hidden="true">|</span>
      </p>

      <h1 class="hero-qr-titulo" id="h1-que-recibes">
        TU TARIFA DE LUZ NO<br />
        ESTÁ EN UNA <span class="titulo-cursiva">lista de</span><br />
        <span class="titulo-cursiva">precios.</span>
      </h1>

      <p class="hero-qr-desc">
        Lo que hemos visto en tu suministro y la tarifa que sale de ahí, explicado por una persona. El informe es tuyo, decidas lo que decidas.
      </p>
    </div>

    <!-- Columna Derecha: Tarjeta de cristal interactiva con los 4 tramos de gasto -->
    <div class="hero-qr-col-der">
      <div class="hero-qr-card-cristal">
        <h2 class="qr-card-titulo">¿Cuánto paga tu empresa de luz al mes?</h2>
        <p class="qr-card-subtitulo">
          En total, sumando todos tus suministros. Con una cifra aproximada nos basta.
        </p>

        <!-- Rejilla 2x2 de botones de gasto con círculo cian y chevron -->
        <div class="qr-tramos-grid">
          {
            tramosGasto.map((t) => (
              <button
                type="button"
                class="btn-tramo-qr"
                data-abrir-funnel
                data-tramo-id={t.id}
                data-tramo-label={`Estudio para empresa: ${t.etiqueta}`}
                data-tramo-rango={t.rango}
                data-tramo-msg={t.msg}
              >
                <span class="btn-txt">{t.etiqueta}</span>
                <span class="btn-circulo" aria-hidden="true">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     HERO QUÉ RECIBES / DIAGNÓSTICO - FONDO Hero (1).png Y DISEÑO OFICIAL
     ========================================================================== */
  .hero-qr-seccion {
    position: relative;
    z-index: 20;
    margin-top: -78px;
    min-height: calc(84vh + 78px);
    display: flex;
    align-items: center;
    padding: calc(78px + 48px) 0 72px;
    background-color: #004aad;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 85% center;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #004aad 0%,
      #004aad 28%,
      rgba(0, 74, 173, 0.88) 42%,
      rgba(0, 74, 173, 0.42) 55%,
      rgba(235, 244, 255, 0.28) 70%,
      rgba(235, 244, 255, 0.42) 100%
    );
    pointer-events: none;
  }

  @media (max-width: 1024px) {
    .hero-bg-overlay {
      background: linear-gradient(
        180deg,
        rgba(0, 74, 173, 0.96) 0%,
        rgba(0, 74, 173, 0.88) 55%,
        rgba(0, 74, 173, 0.75) 100%
      );
    }
  }

  .hero-qr-contenedor {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 52px);
    display: grid;
    grid-template-columns: minmax(0, 1.24fr) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 60px);
    align-items: center;
  }

  @media (max-width: 1024px) {
    .hero-qr-contenedor {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* ==========================================================================
     COLUMNA IZQUIERDA
     ========================================================================== */
  .hero-qr-col-izq {
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hero-qr-kicker {
    font-family: "Poppins", "Sora", sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .kicker-sep {
    color: #00d4ff;
    font-weight: 400;
    font-size: 1.15em;
  }

  .hero-qr-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.7rem + 1.8vw, 3.2rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .titulo-cursiva {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: #38bdf8;
    letter-spacing: -0.01em;
    display: inline;
  }

  .hero-qr-desc {
    font-size: clamp(1.02rem, 1.15vw, 1.15rem);
    line-height: 1.6;
    color: rgba(240, 248, 255, 0.95);
    font-weight: 400;
    margin: 4px 0 0;
    max-width: 560px;
  }

  /* ==========================================================================
     COLUMNA DERECHA: TARJETA DE CRISTAL INTERACTIVA
     ========================================================================== */
  .hero-qr-col-der {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 1024px) {
    .hero-qr-col-der {
      justify-content: flex-start;
    }
  }

  .hero-qr-card-cristal {
    width: 100%;
    max-width: 530px;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.62) 0%,
      rgba(235, 244, 255, 0.5) 100%
    );
    border: 1.5px solid rgba(255, 255, 255, 0.75);
    border-radius: 28px;
    padding: clamp(28px, 3.4vw, 38px);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 24px 60px rgba(0, 16, 48, 0.28), inset 0 1px 1px rgba(255, 255, 255, 0.9);
  }

  .qr-card-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(1.24rem, 1.1rem + 0.4vw, 1.48rem);
    font-weight: 700;
    color: #004aad;
    line-height: 1.25;
    margin: 0 0 8px;
    letter-spacing: -0.015em;
  }

  .qr-card-subtitulo {
    font-size: 0.94rem;
    color: #0f172a;
    margin: 0 0 22px;
    line-height: 1.5;
    font-weight: 500;
  }

  /* Rejilla 2x2 */
  .qr-tramos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 13px;
  }

  @media (max-width: 540px) {
    .qr-tramos-grid {
      grid-template-columns: 1fr;
    }
  }

  .btn-tramo-qr {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 15px 17px;
    background: #004aad;
    border: 1.5px solid rgba(0, 74, 173, 0.25);
    border-radius: 12px;
    color: #ffffff;
    font-family: "Sora", sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    text-align: left;
    box-shadow: 0 6px 16px rgba(0, 25, 75, 0.25);
    transition: transform 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
  }

  .btn-tramo-qr:hover {
    background: #005ce6;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(0, 74, 173, 0.4);
  }

  .btn-txt {
    font-family: "Sora", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .btn-circulo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #00d4ff;
    color: #004aad;
    flex-shrink: 0;
    transition: transform 0.18s ease, background-color 0.18s ease, color 0.18s ease;
  }

  .btn-tramo-qr:hover .btn-circulo {
    transform: translateX(3px);
    background: #ffffff;
    color: #004aad;
  }
</style>
