---
// Componente: LoQueHayEnTuInforme.astro
// Ubicación: src/components/metodo/Que recibes/LoQueHayEnTuInforme.astro
// Estilo visual de marca EMAX: Luminous, corporate & interactive
// Mantiene con 100% de fidelidad la estructura y gráficos del prototipo,
// aplicando el diseño premium, tarjetas pulidas, bordes sutiles y micro-interacciones de la web.
---

<section class="sec-informe-root" id="lo-que-hay-en-tu-informe" aria-labelledby="h2-lo-que-hay">
  <div class="informe-par-container">
    <!-- Columna Izquierda: Introducción e Índice de Bloques -->
    <div class="informe-intro-col">
      <p class="informe-kicker">
        ANALIZAMOS TU SUMINISTRO <span class="kicker-sep" aria-hidden="true">|</span>
      </p>

      <h2 class="informe-titulo" id="h2-lo-que-hay">
        LO QUE HAY EN TU<br />
        <span class="titulo-cursiva">informe</span>
      </h2>

      <p class="intro-desc">
        No te ofrecemos una tarifa: te damos una razón para elegirla. Primero, lo que hemos visto en tu suministro. Después, la tarifa que sale de ahí. Cada bloque dice con qué dato está hecho.
      </p>

      <!-- Lista / Índice interactivo con estilo EMAX -->
      <ul class="indice-bloques" role="tablist" aria-label="Bloques del informe" id="ind-bloques">
        <!-- Generado dinámicamente -->
      </ul>

      <!-- Enlaces oficiales según la base v12.16 -->
      <div class="informe-acciones">
        <a href="/metodo#decisiones" class="btn-decisiones-pill">
          <span class="btn-txt-cyan">Las cinco decisiones</span>
          <span class="btn-circulo-cyan" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3.5 10.5 8 6 12.5"></path>
            </svg>
          </span>
        </a>
        <a href="/tarifas" class="enlace-secundario-tarifa">
          Cómo se construye una tarifa
        </a>
      </div>
    </div>

    <!-- Columna Derecha: Hoja de Informe EMAX -->
    <div class="informe-hoja-col">
      <article class="hoja-informe-card" aria-live="polite">
        <header class="hoja-top">
          <div class="hoja-marca-badge">
            <span class="punto-en-vivo" aria-hidden="true"></span>
            <span><b>Informe EMAX</b> · Ejemplo auditado</span>
          </div>
          <div class="hoja-top-derecha">
            <div class="hoja-dots-indicador" id="hoja-dots-indicador" aria-label="Progreso de bloques"></div>
            <span class="hoja-contador-chip" id="hoja-pag-contador">Bloque 1 de 4</span>
          </div>
        </header>

        <div class="hoja-cuerpo" id="hoja-contenido-dinamico">
          <!-- Se inyecta dinámicamente con animación de entrada -->
        </div>

        <footer class="hoja-pie">
          <div class="hoja-pie-autor">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="escudo-svg" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
            <span>Revisado por un especialista de EMAX.</span>
          </div>

          <!-- Controles interactivos de navegación directa entre bloques -->
          <div class="hoja-nav-controles">
            <button type="button" class="btn-hoja-nav" id="btn-hoja-ant" aria-label="Bloque anterior">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 3.5 5.5 8 10 12.5"></path>
              </svg>
              <span>Anterior</span>
            </button>
            <button type="button" class="btn-hoja-nav" id="btn-hoja-sig" aria-label="Siguiente bloque">
              <span>Siguiente</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 3.5 10.5 8 6 12.5"></path>
              </svg>
            </button>
          </div>
        </footer>
      </article>

      <!-- Nota oficial del informe según base v12.16 -->
      <p class="informe-nota-cierre">
        Si tu contrato actual ya encaja con cómo consume tu empresa, el informe te lo dice en lugar de proponerte otra tarifa.
      </p>
    </div>
  </div>
</section>

<script>
  (function () {
    // 100% de fidelidad con el documento base oficial EMAX Energía v12.16
    const BLOQUES = [
      {
        t: "Cuánto y cuándo consume tu empresa",
        d: "Tu consumo por periodos y por meses, traducido a las horas de tu negocio: cuánto va a las horas caras y cuánto a las baratas.",
        dato: ["Tu factura (un mes)", "tu CUPS (el histórico)"],
        vis: "horas",
      },
      {
        t: "Tu potencia",
        d: "La potencia que tienes contratada en cada periodo frente a la que usas de verdad. Si te sobra, si te falta y si pagas excesos.",
        dato: ["Tu factura", "tu CUPS", "tus maxímetros"],
        vis: "pot",
      },
      {
        t: "Tu energía reactiva",
        d: "Si la pagas, en qué periodos, cuánto al año y si compensa corregirla.",
        dato: ["Tu factura", "tu CUPS"],
        vis: "meses",
      },
      {
        t: "Tu propuesta de tarifa",
        d: "La tarifa que sale de los tres bloques anteriores: estructura, modalidad, potencias y condiciones.",
        dato: ["Todo lo anterior"],
        vis: "suma",
      },
    ];

    let bloqueActual = 0;

    // 1. Gráfico de consumo 24 horas con onda y lector integrado
    function renderHorasVisual() {
      const alturas = [18, 16, 15, 15, 16, 20, 34, 52, 70, 88, 96, 92, 86, 70, 60, 62, 68, 80, 94, 90, 76, 56, 38, 24];

      let barras = [];
      for (let i = 0; i < 24; i++) {
        let col = "var(--azul-400)";
        let tipoNombre = "Horas baratas";

        if ((i >= 10 && i <= 13) || (i >= 18 && i <= 21)) {
          col = "var(--tinta)";
          tipoNombre = "Horas caras";
        } else if ((i >= 8 && i < 10) || (i > 13 && i < 18) || (i > 21 && i < 24)) {
          col = "var(--azul-900)";
          tipoNombre = "Intermedias";
        }

        const hPct = alturas[i];
        const horaStr = `${String(i).padStart(2, "0")}:00 h`;

        barras.push(`
          <span 
            class="barra-h" 
            style="--h:${hPct}%; --delay:${i * 20}ms; background:${col};"
            data-hora="${horaStr}"
            data-tipo="${tipoNombre}"
            data-col="${col}"
            tabindex="0"
            role="graphics-symbol"
            aria-label="${horaStr}: ${tipoNombre}"
          ></span>
        `);
      }

      return `
        <div class="vis-sub-panel vis-horas-panel">
          <!-- Banda de lectura integrada: NO se desborda ni se corta en esquinas -->
          <div class="live-strip" id="horas-live-strip">
            <span class="live-strip-dot" aria-hidden="true"></span>
            <span class="live-strip-txt" id="horas-live-txt">Pasa el cursor por las horas para ver el tramo</span>
          </div>

          <div class="horas-chart-stage">
            <div class="horas" id="horas-barras-grid" role="img" aria-label="Ejemplo de consumo hora a hora de una empresa">
              ${barras.join("")}
            </div>
          </div>

          <div class="eje">
            <span>0 h</span>
            <span>6 h</span>
            <span>12 h</span>
            <span>18 h</span>
            <span>24 h</span>
          </div>

          <div class="leyenda">
            <span><i style="background:var(--tinta)"></i>Horas caras</span>
            <span><i style="background:var(--azul-900)"></i>Intermedias</span>
            <span><i style="background:var(--azul-400)"></i>Baratas</span>
          </div>
        </div>
      `;
    }

    // 2. Gráfico de potencia contratada vs registrada
    function renderPotenciaVisual() {
      const filas = [
        ["P1", 80, 52, 0, "Potencia contratada holgada"],
        ["P2", 60, 60, 16, "Exceso registrado en maxímetro"],
        ["P3", 50, 38, 0, "Potencia contratada ajustada"],
      ];

      let out = "";
      filas.forEach((r, idx) => {
        const pContratada = r[1];
        const pUsada = r[2];
        const pExceso = r[3];
        const anchoPista = (pContratada / 80) * 100;
        const anchoUso = (pUsada / pContratada) * 100;
        const anchoEx = pExceso ? (pExceso / pContratada) * 100 : 0;

        out += `
          <div class="pot__f" data-idx="${idx}">
            <div class="pot-head-fila">
              <span class="pot-periodo-tag">${r[0]}</span>
              <span class="pot-badge-estado ${pExceso ? 'badge-alerta' : 'badge-neutro'}">
                ${r[4]}
              </span>
            </div>
            <div class="pot__pista" style="width:${anchoPista}%">
              <div class="pot__uso" style="width:${anchoUso}%" title="Potencia usada: ${pUsada} kW"></div>
              ${pExceso ? `<div class="pot__ex" style="left:100%;width:${anchoEx}%" title="Exceso: +${pExceso} kW"></div>` : ""}
            </div>
          </div>
        `;
      });

      return `
        <div class="vis-sub-panel vis-pot-panel">
          <div class="pot" role="img" aria-label="Comparativa de potencia contratada frente a potencia registrada">
            ${out}
          </div>

          <div class="leyenda">
            <span><i style="border:1.5px solid var(--borde-campo); background:#fff;"></i>Contratada</span>
            <span><i style="background:var(--azul-900)"></i>Usada</span>
            <span><i style="background:var(--tinta)"></i>Exceso</span>
          </div>
        </div>
      `;
    }

    // 3. Gráfico de reactiva con umbral legal 40%
    function renderReactivaVisual() {
      const m = [30, 34, 28, 26, 30, 44, 58, 62, 50, 36, 32, 34];
      const L = ["E", "F", "M", "A", "M", "J", "J", "A", "S", "O", "N", "D"];
      const NOMBRES = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

      let c2 = "", e = "";
      m.forEach((v, i) => {
        const esAlto = v > 40;
        c2 += `
          <span 
            class="mes-col ${esAlto ? "alto" : ""}" 
            style="--h:${v}%; --delay:${i * 24}ms;" 
            data-mes="${NOMBRES[i]}"
            data-tipo="${esAlto ? 'Mes con recargo en factura' : 'Sin coste regulado'}"
            tabindex="0"
            role="graphics-symbol"
            aria-label="${NOMBRES[i]}: ${v}% reactiva"
          ></span>
        `;
        e += `<span>${L[i]}</span>`;
      });

      return `
        <div class="vis-sub-panel vis-reactiva-panel">
          <div class="live-strip" id="reactiva-live-strip">
            <span class="live-strip-dot" aria-hidden="true"></span>
            <span class="live-strip-txt" id="reactiva-live-txt">Pasa el cursor por los meses para ver el estado</span>
          </div>

          <div class="meses-chart-stage">
            <div class="meses" role="img" aria-label="Ejemplo de energía reactiva mes a mes">
              <div class="umbral" style="bottom:40%">
                <b>Umbral legal (40%)</b>
              </div>
              ${c2}
            </div>
          </div>

          <div class="eje12">${e}</div>

          <div class="leyenda">
            <span><i style="background:var(--tinta)"></i>Meses con recargo en factura</span>
            <span><i style="background:var(--azul-400)"></i>Sin coste regulado</span>
          </div>
        </div>
      `;
    }

    // 4. Propuesta de tarifa estructurada según base
    function renderSumaVisual() {
      return `
        <div class="vis-sub-panel vis-suma-panel">
          <div class="suma-flow">
            <div class="suma__in">
              <div class="chip-in">
                <span class="dot-in"></span>
                <span>1. Curva de consumo</span>
              </div>
              <div class="chip-in">
                <span class="dot-in"></span>
                <span>2. Potencias exactas</span>
              </div>
              <div class="chip-in">
                <span class="dot-in"></span>
                <span>3. Reactiva resuelta</span>
              </div>
            </div>

            <div class="suma-flecha-conector" aria-hidden="true">
              <svg width="20" height="24" viewBox="0 0 20 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 2v18"></path>
                <path d="m4 14 6 6 6-6"></path>
              </svg>
            </div>

            <div class="suma__res">
              <div class="res-item">
                <div class="res-tit">
                  <b>Estructura</b>
                </div>
                <span class="res-desc">Ajustada a las horas de tu negocio</span>
              </div>
              <div class="res-item">
                <div class="res-tit">
                  <b>Modalidad</b>
                </div>
                <span class="res-desc">Precio fijo o indexado según tu preferencia</span>
              </div>
              <div class="res-item">
                <div class="res-tit">
                  <b>Potencias</b>
                </div>
                <span class="res-desc">Ajustadas a lo que usas de verdad</span>
              </div>
              <div class="res-item">
                <div class="res-tit">
                  <b>Condiciones</b>
                </div>
                <span class="res-desc">Transparentes y sin permanencias ocultas</span>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    function generarVisual(tipo: string) {
      if (tipo === "horas") return renderHorasVisual();
      if (tipo === "pot") return renderPotenciaVisual();
      if (tipo === "meses") return renderReactivaVisual();
      return renderSumaVisual();
    }

    function renderDatosChips(b: (typeof BLOQUES)[0]) {
      return `
        <div class="datos">
          <span class="datos-tit">Con qué dato</span>
          <div class="chips-wrap">
            ${b.dato.map((x) => `<span class="chip">${x}</span>`).join("")}
          </div>
        </div>
      `;
    }

    const ind = document.getElementById("ind-bloques");
    const hoja = document.getElementById("hoja-contenido-dinamico");
    const pag = document.getElementById("hoja-pag-contador");
    const dotsContainer = document.getElementById("hoja-dots-indicador");
    const btnAnt = document.getElementById("btn-hoja-ant") as HTMLButtonElement | null;
    const btnSig = document.getElementById("btn-hoja-sig") as HTMLButtonElement | null;
    const btns: HTMLButtonElement[] = [];

    if (!ind || !hoja || !pag) return;

    // Crear dots de progreso en cabecera
    if (dotsContainer) {
      dotsContainer.innerHTML = BLOQUES.map((_, i) => `<span class="prog-dot ${i === 0 ? 'activo' : ''}" data-goto="${i}"></span>`).join("");
      dotsContainer.querySelectorAll(".prog-dot").forEach((dot) => {
        dot.addEventListener("click", () => {
          const idx = Number(dot.getAttribute("data-goto"));
          ver(idx);
        });
      });
    }

    BLOQUES.forEach((b, i) => {
      const li = document.createElement("li");
      const bt = document.createElement("button");
      bt.type = "button";
      bt.setAttribute("role", "tab");
      bt.className = "btn-indice-row";
      bt.innerHTML = `
        <span class="n" aria-hidden="true">${i + 1}</span>
        <span class="t">${b.t}</span>
        <span class="ind-chevron" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3.5 10.5 8 6 12.5"></path>
          </svg>
        </span>
      `;

      bt.addEventListener("click", () => ver(i));
      bt.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          e.preventDefault();
          const j = (i + (e.key === "ArrowDown" ? 1 : BLOQUES.length - 1)) % BLOQUES.length;
          ver(j);
          btns[j].focus();
        }
      });

      li.appendChild(bt);
      ind.appendChild(li);
      btns.push(bt);
    });

    btnAnt?.addEventListener("click", () => {
      const previo = (bloqueActual - 1 + BLOQUES.length) % BLOQUES.length;
      ver(previo);
    });

    btnSig?.addEventListener("click", () => {
      const siguiente = (bloqueActual + 1) % BLOQUES.length;
      ver(siguiente);
    });

    function attachInteractiveEvents(tipo: string) {
      if (tipo === "horas") {
        const strip = hoja.querySelector<HTMLElement>("#horas-live-strip");
        const stripTxt = hoja.querySelector<HTMLElement>("#horas-live-txt");
        const stripDot = strip?.querySelector<HTMLElement>(".live-strip-dot");
        const barras = hoja.querySelectorAll<HTMLElement>(".barra-h");

        barras.forEach((bar) => {
          bar.addEventListener("mouseenter", () => {
            const hora = bar.getAttribute("data-hora") || "";
            const tipo = bar.getAttribute("data-tipo") || "";
            const col = bar.getAttribute("data-col") || "var(--azul-400)";
            if (stripTxt && stripDot) {
              stripTxt.innerHTML = `<b>${hora}</b> · Tramo: <b>${tipo}</b>`;
              stripDot.style.backgroundColor = col;
              stripDot.style.transform = "scale(1.2)";
            }
          });

          bar.addEventListener("mouseleave", () => {
            if (stripTxt && stripDot) {
              stripTxt.textContent = "Pasa el cursor por las horas para ver el tramo";
              stripDot.style.backgroundColor = "var(--azul-400)";
              stripDot.style.transform = "scale(1)";
            }
          });
        });
      }

      if (tipo === "meses") {
        const strip = hoja.querySelector<HTMLElement>("#reactiva-live-strip");
        const stripTxt = hoja.querySelector<HTMLElement>("#reactiva-live-txt");
        const stripDot = strip?.querySelector<HTMLElement>(".live-strip-dot");
        const cols = hoja.querySelectorAll<HTMLElement>(".mes-col");

        cols.forEach((col) => {
          col.addEventListener("mouseenter", () => {
            const mes = col.getAttribute("data-mes") || "";
            const tipo = col.getAttribute("data-tipo") || "";
            const esAlto = col.classList.contains("alto");
            if (stripTxt && stripDot) {
              stripTxt.innerHTML = `<b>${mes}</b> · <b>${tipo}</b>`;
              stripDot.style.backgroundColor = esAlto ? "var(--tinta)" : "var(--azul-400)";
              stripDot.style.transform = "scale(1.2)";
            }
          });

          col.addEventListener("mouseleave", () => {
            if (stripTxt && stripDot) {
              stripTxt.textContent = "Pasa el cursor por los meses para ver el estado";
              stripDot.style.backgroundColor = "var(--azul-400)";
              stripDot.style.transform = "scale(1)";
            }
          });
        });
      }
    }

    function ver(i: number) {
      bloqueActual = i;
      const b = BLOQUES[i];
      btns.forEach((x, j) => {
        x.setAttribute("aria-selected", j === i ? "true" : "false");
        x.tabIndex = j === i ? 0 : -1;
      });

      // Actualizar dots
      const dots = dotsContainer?.querySelectorAll(".prog-dot");
      dots?.forEach((d, j) => {
        d.classList.toggle("activo", j === i);
      });

      pag.textContent = `Bloque ${i + 1} de ${BLOQUES.length}`;
      hoja.innerHTML = `
        <div class="pane">
          <h3>${b.t}</h3>
          <p class="desc">${b.d}</p>
          <div class="vis">${generarVisual(b.vis)}</div>
          ${renderDatosChips(b)}
        </div>
      `;

      attachInteractiveEvents(b.vis);
    }

    ver(0);
  })();
</script>

<style>
  /* ==========================================================================
     SISTEMA VISUAL EMAX - LO QUE HAY EN TU INFORME
     ========================================================================== */
  .sec-informe-root {
    --tinta: #0f2346;
    --tinta-2: #3a4b68;
    --papel: #ffffff;
    --suave: #f4f8fe;
    --azul-900: #004aad;
    --azul-800: #003c8c;
    --azul-700: #0f5bd8;
    --azul-400: #00c2ff;
    --resalte: #eaf3fe;
    --linea: #dbe5f3;
    --linea-fina: #eaf1fa;
    --borde-campo: #7b879c;
    --sombra-card: 0 18px 45px rgba(0, 74, 173, 0.08), 0 4px 12px rgba(15, 35, 70, 0.03);
    --sombra-hover: 0 24px 54px rgba(0, 74, 173, 0.12), 0 6px 16px rgba(15, 35, 70, 0.04);
    --f-marca: var(--font-titulos, "Poppins", sans-serif);
    --f-texto: "Poppins", "Inter", sans-serif;
    --f-dato: var(--font-titulos, "Poppins", sans-serif);

    background: #ffffff;
    color: var(--tinta);
    font: 400 1rem/1.6 var(--f-texto);
    padding-block: 84px 96px;
    border-bottom: 1px solid var(--linea-fina);
    position: relative;
  }

  .informe-par-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 48px);
    display: grid;
    gap: clamp(36px, 4vw, 64px);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  @media (min-width: 960px) {
    .informe-par-container {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  /* ==========================================================================
     COLUMNA IZQUIERDA: TITULAR + ÍNDICE INTERACTIVO PULIDO
     ========================================================================== */
  .informe-intro-col {
    position: sticky;
    top: 96px;
  }

  @media (max-width: 960px) {
    .informe-intro-col {
      position: static;
    }
  }

  .informe-kicker {
    font-family: var(--f-marca);
    font-size: 0.8rem;
    font-weight: 600;
    color: #4b6387;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .kicker-sep {
    color: #00c2ff;
    font-weight: 300;
    font-size: 1.1em;
  }

  .informe-titulo {
    font-family: var(--font-titulos, "Poppins", sans-serif);
    font-size: clamp(2.1rem, 1.7rem + 1.8vw, 3rem);
    font-weight: 800;
    color: var(--tinta);
    line-height: 1.14;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin: 0;
  }

  .titulo-cursiva {
    font-family: var(--font-acento, "Literata", Georgia, serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: #00c2ff;
    letter-spacing: 0;
    font-size: 1.08em;
    display: inline-block;
  }

  .intro-desc {
