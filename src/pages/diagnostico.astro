---
// Página: Diagnóstico de Factura e Informe de tu Empresa
// Muestra qué recibes en tu informe de diagnóstico y el desglose de auditoría
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroQueRecibes from "../components/metodo/Que recibes/HeroQueRecibes.astro";
import LoQueHayEnTuInforme from "../components/metodo/Que recibes/LoQueHayEnTuInforme.astro";
import CasoRealObrador from "../components/metodo/Que recibes/CasoRealObrador.astro";
import PuedesEmpezarConPoco from "../components/metodo/Que recibes/PuedesEmpezarConPoco.astro";
import ProximaFactura from "../components/home/ProximaFactura.astro";
---

<BaseLayout
  title="EMAX Energía"
  description="El informe de tu empresa, bloque a bloque: curva de consumo, potencias optimizadas, eliminación de reactiva y comparativa técnica."
  path="/diagnostico"
>
  <div class="diagnostico-page-wrapper">
    <!-- Hero Oficial Qué Recibes -->
    <HeroQueRecibes />

    <!-- Lo que hay en tu informe (Sección 2 oficial) -->
    <LoQueHayEnTuInforme />

    <!-- Caso real auditado línea a línea (con id factura-obrador para enlaces directos) -->
    <CasoRealObrador />

    <!-- Puedes empezar con poco (Tabla comparativa y garantías de privacidad) -->
    <PuedesEmpezarConPoco />

    <!-- Cierre final: Formulario "La tarifa no se elige: se construye" -->
    <ProximaFactura />
  </div>
</BaseLayout>

<style>
  .diagnostico-page-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
