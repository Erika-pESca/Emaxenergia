---
// Página 404 (/404.html). En Hostinger se sirve con `ErrorDocument 404 /404.html` (ver public/.htaccess).
// No se indexa y no entra en el sitemap.
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o ha cambiado de dirección. Vuelve al inicio, a las tarifas o escríbenos."
  path="/404/"
  noindex
>
  <div class="pagina-404">
    <section class="error-hero" aria-labelledby="tit-404">
      <div class="error-contenedor">
        <p class="error-codigo" aria-hidden="true">404</p>
        <h1 class="error-titulo" id="tit-404">Esta página no existe.</h1>
        <p class="error-subtitulo">
          Puede que el enlace esté mal escrito o que la página haya cambiado de sitio.
        </p>
        <p class="error-urgente">
          Si necesitas algo ya, llámanos al <a href={site.phoneHref} class="error-tel-link">{site.phone}</a>.
        </p>

        <div class="error-acciones">
          <a href="/tarifas/" class="error-link">Ver las tarifas →</a>
          <a href="/contacto/" class="error-link">Ir a contacto →</a>
          <a href="/" class="btn-volver-inicio">
            <span>Volver al inicio</span>
            <span class="btn-arrow-circulo" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .pagina-404 {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: #06183b;
  }

  .error-hero {
    position: relative;
    z-index: 20;
    margin-top: -78px;
    width: 100%;
    min-height: calc(85vh + 78px);
    background: linear-gradient(
      90deg,
      #06183b 0%,
      #05255d 26%,
      #004aad 47%,
      #0051be 50%,
      #004aad 53%,
      #05255d 74%,
      #06183b 100%
    );
    border-radius: 0 0 28px 28px;
    padding: calc(78px + 72px) 24px 84px;
    overflow: hidden;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .error-contenedor {
    max-width: 820px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .error-codigo {
    font-family: var(--font-display, var(--font-sora), sans-serif);
    font-size: clamp(4.5rem, 14vw, 8rem);
    font-weight: 800;
    line-height: 1;
    margin: 0 0 12px;
    color: #38b6ff;
    letter-spacing: -0.02em;
  }

  .error-titulo {
    font-family: var(--font-acento, var(--font-literata), Georgia, serif);
    font-style: italic;
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    font-weight: 400;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }

  .error-subtitulo {
    font-family: var(--font-titulos, var(--font-poppins), sans-serif);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    font-weight: 500;
    color: #ffffff;
    line-height: 1.45;
    margin: 0 0 16px;
    max-width: 640px;
  }

  .error-urgente {
    font-family: var(--font-cuerpo, var(--font-poppins), sans-serif);
    font-size: clamp(0.92rem, 1.2vw, 1rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.45;
    margin: 0 0 38px;
  }

  .error-tel-link {
    color: #ffffff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .error-tel-link:hover {
    color: #38b6ff;
  }

  .error-acciones {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 32px);
    flex-wrap: wrap;
    width: 100%;
  }

  .error-link {
    font-family: var(--font-cuerpo, var(--font-poppins), sans-serif);
    font-size: clamp(0.88rem, 1.1vw, 0.96rem);
    font-weight: 500;
    color: #25b5f8;
    text-decoration: none;
    padding: 6px 4px;
  }

  .error-link:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .btn-volver-inicio {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25b5f8;
    color: #071f49;
    font-family: var(--font-display, var(--font-sora), sans-serif);
    font-size: clamp(0.88rem, 1.1vw, 0.95rem);
    font-weight: 700;
    text-decoration: none;
    padding: 10px 18px 10px 22px;
    border-radius: 9999px;
    box-shadow: 0 6px 20px rgba(37, 181, 248, 0.35);
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-volver-inicio:hover {
    background: #46c3fc;
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(37, 181, 248, 0.5);
  }

  .btn-arrow-circulo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #071f49;
    color: #ffffff;
  }

  @media (max-width: 680px) {
    .error-hero {
      padding: calc(78px + 44px) 20px 60px;
      min-height: auto;
    }

    .error-acciones {
      flex-direction: column;
      gap: 18px;
    }

    .btn-volver-inicio {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }
  }
</style>
