---
// Página: Varios suministros / empresas con varias sedes (/sectores/varios-suministros)
// "UN LOCAL con la potencia mal ajustada SE NOTA POCO."
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroVariosSuministros from "../../components/sectores/varios-suministros/HeroVariosSuministros.astro";
import DoceContratosNoSonUnContrato from "../../components/sectores/varios-suministros/DoceContratosNoSonUnContrato.astro";
import DosNivelesDeDecision from "../../components/sectores/varios-suministros/DosNivelesDeDecision.astro";
import LoQueRecibes from "../../components/sectores/varios-suministros/LoQueRecibes.astro";
import ParaEmpezarBastaFactura from "../../components/sectores/varios-suministros/ParaEmpezarBastaFactura.astro";
import LoQueNoHacemosVarios from "../../components/sectores/varios-suministros/LoQueNoHacemosVarios.astro";
import CierreVariosSuministrosGasto from "../../components/sectores/varios-suministros/CierreVariosSuministrosGasto.astro";
---

<BaseLayout
  title="Luz para empresas con varias sedes: cada suministro y todos juntos | EMAX Energía"
  description="Un local con la potencia mal ajustada se nota poco; en veinte, se nota en el margen. Leemos cada suministro y todos juntos: potencias, periodos, reactiva y renovaciones."
  path="/sectores/varios-suministros"
>
  <div class="varios-page-wrapper">
    <!-- 1. Hero: degradado azul a blanco + tarjeta con selector de tramos -->
    <HeroVariosSuministros />

    <!-- 2. "DOCE CONTRATOS NO SON UN contrato multiplicado por doce." (5 tarjetas de problemas con varias sedes) -->
    <DoceContratosNoSonUnContrato />

    <!-- 3. "Dos niveles de decisión" + "Cinco sedes, cinco decisiones" + "El calendario del grupo" (Fondo blanco) -->
    <DosNivelesDeDecision />

    <!-- 4. "LO QUE RECIBES" (Tarjetas superpuestas de Informe, Llamada y Compensación) -->
    <LoQueRecibes />

    <!-- 5. "Para empezar TE BASTA UNA FACTURA" (Banner con hero (8).png y degradado azul) -->
    <ParaEmpezarBastaFactura />

    <!-- 6. "LO QUE NO HACEMOS" (Comparativas / Panel + Analizar mis locales) -->
    <LoQueNoHacemosVarios />

    <!-- 7. Cierre con formulario de tramos ("CIERRAS LA PERSIANA. La potencia se sigue pagando.") -->
    <CierreVariosSuministrosGasto />
  </div>
</BaseLayout>

<style>
  .varios-page-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
