---
// Página: Varios suministros / empresas con varias sedes (/sectores/varios-suministros)
// "UN LOCAL con la potencia mal ajustada SE NOTA POCO."
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroVariosSuministros from "../../components/sectores/varios-suministros/HeroVariosSuministros.astro";
import DoceContratosNoSonUnContrato from "../../components/sectores/varios-suministros/DoceContratosNoSonUnContrato.astro";
import LoQueRecibes from "../../components/sectores/varios-suministros/LoQueRecibes.astro";
---

<BaseLayout
  title="Luz para empresas con varias sedes: cada suministro y todos juntos | EMAX Energía"
  description="Un local con la potencia mal ajustada se nota poco; en veinte, se nota en el margen. Leemos cada suministro y todos juntos: potencias, periodos, reactiva y renovaciones."
  path="/sectores/varios-suministros"
>
  <div class="varios-page-wrapper">
    <!-- 1. Hero: degradado azul a blanco + tarjeta con selector de tramos -->
    <HeroVariosSuministros />

    <!-- 2. "DOCE CONTRATOS NO SON UN contrato multiplicado por doce." (5 tarjetas de problemas con varias sedes) -->
    <DoceContratosNoSonUnContrato />

    <!-- 3. "LO QUE RECIBES" (Tarjetas superpuestas de Informe, Llamada y Compensación) -->
    <LoQueRecibes />
  </div>
</BaseLayout>

<style>
  .varios-page-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
