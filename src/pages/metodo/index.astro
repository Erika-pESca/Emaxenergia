---
// Página: El Método de EMAX Energía
// Muestra el proceso de análisis metodológico antes de elegir tarifa:
// 1. Hero con propuesta inicial y selector interactivo de gasto
// 2. Orden metodológico en 3 etapas (Diagnóstico, Estrategia, Tarifa)
// 3. Las cinco decisiones estratégicas con acordeones y fuentes técnicas
// 4. Quién lee tus datos (Motor algorítmico Maxi + Asesor especialista colegiado)
// 5. Cierre comercial con opciones de conversión y teléfono directo
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroMetodo from "../../components/metodo/HeroMetodo.astro";
import TresEtapas from "../../components/metodo/TresEtapas.astro";
import CincoDecisiones from "../../components/metodo/CincoDecisiones.astro";
import QuienLeeTusDatos from "../../components/metodo/QuienLeeTusDatos.astro";
import ProximaFactura from "../../components/home/ProximaFactura.astro";
---

<BaseLayout
  title="EMAX Energía"
  description="Antes de elegir tarifa, hay cinco decisiones que se toman con tus datos reales: potencia, penalizaciones, horarios, riesgo y condiciones."
  path="/metodo"
>
  <div class="metodo-root">
    <!-- 1. Hero con propuesta inicial y selector de gasto -->
    <HeroMetodo />

    <!-- 2. Tres etapas del método: Diagnóstico, Estrategia y Tarifa -->
    <TresEtapas />

    <!-- 3. Las cinco decisiones estratégicas detalladas -->
    <CincoDecisiones />

    <!-- 4. Quién lee tus datos: Inteligencia Maxi + Especialistas humanos -->
    <QuienLeeTusDatos />

    <!-- 5. Cierre comercial con selector de gasto y llamada telefónica -->
    <ProximaFactura />
  </div>
</BaseLayout>

<style>
  .metodo-root {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
