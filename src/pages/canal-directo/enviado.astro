---
// Página: Confirmación de Canal Directo (/canal-directo/enviado)
// Unificado con el diseño oficial de confirmación de Contacto
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroContactoRecibido from "../../components/contacto/HeroContactoRecibido.astro";
---

<BaseLayout
  title="Solicitud recibida · Canal Directo · EMAX Energía"
  description="Hemos recibido tu solicitud para el Canal Directo de EMAX Energía."
  path="/canal-directo/enviado/"
>
  <div class="canal-recibido-page">
    <HeroContactoRecibido tipo="canal" />
  </div>
</BaseLayout>

<style>
  .canal-recibido-page {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: #06183b;
  }
</style>
