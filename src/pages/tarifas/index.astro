---
// Página: Tarifas de Luz para Empresas (/tarifas)
// Replicación fiel y modular de la sección oficial de tarifas
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroTarifas from "../../components/tarifas/HeroTarifas.astro";
import Acordeon from "../../components/tarifas/Acordeon.astro";
import CasoTarifa from "../../components/tarifas/CasoTarifa.astro";
import PartesPrecio from "../../components/tarifas/PartesPrecio.astro";
import CompararOfertas from "../../components/tarifas/CompararOfertas.astro";
import ProximaFactura from "../../components/home/ProximaFactura.astro";
---

<BaseLayout
  title="Tarifas de luz para empresas: así se construye la tuya | EMAX Energía"
  description="No tenemos lista de precios: tu tarifa sale de tu consumo real. Conoce las cuatro piezas de una tarifa, los peajes 2.0TD, 3.0TD y 6.1TD y cómo comparar ofertas."
  path="/tarifas"
>
  <div class="tarifas-page-wrapper">
    <!-- 1. Hero con diseño oficial exacto y selector de gasto interactivo -->
    <HeroTarifas />

    <!-- 2. Acordeón interactivo de las cuatro piezas (Estructura, Modalidad, Potencia y Condiciones) -->
    <Acordeon />

    <!-- 3. Caso de ejemplo auditado: Así quedó su tarifa (Obrador de panadería) -->
    <CasoTarifa />

    <!-- 4. Lo que es igual con cualquier compañía (3 partes, acordeón de peajes y acordeón de desglose) -->
    <PartesPrecio />

    <!-- 6. Cinco comprobaciones para comparar ofertas -->
    <CompararOfertas />

    <!-- 7. Cierre oficial con formulario de análisis -->
    <ProximaFactura />
  </div>
</BaseLayout>

<style>
  .tarifas-page-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
