---
// Página: Tarifas de Luz para Empresas (/tarifas)
// Replicación fiel y modular de la sección oficial de tarifas
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroTarifas from "../../components/tarifas/HeroTarifas.astro";
import PeajesTarifas from "../../components/tarifas/PeajesTarifas.astro";
import PartesPrecio from "../../components/tarifas/PartesPrecio.astro";
import CompararOfertas from "../../components/tarifas/CompararOfertas.astro";
import ProximaFactura from "../../components/home/ProximaFactura.astro";
---

<BaseLayout
  title="Tarifas de luz para empresas: así se construye la tuya | EMAX Energía"
  description="No tenemos lista de precios: tu tarifa sale de tu consumo real. Conoce los peajes 2.0TD, 3.0TD y 6.1TD, de qué está hecho el precio y cómo comparar cualquier oferta."
  path="/tarifas"
>
  <div class="tarifas-page-wrapper">
    <!-- Hero con diseño oficial exacto y selector de gasto interactivo -->
    <HeroTarifas />

    <!-- Estructura de peajes regulados (2.0TD, 3.0TD, 6.1TD) -->
    <PeajesTarifas />

    <!-- Partes del precio y componentes optimizables vs regulados -->
    <PartesPrecio />

    <!-- Cinco comprobaciones para comparar ofertas -->
    <CompararOfertas />

    <!-- Cierre oficial con formulario de análisis -->
    <ProximaFactura />
  </div>
</BaseLayout>

<style>
  .tarifas-page-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
