---
// Página: Atención al Cliente
// Diseño: Hero institucional oscuro + Cuadrícula de 6 TARJETAS VISIBLES (sin acordeones)
// Contenido: Texto exacto oficial del borrador v12.16 con todas las notas [LEGAL], [PENDIENTE] y citas del RD 88/2026
import BaseLayout from "../layouts/BaseLayout.astro";
import HablaConNosotros from "../components/contacto/HablaConNosotros.astro";
import { site } from "../data/site";

const whatsappHref =
  "https://wa.me/34933949343?text=" +
  encodeURIComponent(
    "Hola EMAX Energía, ya soy cliente y necesito ayuda con mi suministro."
  );

const mailtoSoporte = `mailto:${site.emailSoporte}`;
---

<BaseLayout
  title="Atención al cliente · EMAX Energía"
  description="Busca tu caso. Te decimos a quién acudir y qué puedes pedir: dudas sobre facturas o contratos, averías, cambio de compañía o reclamaciones."
  path="/atencion-al-cliente/"
>
  <!-- Hero institucional oscuro con salidas directas -->
  <section class="ac-hero" aria-labelledby="h1-atencion">
    <div class="ac-hero-contenedor">
      <p class="ac-kicker">Si ya eres cliente</p>
      <h1 class="ac-h1" id="h1-atencion">Atención al cliente</h1>
      <p class="ac-subtitulo">
        Busca tu caso. Te decimos a quién acudir y qué puedes pedir.
      </p>

      <p class="ac-canales-directos">
        <a href={site.phoneHref} class="ac-link-blanco">{site.phone}</a> · <a href={mailtoSoporte} class="ac-link-blanco">{site.emailSoporte}</a><br />
        De lunes a viernes, de 9:00 a 13:00 y de 15:00 a 19:00
      </p>

      <!-- Botones de acción rápida y embudo a Contacto -->
      <div class="ac-hero-botones">
        <a href="#contacto-directo" class="ac-btn ac-btn--primario">
          Ir a Contacto
          <span class="ac-btn-icono" aria-hidden="true">→</span>
        </a>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="ac-btn ac-btn--whatsapp"
        >
          WhatsApp directo
        </a>
        <a href={`${mailtoSoporte}?subject=${encodeURIComponent("Atención al cliente · EMAX Energía")}`} class="ac-btn ac-btn--secundario">
          Enviar email
        </a>
        <a href={site.phoneHref} class="ac-btn ac-btn--secundario">
          Llamar al {site.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Casos estructurados como TARJETAS fijas y visibles -->
  <section class="ac-casos-seccion" aria-labelledby="h2-casos">
    <div class="ac-contenedor">
      <header class="ac-seccion-header">
        <span class="ac-seccion-kicker">RESOLUCIÓN POR CASO</span>
        <h2 class="ac-seccion-h2" id="h2-casos">Tu caso</h2>
        <p class="ac-seccion-sub">
          Busca tu situación: te decimos a quién acudir, qué puedes pedir y cuáles son tus derechos legales.
        </p>
      </header>

      <!-- CUADRÍCULA DE TARJETAS (Texto exacto 12.16) -->
      <div class="ac-cards-grid">
        <!-- Caso 1 -->
        <article class="ac-card" id="factura">
          <div class="ac-card-head">
            <span class="ac-card-num">01</span>
            <h3 class="ac-card-tit">Tengo una duda sobre mi factura o mi contrato</h3>
          </div>
          <p class="ac-card-bajada">
            Llámanos, escríbenos o mándanos la factura por email: te explicamos cada concepto.
          </p>

          <div class="ac-card-cuerpo">
            <dl class="ac-dl">
              <div>
                <dt>Tu derecho</dt>
                <dd>
                  Tienes derecho a una explicación clara y comprensible de los conceptos de tu factura, sobre todo si no se basa en tu consumo real. <span class="sector__fuente">(RD 88/2026, art. 6.1.o)</span>
                </dd>
              </div>
            </dl>
          </div>

          <div class="ac-card-pie">
            <a href="/guias/factura-luz-empresa/" class="ac-card-enlace">Cómo leer la factura de luz de tu empresa →</a>
            <a href="#contacto-directo" class="ac-card-btn-mini">Escribir en Contacto</a>
          </div>
        </article>

        <!-- Caso 2 -->
        <article class="ac-card ac-card--alerta" id="averia">
          <div class="ac-card-head">
            <span class="ac-card-num ac-num--alerta">02</span>
            <h3 class="ac-card-tit">Tengo una avería o me he quedado sin luz</h3>
          </div>
          <p class="ac-card-bajada">
            Llama a tu distribuidora: su teléfono de averías es gratuito, atiende las 24 horas y aparece en tu factura.
          </p>

          <div class="ac-card-cuerpo">
            <dl class="ac-dl">
              <div>
                <dt>Qué hacer</dt>
                <dd>
                  La distribuidora es la empresa que gestiona la red de tu zona y la que resuelve averías y cortes. <span class="sector__fuente">(RD 88/2026, art. 6.1.ac)</span>
                </dd>
              </div>
              <div>
                <dt>Por qué no nosotros</dt>
                <dd>
                  Ninguna comercializadora puede reparar la red. Llamar primero a la distribuidora te ahorra tiempo.
                </dd>
              </div>
              <div>
                <dt>Después</dt>
                <dd>
                  Si la avería te ha causado un problema con tu factura o tu contrato, cuéntanoslo.
                </dd>
              </div>
            </dl>
          </div>

          <div class="ac-card-pie">
            <span class="ac-distribuidora-aviso">Teléfono de averías 24h en tu factura</span>
            <a href={site.phoneHref} class="ac-card-btn-mini ac-btn--alerta">Llamar a EMAX</a>
          </div>
        </article>

        <!-- Caso 3 -->
        <article class="ac-card" id="cambio">
          <div class="ac-card-head">
            <span class="ac-card-num">03</span>
            <h3 class="ac-card-tit">Estoy cambiando de compañía</h3>
          </div>
          <p class="ac-card-bajada">
            Llámanos o escríbenos con tu CUPS y te decimos en qué paso está.
          </p>

          <div class="ac-card-cuerpo">
            <dl class="ac-dl">
              <div>
                <dt>Tu derecho</dt>
                <dd>
                  Tienes derecho a saber en qué punto está tu cambio y a pedir información por cualquiera de nuestros canales. <span class="sector__fuente">(RD 88/2026, art. 6.1.w)</span>
                </dd>
              </div>
            </dl>
          </div>

          <div class="ac-card-pie">
            <a href="#contacto-directo" class="ac-card-enlace">Consultar estado con tu CUPS →</a>
            <a href="#contacto-directo" class="ac-card-btn-mini">Ir a Contacto</a>
          </div>
        </article>

        <!-- Caso 4 -->
        <article class="ac-card" id="reclamacion">
          <div class="ac-card-head">
            <span class="ac-card-num">04</span>
            <h3 class="ac-card-tit">
              Quiero hacer una reclamación <span class="pendiente">[LEGAL]</span>
            </h3>
          </div>
          <p class="ac-card-bajada">
            Por teléfono, por email o por la vía electrónica que fije la asesoría.
          </p>

          <div class="ac-card-cuerpo">
            <dl class="ac-dl">
              <div>
                <dt>Cómo</dt>
                <dd>
                  <span class="pendiente">[LEGAL: vías de reclamación y a nombre de quién se presenta · art. 6.1.x]</span>
                </dd>
              </div>
              <div>
                <dt>Plazo de respuesta</dt>
                <dd>
                  <span class="pendiente">[PENDIENTE: plazo del art. 55, por verificar]</span>
                </dd>
              </div>
              <div>
                <dt>Qué incluir</dt>
                <dd>
                  Tu nombre o el de tu empresa, el CUPS, la factura afectada y qué ha pasado.
                </dd>
              </div>
            </dl>
          </div>

          <div class="ac-card-pie">
            <a href={`${mailtoSoporte}?subject=${encodeURIComponent("Reclamación · EMAX Energía")}`} class="ac-card-enlace">Escribir a {site.emailSoporte} →</a>
            <a href="#contacto-directo" class="ac-card-btn-mini">Abrir reclamación</a>
          </div>
        </article>

        <!-- Caso 5 -->
        <article class="ac-card" id="no-resuelta">
          <div class="ac-card-head">
            <span class="ac-card-num">05</span>
            <h3 class="ac-card-tit">
              Mi reclamación no se ha resuelto <span class="pendiente">[LEGAL]</span>
            </h3>
          </div>
          <p class="ac-card-bajada">
            Entidad de resolución alternativa de litigios: pendiente (31 L1, L2).
          </p>

          <div class="ac-card-cuerpo">
            <div class="ac-pendiente-box">
              <span class="pendiente">[LEGAL: entidad y enlace · art. 6.1.ak]</span>
            </div>
          </div>

          <div class="ac-card-pie">
            <a href="https://www.cnmc.es" target="_blank" rel="noopener noreferrer" class="ac-card-enlace">Portal CNMC Energía →</a>
            <a href="#contacto-directo" class="ac-card-btn-mini">Pedir mediación</a>
          </div>
        </article>

        <!-- Caso 6 -->
        <article class="ac-card" id="datos">
          <div class="ac-card-head">
            <span class="ac-card-num">06</span>
            <h3 class="ac-card-tit">
              Quiero ejercer mis derechos sobre mis datos
            </h3>
          </div>
          <p class="ac-card-bajada">
            El responsable es ENERGYMAX ADVISORY, S.L.U. Puedes escribirnos para ejercer tus derechos.
          </p>

          <div class="ac-card-cuerpo">
            <div class="ac-pendiente-box">
              Acceso, rectificación, supresión, oposición, portabilidad y limitación: <a href={`mailto:${site.emailLegal}`}>{site.emailLegal}</a>.
            </div>
          </div>

          <div class="ac-card-pie">
            <a href="/privacidad/" class="ac-card-enlace">Política de privacidad →</a>
            <a href={`mailto:${site.emailLegal}?subject=${encodeURIComponent("Ejercicio Derechos RGPD")}`} class="ac-card-btn-mini">Ejercer derechos</a>
          </div>
        </article>
      </div>

      <!-- Banner de embudo hacia Contacto -->
      <div class="ac-embudo-banner">
        <div class="ac-embudo-info">
          <h3 class="ac-embudo-titulo">¿Prefieres que revisemos tu caso directamente?</h3>
          <p class="ac-embudo-desc">
            Rellena el formulario que tienes a continuación o escríbenos por WhatsApp y te contactaremos de inmediato.
          </p>
        </div>
        <div class="ac-embudo-acciones">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="ac-btn ac-btn--whatsapp">
            Abrir WhatsApp
          </a>
          <a href="#contacto-directo" class="ac-btn ac-btn--primario">
            Ir al formulario ↓
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Embudo al formulario de Contacto integrado -->
  <div id="contacto-directo">
    <HablaConNosotros />
  </div>
</BaseLayout>

<style>
  .ac-hero {
    position: relative;
    z-index: 20;
    margin-top: -78px;
    width: 100%;
    background: linear-gradient(
      90deg,
      #06183b 0%,
      #05255d 26%,
      #004aad 47%,
      #0051be 50%,
      #004aad 53%,
      #05255d 74%,
      #06183b 100%
    );
    border-radius: 0 0 28px 28px;
    padding: calc(78px + 84px) 0 68px;
    color: #ffffff;
  }

  .ac-hero-contenedor {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  .ac-kicker {
    display: inline-block;
    font-family: var(--font-poppins), sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #bae6fd;
    background: rgba(37, 181, 248, 0.16);
    border: 1px solid rgba(56, 189, 248, 0.35);
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .ac-h1 {
    font-family: var(--font-poppins), sans-serif;
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.08;
    color: #25b5f8;
    margin: 0 0 16px;
  }

  .ac-subtitulo {
    font-family: var(--font-poppins), sans-serif;
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    font-weight: 400;
    line-height: 1.55;
    color: #e8f2ff;
    max-width: 720px;
    margin: 0 auto 16px;
  }

  .ac-canales-directos {
    margin-bottom: 28px;
    font-family: var(--font-poppins), sans-serif;
    font-size: 0.9rem;
    color: #cbd5e1;
    line-height: 1.5;
  }

  .ac-link-blanco {
    color: #ffffff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ac-hero-botones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .ac-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-poppins), sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .ac-btn--primario {
    background: #14a9f5;
    color: #ffffff;
    border: 1.5px solid #14a9f5;
    box-shadow: 0 8px 22px rgba(20, 169, 245, 0.35);
  }

  .ac-btn--primario:hover {
    background: #0c95dc;
    transform: translateY(-2px);
  }

  .ac-btn--whatsapp {
    background: #10b981;
    color: #ffffff;
    border: 1.5px solid #10b981;
    box-shadow: 0 8px 22px rgba(16, 185, 129, 0.32);
  }

  .ac-btn--whatsapp:hover {
    background: #059669;
    transform: translateY(-2px);
  }

  .ac-btn--secundario {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
  }

  .ac-btn--secundario:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #ffffff;
  }

  /* Sección de casos */
  .ac-casos-seccion {
    background: #e6ecf5;
    padding: 68px 0 48px;
  }

  .ac-contenedor {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .ac-seccion-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 44px;
  }

  .ac-seccion-kicker {
    display: inline-block;
    font-family: var(--font-poppins), sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0051be;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .ac-seccion-h2 {
    font-family: var(--font-poppins), sans-serif;
    font-size: clamp(1.65rem, 3vw, 2.3rem);
    font-weight: 800;
    color: #06183b;
    line-height: 1.2;
    margin: 0 0 10px;
  }

  .ac-seccion-sub {
    font-family: var(--font-poppins), sans-serif;
    font-size: 0.94rem;
    color: #475569;
    line-height: 1.55;
    margin: 0;
  }

  /* Cuadrícula de Tarjetas */
  .ac-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 56px;
  }

  .ac-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #d5e0f0;
    box-shadow: 0 10px 28px rgba(6, 24, 59, 0.05);
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: var(--font-poppins), sans-serif;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .ac-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0, 74, 173, 0.12);
    border-color: #38bdf8;
  }

  .ac-card--alerta {
    border-color: #fecaca;
  }

  .ac-card--alerta:hover {
    border-color: #f87171;
  }

  .ac-card-head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 12px;
  }

  .ac-card-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #edf4fe;
    color: #004aad;
    font-weight: 800;
    font-size: 0.95rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .ac-num--alerta {
    background: #fee2e2;
    color: #dc2626;
  }

  .ac-card-tit {
    font-size: 1.1rem;
    font-weight: 700;
    color: #06183b;
    margin: 0;
    line-height: 1.35;
  }

  .ac-card-bajada {
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0 0 18px;
  }

  .ac-card-cuerpo {
    flex: 1;
    margin-bottom: 20px;
  }

  /* Listado de definiciones / detalles */
  .ac-dl {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    background: #f8fafc;
    border-radius: 10px;
    padding: 14px 16px;
    border-left: 3px solid #004aad;
  }

  .ac-dl dt {
    font-weight: 700;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #004aad;
    margin-bottom: 2px;
  }

  .ac-dl dd {
    font-size: 0.88rem;
    color: #334155;
    line-height: 1.5;
    margin: 0;
  }

  .sector__fuente {
    color: #64748b;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .pendiente {
    color: #b91c1c;
    background: #fee2e2;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.88em;
  }

  .ac-pendiente-box {
    background: #fff8eb;
    border: 1px dashed #f59e0b;
    border-radius: 10px;
    padding: 14px 16px;
  }

  .ac-card-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid #f1f5f9;
    margin-top: auto;
  }

  .ac-card-enlace {
    font-size: 0.86rem;
    color: #0051be;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ac-card-enlace:hover {
    color: #14a9f5;
  }

  .ac-card-btn-mini {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #004aad;
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .ac-card-btn-mini:hover {
    background: #003885;
    transform: translateY(-1px);
  }

  .ac-btn--alerta {
    background: #dc2626;
  }

  .ac-btn--alerta:hover {
    background: #b91c1c;
  }

  .ac-distribuidora-aviso {
    font-size: 0.82rem;
    color: #64748b;
    font-weight: 600;
  }

  /* Banner de embudo */
  .ac-embudo-banner {
    background: #06183b;
    border-radius: 20px;
    padding: 30px 36px;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    border: 1px solid rgba(56, 189, 248, 0.28);
    box-shadow: 0 16px 40px rgba(4, 18, 46, 0.16);
  }

  .ac-embudo-titulo {
    font-family: var(--font-poppins), sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 6px;
  }

  .ac-embudo-desc {
    font-family: var(--font-poppins), sans-serif;
    font-size: 0.9rem;
    color: #cbd5e1;
    margin: 0;
    line-height: 1.5;
  }

  .ac-embudo-acciones {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }

  @media (max-width: 820px) {
    .ac-hero {
      padding: calc(78px + 52px) 0 48px;
    }

    .ac-cards-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .ac-card {
      padding: 22px 20px;
    }

    .ac-embudo-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px 22px;
    }

    .ac-embudo-acciones {
      width: 100%;
      flex-direction: column;
    }

    .ac-embudo-acciones .ac-btn {
      width: 100%;
    }
  }
</style>
