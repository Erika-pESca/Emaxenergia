---
// Estructura de cada página. El contenido de la página entra en <slot />.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Dock from "../components/Dock.astro";
import Formulario from "../components/Formulario.astro";
import CookieBanner from "../components/CookieBanner.astro";
import Seo from "../components/Seo.astro";
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-inter" preload={[{ weight: 400, style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-poppins" preload={[{ weight: 700, style: "normal", subset: "latin" }, { weight: 800, style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-sora" />
    <Font cssVariable="--font-literata" />
    <Seo title={title} description={description} path={path} noindex={noindex} />
  </head>
  <body class="con-dock">
    <a class="saltar-enlace" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Dock />
    <Footer />
    <Formulario />
    <CookieBanner />
  </body>
</html>
