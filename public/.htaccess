# =============================================================================
# EMAX Energía · .htaccess (Hostinger, Apache/LiteSpeed)
#
# IMPORTANTE · HSTS: empieza con max-age=300 (5 minutos) a propósito. Cuando
# se haya confirmado que HTTPS funciona en todo el dominio y en todas las
# páginas (y que no hace falta volver atrás), hay que subirlo a 31536000
# (1 año) en la cabecera Strict-Transport-Security de más abajo.
#
# Este archivo solo lo interpreta Apache/LiteSpeed. Otros hostings (Vercel,
# Netlify...) lo ignoran. Después de publicar, comprueba las cabeceras reales:
#   curl -I https://emaxenergia.com/
#
# La CSP se ha ajustado a lo que el sitio carga de verdad: todo es del propio
# dominio (scripts y estilos inline de Astro incluidos, de ahí 'unsafe-inline').
# Si se añade un recurso externo (analítica, mapas, vídeo, servicio de
# formularios...) hay que incluir su dominio aquí.
# =============================================================================

Options -Indexes
AddDefaultCharset UTF-8

# =============================================================================
# DÍA DEL LANZAMIENTO · redirección 301 de emaxenergia.es -> https://emaxenergia.com
# (ahora mismo DESACTIVADA: todo el bloque está comentado)
#
# Decisión de dominios:
#   - Revisión: el sitio se sirve en emaxenergia.es con noindex (regla más abajo).
#   - Lanzamiento: el sitio se publica en emaxenergia.com y se indexa con normalidad.
#     emaxenergia.com es el dominio canónico definitivo.
#   - Desde el lanzamiento, emaxenergia.es redirige con 301 a emaxenergia.com.
#
# Cómo activarlo (en el .htaccess que se sirve en emaxenergia.es, NO en el del .com):
#   1. Quitar el "# " inicial de las líneas del bloque de abajo.
#   2. El bloque tiene que ir ANTES de la regla "HTTPS y www -> sin www" de más
#      abajo, para que http://emaxenergia.es/x/ no pase por dos redirecciones.
#      (Lo más sencillo: dejar en el .htaccess del .es solo este bloque activo.)
#   3. El .es necesita certificado SSL válido, también para www, o los navegadores
#      avisarán antes de llegar a la redirección.
#   4. Comprobar:
#        curl -I http://emaxenergia.es/metodo/
#        curl -I https://www.emaxenergia.es/
#      Los dos tienen que dar 301 con "Location: https://emaxenergia.com/metodo/"
#      (la misma ruta) y "Location: https://emaxenergia.com/" respectivamente.
#
# Con el bloque activo, la regla de noindex del .es (más abajo) deja de importar:
# ninguna petición al .es llega a servir una página, todas redirigen. Puede
# dejarse tal cual. El .com nunca recibe esa cabecera.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   # .es y www.es, en http y en https, con o sin puerto; conserva la ruta y la query
#   RewriteCond %{HTTP_HOST} ^(?:www\.)?emaxenergia\.es(?::\d+)?$ [NC]
#   RewriteRule ^ https://emaxenergia.com%{REQUEST_URI} [L,R=301]
# </IfModule>
# =============================================================================

# --- HTTPS y www -> sin www, conservando el dominio de la petición ----------
# Sirve igual para emaxenergia.es (revisión) y emaxenergia.com: ningún dominio va fijo.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https (y quita el www de paso, en una sola redirección)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(?:www\.)?([^:]+)(?::\d+)?$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # https://www.dominio -> https://dominio
  RewriteCond %{HTTP_HOST} ^www\.([^:]+)(?::\d+)?$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Versión de revisión (emaxenergia.es): que NO se indexe -------------------
# Mientras el .es sea solo para revisar, se envía X-Robots-Tag: noindex, nofollow.
# CUANDO EL .es PASE A SER PÚBLICO (o se retire): borrar estas dos líneas
# (SetEnvIf y Header ... env=NOINDEX_REVISION). El .com nunca lleva esta cabecera.
SetEnvIf Host "(^|\.)emaxenergia\.es(:\d+)?$" NOINDEX_REVISION
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=NOINDEX_REVISION
</IfModule>

# --- Página de error ---------------------------------------------------------
ErrorDocument 404 /404.html

# --- Cabeceras de seguridad --------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"

  # HSTS: ver el aviso al principio del archivo. Subir a 31536000 cuando HTTPS esté confirmado.
  Header always set Strict-Transport-Security "max-age=300; includeSubDomains"

  # CSP: todo es del propio dominio. El envío de correo (Resend) lo hace el servidor PHP, no el navegador:
  # el navegador solo habla con /api/enviar-formulario.php (mismo dominio), así que connect-src 'self' alcanza.
  # CSP: 'unsafe-inline' hace falta por los <script> y <style> inline que genera Astro.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; frame-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# --- Caché -------------------------------------------------------------------
<IfModule mod_headers.c>
  # Todo lo de /_astro/ lleva hash en el nombre: se puede cachear un año sin riesgo.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # El HTML no se cachea: siempre se revalida para ver los cambios al publicar.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compresión --------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
