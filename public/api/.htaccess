# EMAX Energía · protección de public/api/
# Solo enviar-formulario.php es accesible; todo lo demás de esta carpeta queda denegado
# y no hay listado de directorio.
Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
  <Files "enviar-formulario.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "enviar-formulario.php">
    Allow from all
  </Files>
</IfModule>
